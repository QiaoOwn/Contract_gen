  "contract": {
    "definition": "orderProduct: OrderProduct = OrderProduct.allInstances()->any(op: OrderProduct | op.OrderID = orderID)",
    "precondition": "OrderProduct.allInstances()->one(op: OrderProduct | op.OrderID = orderID)",
    "postcondition": "result = true and orderProduct.Status = 'RECEIVED' and Item.allInstances()->forAll(i: Item | if orderProduct.OrderEntry@pre->exists(e: OrderEntry | e.Item@pre = i) then i.StockNumber = i.StockNumber@pre + orderProduct.OrderEntry@pre->sumBy(e: OrderEntry | if e.Item@pre = i then e.Quantity@pre else 0 endif) else i.StockNumber = i.StockNumber@pre endif)"
  },
