{
  "name": "langchain-ocl-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run remove-tmp-test-folder && npm run test:out && next build",
    "start": "next start",
    "lint": "tsc --noEmit && eslint src script",
    "test": "jest --coverage --testPathIgnorePatterns=test/tmp",
    "test:out": "jest --coverage --coverageDirectory=public/coverage --testPathIgnorePatterns=test/tmp",
    "test:watchAll": "jest --coverage --watchAll --testPathIgnorePatterns=test/tmp",
    "test:l:watch": "jest LogicFormulaBuilder.test.ts --watch --coverage",
    "remodel-antlr4-typescript": "antlr4 -Dlanguage=TypeScript ./antlr4/REMODEL.g4 -visitor && yarn run pretty",
    "statistic": "tsx statistic.ts",
    "experiment": "tsx script/experiment.ts",
    "experiment-line": "tsx script/experiment-line.ts",
    "export-operations-jsonl": "tsx script/export-operations-jsonl.ts",
    "generate-bleu-dataset": "tsx script/generate-bleu-dataset.ts",
    "generate-bleu-dataset-line": "tsx script/generate-bleu-dataset-line.ts",
    "generate-cosine-similarity": "tsx script/generate-cosine-similarity.ts",
    "generate-cosine-similarity-line": "tsx script/generate-cosine-similarity-line.ts",
    "generate-test-files": "tsx script/generate-test-files.ts && npm run pretty",
    "remove-tmp-test-folder": "tsx script/remove-tmp-test-folder.ts",
    "pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json}\"",
    "prepare": "husky install"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.0.1",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@babel/generator": "^7.27.1",
    "@babel/parser": "^7.27.2",
    "@babel/preset-typescript": "^7.27.1",
    "@babel/template": "^7.27.2",
    "@bprogress/next": "^3.2.12",
    "@langchain/core": "^0.3.66",
    "@langchain/langgraph": "^0.4.0",
    "@langchain/openai": "^0.6.7",
    "@microlink/react-json-view": "^1.27.0",
    "@monaco-editor/react": "^4.7.0-rc.0",
    "ahooks": "^3.8.1",
    "ai": "^5.0.0",
    "antd": "^5.26.7",
    "antlr4": "^4.13.2",
    "axios": "^1.8.4",
    "classnames": "^2.5.1",
    "js-rouge": "^3.0.0",
    "langchain": "^0.3.21",
    "langsmith": "^0.3.49",
    "lodash": "^4.17.21",
    "monaco-editor": "^0.52.2",
    "next": "15.3.0",
    "prettier": "^3.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.13"
  },
  "devDependencies": {
    "@babel/types": "^7.27.1",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__template": "^7.4.4",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.17",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "colors": "^1.4.0",
    "dotenv": "^17.2.1",
    "eslint": "^9",
    "eslint-config-next": "15.3.0",
    "fs-extra": "^11.3.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "openai": "^5.12.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.3.4",
    "tsx": "^4.19.4",
    "typescript": "^5"
  }
}
