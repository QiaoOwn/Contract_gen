Contract RepairService::approve(sid:Integer,rid:Integer,reject:Boolean,suggestion:String): ApprovalHistory {
          precondition:
          Repair.allInstances()->exists(r | r.Id = rid) and
Staff.allInstances()->exists(s | s.Id = sid)
            postcondition:
          ApprovalHistory.allInstances()->exists(ah |
        not ApprovalHistory.allInstances@pre()->includes(ah) and
        ah.StaffId = sid and
        ah.Reject = reject and
        ah.Suggestion = suggestion and
        ah.repair = Repair.allInstances()->any(r | r.Id = rid)
    ) and
let r: Repair = Repair.allInstances()->any(x | x.Id = rid) in
    let s: Staff = Staff.allInstances()->any(x | x.Id = sid) in
        reject = true and s.Role = 1 and r.Process@pre = 0
        implies r.Process = 1 and
let r: Repair = Repair.allInstances()->any(x | x.Id = rid) in
    let s: Staff = Staff.allInstances()->any(x | x.Id = sid) in
        reject = true and s.Role = 2 and r.Process@pre = 1
        implies r.Process = 2 and
let r: Repair = Repair.allInstances()->any(x | x.Id = rid) in
    let s: Staff = Staff.allInstances()->any(x | x.Id = sid) in
        reject = true and s.Role = 3 and r.Process@pre = 2
        implies r.Process = 3 and
let r: Repair = Repair.allInstances()->any(x | x.Id = rid) in
        reject = false implies r.Process = 5 and
not ApprovalHistory.allInstances@pre()->includes(result) and
    result.StaffId = sid and
    result.Reject = reject and
    result.Suggestion = suggestion and
    result.repair = Repair.allInstances()->any(r | r.Id = rid)
            
        }