Contract AutomatedTellerMachineSystem::ejectCard(): Boolean {
          precondition:
          self.isCardValidated = true and
not self.currentCard.oclIsUndefined()
            postcondition:
          self.currentCard.oclIsUndefined() and
self.isCardValidated = false and
self.isDeposit = false and self.depositAmount = 0 and
self.isWithdraw = false and self.withdrawAmount = 0 and
result = true
            
        }