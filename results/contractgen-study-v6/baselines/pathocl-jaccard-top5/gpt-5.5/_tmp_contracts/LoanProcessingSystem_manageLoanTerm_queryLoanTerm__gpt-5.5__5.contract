Contract ManageLoanTermCRUDService::queryLoanTerm(itemid:Integer): LoanTerm {
          precondition:
          LoanTerm.allInstances()->exists(lt | lt.oclIsDefined() and lt.LoanAccountID = itemid)
            postcondition:
          result = LoanTerm.allInstances()->any(lt | lt.LoanAccountID = itemid)
            
        }