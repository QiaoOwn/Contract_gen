Contract ManageLoanTermCRUDService::createLoanTerm(itemid:Integer,content:String): Boolean {
          precondition:
          LoanAgreement.allInstances()->forAll(lt | lt.itemid <> itemid)
            postcondition:
          LoanAgreement.allInstances()->exists(lt |
        lt.oclIsNew() and
        lt.itemid = itemid and
        lt.Content = content
    ) and
result = true
            
        }