Contract ManageItemCRUDService::modifyItem(barcode:Integer,name:String,price:Real,stocknumber:Integer,orderprice:Real): Boolean {
          precondition:
          Item.allInstances()->exists(i: Item | i.Barcode = barcode)
            postcondition:
          Item.allInstances()->any(i: Item | i.Barcode@pre = barcode).Barcode = barcode and
    Item.allInstances()->any(i: Item | i.Barcode = barcode).Name = name and
    Item.allInstances()->any(i: Item | i.Barcode = barcode).Price = price and
    Item.allInstances()->any(i: Item | i.Barcode = barcode).StockNumber = stocknumber and
    Item.allInstances()->any(i: Item | i.Barcode = barcode).OrderPrice = orderprice and
result = true
            
        }