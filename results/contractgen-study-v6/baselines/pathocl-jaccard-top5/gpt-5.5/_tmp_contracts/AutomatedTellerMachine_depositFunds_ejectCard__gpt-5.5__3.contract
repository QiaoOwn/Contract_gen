Contract AutomatedTellerMachineSystem::ejectCard(): Boolean {
          precondition:
          self.isCardIdValidated = true and
    self.isPasswordValidated = true and
not self.currentCard.oclIsUndefined()
            postcondition:
          self.currentCard.oclIsUndefined() and
self.isCardIdValidated = false and
    self.isPasswordValidated = false and
    self.isAuthenticated = false and
self.isDepositing = false and
    self.isWithdrawing = false and
    self.depositAmount = 0 and
    self.withdrawAmount = 0 and
result = true
            
        }