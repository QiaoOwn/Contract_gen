Contract CoCoMESystem::closeCashDesk(cashDeskID:Integer): Boolean {
          precondition:
          CashDesk.allInstances()->exists(cd: CashDesk |
        cd.Id = cashDeskID and
        cd.IsOpened = true
    ) and
Store.allInstances()->exists(s: Store |
        s.IsOpened = true and
        s.AssociationCashdeskes->exists(cd: CashDesk |
            cd.Id = cashDeskID and
            cd.IsOpened = true
        )
    )
            postcondition:
          CashDesk.allInstances()->select(cd: CashDesk |
        cd.Id = cashDeskID
    )->forAll(cd: CashDesk |
        cd.IsOpened = false
    ) and
CashDesk.allInstances()->select(cd: CashDesk |
        cd.Id = cashDeskID
    )->forAll(cd: CashDesk |
        cd.BelongedStore = cd.BelongedStore@pre
    ) and
result = true
            
        }