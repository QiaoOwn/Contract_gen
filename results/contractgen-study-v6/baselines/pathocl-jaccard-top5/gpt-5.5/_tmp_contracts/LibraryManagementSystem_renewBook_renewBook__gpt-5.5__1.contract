Contract LibraryManagementSystemSystem::renewBook(uid:String,barcode:String): Boolean {
          precondition:
          User.allInstances()->exists(u |
        u.UserID = uid and
        u.BorrowStatus = BorrowStatus::NORMAL
    ) and
    BookCopy.allInstances()->exists(c |
        c.Barcode = barcode
    ) and
    Loan.allInstances()->exists(l |
        l.LoanedUser.UserID = uid and
        l.LoanedCopy.Barcode = barcode and
        l.IsReturned = false
    ) and
let c: BookCopy = BookCopy.allInstances()->any(c | c.Barcode = barcode) in
    let l: Loan = Loan.allInstances()->any(l |
        l.LoanedUser.UserID = uid and
        l.LoanedCopy.Barcode = barcode and
        l.IsReturned = false
    ) in
        c.IsReserved = false and
        l.DueDate > Date::today() and
        l.OverDueFee = 0.0 and
let u: User = User.allInstances()->any(u | u.UserID = uid) in
    let l: Loan = Loan.allInstances()->any(l |
        l.LoanedUser.UserID = uid and
        l.LoanedCopy.Barcode = barcode and
        l.IsReturned = false
    ) in
        if u.oclIsKindOf(Student) then
            l.RenewalCount < 3
        else
            if u.oclIsKindOf(Faculty) then
                l.RenewalCount < 6
            else
                false
            endif
        endif
            postcondition:
          let l: Loan = Loan.allInstances()->any(l |
        l.LoanedUser.UserID = uid and
        l.LoanedCopy.Barcode = barcode and
        l.IsReturned = false
    ) in
        l.RenewalCount = l.RenewalCount@pre + 1 and
let l: Loan = Loan.allInstances()->any(l |
        l.LoanedUser.UserID = uid and
        l.LoanedCopy.Barcode = barcode and
        l.IsReturned = false
    ) in
        l.RenewalDate = Date::today() and
let u: User = User.allInstances()->any(u | u.UserID = uid) in
    let l: Loan = Loan.allInstances()->any(l |
        l.LoanedUser.UserID = uid and
        l.LoanedCopy.Barcode = barcode and
        l.IsReturned = false
    ) in
        if u.oclIsKindOf(Student) then
            if u.oclAsType(Student).StudentType = StudentType::BACHELOR then
                l.DueDate = l.DueDate@pre.addDays(20)
            else
                if u.oclAsType(Student).StudentType = StudentType::MASTER then
                    l.DueDate = l.DueDate@pre.addDays(40)
                else
                    l.DueDate = l.DueDate@pre.addDays(60)
                endif
            endif
        else
            if u.oclIsKindOf(Faculty) then
                l.DueDate = l.DueDate@pre.addDays(60)
            else
                false
            endif
        endif and
result = true
            
        }