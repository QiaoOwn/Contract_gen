Contract ListBookHistory::listHodingBook(uid:String): Set(Loan) {
          precondition:
          User.allInstances()->exists(u: User | u.UserID = uid)
            postcondition:
          result = Loan.allInstances()->select(l: Loan |
        l.LoanUser.UserID = uid and l.ReturnDate.oclIsUndefined()
    )->asSet()
            
        }