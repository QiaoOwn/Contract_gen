Contract ManageLoanTermCRUDService::queryLoanTerm(itemid:Integer): LoanTerm {
          precondition:
          LoanTerm.allInstances()->exists(lt: LoanTerm | lt.ItemID = itemid)
            postcondition:
          result = LoanTerm.allInstances()->any(lt: LoanTerm | lt.ItemID = itemid)
            
        }