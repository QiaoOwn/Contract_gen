Contract SubmitLoanRequestModule::calculateScore(): Integer {
          precondition:
          self.loanRequest <> null and
self.loanRequest.RequestedCAHistory <> null and
self.loanRequest.CreditReferences <> null and self.loanRequest.CreditReferences <> ''
            postcondition:
          self.loanRequest.CreditScore = 100 and
self.loanRequest.Status = LoanRequestStatus::SUBMITTED and
result = self.loanRequest.CreditScore and result = 100
            
        }