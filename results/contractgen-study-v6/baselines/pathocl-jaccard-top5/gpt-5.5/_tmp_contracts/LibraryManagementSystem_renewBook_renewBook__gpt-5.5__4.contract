Contract LibraryManagementSystemSystem::renewBook(uid:String,barcode:String): Boolean {
          precondition:
          User.allInstances()->exists(u: User |
        u.UserID = uid and
        u.BorrowStatus = BorrowStatus::NORMAL
    ) and
    BookCopy.allInstances()->exists(bc: BookCopy |
        bc.Barcode = barcode
    ) and
    Loan.allInstances()->exists(l: Loan |
        l.Borrower.UserID = uid and
        l.LoanedCopy.Barcode = barcode and
        l.IsReturned = false
    ) and
let u: User = User.allInstances()->any(x: User | x.UserID = uid) in
    let bc: BookCopy = BookCopy.allInstances()->any(x: BookCopy | x.Barcode = barcode) in
    let l: Loan = Loan.allInstances()->any(x: Loan |
        x.Borrower = u and x.LoanedCopy = bc and x.IsReturned = false
    ) in
        bc.IsReserved = false and
        l.DueDate > Date::today() and
        l.OverDueFee = 0 and
let u: User = User.allInstances()->any(x: User | x.UserID = uid) in
    let bc: BookCopy = BookCopy.allInstances()->any(x: BookCopy | x.Barcode = barcode) in
    let l: Loan = Loan.allInstances()->any(x: Loan |
        x.Borrower = u and x.LoanedCopy = bc and x.IsReturned = false
    ) in
        if u.oclIsKindOf(Student) then
            l.RenewalCount < 3
        else
            if u.oclIsKindOf(Faculty) then
                l.RenewalCount < 6
            else
                false
            endif
        endif
            postcondition:
          let u: User = User.allInstances()->any(x: User | x.UserID = uid) in
    let bc: BookCopy = BookCopy.allInstances()->any(x: BookCopy | x.Barcode = barcode) in
    let l: Loan = Loan.allInstances()->any(x: Loan |
        x.Borrower = u and x.LoanedCopy = bc and x.IsReturned = false
    ) in
        l.RenewalCount = l.RenewalCount@pre + 1 and
        l.RenewalDate = Date::today() and
let u: User = User.allInstances()->any(x: User | x.UserID = uid) in
    let bc: BookCopy = BookCopy.allInstances()->any(x: BookCopy | x.Barcode = barcode) in
    let l: Loan = Loan.allInstances()->any(x: Loan |
        x.Borrower = u and x.LoanedCopy = bc and x.IsReturned = false
    ) in
        if u.oclIsKindOf(Student) then
            if u.oclAsType(Student).StudentType = StudentType::BACHELOR then
                l.DueDate = l.DueDate@pre.addDays(20)
            else
                if u.oclAsType(Student).StudentType = StudentType::MASTER then
                    l.DueDate = l.DueDate@pre.addDays(40)
                else
                    l.DueDate = l.DueDate@pre.addDays(60)
                endif
            endif
        else
            if u.oclIsKindOf(Faculty) then
                l.DueDate = l.DueDate@pre.addDays(60)
            else
                false
            endif
        endif and
result = true
            
        }