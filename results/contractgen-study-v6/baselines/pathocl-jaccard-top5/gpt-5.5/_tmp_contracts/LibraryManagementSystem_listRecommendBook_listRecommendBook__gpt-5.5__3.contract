Contract LibraryManagementSystemSystem::listRecommendBook(uid:String): Set(RecommendBook) {
          precondition:
          User.allInstances()->exists(u: User | u.UserID = uid) and
User.allInstances()->any(u: User | u.UserID = uid).RecommendedBook <> null
            postcondition:
          result = User.allInstances()->any(u: User | u.UserID = uid).RecommendedBook->asSet()
            
        }