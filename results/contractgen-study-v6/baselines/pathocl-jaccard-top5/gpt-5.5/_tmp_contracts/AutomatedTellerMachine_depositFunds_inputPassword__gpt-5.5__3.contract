Contract AutomatedTellerMachineSystem::inputPassword(password:Integer): Boolean {
          precondition:
          self.cardIdentifierValidated = true and
not self.currentBankCard.oclIsUndefined()
            postcondition:
          password = self.currentBankCard.Password implies
        self.passwordValidated = true and result = true and
password <> self.currentBankCard.Password implies
        self.passwordValidated = false and result = false
            
        }