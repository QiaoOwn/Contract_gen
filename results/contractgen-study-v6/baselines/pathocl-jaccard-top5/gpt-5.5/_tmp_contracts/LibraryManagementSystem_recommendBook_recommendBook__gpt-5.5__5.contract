Contract LibraryManagementSystemSystem::recommendBook(uid:String,callNo:String,title:String,edition:String,author:String,publisher:String,description:String,isbn:String): Boolean {
          precondition:
          User.allInstances()->exists(u | u.UserID = uid) and
RecommendBook.allInstances()->forAll(rb | rb.CallNo <> callNo)
            postcondition:
          RecommendBook.allInstances()->exists(rb |
        rb.oclIsNew() and
        rb.CallNo = callNo and
        rb.Title = title and
        rb.Edition = edition and
        rb.Author = author and
        rb.Publisher = publisher and
        rb.Description = description and
        rb.ISBn = isbn and
        rb.RecommendDate = Date::today()
    ) and
User.allInstances()->any(u | u.UserID = uid).RecommendBooks->exists(rb |
        rb.oclIsNew() and
        rb.CallNo = callNo
    ) and
result = true
            
        }