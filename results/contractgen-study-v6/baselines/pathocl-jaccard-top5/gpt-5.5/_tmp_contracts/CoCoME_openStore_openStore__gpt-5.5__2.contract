Contract CoCoMESystem::openStore(storeID:Integer): Boolean {
          precondition:
          Store.allInstances()->exists(s : Store |
        s.Id = storeID and
        s.IsOpened = false
    )
            postcondition:
          Store.allInstances()->exists(s : Store |
        s.Id = storeID and
        s.IsOpened = true
    ) and
self.currentStore = Store.allInstances()->any(s : Store | s.Id = storeID) and
result = true
            
        }