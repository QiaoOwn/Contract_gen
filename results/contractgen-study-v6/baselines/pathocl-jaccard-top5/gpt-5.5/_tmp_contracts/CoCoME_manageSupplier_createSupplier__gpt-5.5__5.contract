Contract ManageSupplierCRUDService::createSupplier(id:Integer,name:String): Boolean {
          precondition:
          Supplier.allInstances()->forAll(s | s.Id <> id)
            postcondition:
          Supplier.allInstances()->exists(s |
        s.oclIsNew() and
        s.Id = id and
        s.Name = name
    ) and
result = true
            
        }