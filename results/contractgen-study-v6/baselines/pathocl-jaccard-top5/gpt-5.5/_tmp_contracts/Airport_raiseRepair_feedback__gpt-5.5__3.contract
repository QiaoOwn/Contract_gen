Contract RepairService::feedback(id:Integer,sid:Integer,score:Integer,des:String): Boolean {
          precondition:
          Repair.allInstances()->exists(r: Repair | r.Id = id) and
Repair.allInstances()->any(r: Repair | r.Id = id).History
        ->exists(h: ApprovalHistory | h.StaffId = sid) and
Staff.allInstances()->exists(s: Staff | s.Id = sid and s.Role = 0) and
Repair.allInstances()->any(r: Repair | r.Id = id).Process = 7
            postcondition:
          Repair.allInstances()->any(r: Repair | r.Id = id).Score = score and
if score >= 3 then
        Repair.allInstances()->any(r: Repair | r.Id = id).Close = true
    else
        Repair.allInstances()->any(r: Repair | r.Id = id).Close = false and
        Repair.allInstances()->any(r: Repair | r.Id = id).Description = des and
        Repair.allInstances()->any(r: Repair | r.Id = id).Process = 0
    endif and
result = true
            
        }