Contract AutomatedTellerMachineSystem::ejectCard(): Boolean {
          precondition:
          self.isCardIDandPasswordValidate = true and
not self.currentCard.oclIsUndefined()
            postcondition:
          self.currentCard.oclIsUndefined() and
self.isCardIDandPasswordValidate = false and
self.isDepositing = false and self.depositAmount = 0 and
self.isWithdrawing = false and self.withdrawAmount = 0 and
result = true
            
        }