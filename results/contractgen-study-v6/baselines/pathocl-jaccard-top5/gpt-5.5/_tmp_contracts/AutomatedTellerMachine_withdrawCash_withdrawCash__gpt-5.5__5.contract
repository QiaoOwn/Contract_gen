Contract AutomatedTellerMachineSystem::withdrawCash(quantity:Integer): Boolean {
          precondition:
          self.currentBankCard.CardID->notEmpty() and
    self.currentBankCard.Password->notEmpty() and
self.currentBankCard <> null and
self.currentBankCard.Balance >= quantity
            postcondition:
          self.currentBankCard.Balance = self.currentBankCard.Balance@pre - quantity and
self.withdrawalRecorded = true and
    self.withdrawalAmount = quantity and
result = true
            
        }