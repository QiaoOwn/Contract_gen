Contract ManageProductCatalogCRUDService::modifyProductCatalog(id:Integer,name:String): Boolean {
          precondition:
          ProductCatalog.allInstances()->exists(pc | pc.Id = id)
            postcondition:
          ProductCatalog.allInstances()->any(pc | pc.Id@pre = id).Id = id and
    ProductCatalog.allInstances()->any(pc | pc.Id@pre = id).Name = name and
result = true
            
        }