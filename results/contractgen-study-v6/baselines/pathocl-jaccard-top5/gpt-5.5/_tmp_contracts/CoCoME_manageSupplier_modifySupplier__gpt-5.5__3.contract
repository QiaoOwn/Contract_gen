Contract ManageSupplierCRUDService::modifySupplier(id:Integer,name:String): Boolean {
          precondition:
          Supplier.allInstances()->exists(s | s.identifier = id)
            postcondition:
          Supplier.allInstances()->exists(s |
        s.identifier = id and
        s.identifier = id and
        s.name = name
    ) and
result = true
            
        }