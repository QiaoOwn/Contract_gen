Contract CoCoMEOrderProducts::chooseSupplier(supplierID:Integer): Boolean {
          precondition:
          Supplier.allInstances()->exists(s | s.Id = supplierID) and
OrderProduct.allInstances()->exists(op | op = self)
            postcondition:
          self.Supplier = Supplier.allInstances()->any(s | s.Id = supplierID) and
result = true
            
        }