Contract ListBookHistory::listReservationBook(uid:String): Set(BookCopy) {
          precondition:
          User.allInstances()->exists(u | u.uid = uid) and
Reserve.allInstances()->notEmpty()
            postcondition:
          result = Reserve.allInstances()
        ->select(r | r.User.uid = uid)
        ->collect(r | r.ReservedCopy)
        ->asSet()
            
        }