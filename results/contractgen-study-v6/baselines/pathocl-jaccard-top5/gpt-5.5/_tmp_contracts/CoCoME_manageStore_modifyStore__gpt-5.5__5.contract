Contract ManageStoreCRUDService::modifyStore(id:Integer,name:String,address:String,isopened:Boolean): Boolean {
          precondition:
          Store.allInstances()->exists(s: Store | s.Id = id)
            postcondition:
          Store.allInstances()->any(s: Store | s.Id@pre = id).Id = id and
    Store.allInstances()->any(s: Store | s.Id@pre = id).Name = name and
    Store.allInstances()->any(s: Store | s.Id@pre = id).Address = address and
    Store.allInstances()->any(s: Store | s.Id@pre = id).IsOpened = isopened and
result = true
            
        }