Contract LibraryManagementSystemSystem::payOverDueFee(uid:String,fee:Real): Boolean {
          precondition:
          User.allInstances()->exists(u |
        u.uid = uid and
        u.OverDueFee > 0 and
        u.loan->exists(l |
            l.IsReturned = true and
            l.OverDueFee > 0
        )
    ) and
User.allInstances()->exists(u |
        u.uid = uid and
        fee >= u.OverDueFee
    )
            postcondition:
          User.allInstances()->forAll(u |
        u.uid = uid implies
        u.OverDueFee = 0
    ) and
User.allInstances()->forAll(u |
        u.uid = uid implies
        u.loan@pre->forAll(l |
            l.IsReturned@pre = true and l.OverDueFee@pre > 0 implies
            l.OverDueFee = 0
        )
    ) and
result = true
            
        }