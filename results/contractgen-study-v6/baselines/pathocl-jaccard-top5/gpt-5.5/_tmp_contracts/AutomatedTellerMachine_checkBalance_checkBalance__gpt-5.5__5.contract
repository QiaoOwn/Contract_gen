Contract AutomatedTellerMachineSystem::checkBalance(): Real {
          precondition:
          self.currentCard.CardID->notEmpty() and
    self.currentCard.Password->notEmpty() and
self.currentCard.oclIsTypeOf(BankCard)
            postcondition:
          result = self.currentCard.Balance@pre and
self.currentCard.Balance = self.currentCard.Balance@pre
            
        }