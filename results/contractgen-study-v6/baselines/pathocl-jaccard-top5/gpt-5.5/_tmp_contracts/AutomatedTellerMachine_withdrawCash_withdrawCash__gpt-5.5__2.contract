Contract AutomatedTellerMachineSystem::withdrawCash(quantity:Integer): Boolean {
          precondition:
          self.cardIDValidated = true and self.passwordValidated = true and
not self.currentCard.oclIsUndefined() and
self.currentCard.Balance >= quantity
            postcondition:
          self.currentCard.Balance = self.currentCard.Balance@pre - quantity and
self.withdrawalRecorded = true and self.withdrawalAmount = quantity and
result = true
            
        }