Contract ManageProductCatalogCRUDService::queryProductCatalog(id:Integer): ProductCatalog {
          precondition:
          ProductCatalog.allInstances()->exists(pc: ProductCatalog | pc.Id = id)
            postcondition:
          result = ProductCatalog.allInstances()->any(pc: ProductCatalog | pc.Id = id)
            
        }