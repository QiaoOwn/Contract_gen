Contract LibraryManagementSystemSystem::renewBook(uid:String,barcode:String): Boolean {
          precondition:
          User.allInstances()->exists(u: User |
        u.UserID = uid and
        u.BorrowStatus = BorrowStatus::NORMAL and
        BookCopy.allInstances()->exists(bc: BookCopy |
            bc.Barcode = barcode and
            Loan.allInstances()->exists(l: Loan |
                l.LoanedUser = u and
                l.LoanedCopy = bc and
                l.IsReturned = false
            )
        )
    ) and
Loan.allInstances()->exists(l: Loan |
        l.LoanedUser.UserID = uid and
        l.LoanedCopy.Barcode = barcode and
        l.IsReturned = false and
        l.LoanedCopy.IsReserved = false and
        l.DueDate > Date::today() and
        l.OverDueFee = 0.0
    ) and
Loan.allInstances()->forAll(l: Loan |
        l.LoanedUser.UserID = uid and
        l.LoanedCopy.Barcode = barcode and
        l.IsReturned = false implies
            (
                l.LoanedUser.oclIsTypeOf(Student) implies
                    l.RenewedTimes < 3
            ) and
            (
                l.LoanedUser.oclIsTypeOf(Faculty) implies
                    l.RenewedTimes < 6
            )
    )
            postcondition:
          Loan.allInstances()->forAll(l: Loan |
        l.LoanedUser.UserID = uid and
        l.LoanedCopy.Barcode = barcode and
        l.IsReturned = false implies
            l.RenewedTimes = l.RenewedTimes@pre + 1 and
            l.RenewDate = Date::today()
    ) and
Loan.allInstances()->forAll(l: Loan |
        l.LoanedUser.UserID = uid and
        l.LoanedCopy.Barcode = barcode and
        l.IsReturned = false implies
            (
                l.LoanedUser.oclIsTypeOf(Student) and
                l.LoanedUser.oclAsType(Student).Degree = Degree::BACHELOR
                implies
                    l.DueDate = l.DueDate@pre.addDays(20)
            ) and
            (
                l.LoanedUser.oclIsTypeOf(Student) and
                l.LoanedUser.oclAsType(Student).Degree = Degree::MASTER
                implies
                    l.DueDate = l.DueDate@pre.addDays(40)
            ) and
            (
                l.LoanedUser.oclIsTypeOf(Student) and
                l.LoanedUser.oclAsType(Student).Degree <> Degree::BACHELOR and
                l.LoanedUser.oclAsType(Student).Degree <> Degree::MASTER
                implies
                    l.DueDate = l.DueDate@pre.addDays(60)
            ) and
            (
                l.LoanedUser.oclIsTypeOf(Faculty)
                implies
                    l.DueDate = l.DueDate@pre.addDays(60)
            )
    ) and
result = true
            
        }