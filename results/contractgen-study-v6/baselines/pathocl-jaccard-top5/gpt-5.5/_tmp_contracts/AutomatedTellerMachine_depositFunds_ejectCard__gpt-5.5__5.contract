Contract AutomatedTellerMachineSystem::ejectCard(): Boolean {
          precondition:
          self.isCardIDValidated = true and self.isPasswordValidated = true and
not self.currentCard.oclIsUndefined()
            postcondition:
          self.currentCard.oclIsUndefined() and
self.isCardIDValidated = false and self.isPasswordValidated = false and
self.isDeposit = false and
    self.isWithdrawal = false and
    self.depositAmount = 0 and
    self.withdrawalAmount = 0 and
result = true
            
        }