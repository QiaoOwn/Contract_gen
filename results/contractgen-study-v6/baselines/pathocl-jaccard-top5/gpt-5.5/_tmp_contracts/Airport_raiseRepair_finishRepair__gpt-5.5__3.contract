Contract RepairService::finishRepair(id:Integer,sid:Integer,did:Integer,res:String): Boolean {
          precondition:
          Device.allInstances()->exists(d: Device |
        d.Id = did and
        Staff.allInstances()->exists(s: Staff |
            s.Id = sid and
            s.AssignedDevice->includes(d)
        )
    ) and
Staff.allInstances()->exists(s: Staff |
        s.Id = sid and
        s.Role = 3
    )
            postcondition:
          Repair.allInstances()->any(r: Repair | r.Id = id).Process = 7 and
Repair.allInstances()->any(r: Repair | r.Id = id).Result = res and
result = true
            
        }