Contract ListBookHistory::listOverDueBook(uid:String): Set(BookCopy) {
          precondition:
          User.allInstances()->exists(u | u.UserID = uid) and
User.allInstances()->any(u | u.UserID = uid).LoanedRecord->notEmpty()
            postcondition:
          result =
        User.allInstances()->any(u | u.UserID = uid).LoanedRecord
            ->select(l | l.IsReturned = false and l.OverDueFee > 0)
            ->collect(l | l.LoanedCopy)
            ->asSet()
            
        }