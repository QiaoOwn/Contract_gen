Contract ManageLoanTermCRUDService::modifyLoanTerm(itemid:Integer,content:String): Boolean {
          precondition:
          LoanAgreement.allInstances()->exists(lt | lt.Content = itemid.toString())
            postcondition:
          LoanAgreement.allInstances()->exists(lt |
        lt.Content = content
    ) and
result = true
            
        }