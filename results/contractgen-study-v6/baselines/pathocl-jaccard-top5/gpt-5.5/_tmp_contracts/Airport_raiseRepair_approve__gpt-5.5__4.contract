Contract RepairService::approve(sid:Integer,rid:Integer,reject:Boolean,suggestion:String): ApprovalHistory {
          precondition:
          Repair.allInstances()->exists(r | r.Id = rid) and
Staff.allInstances()->exists(s | s.Id = sid)
            postcondition:
          ApprovalHistory.allInstances()->exists(ah |
        ah.oclIsNew() and
        ah.Suggestion = suggestion and
        ah.Reject = reject and
        ah.Repair = Repair.allInstances()->any(r | r.Id = rid) and
        result = ah
    ) and
let repair: Repair = Repair.allInstances()->any(r | r.Id = rid) in
    let staff: Staff = Staff.allInstances()->any(s | s.Id = sid) in
        if reject = true then
            if staff.Role = 1 and repair.Process@pre = 0 then
                repair.Process = 1
            else
                if staff.Role = 2 and repair.Process@pre = 1 then
                    repair.Process = 2
                else
                    if staff.Role = 3 and repair.Process@pre = 2 then
                        repair.Process = 3
                    else
                        repair.Process = repair.Process@pre
                    endif
                endif
            endif
        else
            repair.Process = 5
        endif and
result.oclIsNew() and
    ApprovalHistory.allInstances()->includes(result)
            
        }