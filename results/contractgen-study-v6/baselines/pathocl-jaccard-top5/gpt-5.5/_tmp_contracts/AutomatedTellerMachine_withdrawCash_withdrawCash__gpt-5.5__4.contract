Contract AutomatedTellerMachineSystem::withdrawCash(quantity:Integer): Boolean {
          precondition:
          self.checkCardID() = true and self.checkPassword() = true and
self.currentCard->notEmpty() and
self.currentCard.balance >= quantity
            postcondition:
          self.currentCard.balance = self.currentCard.balance@pre - quantity and
self.withdrawal = true and self.withdrawalAmount = quantity and
result = true
            
        }