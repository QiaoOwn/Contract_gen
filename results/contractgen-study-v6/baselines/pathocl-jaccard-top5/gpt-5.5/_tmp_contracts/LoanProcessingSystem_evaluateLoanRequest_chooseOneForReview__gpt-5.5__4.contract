Contract EvaluateLoanRequestModule::chooseOneForReview(requestid:Integer): LoanRequest {
          precondition:
          LoanRequest.allInstances()->exists(lr: LoanRequest |
        lr.RequestID = requestid
    )
            postcondition:
          self.currentLoanRequest = LoanRequest.allInstances()->any(lr: LoanRequest |
        lr.RequestID = requestid
    ) and
result = self.currentLoanRequest and
    result.RequestID = requestid
            
        }