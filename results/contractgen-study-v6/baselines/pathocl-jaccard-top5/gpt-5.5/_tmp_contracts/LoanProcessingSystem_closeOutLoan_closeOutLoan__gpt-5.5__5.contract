Contract LoanProcessingSystemSystem::closeOutLoan(loanid:Integer): Boolean {
          precondition:
          Loan.allInstances()->exists(l | l.loanid = loanid and l.status = LoanStatus::LSOPEN)
            postcondition:
          Loan.allInstances()->any(l | l.loanid = loanid).status = LoanStatus::CLOSED and
result = true
            
        }