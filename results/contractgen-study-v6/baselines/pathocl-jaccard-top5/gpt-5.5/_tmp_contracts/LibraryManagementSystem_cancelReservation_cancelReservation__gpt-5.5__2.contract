Contract LibraryManagementSystemSystem::cancelReservation(uid:String,barcode:String): Boolean {
          precondition:
          User.allInstances()->exists(u | u.UserID = uid) and
    BookCopy.allInstances()->exists(bc | bc.Barcode = barcode) and
    Reserve.allInstances()->exists(r |
        r.ReservedCopy.Barcode = barcode and
        r.IsReserveClosed = false
    ) and
BookCopy.allInstances()->exists(bc |
        bc.Barcode = barcode and
        bc.Status = CopyStatus::LOANED and
        bc.IsReserved = true and
        bc.ReservationRecord->exists(r |
            r.IsReserveClosed = false
        )
    )
            postcondition:
          BookCopy.allInstances()->any(bc | bc.Barcode = barcode).IsReserved = false and
Reserve.allInstances()->forAll(r |
        r.ReservedCopy.Barcode = barcode and
        r.IsReserveClosed@pre = false
        implies
        r.IsReserveClosed = true
    ) and
result = true
            
        }