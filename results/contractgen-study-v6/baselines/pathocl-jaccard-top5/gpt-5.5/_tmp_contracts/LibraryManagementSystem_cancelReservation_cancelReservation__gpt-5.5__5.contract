Contract LibraryManagementSystemSystem::cancelReservation(uid:String,barcode:String): Boolean {
          precondition:
          BookCopy.allInstances()->exists(bc: BookCopy |
        bc.Barcode = barcode
    ) and
BookCopy.allInstances()->exists(bc: BookCopy |
        bc.Barcode = barcode and
        bc.Status = CopyStatus::LOANED
    ) and
BookCopy.allInstances()->exists(bc: BookCopy |
        bc.Barcode = barcode and
        bc.IsReserved = true
    )
            postcondition:
          BookCopy.allInstances()->forAll(bc: BookCopy |
        bc.Barcode = barcode implies
        bc.IsReserved = false
    ) and
result = true
            
        }