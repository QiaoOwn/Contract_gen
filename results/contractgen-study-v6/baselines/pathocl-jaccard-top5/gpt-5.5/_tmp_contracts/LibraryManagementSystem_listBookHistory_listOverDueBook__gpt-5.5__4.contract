Contract ListBookHistory::listOverDueBook(uid:String): Set(BookCopy) {
          precondition:
          User.allInstances()->exists(u | u.UserID = uid) and
User.allInstances()->any(u | u.UserID = uid).ReservedBook->notEmpty()
            postcondition:
          result =
        User.allInstances()->any(u | u.UserID = uid).ReservedBook
            ->select(r |
                r.IsReserveClosed = false and
                r.ReservedUser.OverDueFee > 0
            )
            ->collect(r | r.ReservedCopy)
            ->asSet()
            
        }