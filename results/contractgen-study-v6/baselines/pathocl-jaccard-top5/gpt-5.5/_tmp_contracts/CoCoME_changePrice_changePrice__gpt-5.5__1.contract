Contract CoCoMESystem::changePrice(barcode:Integer,newPrice:Real): Boolean {
          precondition:
          Store.allInstances()->exists(s: Store |
        s.Items->exists(i: Item | i.Barcode = barcode)
    )
            postcondition:
          Store.allInstances()->forAll(s: Store |
        s.Items->select(i: Item | i.Barcode = barcode)->forAll(i: Item |
            i.Price = newPrice
        )
    ) and
result = true
            
        }