Contract ManageCashDeskCRUDService::modifyCashDesk(id:Integer,name:String,isopened:Boolean): Boolean {
          precondition:
          CashDesk.allInstances()->exists(cd: CashDesk | cd.Id = id)
            postcondition:
          CashDesk.allInstances()->any(cd: CashDesk | cd.Id = id).Id = id and
    CashDesk.allInstances()->any(cd: CashDesk | cd.Id = id).Name = name and
    CashDesk.allInstances()->any(cd: CashDesk | cd.Id = id).IsOpened = isopened and
result = true
            
        }