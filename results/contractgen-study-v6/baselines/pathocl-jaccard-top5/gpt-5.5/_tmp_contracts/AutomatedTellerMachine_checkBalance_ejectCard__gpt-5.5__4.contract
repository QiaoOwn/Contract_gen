Contract AutomatedTellerMachineSystem::ejectCard(): Boolean {
          precondition:
          self.cardIDValidated = true and self.passwordValidated = true and
not self.currentCard.oclIsUndefined()
            postcondition:
          self.currentCard.oclIsUndefined() and
self.cardIDValidated = false and
    self.passwordValidated = false and
self.depositValidated = false and
    self.depositAmount = 0 and
self.withdrawalValidated = false and
    self.withdrawalAmount = 0 and
result = true
            
        }