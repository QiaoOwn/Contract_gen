Contract CoCoMEOrderProducts::orderItem(barcode:Integer,quantity:Integer): Boolean {
          precondition:
          Item.allInstances()->exists(i: Item | i.Barcode = barcode)
            postcondition:
          OrderEntry.allInstances()->exists(e: OrderEntry |
        not OrderEntry.allInstances()@pre->includes(e) and
        e.Item.Barcode = barcode and
        e.Quantity = quantity and
        e.SubAmount = e.Item.OrderPrice * quantity
    ) and
self.ContainedEntries->exists(e: OrderEntry |
        not OrderEntry.allInstances()@pre->includes(e) and
        e.Item.Barcode = barcode and
        e.Quantity = quantity and
        e.SubAmount = e.Item.OrderPrice * quantity
    ) and
result = true
            
        }