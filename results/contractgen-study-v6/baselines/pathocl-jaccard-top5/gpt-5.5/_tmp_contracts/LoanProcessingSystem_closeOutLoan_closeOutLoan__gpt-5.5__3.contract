Contract LoanProcessingSystemSystem::closeOutLoan(loanid:Integer): Boolean {
          precondition:
          Loan.allInstances()->exists(l: Loan |
        l.LoanID = loanid and
        l.Status = LoanStatus::LSOPEN
    )
            postcondition:
          Loan.allInstances()->forAll(l: Loan |
        l.LoanID = loanid implies
        l.Status = LoanStatus::CLOSED
    ) and
result = true
            
        }