Contract ManageLoanTermCRUDService::modifyLoanTerm(itemid:Integer,content:String): Boolean {
          precondition:
          LoanTerm.allInstances()->exists(lt: LoanTerm | lt.ItemID = itemid)
            postcondition:
          LoanTerm.allInstances()->any(lt: LoanTerm | lt.ItemID = itemid).ItemID = itemid and
    LoanTerm.allInstances()->any(lt: LoanTerm | lt.ItemID = itemid).Content = content and
result = true
            
        }