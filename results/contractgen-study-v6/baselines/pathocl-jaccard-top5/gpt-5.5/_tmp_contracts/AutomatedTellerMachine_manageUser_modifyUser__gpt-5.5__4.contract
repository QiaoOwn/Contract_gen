Contract ManageUserCRUDService::modifyUser(userid:Integer,name:String,address:String): Boolean {
          precondition:
          User.allInstances()->exists(u | u.userid = userid)
            postcondition:
          User.allInstances()->exists(u |
        u.userid = userid and
        u.name = name and
        u.address = address
    ) and
result = true
            
        }