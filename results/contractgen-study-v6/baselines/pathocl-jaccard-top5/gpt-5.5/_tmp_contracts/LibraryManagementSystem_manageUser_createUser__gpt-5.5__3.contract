Contract ManageUserCRUDService::createUser(userid:String,name:String,sex:Sex [M|F],password:String,email:String,faculty:String,loanednumber:Integer,borrowstatus:BorrowStatus [NORMAL|SUSPEND],suspensiondays:Integer,overduefee:Real): Boolean {
          precondition:
          User.allInstances()->forAll(u: User | u.UserID <> userid)
            postcondition:
          User.allInstances()->exists(u: User |
        u.oclIsNew() and
        u.UserID = userid and
        u.Name = name and
        u.Sex = sex and
        u.Password = password and
        u.Email = email and
        u.Faculty = faculty and
        u.LoanedNumber = loanednumber and
        u.BorrowStatus = borrowstatus and
        u.SuspensionDays = suspensiondays and
        u.OverDueFee = overduefee
    ) and
User.allInstances()->exists(u: User |
        u.UserID = userid
    ) and
result = true
            
        }