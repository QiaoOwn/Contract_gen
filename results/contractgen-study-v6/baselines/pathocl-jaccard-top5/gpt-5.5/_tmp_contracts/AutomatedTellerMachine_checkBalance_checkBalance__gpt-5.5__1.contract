Contract AutomatedTellerMachineSystem::checkBalance(): Real {
          precondition:
          self.currentBankCard.CardID = self.enteredCardID and
    self.currentBankCard.Password = self.enteredPassword and
not self.currentBankCard.oclIsUndefined()
            postcondition:
          result = self.currentBankCard.Balance@pre and
self.currentBankCard.Balance = self.currentBankCard.Balance@pre
            
        }