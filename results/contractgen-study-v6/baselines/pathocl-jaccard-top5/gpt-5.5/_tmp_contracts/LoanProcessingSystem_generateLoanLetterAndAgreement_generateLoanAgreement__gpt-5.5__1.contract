Contract GenerateLoanLetterAndAgreementModule::generateLoanAgreement(): Boolean {
          precondition:
          LoanRequest.allInstances()->exists(lr | lr.isCurrent = true)
            postcondition:
          LoanAgreement.allInstances()->exists(la |
        la.oclIsNew() and
        la.Content = 'standard content'
    ) and
result = true
            
        }