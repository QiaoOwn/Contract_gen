Contract ManageLoanTermCRUDService::createLoanTerm(itemid:Integer,content:String): Boolean {
          precondition:
          LoanTerm.allInstances()->forAll(lt: LoanTerm | lt.ItemID <> itemid)
            postcondition:
          LoanTerm.allInstances()->exists(lt: LoanTerm |
        lt.oclIsNew() and
        lt.ItemID = itemid and
        lt.Content = content
    ) and
result = true
            
        }