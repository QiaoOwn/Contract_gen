Contract LoanProcessingSystemSystem::loanPayment(loanid:Integer): Boolean {
          precondition:
          Loan.allInstances()->exists(l: Loan | l.LoanID = loanid) and
Loan.allInstances()->any(l: Loan | l.LoanID = loanid).Status = LoanStatus::LSOPEN
            postcondition:
          Loan.allInstances()->any(l: Loan | l.LoanID = loanid).RemainAmountToPay =
        Loan.allInstances()->any(l: Loan | l.LoanID = loanid).RemainAmountToPay@pre -
        Loan.allInstances()->any(l: Loan | l.LoanID = loanid).RepaymentAmount@pre and
result = true
            
        }