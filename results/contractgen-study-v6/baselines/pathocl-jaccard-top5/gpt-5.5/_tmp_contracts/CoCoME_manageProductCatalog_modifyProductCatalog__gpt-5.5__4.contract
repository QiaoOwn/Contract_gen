Contract ManageProductCatalogCRUDService::modifyProductCatalog(id:Integer,name:String): Boolean {
          precondition:
          ProductCatalog.allInstances()->exists(pc: ProductCatalog | pc.Id = id)
            postcondition:
          ProductCatalog.allInstances()->exists(pc: ProductCatalog |
        pc.Id = id and
        pc.Name = name
    ) and
result = true
            
        }