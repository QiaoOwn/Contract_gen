Contract ManageBankCardCRUDService::deleteBankCard(cardid:Integer): Boolean {
          precondition:
          BankCard.allInstances()->exists(bc: BankCard | bc.CardID = cardid)
            postcondition:
          BankCard.allInstances()->forAll(bc: BankCard | bc.CardID <> cardid) and
result = true
            
        }