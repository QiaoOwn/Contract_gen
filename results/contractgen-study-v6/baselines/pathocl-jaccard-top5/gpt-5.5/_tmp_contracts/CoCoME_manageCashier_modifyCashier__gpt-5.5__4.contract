Contract ManageCashierCRUDService::modifyCashier(id:Integer,name:String): Boolean {
          precondition:
          Cashier.allInstances()->exists(c | c.Id = id)
            postcondition:
          Cashier.allInstances()->any(c | c.Id = id).Id = id and
    Cashier.allInstances()->any(c | c.Id = id).Name = name and
result = true
            
        }