Contract ManageSupplierCRUDService::modifySupplier(id:Integer,name:String): Boolean {
          precondition:
          CashDesk.allInstances()->exists(s | s.Id = id)
            postcondition:
          CashDesk.allInstances()->exists(s |
        s.Id = id and
        s.Name = name
    ) and
result = true
            
        }