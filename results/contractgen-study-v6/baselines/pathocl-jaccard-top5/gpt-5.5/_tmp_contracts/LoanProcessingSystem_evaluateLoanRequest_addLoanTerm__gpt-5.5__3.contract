Contract EvaluateLoanRequestModule::addLoanTerm(termid:Integer): Boolean {
          precondition:
          self.currentLoanRequest <> null and
LoanTerm.allInstances()->exists(t | t.termid = termid)
            postcondition:
          self.currentLoanRequest.loanTerm =
        LoanTerm.allInstances()->any(t | t.termid = termid) and
result = true
            
        }