Contract AutomatedTellerMachineSystem::inputCard(cardid:Integer): Boolean {
          precondition:
          BankCard.allInstances()->exists(c: BankCard |
        c.CardID = cardid and c.CardStatus = CardStatus::NORMAL
    )
            postcondition:
          let card: BankCard = BankCard.allInstances()->any(c: BankCard |
        c.CardID = cardid and c.CardStatus = CardStatus::NORMAL
    ) in
    if card.BelongedUser->notEmpty() then
        self.currentCard = card and
        self.cardValidated = true and
        result = true
    else
        self.cardValidated = false and
        result = false
    endif
            
        }