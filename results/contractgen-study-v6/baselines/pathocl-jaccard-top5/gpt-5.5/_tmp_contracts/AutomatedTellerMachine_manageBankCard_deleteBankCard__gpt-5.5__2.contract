Contract ManageBankCardCRUDService::deleteBankCard(cardid:Integer): Boolean {
          precondition:
          BankCard.allInstances()->exists(card : BankCard | card.CardID = cardid)
            postcondition:
          BankCard.allInstances()->forAll(card : BankCard | card.CardID <> cardid) and
result = true
            
        }