Contract SubmitLoanRequestModule::calculateScore(): Integer {
          precondition:
          self.loanRequest <> null and
self.loanRequest.CheckingAccountNumber <> null and
self.loanRequest.CreditReferences <> null and
    self.loanRequest.SecurityNumber <> null
            postcondition:
          self.loanRequest.CreditScore = 100 and
self.loanRequest.Status = LoanRequestStatus::SUBMITTED and
result = 100
            
        }