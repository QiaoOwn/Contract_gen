Contract ManageLoanTermCRUDService::modifyLoanTerm(itemid:Integer,content:String): Boolean {
          precondition:
          ApprovalLetter.allInstances()->exists(lt | lt.Content = itemid.toString())
            postcondition:
          ApprovalLetter.allInstances()->exists(lt | lt.Content = content) and
result = true
            
        }