Contract AutomatedTellerMachineSystem::inputCard(cardid:Integer): Boolean {
          precondition:
          BankCard.allInstances()->exists(c: BankCard |
        c.CardID = cardid and
        c.CardStatus = CardStatus::NORMAL
    )
            postcondition:
          let card: BankCard =
        BankCard.allInstances()->any(c: BankCard |
            c.CardID = cardid and
            c.CardStatus = CardStatus::NORMAL
        )
    in
        if User.allInstances()->exists(u: User | u.OwnedCard = card) then
            self.CurrentCard = card and
            self.CardIDValidated = true and
            result = true
        else
            self.CardIDValidated = false and
            result = false
        endif
            
        }