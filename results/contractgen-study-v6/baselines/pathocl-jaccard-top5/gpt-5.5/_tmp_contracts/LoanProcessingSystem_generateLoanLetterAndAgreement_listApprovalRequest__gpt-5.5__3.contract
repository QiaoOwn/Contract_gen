Contract GenerateLoanLetterAndAgreementModule::listApprovalRequest(): Set(LoanRequest) {
          precondition:
          LoanRequest.allInstances()->select(lr | lr.Status = LoanRequestStatus::APPROVED)->notEmpty()
            postcondition:
          self.requestCollection =
        LoanRequest.allInstances()->select(lr | lr.Status = LoanRequestStatus::APPROVED)->asSet() and
result =
        LoanRequest.allInstances()->select(lr | lr.Status = LoanRequestStatus::APPROVED)->asSet()
            
        }