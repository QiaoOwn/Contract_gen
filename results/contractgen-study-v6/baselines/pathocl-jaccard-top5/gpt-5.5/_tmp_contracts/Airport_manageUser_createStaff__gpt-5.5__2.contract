Contract AirportSystem::createStaff(id:Integer,name:String,pswd:String,phone:String,role:Integer,bossid:Integer): Boolean {
          precondition:
          Staff.allInstances()->forAll(s | s.Id <> id)
            postcondition:
          Staff.allInstances()->exists(s |
        s.oclIsNew() and
        s.Id = id and
        s.Name = name and
        s.Password = pswd and
        s.Phone = phone and
        s.Role = role
    ) and
Staff.allInstances()->exists(s |
        s.oclIsNew() and
        s.Id = id and
        (
            Staff.allInstances@pre()->exists(b | b.Id = bossid)
            implies
            s.Boss = Staff.allInstances@pre()->any(b | b.Id = bossid)
        )
    ) and
Staff.allInstances()->exists(s |
        s.oclIsNew() and
        s.Id = id and
        (
            Staff.allInstances@pre()->forAll(b | b.Id <> bossid)
            implies
            s.Boss.oclIsUndefined()
        )
    ) and
result = true
            
        }