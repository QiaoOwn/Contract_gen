Contract EnterValidatedCreditReferencesModule::listSubmitedLoanRequest(): Set(LoanRequest) {
          precondition:
          LoanRequest.allInstances()->exists(lr | lr.Status = LoanRequestStatus::SUBMITTED)
            postcondition:
          self.CurrentLoanRequests =
        LoanRequest.allInstances()->select(lr | lr.Status = LoanRequestStatus::SUBMITTED) and
result =
        LoanRequest.allInstances()->select(lr | lr.Status = LoanRequestStatus::SUBMITTED)
            
        }