Contract SubmitLoanRequestModule::calculateScore(): Integer {
          precondition:
          not self.CurrentLoanRequest.oclIsUndefined() and
not self.CurrentLoanRequest.RequestedCAHistory.oclIsUndefined() and
not self.CurrentLoanRequest.RequestedCreditHistory.oclIsUndefined()
            postcondition:
          self.CurrentLoanRequest.CreditScore = 100 and
self.CurrentLoanRequest.Status = LoanRequestStatus::SUBMITTED and
result = 100
            
        }