Contract ProcessSaleService::enterItem(barcode:Integer,quantity:Integer): Boolean {
          precondition:
          self.CurrentSale <> null and
    self.CurrentSale.IsComplete = false and
Item.allInstances()->exists(i: Item |
        i.Barcode = barcode and
        i.StockNumber > 0
    )
            postcondition:
          SalesLineItem.allInstances()->exists(sli: SalesLineItem |
        sli.oclIsNew() and
        sli.BelongedSale = self.CurrentSale and
        sli.BelongedItem.Barcode = barcode and
        sli.Quantity = quantity and
        sli.Subamount = sli.BelongedItem.Price * quantity
    ) and
Item.allInstances()->forAll(i: Item |
        i.Barcode = barcode implies
            i.StockNumber = i.StockNumber@pre - quantity
    ) and
self.CurrentSaleLine.oclIsNew() and
    self.CurrentSaleLine.BelongedSale = self.CurrentSale and
    self.CurrentSaleLine.BelongedItem.Barcode = barcode and
    self.CurrentSaleLine.Quantity = quantity and
    self.CurrentSaleLine.Subamount = self.CurrentSaleLine.BelongedItem.Price * quantity and
result = true
            
        }