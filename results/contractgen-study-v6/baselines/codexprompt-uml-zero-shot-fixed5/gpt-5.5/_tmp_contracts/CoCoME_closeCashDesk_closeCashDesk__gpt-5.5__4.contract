Contract CoCoMESystem::closeCashDesk(cashDeskID:Integer): Boolean {
          precondition:
          CashDesk.allInstances()->exists(cd |
        cd.Id = cashDeskID and cd.IsOpened = true
    ) and
not self.CurrentStore.oclIsUndefined() and
    self.CurrentStore.IsOpened = true
            postcondition:
          CashDesk.allInstances()->exists(cd |
        cd.Id = cashDeskID and
        cd.IsOpened = false and
        cd = self.CurrentCashDesk
    ) and
self.CurrentCashDesk = self.CurrentCashDesk@pre and
result = true
            
        }