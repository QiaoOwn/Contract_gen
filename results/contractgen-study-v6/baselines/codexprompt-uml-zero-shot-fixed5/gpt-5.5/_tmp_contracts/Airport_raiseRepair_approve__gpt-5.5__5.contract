Contract RepairService::approve(sid:Integer,rid:Integer,reject:Boolean,suggestion:String): ApprovalHistory {
          precondition:
          Repair.allInstances()->exists(r | r.Id = rid) and
Staff.allInstances()->exists(s | s.Id = sid)
            postcondition:
          result.oclIsNew() and
    result.Id =
        ApprovalHistory.allInstances()->excluding(result)
            ->collect(h | h.Id)
            ->including(result.Id)
            ->max() and
    result.StaffId = sid and
    result.Reject = reject and
    result.Suggestion = suggestion and
Repair.allInstances()->any(r |
        r.Id = rid and
        r.History->includes(result)
    ) and
let repair : Repair =
        Repair.allInstances()->any(r | r.Id = rid),
        staff : Staff =
        Staff.allInstances()->any(s | s.Id = sid)
    in
        reject implies
            (
                (staff.Role = 1 and repair.Process = 0 and
                    repair.Process@pre = 1) or
                (staff.Role = 2 and repair.Process = 1 and
                    repair.Process@pre = 2) or
                (staff.Role = 3 and repair.Process = 2 and
                    repair.Process@pre = 3)
            ) and
let repair : Repair =
        Repair.allInstances()->any(r | r.Id = rid)
    in
        not reject implies
            repair.Process = 5 and
result = ApprovalHistory.allInstances()
        ->select(h | h.oclIsNew())
        ->any(true)
            
        }