Contract AirportSystem::createStaff(id:Integer,name:String,pswd:String,phone:String,role:Integer,bossid:Integer): Boolean {
          precondition:
          Staff.allInstances()->forAll(s | s.Id <> id)
            postcondition:
          Staff.allInstances()->exists(s |
        not Staff.allInstances@pre()->includes(s) and
        s.Id = id and
        s.Name = name and
        s.Password = pswd and
        s.Phone = phone and
        s.Role = role
    ) and
let newStaff : Staff =
        Staff.allInstances()->any(s |
            not Staff.allInstances@pre()->includes(s) and s.Id = id
        )
    in
        if Staff.allInstances@pre()->exists(b | b.Id = bossid) then
            newStaff.Boss =
                Staff.allInstances@pre()->any(b | b.Id = bossid)
        else
            newStaff.Boss.oclIsUndefined()
        endif and
result = true
            
        }