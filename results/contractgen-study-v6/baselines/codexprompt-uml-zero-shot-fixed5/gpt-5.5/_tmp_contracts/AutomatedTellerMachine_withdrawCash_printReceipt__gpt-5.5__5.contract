Contract AutomatedTellerMachineSystem::printReceipt(): Real {
          precondition:
          self.CardIDValidated = true and self.PasswordValidated = true and
not self.InputCard.oclIsUndefined()
            postcondition:
          if self.IsWithdraw = true then
        result = self.WithdrawedNumber
    else
        if self.IsDeposit = true then
            result = self.DepositedNumber
        else
            result = 0
        endif
    endif
            
        }