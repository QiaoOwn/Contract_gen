Contract ProcessSaleService::makeNewSale(): Boolean {
          precondition:
          self.CurrentCashDesk <> null and
    self.CurrentCashDesk.IsOpened = true and
self.CurrentSale = null or
    self.CurrentSale.IsComplete = true
            postcondition:
          Sale.allInstances()->exists(s : Sale |
        s.oclIsNew() and
        s.IsComplete = false and
        s.IsReadytoPay = false and
        s.BelongedCashDesk = self.CurrentCashDesk
    ) and
self.CurrentSale.oclIsNew() and
    self.CurrentSale.IsComplete = false and
    self.CurrentSale.IsReadytoPay = false and
    self.CurrentSale.BelongedCashDesk = self.CurrentCashDesk and
Sale.allInstances()->includes(self.CurrentSale) and
result = true
            
        }