Contract AutomatedTellerMachineSystem::checkBalance(): Real {
          precondition:
          self.CardIDValidated = true
    and self.PasswordValidated = true
    and not self.InputCard.oclIsUndefined()
            postcondition:
          result = self.InputCard.Balance
    and self.InputCard.Balance = self@pre.InputCard.Balance
            
        }