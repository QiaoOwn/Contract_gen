Contract ManageSupplierCRUDService::modifySupplier(id:Integer,name:String): Boolean {
          precondition:
          Supplier.allInstances()->exists(s: Supplier | s.Id = id)
            postcondition:
          Supplier.allInstances()->exists(s: Supplier |
        s.Id = id and
        s.Name = name
    ) and
result = true
            
        }