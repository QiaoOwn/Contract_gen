Contract GenerateLoanLetterAndAgreementModule::generateLoanAgreement(): Boolean {
          precondition:
          not self.CurrentLoanRequest.oclIsUndefined()
            postcondition:
          LoanAgreement.allInstances()->exists(la |
        la.oclIsNew() and
        la.Content = 'Standard Loan Agreement Content' and
        self.CurrentLoanRequest.AttachedLoanAgreement = la and
        self.CurrentLoanAgreement = la
    ) and
result = true
            
        }