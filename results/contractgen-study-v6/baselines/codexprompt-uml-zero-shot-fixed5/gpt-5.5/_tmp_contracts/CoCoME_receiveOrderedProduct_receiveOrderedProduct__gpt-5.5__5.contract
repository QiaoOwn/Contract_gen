Contract CoCoMESystem::receiveOrderedProduct(orderID:Integer): Boolean {
          precondition:
          OrderProduct.allInstances()->exists(op: OrderProduct | op.Id = orderID)
            postcondition:
          OrderProduct.allInstances()->any(op: OrderProduct | op.Id = orderID).OrderStatus = OrderStatus::RECEIVED and
let receivedOrder: OrderProduct =
        OrderProduct.allInstances()->any(op: OrderProduct | op.Id = orderID)
    in
        receivedOrder.ContainedEntries->forAll(entry: OrderEntry |
            entry.Item.StockNumber =
                entry.Item.StockNumber@pre + entry.Quantity
        ) and
result = true
            
        }