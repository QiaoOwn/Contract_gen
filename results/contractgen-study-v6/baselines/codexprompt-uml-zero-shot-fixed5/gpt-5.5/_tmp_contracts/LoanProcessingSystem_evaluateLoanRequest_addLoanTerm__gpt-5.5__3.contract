Contract EvaluateLoanRequestModule::addLoanTerm(termid:Integer): Boolean {
          precondition:
          not self.CurrentLoanRequest.oclIsUndefined() and
LoanTerm.allInstances()->exists(t | t.ItemID = termid)
            postcondition:
          self.CurrentLoanRequest.AttachedLoanTerms =
        self.CurrentLoanRequest.AttachedLoanTerms@pre->including(
            LoanTerm.allInstances()->any(t | t.ItemID = termid)
        ) and
result = true
            
        }