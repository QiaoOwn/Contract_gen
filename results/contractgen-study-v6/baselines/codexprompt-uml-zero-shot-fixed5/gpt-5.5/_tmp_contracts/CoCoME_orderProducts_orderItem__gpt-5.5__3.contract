Contract CoCoMEOrderProducts::orderItem(barcode:Integer,quantity:Integer): Boolean {
          precondition:
          Item.allInstances()->exists(i: Item | i.Barcode = barcode)
            postcondition:
          OrderEntry.allInstances()->exists(oe: OrderEntry |
        oe.oclIsNew() and
        oe.Item = Item.allInstances()->any(i: Item | i.Barcode = barcode) and
        oe.Quantity = quantity and
        oe.SubAmount = quantity * Item.allInstances()->any(i: Item | i.Barcode = barcode).OrderPrice
    ) and
self.CurrentOrderProduct.ContainedEntries =
        self.CurrentOrderProduct.ContainedEntries@pre->including(
            OrderEntry.allInstances()->any(oe: OrderEntry |
                oe.oclIsNew() and
                oe.Item = Item.allInstances()->any(i: Item | i.Barcode = barcode) and
                oe.Quantity = quantity and
                oe.SubAmount = quantity * Item.allInstances()->any(i: Item | i.Barcode = barcode).OrderPrice
            )
        ) and
result = true
            
        }