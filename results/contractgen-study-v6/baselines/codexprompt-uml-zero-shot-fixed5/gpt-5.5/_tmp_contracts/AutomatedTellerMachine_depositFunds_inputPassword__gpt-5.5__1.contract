Contract AutomatedTellerMachineSystem::inputPassword(password:Integer): Boolean {
          precondition:
          self.CardIDValidated = true and
    self.InputCard <> null
            postcondition:
          if password = self.InputCard.Password then
        result = true and
        self.PasswordValidated = true
    else
        result = false and
        self.PasswordValidated = false
    endif
            
        }