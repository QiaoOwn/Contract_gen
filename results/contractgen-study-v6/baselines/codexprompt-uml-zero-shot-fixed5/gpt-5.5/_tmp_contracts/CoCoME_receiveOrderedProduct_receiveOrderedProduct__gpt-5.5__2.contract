Contract CoCoMESystem::receiveOrderedProduct(orderID:Integer): Boolean {
          precondition:
          OrderProduct.allInstances()->exists(op: OrderProduct | op.Id = orderID)
            postcondition:
          OrderProduct.allInstances()
        ->any(op: OrderProduct | op.Id = orderID).OrderStatus = OrderStatus::RECEIVED and
OrderProduct.allInstances()
        ->any(op: OrderProduct | op.Id = orderID).ContainedEntries
        ->forAll(oe: OrderEntry |
            oe.Item.StockNumber =
                oe.Item.StockNumber@pre + oe.Quantity
        ) and
result = true
            
        }