Contract SubmitLoanRequestModule::calculateScore(): Integer {
          precondition:
          self.CurrentLoanRequest <> null and
self.CurrentLoanRequest.RequestedCAHistory <> null and
self.CurrentLoanRequest.RequestedCreditHistory <> null
            postcondition:
          self.CurrentLoanRequest.CreditScore = 100 and
self.CurrentLoanRequest.Status = LoanRequestStatus::SUBMITTED and
result = self.CurrentLoanRequest.CreditScore and result = 100
            
        }