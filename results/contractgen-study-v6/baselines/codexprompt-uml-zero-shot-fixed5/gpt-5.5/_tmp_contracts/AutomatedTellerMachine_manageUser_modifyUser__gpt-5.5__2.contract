Contract ManageUserCRUDService::modifyUser(userid:Integer,name:String,address:String): Boolean {
          precondition:
          User.allInstances()->exists(u | u.UserID = userid)
            postcondition:
          let targetUser : User = User.allInstances()->any(u | u.UserID = userid) in
    targetUser.UserID = userid and
    targetUser.Name = name and
    targetUser.Address = address and
    result = true
            
        }