Contract RepairService::finishRepair(id:Integer,sid:Integer,did:Integer,res:String): Boolean {
          precondition:
          Device.allInstances()->exists(d |
        d.Id = did and
        d.Contacts.Id = sid
    ) and
Staff.allInstances()->exists(s |
        s.Id = sid and
        s.Role = 3
    )
            postcondition:
          Repair.allInstances()->exists(r |
        r.Id = id and
        r.RelatedDevice.Id = did and
        r.Process = 7 and
        r.Result = res
    ) and
result = true
            
        }