Contract ManageLoanTermCRUDService::deleteLoanTerm(itemid:Integer): Boolean {
          precondition:
          LoanTerm.allInstances()->exists(lt: LoanTerm | lt.ItemID = itemid)
            postcondition:
          LoanTerm.allInstances()->forAll(lt: LoanTerm | lt.ItemID <> itemid) and
result = true
            
        }