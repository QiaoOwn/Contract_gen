Contract CoCoMEOrderProducts::makeNewOrder(orderid:Integer): Boolean {
          precondition:
          OrderProduct.allInstances()->forAll(op | op.Id <> orderid)
            postcondition:
          OrderProduct.allInstances()->exists(op |
        op.oclIsNew() and
        op.Id = orderid and
        op.OrderStatus = OrderStatus::NEW and
        op.Time = Now
    ) and
self.CurrentOrderProduct.oclIsNew() and
    self.CurrentOrderProduct.Id = orderid and
    self.CurrentOrderProduct.OrderStatus = OrderStatus::NEW and
    self.CurrentOrderProduct.Time = Now and
OrderProduct.allInstances() =
        OrderProduct.allInstances@pre()->including(self.CurrentOrderProduct) and
result = true
            
        }