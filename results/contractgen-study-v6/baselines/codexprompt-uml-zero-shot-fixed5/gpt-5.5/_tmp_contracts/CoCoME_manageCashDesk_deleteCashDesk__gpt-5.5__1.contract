Contract ManageCashDeskCRUDService::deleteCashDesk(id:Integer): Boolean {
          precondition:
          CashDesk.allInstances()->exists(cd: CashDesk | cd.Id = id)
            postcondition:
          CashDesk.allInstances()->forAll(cd: CashDesk | cd.Id <> id) and
result = true
            
        }