Contract ManageBookCopyCRUDService::addBookCopy(callNo:String,barcode:String,location:String): Boolean {
          precondition:
          Book.allInstances()->exists(b: Book | b.CallNo = callNo) and
Book.allInstances()->any(b: Book | b.CallNo = callNo)
        .Copys->forAll(c: BookCopy | c.Barcode <> barcode)
            postcondition:
          BookCopy.allInstances()->exists(c: BookCopy |
        not BookCopy.allInstances@pre()->includes(c) and
        c.Barcode = barcode and
        c.Location = location and
        c.Status = CopyStatus::AVAILABLE and
        c.IsReserved = false and
        c.BookBelongs = Book.allInstances()->any(b: Book | b.CallNo = callNo)
    ) and
let targetBook: Book = Book.allInstances()->any(b: Book | b.CallNo = callNo) in
    targetBook.Copys->exists(c: BookCopy |
        not BookCopy.allInstances@pre()->includes(c) and
        c.Barcode = barcode and
        c.BookBelongs = targetBook
    ) and
let targetBook: Book = Book.allInstances()->any(b: Book | b.CallNo = callNo) in
    targetBook.CopyNum = targetBook.CopyNum@pre + 1 and
BookCopy.allInstances()->one(c: BookCopy |
        not BookCopy.allInstances@pre()->includes(c) and
        c.Barcode = barcode
    ) and
result = true
            
        }