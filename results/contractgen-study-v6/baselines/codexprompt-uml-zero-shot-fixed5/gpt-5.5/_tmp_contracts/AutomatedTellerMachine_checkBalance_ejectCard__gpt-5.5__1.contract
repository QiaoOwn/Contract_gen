Contract AutomatedTellerMachineSystem::ejectCard(): Boolean {
          precondition:
          self.CardIDValidated = true
    and self.PasswordValidated = true
    and self.InputCard <> null
            postcondition:
          self.InputCard = null
    and self.CardIDValidated = false
    and self.PasswordValidated = false
    and self.DepositAmount = 0
    and self.WithdrawAmount = 0
    and result = true
            
        }