Contract ManageSupplierCRUDService::deleteSupplier(id:Integer): Boolean {
          precondition:
          Supplier.allInstances()->exists(s | s.Id = id)
            postcondition:
          Supplier.allInstances()->excludes(
    Supplier.allInstances()->any(s | s.Id = id)
  )
  and result = true
            
        }