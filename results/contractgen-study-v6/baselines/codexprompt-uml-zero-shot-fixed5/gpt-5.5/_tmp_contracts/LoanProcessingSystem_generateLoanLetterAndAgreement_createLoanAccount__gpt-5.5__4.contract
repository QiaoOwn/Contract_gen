Contract GenerateLoanLetterAndAgreementModule::createLoanAccount(loanaccountid:Integer,balance:Real,status:LoanAccountStatus[NORMAL|HASPAIDINFULL]): Boolean {
          precondition:
          LoanAccount.allInstances()->forAll(la : LoanAccount |
        la.LoanAccountID <> loanaccountid
    )
            postcondition:
          LoanAccount.allInstances()->exists(la : LoanAccount |
        not LoanAccount.allInstances()@pre->includes(la) and
        la.LoanAccountID = loanaccountid and
        la.Balance = balance and
        la.Status = status
    ) and
LoanAccount.allInstances()->select(la : LoanAccount |
        not LoanAccount.allInstances()@pre->includes(la)
    )->size() = 1 and
result = true
            
        }