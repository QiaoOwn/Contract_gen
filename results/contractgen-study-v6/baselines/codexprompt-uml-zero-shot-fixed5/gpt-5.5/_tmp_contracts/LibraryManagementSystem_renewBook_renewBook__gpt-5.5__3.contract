Contract LibraryManagementSystemSystem::renewBook(uid:String,barcode:String): Boolean {
          precondition:
          User.allInstances()->exists(u |
        u.UserID = uid and
        u.BorrowStatus = BorrowStatus::NORMAL and
        BookCopy.allInstances()->exists(c |
            c.Barcode = barcode and
            Loan.allInstances()->exists(l |
                l.LoanedUser = u and
                l.LoanedCopy = c and
                l.IsReturned = false
            )
        )
    ) and
Loan.allInstances()->exists(l |
        l.LoanedUser.UserID = uid and
        l.LoanedCopy.Barcode = barcode and
        l.IsReturned = false and
        l.LoanedCopy.IsReserved = false and
        l.DueDate > Today and
        l.OverDueFee = 0
    ) and
Loan.allInstances()->exists(l |
        l.LoanedUser.UserID = uid and
        l.LoanedCopy.Barcode = barcode and
        l.IsReturned = false and
        (
            (l.LoanedUser.oclIsKindOf(Student) and l.RenewedTimes < 3) or
            (l.LoanedUser.oclIsKindOf(Faculty) and l.RenewedTimes < 6)
        )
    )
            postcondition:
          Loan.allInstances()->any(l |
        l.LoanedUser.UserID = uid and
        l.LoanedCopy.Barcode = barcode and
        l.IsReturned = false
    ).RenewedTimes =
    Loan.allInstances()->any(l |
        l.LoanedUser.UserID = uid and
        l.LoanedCopy.Barcode = barcode and
        l.IsReturned = false
    ).RenewedTimes@pre + 1 and
Loan.allInstances()->any(l |
        l.LoanedUser.UserID = uid and
        l.LoanedCopy.Barcode = barcode and
        l.IsReturned = false
    ).RenewDate = Today and
let loan: Loan =
        Loan.allInstances()->any(l |
            l.LoanedUser.UserID = uid and
            l.LoanedCopy.Barcode = barcode and
            l.IsReturned = false
        )
    in
        if loan.LoanedUser.oclIsTypeOf(Student) and
           loan.LoanedUser.oclAsType(Student).Programme = Programme::BACHELOR
        then
            loan.DueDate = loan.DueDate@pre + 20
        else
            if loan.LoanedUser.oclIsTypeOf(Student) and
               loan.LoanedUser.oclAsType(Student).Programme = Programme::MASTER
            then
                loan.DueDate = loan.DueDate@pre + 40
            else
                if loan.LoanedUser.oclIsKindOf(Student)
                then
                    loan.DueDate = loan.DueDate@pre + 60
                else
                    if loan.LoanedUser.oclIsKindOf(Faculty)
                    then
                        loan.DueDate = loan.DueDate@pre + 60
                    else
                        false
                    endif
                endif
            endif
        endif and
result = true
            
        }