Contract ListBookHistory::listRecommendBook(uid:String): Set(RecommendBook) {
          precondition:
          User.allInstances()->exists(u | u.UserID = uid) and
User.allInstances()->any(u | u.UserID = uid).RecommendedBook <> null
            postcondition:
          result = User.allInstances()->any(u | u.UserID = uid).RecommendedBook
            
        }