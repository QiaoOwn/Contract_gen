Contract LibraryManagementSystemSystem::renewBook(uid:String,barcode:String): Boolean {
          precondition:
          User.allInstances()->exists(u: User |
        u.UserID = uid and
        u.BorrowStatus = BorrowStatus::NORMAL and
        BookCopy.allInstances()->exists(c: BookCopy |
            c.Barcode = barcode and
            Loan.allInstances()->exists(l: Loan |
                l.LoanedUser = u and
                l.LoanedCopy = c and
                l.IsReturned = false
            )
        )
    ) and
Loan.allInstances()->exists(l: Loan |
        l.LoanedUser.UserID = uid and
        l.LoanedCopy.Barcode = barcode and
        l.IsReturned = false and
        l.LoanedCopy.IsReserved = false and
        l.DueDate > Today and
        l.OverDueFee = 0
    ) and
Loan.allInstances()->exists(l: Loan |
        l.LoanedUser.UserID = uid and
        l.LoanedCopy.Barcode = barcode and
        l.IsReturned = false and
        (
            (l.LoanedUser.oclIsTypeOf(Student) and l.RenewedTimes < 3) or
            (l.LoanedUser.oclIsTypeOf(Faculty) and l.RenewedTimes < 6)
        )
    )
            postcondition:
          Loan.allInstances()->forAll(l: Loan |
        l.LoanedUser.UserID = uid and
        l.LoanedCopy.Barcode = barcode and
        l.IsReturned = false
        implies
        l.RenewedTimes = l.RenewedTimes@pre + 1
    ) and
Loan.allInstances()->forAll(l: Loan |
        l.LoanedUser.UserID = uid and
        l.LoanedCopy.Barcode = barcode and
        l.IsReturned = false
        implies
        l.RenewDate = Today
    ) and
Loan.allInstances()->forAll(l: Loan |
        l.LoanedUser.UserID = uid and
        l.LoanedCopy.Barcode = barcode and
        l.IsReturned = false
        implies
        (
            (l.LoanedUser.oclIsTypeOf(Student) and
             l.LoanedUser.oclAsType(Student).Programme = Programme::BACHELOR
             implies l.DueDate = l.DueDate@pre + 20) and

            (l.LoanedUser.oclIsTypeOf(Student) and
             l.LoanedUser.oclAsType(Student).Programme = Programme::MASTER
             implies l.DueDate = l.DueDate@pre + 40) and

            (l.LoanedUser.oclIsTypeOf(Student) and
             l.LoanedUser.oclAsType(Student).Programme <> Programme::BACHELOR and
             l.LoanedUser.oclAsType(Student).Programme <> Programme::MASTER
             implies l.DueDate = l.DueDate@pre + 60) and

            (l.LoanedUser.oclIsTypeOf(Faculty)
             implies l.DueDate = l.DueDate@pre + 60)
        )
    ) and
result = true
            
        }