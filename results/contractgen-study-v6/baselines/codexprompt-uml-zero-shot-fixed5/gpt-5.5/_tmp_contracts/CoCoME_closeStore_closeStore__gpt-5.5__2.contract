Contract CoCoMESystem::closeStore(storeID:Integer): Boolean {
          precondition:
          Store.allInstances()->exists(s: Store |
        s.Id = storeID and s.IsOpened = true
    )
            postcondition:
          Store.allInstances()->exists(s: Store |
        s.Id = storeID and s.IsOpened = false
    ) and
result = true
            
        }