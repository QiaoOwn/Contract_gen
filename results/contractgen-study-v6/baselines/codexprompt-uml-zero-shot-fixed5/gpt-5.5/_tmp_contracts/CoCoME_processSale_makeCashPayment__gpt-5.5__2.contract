Contract ProcessSaleService::makeCashPayment(amount:Real): Boolean {
          precondition:
          not self.CurrentSale.oclIsUndefined()
    and self.CurrentSale.IsComplete = false
    and self.CurrentSale.IsReadytoPay = true and
amount >= self.CurrentSale.Amount
            postcondition:
          CashPayment.allInstances()->exists(p |
        p.oclIsNew()
        and p.AmountTendered = amount
        and p.Balance = amount - self.CurrentSale.Amount
        and p.BelongedSale = self.CurrentSale
        and self.CurrentSale.AssoicatedPayment = p
    ) and
self.CurrentSale.Belongedstore = self.CurrentSale.BelongedCashDesk.BelongedStore
    and self.CurrentSale.Time = Now
    and self.CurrentSale.IsComplete = true and
not self.CurrentSale.AssoicatedPayment.oclIsUndefined()
    and self.CurrentSale.AssoicatedPayment.oclIsTypeOf(CashPayment) and
result = true
            
        }