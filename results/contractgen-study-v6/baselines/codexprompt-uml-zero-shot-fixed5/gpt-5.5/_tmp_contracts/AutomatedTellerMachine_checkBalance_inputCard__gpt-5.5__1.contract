Contract AutomatedTellerMachineSystem::inputCard(cardid:Integer): Boolean {
          precondition:
          BankCard.allInstances()->exists(card |
        card.CardID = cardid and
        card.CardStatus = CardStatus::NORMAL
    )
            postcondition:
          if BankCard.allInstances()->exists(card |
        card.CardID = cardid and
        card.CardStatus = CardStatus::NORMAL and
        card.BelongedUser <> null
    ) then
        result = true and
        self.InputCard =
            BankCard.allInstances()->any(card |
                card.CardID = cardid and
                card.CardStatus = CardStatus::NORMAL and
                card.BelongedUser <> null
            ) and
        self.CardIDValidated = true
    else
        result = false and
        self.CardIDValidated = false
    endif
            
        }