Contract CoCoMESystem::changePrice(barcode:Integer,newPrice:Real): Boolean {
          precondition:
          Item.allInstances()->exists(i | i.Barcode = barcode)
            postcondition:
          Item.allInstances()->select(i | i.Barcode = barcode)->forAll(i |
        i.Price = newPrice
    ) and
result = true
            
        }