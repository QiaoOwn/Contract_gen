Contract AutomatedTellerMachineSystem::printReceipt(): Real {
          precondition:
          self.CardIDValidated = true and
  self.PasswordValidated = true and
  self.InputCard <> null
            postcondition:
          (self.IsDeposit = true implies result = self.DepositedNumber) and
  (self.IsDeposit = false implies result = 0)
            
        }