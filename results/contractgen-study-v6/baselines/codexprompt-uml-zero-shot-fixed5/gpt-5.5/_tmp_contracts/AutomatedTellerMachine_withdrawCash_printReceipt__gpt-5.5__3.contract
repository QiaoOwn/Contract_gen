Contract AutomatedTellerMachineSystem::printReceipt(): Real {
          precondition:
          self.CardIDValidated = true and
    self.PasswordValidated = true and
not self.InputCard.oclIsUndefined()
            postcondition:
          result =
        if self.IsWithdraw = true then
            self.WithdrawedNumber
        else
            if self.IsDeposit = true then
                self.DepositedNumber
            else
                0.0
            endif
        endif
            
        }