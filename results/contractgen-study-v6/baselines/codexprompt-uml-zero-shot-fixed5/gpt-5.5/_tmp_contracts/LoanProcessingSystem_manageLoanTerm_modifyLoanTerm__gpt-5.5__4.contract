Contract ManageLoanTermCRUDService::modifyLoanTerm(itemid:Integer,content:String): Boolean {
          precondition:
          LoanTerm.allInstances()->exists(lt: LoanTerm | lt.ItemID = itemid)
            postcondition:
          LoanTerm.allInstances()->exists(lt: LoanTerm |
        lt.ItemID = itemid and
        lt.Content = content
    ) and
result = true
            
        }