Contract GenerateLoanLetterAndAgreementModule::genereateApprovalLetter(id:Integer): Boolean {
          precondition:
          LoanRequest.allInstances()->exists(lr: LoanRequest | lr.RequestID = id)
            postcondition:
          self.CurrentLoanRequest = LoanRequest.allInstances()->any(lr: LoanRequest | lr.RequestID = id) and
ApprovalLetter.allInstances()->exists(al: ApprovalLetter |
        al.oclIsNew() and
        al.Content = 'Standard approval letter'
    ) and
self.CurrentLoanRequest.AttachedApprovalLetter.oclIsNew() and
    self.CurrentLoanRequest.AttachedApprovalLetter.Content = 'Standard approval letter' and
self.CurrentApprovalLetter = self.CurrentLoanRequest.AttachedApprovalLetter and
result = true
            
        }