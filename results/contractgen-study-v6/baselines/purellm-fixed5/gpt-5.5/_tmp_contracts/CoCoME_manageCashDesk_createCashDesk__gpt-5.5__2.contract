Contract ManageCashDeskCRUDService::createCashDesk(id:Integer,name:String,isopened:Boolean): Boolean {
          precondition:
          CashDesk.allInstances()->forAll(cashDesk:CashDesk | cashDesk.Id <> id)
            postcondition:
          let cashDesk:CashDesk in cashDesk.oclIsNew() and CashDesk.allInstances()->includes(cashDesk) and cashDesk.Id = id and cashDesk.Name = name and cashDesk.IsOpened = isopened and result = true
            
        }