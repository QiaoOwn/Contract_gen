Contract ListBookHistory::listOverDueBook(uid:String): Set(BookCopy) {
          definition:
          targetUser:User = User.allInstances()->any(user:User | user.UserID = uid), overdueLoans:Set(Loan) = Loan.allInstances()->select(loan:Loan | (loan.LoanedUser = targetUser and loan.IsReturned = false) and loan.OverDueFee > 0.0)
            precondition:
          targetUser.oclIsUndefined() = false and overdueLoans.oclIsUndefined() = false
            postcondition:
          result = overdueLoans->collect(loan:Loan | loan.LoanedCopy)
            
        }