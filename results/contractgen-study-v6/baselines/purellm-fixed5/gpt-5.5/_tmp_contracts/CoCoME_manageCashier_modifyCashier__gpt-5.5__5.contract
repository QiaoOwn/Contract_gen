Contract ManageCashierCRUDService::modifyCashier(id:Integer,name:String): Boolean {
          definition:
          targetCashier:Cashier = Cashier.allInstances()->any(candidate:Cashier | candidate.Id = id)
            precondition:
          targetCashier.oclIsUndefined() = false
            postcondition:
          targetCashier.Id = id and targetCashier.Name = name and result = true
            
        }