Contract AutomatedTellerMachineSystem::ejectCard(): Boolean {
          precondition:
          self.CardIDValidated = true and self.PasswordValidated = true and self.InputCard.oclIsUndefined() = false
            postcondition:
          self.InputCard = null and self.CardIDValidated = false and self.PasswordValidated = false and self.IsDeposit = false and self.IsWithdraw = false and self.DepositedNumber = 0.0 and self.WithdrawedNumber = 0.0 and result = true
            
        }