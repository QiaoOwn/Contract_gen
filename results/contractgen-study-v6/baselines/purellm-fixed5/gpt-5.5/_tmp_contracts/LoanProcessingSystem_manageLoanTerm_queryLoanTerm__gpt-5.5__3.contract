Contract ManageLoanTermCRUDService::queryLoanTerm(itemid:Integer): LoanTerm {
          definition:
          loanTerm:LoanTerm = LoanTerm.allInstances()->any(candidate:LoanTerm | candidate.ItemID = itemid)
            precondition:
          loanTerm.oclIsUndefined() = false
            postcondition:
          result = loanTerm
            
        }