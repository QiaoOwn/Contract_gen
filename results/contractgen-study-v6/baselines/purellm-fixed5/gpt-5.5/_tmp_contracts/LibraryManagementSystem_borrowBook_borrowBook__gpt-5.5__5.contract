Contract LibraryManagementSystemSystem::borrowBook(uid:String,barcode:String): Boolean {
          definition:
          user:User = User.allInstances()->any(candidate:User | candidate.UserID = uid), copy:BookCopy = BookCopy.allInstances()->any(candidate:BookCopy | candidate.Barcode = barcode), student:Student = Student.allInstances()->any(candidate:Student | candidate.UserID = uid), faculty:Faculty = Faculty.allInstances()->any(candidate:Faculty | candidate.UserID = uid), matchingReservation:Reserve = Reserve.allInstances()->any(candidate:Reserve | candidate.ReservedUser = user and candidate.ReservedCopy = copy and candidate.IsReserveClosed = false)
            precondition:
          User.allInstances()->exists(candidate:User | candidate.UserID = uid) and BookCopy.allInstances()->exists(candidate:BookCopy | candidate.Barcode = barcode) and user.BorrowStatus = BorrowStatus::NORMAL and user.SuspensionDays = 0 and if user.oclIsTypeOf(Student) then if student.Programme = Programme::BACHELOR then user.LoanedNumber < 20 else if student.Programme = Programme::MASTER then user.LoanedNumber < 40 else user.LoanedNumber < 60 endif endif else if user.oclIsTypeOf(Faculty) then user.LoanedNumber < 60 else false endif endif and (copy.Status = CopyStatus::AVAILABLE or (copy.Status = CopyStatus::ONHOLDSHELF and copy.IsReserved = true and Reserve.allInstances()->exists(candidate:Reserve | candidate.ReservedUser = user and candidate.ReservedCopy = copy and candidate.IsReserveClosed = false)))
            postcondition:
          let loan:Loan in loan.oclIsNew() and Loan.allInstances()->includes(loan) and loan.LoanedUser = user and loan.LoanedCopy = copy and user.LoanedBook->includes(loan) and copy.LoanedRecord->includes(loan) and loan.LoanDate = Today and loan.IsReturned = false and if user.oclIsTypeOf(Student) then loan.DueDate = Today.After(30) else loan.DueDate = Today.After(60) endif and user.LoanedNumber = user.LoanedNumber@pre + 1 and copy.Status = CopyStatus::LOANED and loan.OverDue3Days = false and loan.OverDue10Days = false and loan.OverDue17Days = false and loan.OverDue31Days = false and if copy.Status@pre = CopyStatus::ONHOLDSHELF then copy.IsReserved = false and matchingReservation.IsReserveClosed = true else copy.IsReserved = copy.IsReserved endif and result = true
            
        }