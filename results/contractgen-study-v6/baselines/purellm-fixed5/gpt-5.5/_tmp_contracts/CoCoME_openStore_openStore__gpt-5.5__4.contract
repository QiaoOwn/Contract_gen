Contract CoCoMESystem::openStore(storeID:Integer): Boolean {
          definition:
          targetStore:Store = Store.allInstances()->any(store:Store | store.Id = storeID)
            precondition:
          Store.allInstances()->includes(targetStore) and targetStore.IsOpened = false
            postcondition:
          targetStore.IsOpened = true and self.CurrentStore = targetStore and result = true
            
        }