Contract ProcessSaleService::endSale(): Real {
          definition:
          lineSubamounts:Set(Real) = self.CurrentSale.ContainedSalesLine->collect(line:SalesLineItem | line.Subamount)
            precondition:
          self.CurrentSale.oclIsUndefined() = false and self.CurrentSale.IsComplete = false and self.CurrentSale.IsReadytoPay = false
            postcondition:
          self.CurrentSale.Amount = lineSubamounts->sum() and self.CurrentSale.IsReadytoPay = true and result = self.CurrentSale.Amount
            
        }