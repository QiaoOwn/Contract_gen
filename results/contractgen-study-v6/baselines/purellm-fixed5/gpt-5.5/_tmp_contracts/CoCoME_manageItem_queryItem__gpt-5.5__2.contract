Contract ManageItemCRUDService::queryItem(barcode:Integer): Item {
          definition:
          referencedItem:Item = Item.allInstances()->any(item:Item | item.Barcode = barcode)
            precondition:
          Item.allInstances()->exists(item:Item | item.Barcode = barcode)
            postcondition:
          result = referencedItem
            
        }