Contract ManageCashierCRUDService::deleteCashier(id:Integer): Boolean {
          definition:
          cashier:Cashier = Cashier.allInstances()->any(candidate:Cashier | candidate.Id = id)
            precondition:
          cashier.oclIsUndefined() = false
            postcondition:
          Cashier.allInstances()->excludes(cashier) and result = true
            
        }