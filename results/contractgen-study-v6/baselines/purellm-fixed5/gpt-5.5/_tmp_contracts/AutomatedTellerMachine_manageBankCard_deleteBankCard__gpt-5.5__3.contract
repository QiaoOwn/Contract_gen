Contract ManageBankCardCRUDService::deleteBankCard(cardid:Integer): Boolean {
          definition:
          bankCard:BankCard = BankCard.allInstances()->any(candidate:BankCard | candidate.CardID = cardid)
            precondition:
          bankCard.oclIsUndefined() = false
            postcondition:
          BankCard.allInstances()->excludes(bankCard) and result = true
            
        }