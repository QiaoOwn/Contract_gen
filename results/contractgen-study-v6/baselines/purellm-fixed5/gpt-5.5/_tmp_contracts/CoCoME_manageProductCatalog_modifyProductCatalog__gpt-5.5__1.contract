Contract ManageProductCatalogCRUDService::modifyProductCatalog(id:Integer,name:String): Boolean {
          definition:
          productCatalog:ProductCatalog = ProductCatalog.allInstances()->any(candidate:ProductCatalog | candidate.Id = id)
            precondition:
          ProductCatalog.allInstances()->exists(candidate:ProductCatalog | candidate.Id = id)
            postcondition:
          productCatalog.Id = id and productCatalog.Name = name and result = true
            
        }