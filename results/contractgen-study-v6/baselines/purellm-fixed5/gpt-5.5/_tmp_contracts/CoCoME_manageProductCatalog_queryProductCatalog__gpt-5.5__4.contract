Contract ManageProductCatalogCRUDService::queryProductCatalog(id:Integer): ProductCatalog {
          definition:
          referencedProductCatalog:ProductCatalog = ProductCatalog.allInstances()->any(candidate:ProductCatalog | candidate.Id = id)
            precondition:
          ProductCatalog.allInstances()->exists(candidate:ProductCatalog | candidate.Id = id)
            postcondition:
          result = referencedProductCatalog
            
        }