Contract AirportSystem::createStaff(id:Integer,name:String,pswd:String,phone:String,role:Integer,bossid:Integer): Boolean {
          definition:
          existingStaff:Set(Staff) = Staff.allInstances()->select(s:Staff | s.Id = id), bossStaff:Staff = Staff.allInstances()->any(b:Staff | b.Id = bossid)
            precondition:
          existingStaff->isEmpty()
            postcondition:
          let newStaff:Staff in newStaff.oclIsNew() and Staff.allInstances()->includes(newStaff) and newStaff.Id = id and newStaff.Name = name and newStaff.Password = pswd and newStaff.Phone = phone and newStaff.Role = role and if bossStaff.oclIsUndefined() = false then newStaff.Boss = bossStaff else newStaff.Boss = null endif and result = true
            
        }