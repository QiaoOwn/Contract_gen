Contract SubmitLoanRequestModule::calculateScore(): Integer {
          precondition:
          self.CurrentLoanRequest.oclIsUndefined() = false and self.CurrentLoanRequest.RequestedCAHistory.oclIsUndefined() = false and self.CurrentLoanRequest.RequestedCreditHistory.oclIsUndefined() = false
            postcondition:
          self.CurrentLoanRequest.CreditScore = 100 and self.CurrentLoanRequest.Status = LoanRequestStatus::SUBMITTED and result = self.CurrentLoanRequest.CreditScore
            
        }