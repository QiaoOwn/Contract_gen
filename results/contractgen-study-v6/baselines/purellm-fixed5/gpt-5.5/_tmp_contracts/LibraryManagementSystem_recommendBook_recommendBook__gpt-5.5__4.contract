Contract LibraryManagementSystemSystem::recommendBook(uid:String,callNo:String,title:String,edition:String,author:String,publisher:String,description:String,isbn:String): Boolean {
          definition:
          user:User = User.allInstances()->any(candidate:User | candidate.UserID = uid)
            precondition:
          user.oclIsUndefined() = false and RecommendBook.allInstances()->forAll(book:RecommendBook | book.CallNo <> callNo)
            postcondition:
          let recommendedBook:RecommendBook in recommendedBook.oclIsNew() and RecommendBook.allInstances()->includes(recommendedBook) and recommendedBook.CallNo = callNo and recommendedBook.Title = title and recommendedBook.Edition = edition and recommendedBook.Author = author and recommendedBook.Publisher = publisher and recommendedBook.Description = description and recommendedBook.ISBn = isbn and recommendedBook.RecommendDate = Today and recommendedBook.RecommendUser = user and user.RecommendedBook->includes(recommendedBook) and result = true
            
        }