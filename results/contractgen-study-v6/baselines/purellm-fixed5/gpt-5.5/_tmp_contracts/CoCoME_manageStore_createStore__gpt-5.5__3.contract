Contract ManageStoreCRUDService::createStore(id:Integer,name:String,address:String,isopened:Boolean): Boolean {
          precondition:
          Store.allInstances()->forAll(store:Store | store.Id <> id)
            postcondition:
          let store:Store in store.oclIsNew() and Store.allInstances()->includes(store) and store.Id = id and store.Name = name and store.Address = address and store.IsOpened = isopened and result = true
            
        }