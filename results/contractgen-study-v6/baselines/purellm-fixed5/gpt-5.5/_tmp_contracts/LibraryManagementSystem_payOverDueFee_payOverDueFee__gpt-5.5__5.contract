Contract LibraryManagementSystemSystem::payOverDueFee(uid:String,fee:Real): Boolean {
          definition:
          user:User = User.allInstances()->any(candidate:User | candidate.UserID = uid), applicableLoans:Set(Loan) = Loan.allInstances()->select(loan:Loan | loan.LoanedUser = user and loan.IsReturned = true and loan.OverDueFee > 0.0), totalFee:Real = applicableLoans.OverDueFee->sum()
            precondition:
          user.oclIsUndefined() = false and applicableLoans->notEmpty() and fee >= totalFee
            postcondition:
          user.OverDueFee = 0.0 and applicableLoans->forAll(loan:Loan | loan.OverDueFee = 0.0) and result = true
            
        }