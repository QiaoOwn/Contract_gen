Contract CoCoMEOrderProducts::chooseSupplier(supplierID:Integer): Boolean {
          definition:
          selectedSupplier:Supplier = Supplier.allInstances()->any(candidate:Supplier | candidate.Id = supplierID)
            precondition:
          selectedSupplier.oclIsUndefined() = false and self.CurrentOrderProduct.oclIsUndefined() = false
            postcondition:
          self.CurrentOrderProduct.Supplier = selectedSupplier and result = true
            
        }