Contract EvaluateLoanRequestModule::reviewCheckingAccount(): CheckingAccount {
          definition:
          checkingAccount:CheckingAccount = self.CurrentLoanRequest.RequestedCAHistory
            precondition:
          self.CurrentLoanRequest.oclIsUndefined() = false and checkingAccount.oclIsUndefined() = false
            postcondition:
          result = checkingAccount
            
        }