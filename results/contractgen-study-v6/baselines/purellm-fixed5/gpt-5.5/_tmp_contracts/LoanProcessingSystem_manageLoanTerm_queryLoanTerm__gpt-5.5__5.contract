Contract ManageLoanTermCRUDService::queryLoanTerm(itemid:Integer): LoanTerm {
          definition:
          referencedLoanTerm:LoanTerm = LoanTerm.allInstances()->any(loanTerm:LoanTerm | loanTerm.ItemID = itemid)
            precondition:
          LoanTerm.allInstances()->exists(loanTerm:LoanTerm | loanTerm.ItemID = itemid)
            postcondition:
          result = referencedLoanTerm
            
        }