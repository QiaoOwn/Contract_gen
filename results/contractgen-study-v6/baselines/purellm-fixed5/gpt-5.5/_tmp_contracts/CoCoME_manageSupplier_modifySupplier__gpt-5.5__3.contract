Contract ManageSupplierCRUDService::modifySupplier(id:Integer,name:String): Boolean {
          definition:
          targetSupplier:Supplier = Supplier.allInstances()->any(s:Supplier | s.Id = id)
            precondition:
          targetSupplier.oclIsUndefined() = false
            postcondition:
          targetSupplier.Id = id and targetSupplier.Name = name and result = true
            
        }