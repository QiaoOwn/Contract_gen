Contract ManageCashDeskCRUDService::deleteCashDesk(id:Integer): Boolean {
          definition:
          cashDesk:CashDesk = CashDesk.allInstances()->any(candidate:CashDesk | candidate.Id = id)
            precondition:
          cashDesk.oclIsUndefined() = false
            postcondition:
          CashDesk.allInstances()->excludes(cashDesk) and result = true
            
        }