Contract ManageBankCardCRUDService::queryBankCard(cardid:Integer): BankCard {
          definition:
          targetCard:BankCard = BankCard.allInstances()->any(candidate:BankCard | candidate.CardID = cardid)
            precondition:
          targetCard.oclIsUndefined() = false
            postcondition:
          result = targetCard
            
        }