Contract ManageBankCardCRUDService::queryBankCard(cardid:Integer): BankCard {
          definition:
          referencedBankCard:BankCard = BankCard.allInstances()->any(candidate:BankCard | candidate.CardID = cardid)
            precondition:
          BankCard.allInstances()->exists(candidate:BankCard | candidate.CardID = cardid)
            postcondition:
          result = referencedBankCard
            
        }