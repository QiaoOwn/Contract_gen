Contract ManageCashierCRUDService::deleteCashier(id:Integer): Boolean {
          definition:
          cashier:Cashier = Cashier.allInstances()->any(c:Cashier | c.Id = id)
            precondition:
          Cashier.allInstances()->exists(c:Cashier | c.Id = id)
            postcondition:
          Cashier.allInstances()->excludes(cashier) and result = true
            
        }