Contract ManageLoanTermCRUDService::createLoanTerm(itemid:Integer,content:String): Boolean {
          precondition:
          LoanTerm.allInstances()->forAll(loanTerm:LoanTerm | loanTerm.ItemID <> itemid)
            postcondition:
          let loanTerm:LoanTerm in loanTerm.oclIsNew() and LoanTerm.allInstances()->includes(loanTerm) and loanTerm.ItemID = itemid and loanTerm.Content = content and result = true
            
        }