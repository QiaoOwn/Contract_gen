Contract EvaluateLoanRequestModule::addLoanTerm(termid:Integer): Boolean {
          definition:
          selectedLoanTerm:LoanTerm = LoanTerm.allInstances()->any(candidate:LoanTerm | candidate.ItemID = termid)
            precondition:
          self.CurrentLoanRequest.oclIsUndefined() = false and selectedLoanTerm.oclIsUndefined() = false
            postcondition:
          self.CurrentLoanRequest.AttachedLoanTerms->includes(selectedLoanTerm) and result = true
            
        }