Contract ManageLibrarianCRUDService::createLibrarian(librarianid:String,name:String,password:String): Boolean {
          precondition:
          Librarian.allInstances()->forAll(l:Librarian | l.LibrarianID <> librarianid)
            postcondition:
          let librarian:Librarian in librarian.oclIsNew() and Librarian.allInstances()->includes(librarian) and librarian.LibrarianID = librarianid and librarian.Name = name and librarian.Password = password and result = true
            
        }