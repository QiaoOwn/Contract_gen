Contract AutomatedTellerMachineSystem::inputPassword(password:Integer): Boolean {
          precondition:
          self.CardIDValidated = true and self.InputCard.oclIsUndefined() = false
            postcondition:
          if password = self.InputCard.Password then self.PasswordValidated = true and result = true else self.PasswordValidated = false and result = false endif
            
        }