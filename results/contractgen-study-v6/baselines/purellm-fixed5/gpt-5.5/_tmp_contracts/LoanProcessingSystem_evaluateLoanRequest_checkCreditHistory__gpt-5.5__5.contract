Contract EvaluateLoanRequestModule::checkCreditHistory(): CreditHistory {
          definition:
          currentCreditHistory:CreditHistory = self.CurrentLoanRequest.RequestedCreditHistory
            precondition:
          self.CurrentLoanRequest.oclIsUndefined() = false and currentCreditHistory.oclIsUndefined() = false
            postcondition:
          result = currentCreditHistory
            
        }