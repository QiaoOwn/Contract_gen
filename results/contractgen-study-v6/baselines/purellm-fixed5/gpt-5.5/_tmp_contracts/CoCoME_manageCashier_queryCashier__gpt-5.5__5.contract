Contract ManageCashierCRUDService::queryCashier(id:Integer): Cashier {
          definition:
          referencedCashier:Cashier = Cashier.allInstances()->any(cashier:Cashier | cashier.Id = id)
            precondition:
          referencedCashier.oclIsUndefined() = false
            postcondition:
          result = referencedCashier
            
        }