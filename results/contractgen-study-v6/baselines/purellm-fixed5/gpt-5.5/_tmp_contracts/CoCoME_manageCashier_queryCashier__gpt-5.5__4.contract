Contract ManageCashierCRUDService::queryCashier(id:Integer): Cashier {
          definition:
          cashier:Cashier = Cashier.allInstances()->any(candidate:Cashier | candidate.Id = id)
            precondition:
          Cashier.allInstances()->exists(candidate:Cashier | candidate.Id = id)
            postcondition:
          result = cashier
            
        }