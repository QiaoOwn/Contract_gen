Contract ManageLoanTermCRUDService::deleteLoanTerm(itemid:Integer): Boolean {
          definition:
          loanTerm:LoanTerm = LoanTerm.allInstances()->any(candidate:LoanTerm | candidate.ItemID = itemid)
            precondition:
          LoanTerm.allInstances()->includes(loanTerm)
            postcondition:
          LoanTerm.allInstances()->excludes(loanTerm) and result = true
            
        }