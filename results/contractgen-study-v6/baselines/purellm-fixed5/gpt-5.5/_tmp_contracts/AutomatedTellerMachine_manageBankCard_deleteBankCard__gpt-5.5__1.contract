Contract ManageBankCardCRUDService::deleteBankCard(cardid:Integer): Boolean {
          definition:
          targetCard:BankCard = BankCard.allInstances()->any(card:BankCard | card.CardID = cardid)
            precondition:
          BankCard.allInstances()->exists(card:BankCard | card.CardID = cardid)
            postcondition:
          BankCard.allInstances()->excludes(targetCard) and result = true
            
        }