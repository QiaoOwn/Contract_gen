Contract CoCoMESystem::openCashDesk(cashDeskID:Integer): Boolean {
          definition:
          cashDesk:CashDesk = CashDesk.allInstances()->any(candidate:CashDesk | candidate.Id = cashDeskID)
            precondition:
          CashDesk.allInstances()->includes(cashDesk) and cashDesk.IsOpened = false and self.CurrentStore.oclIsUndefined() = false and self.CurrentStore.IsOpened = true
            postcondition:
          cashDesk.IsOpened = true and self.CurrentCashDesk = cashDesk and result = true
            
        }