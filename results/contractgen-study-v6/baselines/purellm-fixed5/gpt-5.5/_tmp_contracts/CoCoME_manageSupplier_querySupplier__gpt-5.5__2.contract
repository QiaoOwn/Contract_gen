Contract ManageSupplierCRUDService::querySupplier(id:Integer): Supplier {
          definition:
          referencedSupplier:Supplier = Supplier.allInstances()->any(candidate:Supplier | candidate.Id = id)
            precondition:
          referencedSupplier.oclIsUndefined() = false
            postcondition:
          result = referencedSupplier
            
        }