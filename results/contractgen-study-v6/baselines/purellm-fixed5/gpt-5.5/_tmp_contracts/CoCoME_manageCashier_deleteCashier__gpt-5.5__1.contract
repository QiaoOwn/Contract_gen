Contract ManageCashierCRUDService::deleteCashier(id:Integer): Boolean {
          definition:
          targetCashier:Cashier = Cashier.allInstances()->any(candidate:Cashier | candidate.Id = id)
            precondition:
          targetCashier.oclIsUndefined() = false
            postcondition:
          Cashier.allInstances()->excludes(targetCashier) and result = true
            
        }