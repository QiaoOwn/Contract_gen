Contract LoanProcessingSystemSystem::closeOutLoan(loanid:Integer): Boolean {
          definition:
          loan:Loan = Loan.allInstances()->any(candidate:Loan | candidate.LoanID = loanid)
            precondition:
          Loan.allInstances()->includes(loan) and loan.Status = LoanStatus::LSOPEN
            postcondition:
          loan.Status = LoanStatus::CLOSED and result = true
            
        }