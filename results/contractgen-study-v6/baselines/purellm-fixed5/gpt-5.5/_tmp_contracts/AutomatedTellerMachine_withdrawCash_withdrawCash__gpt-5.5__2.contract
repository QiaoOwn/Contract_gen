Contract AutomatedTellerMachineSystem::withdrawCash(quantity:Integer): Boolean {
          precondition:
          self.CardIDValidated = true and self.PasswordValidated = true and self.InputCard.oclIsUndefined() = false and self.InputCard.Balance >= quantity
            postcondition:
          self.InputCard.Balance = self.InputCard.Balance@pre - quantity and self.IsWithdraw = true and self.WithdrawedNumber = quantity and result = true
            
        }