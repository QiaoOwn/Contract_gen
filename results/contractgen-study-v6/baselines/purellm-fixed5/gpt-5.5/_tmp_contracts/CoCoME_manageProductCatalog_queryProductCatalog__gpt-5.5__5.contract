Contract ManageProductCatalogCRUDService::queryProductCatalog(id:Integer): ProductCatalog {
          definition:
          productCatalog:ProductCatalog = ProductCatalog.allInstances()->any(candidate:ProductCatalog | candidate.Id = id)
            precondition:
          ProductCatalog.allInstances()->exists(candidate:ProductCatalog | candidate.Id = id)
            postcondition:
          result = productCatalog
            
        }