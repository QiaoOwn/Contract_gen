Contract ProcessSaleService::makeCashPayment(amount:Real): Boolean {
          definition:
          currentStore:Store = Store.allInstances()->any(store:Store | store.Sales->includes(self.CurrentSale))
            precondition:
          self.CurrentSale.oclIsUndefined() = false and self.CurrentSale.IsComplete = false and self.CurrentSale.IsReadytoPay = true and amount >= self.CurrentSale.Amount
            postcondition:
          let payment:CashPayment in payment.oclIsNew() and payment.AmountTendered = amount and payment.Balance = amount - self.CurrentSale.Amount@pre and payment.BelongedSale = self.CurrentSale and self.CurrentSale.AssoicatedPayment = payment and self.CurrentSale.Belongedstore = currentStore and self.CurrentSale.Time = Now and self.CurrentSale.IsComplete = true and Payment.allInstances()->includes(payment) and result = true
            
        }