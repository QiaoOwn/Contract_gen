Contract LibraryManagementSystemSystem::borrowBook(uid:String,barcode:String): Boolean {
          definition:
          user:User = User.allInstances()->any(u:User | u.UserID = uid), copy:BookCopy = BookCopy.allInstances()->any(c:BookCopy | c.Barcode = barcode), student:Student = Student.allInstances()->any(s:Student | s.UserID = uid), faculty:Faculty = Faculty.allInstances()->any(f:Faculty | f.UserID = uid), reservation:Reserve = Reserve.allInstances()->any(r:Reserve | r.ReservedUser = user and r.ReservedCopy = copy and r.IsReserveClosed = false)
            precondition:
          User.allInstances()->includes(user) and BookCopy.allInstances()->includes(copy) and user.BorrowStatus = BorrowStatus::NORMAL and user.SuspensionDays = 0 and (if user.oclIsTypeOf(Student) then if student.Programme = Programme::BACHELOR then user.LoanedNumber < 20 else if student.Programme = Programme::MASTER then user.LoanedNumber < 40 else user.LoanedNumber < 60 endif endif else if user.oclIsTypeOf(Faculty) then user.LoanedNumber < 60 else true endif endif) and (copy.Status = CopyStatus::AVAILABLE or (copy.Status = CopyStatus::ONHOLDSHELF and copy.IsReserved = true and Reserve.allInstances()->includes(reservation)))
            postcondition:
          let loan:Loan in loan.oclIsNew() and Loan.allInstances()->includes(loan) and loan.LoanedUser = user and loan.LoanedCopy = copy and user.LoanedBook->includes(loan) and copy.LoanedRecord->includes(loan) and loan.LoanDate = Today and loan.IsReturned = false and loan.DueDate = if user.oclIsTypeOf(Student) then Today.After(30) else Today.After(60) endif and user.LoanedNumber = user.LoanedNumber@pre + 1 and copy.Status = CopyStatus::LOANED and loan.OverDue3Days = false and loan.OverDue10Days = false and loan.OverDue17Days = false and loan.OverDue31Days = false and if copy.Status@pre = CopyStatus::ONHOLDSHELF then copy.IsReserved = false and reservation.IsReserveClosed = true else true endif and result = true
            
        }