Contract ManageLoanTermCRUDService::queryLoanTerm(itemid:Integer): LoanTerm {
          definition:
          referencedLoanTerm:LoanTerm = LoanTerm.allInstances()->any(candidate:LoanTerm | candidate.ItemID = itemid)
            precondition:
          LoanTerm.allInstances()->exists(candidate:LoanTerm | candidate.ItemID = itemid)
            postcondition:
          result = referencedLoanTerm
            
        }