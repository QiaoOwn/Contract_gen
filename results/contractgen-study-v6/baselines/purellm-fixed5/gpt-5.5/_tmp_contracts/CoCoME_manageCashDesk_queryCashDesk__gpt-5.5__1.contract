Contract ManageCashDeskCRUDService::queryCashDesk(id:Integer): CashDesk {
          definition:
          referencedCashDesk:CashDesk = CashDesk.allInstances()->any(candidate:CashDesk | candidate.Id = id)
            precondition:
          CashDesk.allInstances()->exists(candidate:CashDesk | candidate.Id = id)
            postcondition:
          result = referencedCashDesk
            
        }