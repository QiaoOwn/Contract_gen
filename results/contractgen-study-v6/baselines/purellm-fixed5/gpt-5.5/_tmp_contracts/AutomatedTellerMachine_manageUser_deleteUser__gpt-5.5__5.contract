Contract ManageUserCRUDService::deleteUser(userid:Integer): Boolean {
          definition:
          targetUser:User = User.allInstances()->any(candidate:User | candidate.UserID = userid)
            precondition:
          User.allInstances()->exists(candidate:User | candidate.UserID = userid)
            postcondition:
          User.allInstances()->excludes(targetUser) and result = true
            
        }