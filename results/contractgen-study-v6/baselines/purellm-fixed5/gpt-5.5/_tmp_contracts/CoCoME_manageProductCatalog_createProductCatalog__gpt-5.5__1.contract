Contract ManageProductCatalogCRUDService::createProductCatalog(id:Integer,name:String): Boolean {
          precondition:
          ProductCatalog.allInstances()->forAll(productCatalog:ProductCatalog | productCatalog.Id <> id)
            postcondition:
          let productCatalog:ProductCatalog in productCatalog.oclIsNew() and ProductCatalog.allInstances()->includes(productCatalog) and productCatalog.Id = id and productCatalog.Name = name and result = true
            
        }