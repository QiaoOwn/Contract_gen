Contract ManageItemCRUDService::modifyItem(barcode:Integer,name:String,price:Real,stocknumber:Integer,orderprice:Real): Boolean {
          definition:
          item:Item = Item.allInstances()->any(candidate:Item | candidate.Barcode = barcode)
            precondition:
          item.oclIsUndefined() = false
            postcondition:
          item.Barcode = barcode and item.Name = name and item.Price = price and item.StockNumber = stocknumber and item.OrderPrice = orderprice and result = true
            
        }