Contract ManageUserCRUDService::modifyUser(userid:Integer,name:String,address:String): Boolean {
          definition:
          targetUser:User = User.allInstances()->any(candidate:User | candidate.UserID = userid)
            precondition:
          targetUser.oclIsUndefined() = false
            postcondition:
          targetUser.UserID = userid and targetUser.Name = name and targetUser.Address = address and result = true
            
        }