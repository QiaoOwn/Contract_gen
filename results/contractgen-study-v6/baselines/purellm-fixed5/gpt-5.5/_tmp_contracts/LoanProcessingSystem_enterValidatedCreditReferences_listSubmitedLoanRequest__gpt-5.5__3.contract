Contract EnterValidatedCreditReferencesModule::listSubmitedLoanRequest(): Set(LoanRequest) {
          definition:
          submittedLoanRequests:Set(LoanRequest) = LoanRequest.allInstances()->select(loanRequest:LoanRequest | loanRequest.Status = LoanRequestStatus::SUBMITTED)
            precondition:
          submittedLoanRequests->notEmpty()
            postcondition:
          self.CurrentLoanRequests = submittedLoanRequests and result = submittedLoanRequests
            
        }