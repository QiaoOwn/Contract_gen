Contract EvaluateLoanRequestModule::reviewCheckingAccount(): CheckingAccount {
          definition:
          requestedCheckingAccount:CheckingAccount = self.CurrentLoanRequest.RequestedCAHistory
            precondition:
          self.CurrentLoanRequest.oclIsUndefined() = false and requestedCheckingAccount.oclIsUndefined() = false
            postcondition:
          result = requestedCheckingAccount
            
        }