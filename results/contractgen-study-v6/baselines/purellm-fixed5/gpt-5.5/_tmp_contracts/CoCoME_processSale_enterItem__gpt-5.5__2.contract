Contract ProcessSaleService::enterItem(barcode:Integer,quantity:Integer): Boolean {
          definition:
          currentItem:Item = Item.allInstances()->any(item:Item | item.Barcode = barcode)
            precondition:
          self.CurrentSale.oclIsUndefined() = false and self.CurrentSale.IsComplete = false and currentItem.oclIsUndefined() = false and currentItem.StockNumber > 0
            postcondition:
          let salesLineItem:SalesLineItem in salesLineItem.oclIsNew() and SalesLineItem.allInstances()->includes(salesLineItem) and salesLineItem.BelongedSale = self.CurrentSale and salesLineItem.BelongedItem = currentItem and salesLineItem.Quantity = quantity and salesLineItem.Subamount = currentItem.Price * quantity and self.CurrentSale.ContainedSalesLine->includes(salesLineItem) and currentItem.StockNumber = currentItem.StockNumber@pre - quantity and result = true
            
        }