Contract ManageBankCardCRUDService::createBankCard(cardid:Integer,cardstatus:CardStatus[NORMAL|SUSPEND|CANCEL],catalog:CardCatalog[CREDIT|DEPOSIT],password:Integer,balance:Real): Boolean {
          precondition:
          BankCard.allInstances()->forAll(card:BankCard | card.CardID <> cardid)
            postcondition:
          let card:BankCard in card.oclIsNew() and BankCard.allInstances()->includes(card) and card.CardID = cardid and card.CardStatus = cardstatus and card.Catalog = catalog and card.Password = password and card.Balance = balance and result = true
            
        }