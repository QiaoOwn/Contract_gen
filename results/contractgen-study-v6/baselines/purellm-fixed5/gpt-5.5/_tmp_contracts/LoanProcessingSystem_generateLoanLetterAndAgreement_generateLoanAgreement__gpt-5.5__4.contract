Contract GenerateLoanLetterAndAgreementModule::generateLoanAgreement(): Boolean {
          precondition:
          self.CurrentLoanRequest.oclIsUndefined() = false
            postcondition:
          let loanAgreement:LoanAgreement in loanAgreement.oclIsNew() and LoanAgreement.allInstances()->includes(loanAgreement) and loanAgreement.Content = 'standard content' and self.CurrentLoanRequest.AttachedLoanAgreement = loanAgreement and self.CurrentLoanAgreement = loanAgreement and result = true
            
        }