Contract ManageProductCatalogCRUDService::queryProductCatalog(id:Integer): ProductCatalog {
          definition:
          referencedProductCatalog:ProductCatalog = ProductCatalog.allInstances()->any(productCatalog:ProductCatalog | productCatalog.Id = id)
            precondition:
          ProductCatalog.allInstances()->exists(productCatalog:ProductCatalog | productCatalog.Id = id)
            postcondition:
          result = referencedProductCatalog
            
        }