Contract ManageCashDeskCRUDService::modifyCashDesk(id:Integer,name:String,isopened:Boolean): Boolean {
          definition:
          cashDesk:CashDesk = CashDesk.allInstances()->any(candidate:CashDesk | candidate.Id = id)
            precondition:
          cashDesk.oclIsUndefined() = false
            postcondition:
          cashDesk.Id = id and cashDesk.Name = name and cashDesk.IsOpened = isopened and result = true
            
        }