Contract ManageProductCatalogCRUDService::modifyProductCatalog(id:Integer,name:String): Boolean {
          definition:
          targetCatalog:ProductCatalog = ProductCatalog.allInstances()->any(candidate:ProductCatalog | candidate.Id = id)
            precondition:
          targetCatalog.oclIsUndefined() = false
            postcondition:
          targetCatalog.Id = id and targetCatalog.Name = name and result = true
            
        }