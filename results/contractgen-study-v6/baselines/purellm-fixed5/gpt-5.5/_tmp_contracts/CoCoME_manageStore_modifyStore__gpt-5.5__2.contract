Contract ManageStoreCRUDService::modifyStore(id:Integer,name:String,address:String,isopened:Boolean): Boolean {
          definition:
          targetStore:Store = Store.allInstances()->any(store:Store | store.Id = id)
            precondition:
          targetStore.oclIsUndefined() = false
            postcondition:
          targetStore.Id = id and targetStore.Name = name and targetStore.Address = address and targetStore.IsOpened = isopened and result = true
            
        }