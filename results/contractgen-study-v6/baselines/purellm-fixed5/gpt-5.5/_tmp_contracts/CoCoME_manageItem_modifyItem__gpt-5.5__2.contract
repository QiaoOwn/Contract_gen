Contract ManageItemCRUDService::modifyItem(barcode:Integer,name:String,price:Real,stocknumber:Integer,orderprice:Real): Boolean {
          definition:
          targetItem:Item = Item.allInstances()->any(item:Item | item.Barcode = barcode)
            precondition:
          targetItem.oclIsUndefined() = false
            postcondition:
          targetItem.Barcode = barcode and targetItem.Name = name and targetItem.Price = price and targetItem.StockNumber = stocknumber and targetItem.OrderPrice = orderprice and result = true
            
        }