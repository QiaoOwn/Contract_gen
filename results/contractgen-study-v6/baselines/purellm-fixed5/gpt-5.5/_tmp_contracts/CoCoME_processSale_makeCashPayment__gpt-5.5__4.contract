Contract ProcessSaleService::makeCashPayment(amount:Real): Boolean {
          definition:
          currentStore:Store = self.CurrentSale.BelongedCashDesk.BelongedStore
            precondition:
          self.CurrentSale.oclIsUndefined() = false and self.CurrentSale.IsComplete = false and self.CurrentSale.IsReadytoPay = true and amount >= self.CurrentSale.Amount
            postcondition:
          let payment:CashPayment in payment.oclIsNew() and Payment.allInstances()->includes(payment) and CashPayment.allInstances()->includes(payment) and payment.AmountTendered = amount and payment.Balance = amount - self.CurrentSale.Amount@pre and payment.BelongedSale = self.CurrentSale and self.CurrentSale.AssoicatedPayment = payment and self.CurrentSale.Belongedstore = currentStore and self.CurrentSale.Time = Now and self.CurrentSale.IsComplete = true and result = true
            
        }