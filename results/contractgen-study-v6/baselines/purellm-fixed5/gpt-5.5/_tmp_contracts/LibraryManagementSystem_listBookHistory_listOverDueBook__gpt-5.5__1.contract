Contract ListBookHistory::listOverDueBook(uid:String): Set(BookCopy) {
          definition:
          user:User = User.allInstances()->any(candidate:User | candidate.UserID = uid), overdueLoans:Set(Loan) = Loan.allInstances()->select(loan:Loan | (loan.LoanedUser = user and loan.IsReturned = false) and loan.OverDueFee > 0.0)
            precondition:
          User.allInstances()->exists(candidate:User | candidate.UserID = uid) and overdueLoans.oclIsUndefined() = false
            postcondition:
          result = overdueLoans->collect(loan:Loan | loan.LoanedCopy)
            
        }