Contract ManageCashDeskCRUDService::queryCashDesk(id:Integer): CashDesk {
          definition:
          cashDesk:CashDesk = CashDesk.allInstances()->any(candidate:CashDesk | candidate.Id = id)
            precondition:
          cashDesk.oclIsUndefined() = false
            postcondition:
          result = cashDesk
            
        }