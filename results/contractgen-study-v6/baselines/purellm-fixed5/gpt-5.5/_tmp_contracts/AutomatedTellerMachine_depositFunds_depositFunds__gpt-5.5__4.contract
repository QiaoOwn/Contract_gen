Contract AutomatedTellerMachineSystem::depositFunds(quantity:Real): Boolean {
          precondition:
          self.CardIDValidated = true and self.PasswordValidated = true and self.InputCard.oclIsUndefined() = false and quantity >= 100.0
            postcondition:
          self.InputCard.Balance = self.InputCard.Balance@pre + quantity and self.IsDeposit = true and self.DepositedNumber = quantity and result = true
            
        }