Contract ManageLoanTermCRUDService::modifyLoanTerm(itemid:Integer,content:String): Boolean {
          definition:
          loanTerm:LoanTerm = LoanTerm.allInstances()->any(candidate:LoanTerm | candidate.ItemID = itemid)
            precondition:
          loanTerm.oclIsUndefined() = false
            postcondition:
          loanTerm.ItemID = itemid and loanTerm.Content = content and result = true
            
        }