Contract CoCoMEOrderProducts::chooseSupplier(supplierID:Integer): Boolean {
          definition:
          supplier:Supplier = Supplier.allInstances()->any(candidate:Supplier | candidate.Id = supplierID)
            precondition:
          supplier.oclIsUndefined() = false and self.CurrentOrderProduct.oclIsUndefined() = false
            postcondition:
          self.CurrentOrderProduct.Supplier = supplier and result = true
            
        }