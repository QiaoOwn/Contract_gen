Contract ManageProductCatalogCRUDService::deleteProductCatalog(id:Integer): Boolean {
          definition:
          productCatalog:ProductCatalog = ProductCatalog.allInstances()->any(candidate:ProductCatalog | candidate.Id = id)
            precondition:
          ProductCatalog.allInstances()->includes(productCatalog)
            postcondition:
          ProductCatalog.allInstances()->excludes(productCatalog) and result = true
            
        }