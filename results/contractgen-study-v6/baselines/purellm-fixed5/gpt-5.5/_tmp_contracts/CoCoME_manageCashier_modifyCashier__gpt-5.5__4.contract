Contract ManageCashierCRUDService::modifyCashier(id:Integer,name:String): Boolean {
          definition:
          cashier:Cashier = Cashier.allInstances()->any(candidate:Cashier | candidate.Id = id)
            precondition:
          cashier.oclIsUndefined() = false
            postcondition:
          cashier.Id = id and cashier.Name = name and result = true
            
        }