Contract SearchBook::searchBookByISBN(iSBNnumber:String): Set(Book) {
          definition:
          matchedBooks:Set(Book) = Book.allInstances()->select(book:Book | book.ISBn = iSBNnumber)
            precondition:
          iSBNnumber.oclIsTypeOf(String)
            postcondition:
          result = matchedBooks
            
        }