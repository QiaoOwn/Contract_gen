Contract ManageBankCardCRUDService::deleteBankCard(cardid:Integer): Boolean {
          definition:
          card:BankCard = BankCard.allInstances()->any(candidate:BankCard | candidate.CardID = cardid)
            precondition:
          BankCard.allInstances()->includes(card)
            postcondition:
          BankCard.allInstances()->excludes(card) and result = true
            
        }