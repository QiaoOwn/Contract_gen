Contract AirportSystem::createStaff(id:Integer,name:String,pswd:String,phone:String,role:Integer,bossid:Integer): Boolean {
          definition:
          existingBoss:Staff = Staff.allInstances()->any(candidate:Staff | candidate.Id = bossid)
            precondition:
          Staff.allInstances()->forAll(staff:Staff | staff.Id <> id)
            postcondition:
          let newStaff:Staff in newStaff.oclIsNew() and Staff.allInstances()->includes(newStaff) and newStaff.Id = id and newStaff.Name = name and newStaff.Password = pswd and newStaff.Phone = phone and newStaff.Role = role and if existingBoss.oclIsUndefined() = false then newStaff.Boss = existingBoss else newStaff.Boss = null endif and result = true
            
        }