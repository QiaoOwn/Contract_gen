Contract ListBookHistory::listReservationBook(uid:String): Set(BookCopy) {
          definition:
          user:User = User.allInstances()->any(candidate:User | candidate.UserID = uid), reservations:Set(Reserve) = user.ReservedBook
            precondition:
          user.oclIsUndefined() = false and reservations.oclIsUndefined() = false
            postcondition:
          result = reservations->collect(reservation:Reserve | reservation.ReservedCopy)
            
        }