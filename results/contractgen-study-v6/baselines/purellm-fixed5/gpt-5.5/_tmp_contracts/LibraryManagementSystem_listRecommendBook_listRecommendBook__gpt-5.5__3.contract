Contract LibraryManagementSystemSystem::listRecommendBook(uid:String): Set(RecommendBook) {
          definition:
          targetUser:User = User.allInstances()->any(user:User | user.UserID = uid), recommendationCollection:Set(RecommendBook) = targetUser.RecommendedBook
            precondition:
          targetUser.oclIsUndefined() = false and recommendationCollection.oclIsUndefined() = false
            postcondition:
          result = recommendationCollection
            
        }