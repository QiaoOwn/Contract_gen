Contract ManageCashDeskCRUDService::queryCashDesk(id:Integer): CashDesk {
          definition:
          referencedCashDesk:CashDesk = CashDesk.allInstances()->any(cashDesk:CashDesk | cashDesk.Id = id)
            precondition:
          CashDesk.allInstances()->exists(cashDesk:CashDesk | cashDesk.Id = id)
            postcondition:
          result = referencedCashDesk
            
        }