model StrongUSE_005_Airport_raiseRepair_feedback

-- operation_id: Airport_raiseRepair_feedback
-- operation_signature: feedback(id: Integer, sid: Integer, score: Integer, des: String): Boolean
-- conversion_scope: model_context + generated definition/precondition
-- postcondition is retained as comment because USE invariants do not model operation post-state directly.

-- Generated contract:
-- Contract RepairService::feedback(id: Integer,sid: Integer,score: Integer,des: String): Boolean {
--   definition:
--     staff: Staff = Staff.allInstances()->any(s: Staff|s.Id = sid),
--     repair: Repair = Repair.allInstances()->any(r: Repair|r.Id = id)
--   precondition:
--     repair.RaiseStaff = staff and
--     staff.Role = 0 and
--     repair.Process = 7
--   postcondition:
--     repair.Score = score and
--     if score>=3 
--     then repair.Close = true 
--     else repair.Close = false and
--     repair.Description = des and
--     repair.Process = 0 
--     endif  and
--     result = true
-- }

class ApprovalHistory
attributes
  Id : Integer
  StaffId : Integer
  Reject : Boolean
  Suggestion : String
end

class Device
attributes
  Id : Integer
  Name : String
  Location : String
end

class Repair
attributes
  Id : Integer
  Repairname : String
  Price : Integer
  Description : String
  Score : Integer
  FailTime : Integer
  Close : Boolean
  Process : Integer
  Result : String
end

class Staff
attributes
  Id : Integer
  Name : String
  Password : String
  Phone : String
  Role : Integer
end

class OperationContext
attributes
  id : Integer
  sid : Integer
  score : Integer
  des : String
  Now : Integer
  Today : Integer
operations
  Contract_feedback(id : Integer, sid : Integer, score : Integer, des : String) : Boolean
end

association Device_Contacts_Staff between
  Device[0..*] role Device_Contacts_Owner
  Staff[0..1] role Contacts
end

association Repair_History_ApprovalHistory between
  Repair[0..*] role Repair_History_Owner
  ApprovalHistory[*] role History
end

association Repair_RelatedDevice_Device between
  Repair[0..*] role Repair_RelatedDevice_Owner
  Device[0..1] role RelatedDevice
end

association Repair_RaiseStaff_Staff between
  Repair[0..*] role Repair_RaiseStaff_Owner
  Staff[0..1] role RaiseStaff
end

association Staff_Boss_Staff between
  Staff[0..*] role Staff_Boss_Owner
  Staff[0..1] role Boss
end

constraints

context OperationContext::Contract_feedback(id : Integer, sid : Integer, score : Integer, des : String) : Boolean
  pre feedbackGeneratedPre:
    let staff : Staff = Staff.allInstances()->any(s: Staff|s.Id = sid) in
          let repair : Repair = Repair.allInstances()->any(r: Repair|r.Id = id) in
          repair.RaiseStaff = staff and
    		staff.Role = 0 and
    		repair.Process = 7
  post feedbackGeneratedPost:
    let staff : Staff = Staff.allInstances()->any(s: Staff|s.Id = sid) in
          let repair : Repair = Repair.allInstances()->any(r: Repair|r.Id = id) in
          repair.Score = score and
    		if score>=3 
    		then repair.Close = true 
    		else repair.Close = false and
    		repair.Description = des and
    		repair.Process = 0 
    		endif  and
    		result = true
