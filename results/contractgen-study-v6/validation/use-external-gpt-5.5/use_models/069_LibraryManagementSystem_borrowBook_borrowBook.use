enum BorrowStatus { NORMAL, SUSPEND }
enum CopyStatus { AVAILABLE, INPROCESSING, LIBUSEONLY, LOANED, ONHOLDSHELF }
enum Position { ASSISTANTPROFESSORS, ASSOCIATEPROFESSOR, CHAIRPROFESSOR, PROFESSOR }
enum Programme { BACHELOR, GRADUATED, MASTER, PHD, PROGRAMMING }
enum Sex { F, M }
enum Status { HASRETIRED, INPOSITION }

class Administrator
attributes
  AdminID : String
  UserName : String
  Password : String
end

class Book
attributes
  CallNo : String
  Title : String
  Edition : String
  Author : String
  Publisher : String
  Description : String
  ISBn : String
  CopyNum : Integer
end

class BookCopy
attributes
  Barcode : String
  Status : CopyStatus
  Location : String
  IsReserved : Boolean
end

class Faculty < User
attributes
  Position : Position
  Status : Status
end

class Librarian
attributes
  LibrarianID : String
  Name : String
  Password : String
end

class Loan
attributes
  LoanDate : Integer
  RenewDate : Integer
  DueDate : Integer
  ReturnDate : Integer
  RenewedTimes : Integer
  IsReturned : Boolean
  OverDueFee : Real
  OverDue3Days : Boolean
  OverDue10Days : Boolean
  OverDue17Days : Boolean
  OverDue31Days : Boolean
end

class RecommendBook < Book
attributes
  RecommendDate : Integer
end

class Reserve
attributes
  ReserveDate : Integer
  IsReserveClosed : Boolean
end

class Student < User
attributes
  Major : String
  Programme : Programme
  RegistrationStatus : Programme
end

class Subject
attributes
  Name : String
end

class User
attributes
  UserID : String
  Name : String
  Sex : Sex
  Password : String
  Email : String
  Faculty : String
  LoanedNumber : Integer
  BorrowStatus : BorrowStatus
  SuspensionDays : Integer
  OverDueFee : Real
end

class OperationContext
attributes
  uid : String
  barcode : String
  Now : Integer
  Today : Integer
operations
  Contract_borrowBook(uid : String, barcode : String) : Boolean
end

association Book_Copys_BookCopy between
  Book[0..*] role Book_Copys_Owner
  BookCopy[*] role Copys
end

association Book_Subject_Subject between
  Book[0..*] role Book_Subject_Owner
  Subject[*] role Subject
end

association BookCopy_BookBelongs_Book between
  BookCopy[0..*] role BookCopy_BookBelongs_Owner
  Book[0..1] role BookBelongs
end

association BookCopy_LoanedRecord_Loan between
  BookCopy[0..*] role BookCopy_LoanedRecord_Owner
  Loan[*] role LoanedRecord
end

association BookCopy_ReservationRecord_Reserve between
  BookCopy[0..*] role BookCopy_ReservationRecord_Owner
  Reserve[*] role ReservationRecord
end

association Loan_LoanedUser_User between
  Loan[0..*] role Loan_LoanedUser_Owner
  User[0..1] role LoanedUser
end

association Loan_LoanedCopy_BookCopy between
  Loan[0..*] role Loan_LoanedCopy_Owner
  BookCopy[0..1] role LoanedCopy
end

association Loan_LoanLibrarian_Librarian between
  Loan[0..*] role Loan_LoanLibrarian_Owner
  Librarian[0..1] role LoanLibrarian
end

association Loan_ReturnLibrarian_Librarian between
  Loan[0..*] role Loan_ReturnLibrarian_Owner
  Librarian[0..1] role ReturnLibrarian
end

association RecommendBook_RecommendUser_User between
  RecommendBook[0..*] role RecommendBook_RecommendUser_Owner
  User[0..1] role RecommendUser
end

association Reserve_ReservedCopy_BookCopy between
  Reserve[0..*] role Reserve_ReservedCopy_Owner
  BookCopy[0..1] role ReservedCopy
end

association Reserve_ReservedUser_User between
  Reserve[0..*] role Reserve_ReservedUser_Owner
  User[0..1] role ReservedUser
end

association Subject_SuperSubject_Subject between
  Subject[0..*] role Subject_SuperSubject_Owner
  Subject[0..1] role SuperSubject
end

association Subject_SubSubject_Subject between
  Subject[0..*] role Subject_SubSubject_Owner
  Subject[0..1] role SubSubject
end

association User_LoanedBook_Loan between
  User[0..*] role User_LoanedBook_Owner
  Loan[*] role LoanedBook
end

association User_ReservedBook_Reserve between
  User[0..*] role User_ReservedBook_Owner
  Reserve[*] role ReservedBook
end

association User_RecommendedBook_RecommendBook between
  User[0..*] role User_RecommendedBook_Owner
  RecommendBook[*] role RecommendedBook
end

constraints

context OperationContext::Contract_borrowBook(uid : String, barcode : String) : Boolean
  pre borrowBookGeneratedPre:
    let user : User = User.allInstances()->any(candidate: User|candidate.UserID = uid) in
          let copy : BookCopy = BookCopy.allInstances()->any(candidate: BookCopy|candidate.Barcode = barcode) in
          let student : Student = Student.allInstances()->any(candidate: Student|candidate.UserID = uid) in
          let faculty : Faculty = Faculty.allInstances()->any(candidate: Faculty|candidate.UserID = uid) in
          let reservation : Reserve = Reserve.allInstances()->any(candidate: Reserve|candidate.ReservedUser = user and
    		candidate.ReservedCopy = copy and
    		candidate.IsReserveClosed = false) in
          let dueDate : Integer = if user.oclIsTypeOf(Student) 
    		then (Today + 30) 
    		else (Today + 60) 
    		endif in
          User.allInstances()->exists(candidate: User|candidate.UserID = uid) and
    		BookCopy.allInstances()->exists(candidate: BookCopy|candidate.Barcode = barcode) and
    		user.BorrowStatus = #NORMAL and
    		user.SuspensionDays = 0 and
    		(if user.oclIsTypeOf(Student) 
    		then if student.Programme = #BACHELOR 
    		then user.LoanedNumber<20 
    		else if student.Programme = #MASTER 
    		then user.LoanedNumber<40 
    		else user.LoanedNumber<60 
    		endif  
    		endif  
    		else if user.oclIsTypeOf(Faculty) 
    		then user.LoanedNumber<60 
    		else false 
    		endif  
    		endif ) and
    		(copy.Status = #AVAILABLE or
    		(copy.Status = #ONHOLDSHELF and
    		copy.IsReserved = true and
    		Reserve.allInstances()->exists(candidate: Reserve|candidate.ReservedUser = user and
    		candidate.ReservedCopy = copy and
    		candidate.IsReserveClosed = false)))
  post borrowBookGeneratedPost:
    let user : User = User.allInstances()->any(candidate: User|candidate.UserID = uid) in
          let copy : BookCopy = BookCopy.allInstances()->any(candidate: BookCopy|candidate.Barcode = barcode) in
          let student : Student = Student.allInstances()->any(candidate: Student|candidate.UserID = uid) in
          let faculty : Faculty = Faculty.allInstances()->any(candidate: Faculty|candidate.UserID = uid) in
          let reservation : Reserve = Reserve.allInstances()->any(candidate: Reserve|candidate.ReservedUser = user and
    		candidate.ReservedCopy = copy and
    		candidate.IsReserveClosed = false) in
          let dueDate : Integer = if user.oclIsTypeOf(Student) 
    		then (Today + 30) 
    		else (Today + 60) 
    		endif in
          Loan.allInstances()->exists(loan: Loan |
          loan.oclIsNew() and
    		Loan.allInstances()->includes(loan) and
    		loan.LoanedUser = user and
    		loan.LoanedCopy = copy and
    		user.LoanedBook->includes(loan) and
    		copy.LoanedRecord->includes(loan) and
    		loan.LoanDate = Today and
    		loan.IsReturned = false and
    		loan.DueDate = dueDate and
    		user.LoanedNumber = user.LoanedNumber@pre+1 and
    		copy.Status = #LOANED and
    		loan.OverDue3Days = false and
    		loan.OverDue10Days = false and
    		loan.OverDue17Days = false and
    		loan.OverDue31Days = false and
    		(if copy.Status@pre = #ONHOLDSHELF 
    		then copy.IsReserved = false and
    		reservation.IsReserveClosed = true 
    		else copy.IsReserved = copy.IsReserved@pre 
    		endif ) and
    		result = true)
