constraints

context OperationContext::Contract_listTenLoanRequest() : String
  pre listTenLoanRequestGeneratedPre:
    let matchingRequests : Set(LoanRequest) = LoanRequest.allInstances()->select(request: LoanRequest|request.Status = #REFERENCESVALIDATED) in
          matchingRequests->size() >= 0
  post listTenLoanRequestGeneratedPost:
    let matchingRequests : Set(LoanRequest) = LoanRequest.allInstances()->select(request: LoanRequest|request.Status = #REFERENCESVALIDATED) in
          self.CurrentLoanRequests = matchingRequests and
    		result = matchingRequests
