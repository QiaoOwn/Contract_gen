enum CardCatalog { CREDIT, DESPOSIT }
enum CardStatus { CANNEL, NORMAL, SUSPEND }

class BankCard
attributes
  CardID : Integer
  CardStatus : CardStatus
  Catalog : CardCatalog
  Password : Integer
  Balance : Real
end

class User
attributes
  UserID : Integer
  Name : String
  Address : String
end

class OperationContext
attributes
  CardIDValidated : Boolean
  DepositedNumber : Real
  InputCard : Boolean
  IsDeposit : Boolean
  Now : Integer
  PasswordValidated : Boolean
  Today : Integer
  sampleIndex : Integer
operations
  Contract_printReceipt() : Real
end

association BankCard_BelongedUser_User between
  BankCard[0..*] role BankCard_BelongedUser_Owner
  User[0..1] role BelongedUser
end

association User_OwnedCard_BankCard between
  User[0..*] role User_OwnedCard_Owner
  BankCard[0..1] role OwnedCard
end

constraints

context OperationContext::Contract_printReceipt() : Real
  pre printReceiptGeneratedPre:
    self.CardIDValidated = true and
    		self.PasswordValidated = true and
    		self.InputCard.oclIsUndefined() = false
  post printReceiptGeneratedPost:
    if self.IsDeposit = true 
    		then result = self.DepositedNumber 
    		else result = 0.0 
    		endif
