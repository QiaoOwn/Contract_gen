class ApprovalHistory
attributes
  Id : Integer
  StaffId : Integer
  Reject : Boolean
  Suggestion : String
end

class Device
attributes
  Id : Integer
  Name : String
  Location : String
end

class Repair
attributes
  Id : Integer
  Repairname : String
  Price : Integer
  Description : String
  Score : Integer
  FailTime : Integer
  Close : Boolean
  Process : Integer
  Result : String
end

class Staff
attributes
  Id : Integer
  Name : String
  Password : String
  Phone : String
  Role : Integer
end

class OperationContext
attributes
  id : Integer
  name : String
  location : String
  contactsid : Integer
  Now : Integer
  Today : Integer
operations
  Contract_createDevice(id : Integer, name : String, location : String, contactsid : Integer) : Boolean
end

association Device_Contacts_Staff between
  Device[0..*] role Device_Contacts_Owner
  Staff[0..1] role Contacts
end

association Repair_History_ApprovalHistory between
  Repair[0..*] role Repair_History_Owner
  ApprovalHistory[*] role History
end

association Repair_RelatedDevice_Device between
  Repair[0..*] role Repair_RelatedDevice_Owner
  Device[0..1] role RelatedDevice
end

association Repair_RaiseStaff_Staff between
  Repair[0..*] role Repair_RaiseStaff_Owner
  Staff[0..1] role RaiseStaff
end

association Staff_Boss_Staff between
  Staff[0..*] role Staff_Boss_Owner
  Staff[0..1] role Boss
end

constraints

context OperationContext::Contract_createDevice(id : Integer, name : String, location : String, contactsid : Integer) : Boolean
  pre createDeviceGeneratedPre:
    let contact : Staff = Staff.allInstances()->any(s: Staff|s.Id = contactsid) in
          Device.allInstances()->forAll(d: Device|d.Id<>id) and
    		Staff.allInstances()->exists(s: Staff|s.Id = contactsid)
