enum BorrowStatus { NORMAL, SUSPEND }
enum CopyStatus { AVAILABLE, INPROCESSING, LIBUSEONLY, LOANED, ONHOLDSHELF }
enum Position { ASSISTANTPROFESSORS, ASSOCIATEPROFESSOR, CHAIRPROFESSOR, PROFESSOR }
enum Programme { BACHELOR, GRADUATED, MASTER, PHD, PROGRAMMING }
enum Sex { F, M }
enum Status { HASRETIRED, INPOSITION }

class Administrator
attributes
  AdminID : String
  UserName : String
  Password : String
end

class Book
attributes
  CallNo : String
  Title : String
  Edition : String
  Author : String
  Publisher : String
  Description : String
  ISBn : String
  CopyNum : Integer
end

class BookCopy
attributes
  Barcode : String
  Status : CopyStatus
  Location : String
  IsReserved : Boolean
end

class Faculty < User
attributes
  Position : Position
  Status : Status
end

class Librarian
attributes
  LibrarianID : String
  Name : String
  Password : String
end

class Loan
attributes
  LoanDate : Integer
  RenewDate : Integer
  DueDate : Integer
  ReturnDate : Integer
  RenewedTimes : Integer
  IsReturned : Boolean
  OverDueFee : Real
  OverDue3Days : Boolean
  OverDue10Days : Boolean
  OverDue17Days : Boolean
  OverDue31Days : Boolean
end

class RecommendBook < Book
attributes
  RecommendDate : Integer
end

class Reserve
attributes
  ReserveDate : Integer
  IsReserveClosed : Boolean
end

class Student < User
attributes
  Major : String
  Programme : Programme
  RegistrationStatus : Programme
end

class Subject
attributes
  Name : String
end

class User
attributes
  UserID : String
  Name : String
  Sex : Sex
  Password : String
  Email : String
  Faculty : String
  LoanedNumber : Integer
  BorrowStatus : BorrowStatus
  SuspensionDays : Integer
  OverDueFee : Real
end

class OperationContext
attributes
  uid : String
  Now : Integer
  Today : Integer
operations
  Contract_listReservationBook(uid : String) : String
end

