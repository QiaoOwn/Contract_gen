constraints

context OperationContext::Contract_listReservationBook(uid : String) : String
  pre listReservationBookGeneratedPre:
    let user : User = User.allInstances()->any(candidate: User|candidate.UserID = uid) in
          let reservations : Set(Reserve) = user.ReservedBook in
          User.allInstances()->exists(candidate: User|candidate.UserID = uid) and
    		user.ReservedBook.oclIsUndefined() = false
