constraints

context OperationContext::Contract_addBookCopy(callNo : String, barcode : String, location : String) : Boolean
  post addBookCopyGeneratedPost:
    let targetBook : Book = Book.allInstances()->any(candidate: Book|candidate.CallNo = callNo) in
          BookCopy.allInstances()->exists(newCopy: BookCopy |
          newCopy.oclIsNew() and
    		BookCopy.allInstances()->includes(newCopy) and
    		newCopy.Barcode = barcode and
    		newCopy.Location = location and
    		newCopy.Status = #AVAILABLE and
    		newCopy.IsReserved = false and
    		newCopy.BookBelongs = targetBook and
    		targetBook.Copys->includes(newCopy) and
    		targetBook.CopyNum = targetBook.CopyNum@pre+1 and
    		result = true)
