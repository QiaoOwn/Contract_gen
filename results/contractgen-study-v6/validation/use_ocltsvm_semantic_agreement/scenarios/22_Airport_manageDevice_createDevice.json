  "complexity_score": 62,
  "contract": "Contract AirportSystem::createDevice(id: Integer,name: String,location: String,contactsid: Integer): Boolean {\n\tdefinition:\n\t\tcontact: Staff = Staff.allInstances()->any(s: Staff|s.Id = contactsid)\n\tprecondition:\n\t\tDevice.allInstances()->forAll(d: Device|d.Id<>id) and\n\t\tStaff.allInstances()->exists(s: Staff|s.Id = contactsid)\n\tpostcondition:\n\t\tlet device: Device in\n\t\tdevice.oclIsNew() and\n\t\tDevice.allInstances()->includes(device) and\n\t\tdevice.Id = id and\n\t\tdevice.Name = name and\n\t\tdevice.Location = location and\n\t\tdevice.Contacts = contact and\n\t\tresult = true\n}",
  "complexity_tier": "complex",
