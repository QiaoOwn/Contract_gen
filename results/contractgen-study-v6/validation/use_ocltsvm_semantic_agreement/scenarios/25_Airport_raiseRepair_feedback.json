  "contract": "Contract RepairService::feedback(id: Integer,sid: Integer,score: Integer,des: String): Boolean {\n\tdefinition:\n\t\tstaff: Staff = Staff.allInstances()->any(s: Staff|s.Id = sid),\n\t\trepair: Repair = Repair.allInstances()->any(r: Repair|r.Id = id)\n\tprecondition:\n\t\trepair.RaiseStaff = staff and\n\t\tstaff.Role = 0 and\n\t\trepair.Process = 7\n\tpostcondition:\n\t\trepair.Score = score and\n\t\tif score>=3 \n\t\tthen repair.Close = true \n\t\telse repair.Close = false and\n\t\trepair.Description = des and\n\t\trepair.Process = 0 \n\t\tendif  and\n\t\tresult = true\n}",
  "complexity_tier": "complex",
