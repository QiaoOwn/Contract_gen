  "contract": "Contract ProcessSaleService::enterItem(barcode: Integer,quantity: Integer): Boolean {\n\tdefinition:\n\t\titem: Item = Item.allInstances()->any(candidate: Item|candidate.Barcode = barcode)\n\tprecondition:\n\t\tself.CurrentSale.oclIsUndefined() = false and\n\t\tself.CurrentSale.IsComplete = false and\n\t\titem.oclIsUndefined() = false and\n\t\titem.StockNumber>0\n\tpostcondition:\n\t\tlet salesLineItem: SalesLineItem in\n\t\tsalesLineItem.oclIsNew() and\n\t\tSalesLineItem.allInstances()->includes(salesLineItem) and\n\t\tsalesLineItem.BelongedSale = self.CurrentSale and\n\t\tsalesLineItem.BelongedItem = item and\n\t\tself.CurrentSale.ContainedSalesLine->includes(salesLineItem) and\n\t\tsalesLineItem.Quantity = quantity and\n\t\tsalesLineItem.Subamount = item.Price*quantity and\n\t\titem.StockNumber = item.StockNumber@pre-quantity and\n\t\tresult = true\n}",
  "complexity_tier": "complex",
