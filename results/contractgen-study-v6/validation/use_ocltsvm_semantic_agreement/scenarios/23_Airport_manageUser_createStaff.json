  "complexity_score": 80,
  "contract": "Contract AirportSystem::createStaff(id: Integer,name: String,pswd: String,phone: String,role: Integer,bossid: Integer): Boolean {\n\tdefinition:\n\t\texistingBoss: Staff = Staff.allInstances()->any(candidate: Staff|candidate.Id = bossid)\n\tprecondition:\n\t\tStaff.allInstances()->forAll(staff: Staff|staff.Id<>id)\n\tpostcondition:\n\t\tlet newStaff: Staff in\n\t\tnewStaff.oclIsNew() and\n\t\tStaff.allInstances()->includes(newStaff) and\n\t\tnewStaff.Id = id and\n\t\tnewStaff.Name = name and\n\t\tnewStaff.Password = pswd and\n\t\tnewStaff.Phone = phone and\n\t\tnewStaff.Role = role and\n\t\tif existingBoss.oclIsUndefined() = false \n\t\tthen newStaff.Boss = existingBoss \n\t\telse newStaff.Boss = null \n\t\tendif  and\n\t\tresult = true\n}",
  "complexity_tier": "complex",
