  "contract": "Contract AutomatedTellerMachineSystem::inputCard(cardid: Integer): Boolean {\n\tdefinition:\n\t\tcard: BankCard = BankCard.allInstances()->any(candidate: BankCard|candidate.CardID = cardid)\n\tprecondition:\n\t\tBankCard.allInstances()->includes(card) and\n\t\tcard.CardStatus = CardStatus::NORMAL\n\tpostcondition:\n\t\tif card.BelongedUser.oclIsUndefined() = false \n\t\tthen self.InputCard = card and\n\t\tself.CardIDValidated = true and\n\t\tresult = true \n\t\telse self.CardIDValidated = false and\n\t\tresult = false \n\t\tendif \n}",
