  "contract": "Contract LibraryManagementSystemSystem::renewBook(uid: String,barcode: String): Boolean {\n\tdefinition:\n\t\tuser: User = User.allInstances()->any(candidate: User|candidate.UserID = uid),\n\t\tcopy: BookCopy = BookCopy.allInstances()->any(candidate: BookCopy|candidate.Barcode = barcode),\n\t\tloan: Loan = Loan.allInstances()->any(candidate: Loan|candidate.LoanedUser = user and\n\t\tcandidate.LoanedCopy = copy and\n\t\tcandidate.IsReturned = false),\n\t\tstudent: Student = Student.allInstances()->any(candidate: Student|candidate.UserID = uid),\n\t\tfaculty: Faculty = Faculty.allInstances()->any(candidate: Faculty|candidate.UserID = uid)\n\tprecondition:\n\t\tUser.allInstances()->exists(candidate: User|candidate.UserID = uid) and\n\t\tBookCopy.allInstances()->exists(candidate: BookCopy|candidate.Barcode = barcode) and\n\t\tLoan.allInstances()->exists(candidate: Loan|candidate.LoanedUser = user and\n\t\tcandidate.LoanedCopy = copy and\n\t\tcandidate.IsReturned = false) and\n\t\tuser.BorrowStatus = BorrowStatus::NORMAL and\n\t\tcopy.IsReserved = false and\n\t\tloan.DueDate.isAfter(Today) and\n\t\tloan.OverDueFee = 0.0 and\n\t\tif user.oclIsTypeOf(Student) \n\t\tthen loan.RenewedTimes<3 \n\t\telse if user.oclIsTypeOf(Faculty) \n\t\tthen loan.RenewedTimes<6 \n\t\telse false \n\t\tendif  \n\t\tendif \n\tpostcondition:\n\t\tloan.RenewedTimes = loan.RenewedTimes@pre+1 and\n\t\tloan.RenewDate = Today and\n\t\t(if user.oclIsTypeOf(Student) \n\t\tthen if student.Programme = Programme::BACHELOR \n\t\tthen loan.DueDate = loan.DueDate@pre.After(20) \n\t\telse if student.Programme = Programme::MASTER \n\t\tthen loan.DueDate = loan.DueDate@pre.After(40) \n\t\telse loan.DueDate = loan.DueDate@pre.After(60) \n\t\tendif  \n\t\tendif  \n\t\telse if user.oclIsTypeOf(Faculty) \n\t\tthen loan.DueDate = loan.DueDate@pre.After(60) \n\t\telse loan.DueDate = loan.DueDate@pre \n\t\tendif  \n\t\tendif ) and\n\t\tresult = true\n}",
