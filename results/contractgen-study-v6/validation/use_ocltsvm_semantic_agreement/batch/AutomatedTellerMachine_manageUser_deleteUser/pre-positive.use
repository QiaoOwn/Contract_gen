enum CardCatalog { CREDIT, DESPOSIT }
enum CardStatus { CANNEL, NORMAL, SUSPEND }

class BankCard
attributes
  CardID : Integer
  CardStatus : CardStatus
  Catalog : CardCatalog
  Password : Integer
  Balance : Real
end

class User
attributes
  UserID : Integer
  Name : String
  Address : String
end

class OperationContext
attributes
  userid : Integer
  Now : Integer
  Today : Integer
operations
