  "contract": "Contract RepairService::approve(sid: Integer,rid: Integer,reject: Boolean,suggestion: String): ApprovalHistory {\n\tdefinition:\n\t\trepair: Repair = Repair.allInstances()->any(r: Repair|r.Id = rid),\n\t\tstaff: Staff = Staff.allInstances()->any(s: Staff|s.Id = sid)\n\tprecondition:\n\t\tRepair.allInstances()->exists(r: Repair|r.Id = rid) and\n\t\tStaff.allInstances()->exists(s: Staff|s.Id = sid)\n\tpostcondition:\n\t\tlet history: ApprovalHistory in\n\t\thistory.oclIsNew() and\n\t\tApprovalHistory.allInstances()->includes(history) and\n\t\thistory.StaffId = sid and\n\t\thistory.Reject = reject and\n\t\thistory.Suggestion = suggestion and\n\t\trepair.History->includes(history) and\n\t\tif reject = true \n\t\tthen if staff.Role = 1 \n\t\tthen repair.Process = 1 \n\t\telse if staff.Role = 2 \n\t\tthen repair.Process = 2 \n\t\telse if staff.Role = 3 \n\t\tthen repair.Process = 3 \n\t\telse repair.Process = repair.Process@pre \n\t\tendif  \n\t\tendif  \n\t\tendif  \n\t\telse repair.Process = 5 \n\t\tendif  and\n\t\tresult = history\n}",
