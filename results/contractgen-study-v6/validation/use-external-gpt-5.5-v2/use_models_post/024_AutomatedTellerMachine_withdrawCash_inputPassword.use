enum CardCatalog { CREDIT, DESPOSIT }
enum CardStatus { CANNEL, NORMAL, SUSPEND }

class BankCard
attributes
  CardID : Integer
  CardStatus : CardStatus
  Catalog : CardCatalog
  Password : Integer
  Balance : Real
end

class User
attributes
  UserID : Integer
  Name : String
  Address : String
end

class OperationContext
attributes
  password : Integer
  CardIDValidated : Boolean
  DepositedNumber : Real
  InputCard : BankCard
  IsDeposit : Boolean
  IsWithdraw : Boolean
  Now : Integer
  PasswordValidated : Boolean
  Today : Integer
  WithdrawedNumber : Real
operations
  Contract_inputPassword(password : Integer) : Boolean
end

association BankCard_BelongedUser_User between
  BankCard[0..*] role BankCard_BelongedUser_Owner
  User[0..1] role BelongedUser
end

association User_OwnedCard_BankCard between
  User[0..*] role User_OwnedCard_Owner
  BankCard[0..1] role OwnedCard
end

association OperationContext_InputCard_BankCard between
  OperationContext[0..*] role ContextOwner
  BankCard[0..1] role InputCard
end

constraints

context OperationContext::Contract_inputPassword(password : Integer) : Boolean
  post inputPasswordGeneratedPost:
    if password = self.InputCard.Password 
    		then self.PasswordValidated = true and
    		result = true 
    		else self.PasswordValidated = false and
    		result = false 
    		endif
