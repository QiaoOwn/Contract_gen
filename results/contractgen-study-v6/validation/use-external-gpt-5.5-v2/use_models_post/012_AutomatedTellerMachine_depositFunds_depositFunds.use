model StrongUSE_012_AutomatedTellerMachine_depositFunds_depositFunds

-- operation_id: AutomatedTellerMachine_depositFunds_depositFunds
-- operation_signature: depositFunds(quantity: Real): Boolean
-- conversion_scope: model_context + generated definition/precondition
-- postcondition is retained as comment because USE invariants do not model operation post-state directly.

-- Generated contract:
-- Contract AutomatedTellerMachineSystem::depositFunds(quantity: Real): Boolean {
--   precondition:
--     self.CardIDValidated = true and
--     self.PasswordValidated = true and
--     self.InputCard.oclIsUndefined() = false and
--     quantity>=100.0
--   postcondition:
--     self.InputCard.Balance = self.InputCard.Balance@pre+quantity and
--     self.IsDeposit = true and
--     self.DepositedNumber = quantity and
--     result = true
-- }

enum CardCatalog { CREDIT, DESPOSIT }
enum CardStatus { CANNEL, NORMAL, SUSPEND }

class BankCard
attributes
  CardID : Integer
  CardStatus : CardStatus
  Catalog : CardCatalog
  Password : Integer
  Balance : Real
end

class User
attributes
  UserID : Integer
  Name : String
  Address : String
end

class OperationContext
attributes
  quantity : Real
  CardIDValidated : Boolean
  DepositedNumber : Real
  InputCard : BankCard
  IsDeposit : Boolean
  Now : Integer
  PasswordValidated : Boolean
  Today : Integer
operations
  Contract_depositFunds(quantity : Real) : Boolean
end

association BankCard_BelongedUser_User between
  BankCard[0..*] role BankCard_BelongedUser_Owner
  User[0..1] role BelongedUser
end

association User_OwnedCard_BankCard between
  User[0..*] role User_OwnedCard_Owner
  BankCard[0..1] role OwnedCard
end

association OperationContext_InputCard_BankCard between
  OperationContext[0..*] role ContextOwner
  BankCard[0..1] role InputCard
end

constraints

context OperationContext::Contract_depositFunds(quantity : Real) : Boolean
  post depositFundsGeneratedPost:
    self.InputCard.Balance = self.InputCard.Balance@pre+quantity and
    		self.IsDeposit = true and
    		self.DepositedNumber = quantity and
    		result = true
