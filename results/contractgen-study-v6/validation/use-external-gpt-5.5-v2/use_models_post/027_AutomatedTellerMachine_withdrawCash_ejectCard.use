enum CardCatalog { CREDIT, DESPOSIT }
enum CardStatus { CANNEL, NORMAL, SUSPEND }

class BankCard
attributes
  CardID : Integer
  CardStatus : CardStatus
  Catalog : CardCatalog
  Password : Integer
  Balance : Real
end

class User
attributes
  UserID : Integer
  Name : String
  Address : String
end

class OperationContext
attributes
  CardIDValidated : Boolean
  DepositedNumber : Real
  InputCard : Boolean
  IsDeposit : Boolean
  IsWithdraw : Boolean
  Now : Integer
  PasswordValidated : Boolean
  Today : Integer
  WithdrawedNumber : Real
  sampleIndex : Integer
operations
  Contract_ejectCard() : Boolean
end

association BankCard_BelongedUser_User between
  BankCard[0..*] role BankCard_BelongedUser_Owner
  User[0..1] role BelongedUser
end

association User_OwnedCard_BankCard between
  User[0..*] role User_OwnedCard_Owner
  BankCard[0..1] role OwnedCard
end

constraints

context OperationContext::Contract_ejectCard() : Boolean
  post ejectCardGeneratedPost:
    self.InputCard.oclIsUndefined() = true and
    		self.CardIDValidated = false and
    		self.PasswordValidated = false and
    		self.IsDeposit = false and
    		self.IsWithdraw = false and
    		self.DepositedNumber = 0.0 and
    		self.WithdrawedNumber = 0.0 and
    		result = true
