enum CardCatalog { CREDIT, DESPOSIT }
enum CardStatus { CANNEL, NORMAL, SUSPEND }

class BankCard
attributes
  CardID : Integer
  CardStatus : CardStatus
  Catalog : CardCatalog
  Password : Integer
  Balance : Real
end

class User
attributes
  UserID : Integer
  Name : String
  Address : String
end

class OperationContext
attributes
  cardid : Integer
  cardstatus : String
  catalog : String
  password : Integer
  balance : Real
  Now : Integer
  Today : Integer
operations
  Contract_createBankCard(cardid : Integer, cardstatus : String, catalog : String, password : Integer, balance : Real) : Boolean
end

association BankCard_BelongedUser_User between
  BankCard[0..*] role BankCard_BelongedUser_Owner
  User[0..1] role BelongedUser
end

association User_OwnedCard_BankCard between
  User[0..*] role User_OwnedCard_Owner
  BankCard[0..1] role OwnedCard
end

constraints

context OperationContext::Contract_createBankCard(cardid : Integer, cardstatus : String, catalog : String, password : Integer, balance : Real) : Boolean
  post createBankCardGeneratedPost:
    BankCard.allInstances()->exists(bankCard: BankCard |
          bankCard.oclIsNew() and
    		BankCard.allInstances()->includes(bankCard) and
    		bankCard.CardID = cardid and
    		bankCard.CardStatus = cardstatus and
    		bankCard.Catalog = catalog and
    		bankCard.Password = password and
    		bankCard.Balance = balance and
    		result = true)
