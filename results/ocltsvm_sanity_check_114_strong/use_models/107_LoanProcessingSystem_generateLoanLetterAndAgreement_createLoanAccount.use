end

association LoanRequest_AttachedLoanTerms_LoanTerm between
  LoanRequest[0..*] role LoanRequest_AttachedLoanTerms_Owner
  LoanTerm[*] role AttachedLoanTerms
end

constraints

context OperationContext
  inv createLoanAccountDefinitionPreconditionTypecheck:
    let loanaccountid : Integer = self.loanaccountid in
          let balance : Real = self.balance in
          let status : String = self.status in
          let existingLoanAccount : LoanAccount = LoanAccount.allInstances()->any(o|o.LoanAccountID = loanaccountid) in
          existingLoanAccount.oclIsUndefined() = true
