enum CardCatalog { CREDIT, DESPOSIT }
enum CardStatus { CANNEL, NORMAL, SUSPEND }

class BankCard
attributes
  CardID : Integer
  CardStatus : CardStatus
  Catalog : CardCatalog
  Password : Integer
  Balance : Real
end

class ManageBankCardCRUDService
end

class User
attributes
  UserID : Integer
  Name : String
  Address : String
end

class manageBankCard
end

class OperationContext
attributes
  cardid : Integer
  cardstatus : String
  catalog : String
  password : Integer
  balance : Real
end

association BankCard_BelongedUser_User between
  BankCard[0..*] role BankCard_BelongedUser_Owner
  User[0..1] role BelongedUser
end

association User_OwnedCard_BankCard between
  User[0..*] role User_OwnedCard_Owner
  BankCard[0..1] role OwnedCard
end

constraints

context OperationContext
  inv createBankCardDefinitionPreconditionTypecheck:
    let cardid : Integer = self.cardid in
          let cardstatus : String = self.cardstatus in
          let catalog : String = self.catalog in
          let password : Integer = self.password in
          let balance : Real = self.balance in
          let oldCard : BankCard = BankCard.allInstances()->any(o|o.CardID = cardid) in
          oldCard.oclIsUndefined() = true and
    		password>0 and
    		balance>=0
