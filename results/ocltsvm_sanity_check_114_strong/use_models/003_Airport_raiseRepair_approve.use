model StrongUSE_003_Airport_raiseRepair_approve

-- operation_id: Airport_raiseRepair_approve
-- operation_signature: approve(sid: Integer, rid: Integer, reject: Boolean, suggestion: String): ApprovalHistory
-- conversion_scope: model_context + generated definition/precondition
-- postcondition is retained as comment because USE invariants do not model operation post-state directly.

-- Generated contract:
-- Contract RepairService::approve(sid: Integer,rid: Integer,reject: Boolean,suggestion: String): ApprovalHistory {
--   definition:
--     repair: Repair = Repair.allInstance()->any(r|r.Id = rid),
--     staff: Staff = Staff.allInstance()->any(s|s.Id = sid),
--     nextProcess: Integer = if reject = false 
--     then 1 
--     else 0 
--     endif 
--   precondition:
--     repair.oclIsUndefined() = false and
--     staff.oclIsUndefined() = false
--   postcondition:
--     let approvalHistory: ApprovalHistory in
--     approvalHistory.oclIsNew() and
--     ApprovalHistory.allInstance()->includes(approvalHistory) and
--     repair.History->includes(approvalHistory) and
--     approvalHistory.StaffId = sid and
--     approvalHistory.Reject = reject and
--     approvalHistory.Suggestion = suggestion and
--     repair.Process = nextProcess and
--     result = approvalHistory
-- }

class ApprovalHistory
attributes
  Id : Integer
  StaffId : Integer
  Reject : Boolean
  Suggestion : String
end

class Device
attributes
  Id : Integer
  Name : String
  Location : String
end

class Repair
attributes
  Id : Integer
  Repairname : String
  Price : Integer
  Description : String
  Score : Integer
  FailTime : String
  Close : Boolean
  Process : Integer
  Result : String
end

class RepairService
end

class Staff
attributes
  Id : Integer
  Name : String
  Password : String
  Phone : String
  Role : Integer
end

class raiseRepair
end

class OperationContext
attributes
  sid : Integer
  rid : Integer
  reject : Boolean
  suggestion : String
end

association Device_Contacts_Staff between
  Device[0..*] role Device_Contacts_Owner
  Staff[0..1] role Contacts
end

association Repair_History_ApprovalHistory between
  Repair[0..*] role Repair_History_Owner
  ApprovalHistory[*] role History
end

association Repair_RelatedDevice_Device between
  Repair[0..*] role Repair_RelatedDevice_Owner
  Device[0..1] role RelatedDevice
end

association Repair_RaiseStaff_Staff between
  Repair[0..*] role Repair_RaiseStaff_Owner
  Staff[0..1] role RaiseStaff
end

association Staff_Boss_Staff between
  Staff[0..*] role Staff_Boss_Owner
  Staff[0..1] role Boss
end

constraints

context OperationContext
  inv approveDefinitionPreconditionTypecheck:
    let sid : Integer = self.sid in
          let rid : Integer = self.rid in
          let reject : Boolean = self.reject in
          let suggestion : String = self.suggestion in
          let repair : Repair = Repair.allInstances()->any(r|r.Id = rid) in
          let staff : Staff = Staff.allInstances()->any(s|s.Id = sid) in
          let nextProcess : Integer = if reject = false 
    		then 1 
    		else 0 
    		endif in
          repair.oclIsUndefined() = false and
    		staff.oclIsUndefined() = false
