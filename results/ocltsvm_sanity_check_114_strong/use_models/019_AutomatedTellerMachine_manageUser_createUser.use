enum CardCatalog { CREDIT, DESPOSIT }
enum CardStatus { CANNEL, NORMAL, SUSPEND }

class BankCard
attributes
  CardID : Integer
  CardStatus : CardStatus
  Catalog : CardCatalog
  Password : Integer
  Balance : Real
end

class ManageUserCRUDService
end

class User
attributes
  UserID : Integer
  Name : String
  Address : String
end

class manageUser
end

class OperationContext
attributes
  userid : Integer
  name : String
  address : String
end

association BankCard_BelongedUser_User between
  BankCard[0..*] role BankCard_BelongedUser_Owner
  User[0..1] role BelongedUser
end

association User_OwnedCard_BankCard between
  User[0..*] role User_OwnedCard_Owner
  BankCard[0..1] role OwnedCard
end

constraints

context OperationContext
  inv createUserDefinitionPreconditionTypecheck:
    let userid : Integer = self.userid in
          let name : String = self.name in
          let address : String = self.address in
          let user : User = User.allInstances()->any(u|u.UserID = userid) in
          user.oclIsUndefined() = true
