association OperationContext_CurrentSale_Sale between
  OperationContext[0..*] role ContextOwner
  Sale[0..1] role CurrentSale
end

constraints

context OperationContext
  inv enterItemDefinitionPreconditionTypecheck:
    let barcode : Integer = self.barcode in
          let quantity : Integer = self.quantity in
          let currentSale : Sale = self.CurrentSale in
          let item : Item = Item.allInstances()->any(o|o.Barcode = barcode) in
          quantity>0 and
    		currentSale.oclIsUndefined() = false and
    		currentSale.IsComplete = false and
    		currentSale.IsReadytoPay = false and
    		Sale.allInstances()->includes(currentSale) and
    		item.oclIsUndefined() = false
