class OperationContext
attributes
  id : Integer
  name : String
  pswd : String
  phone : String
  role : Integer
  bossid : Integer
end

association Device_Contacts_Staff between
  Device[0..*] role Device_Contacts_Owner
  Staff[0..1] role Contacts
end

association Repair_History_ApprovalHistory between
  Repair[0..*] role Repair_History_Owner
  ApprovalHistory[*] role History
end

association Repair_RelatedDevice_Device between
  Repair[0..*] role Repair_RelatedDevice_Owner
  Device[0..1] role RelatedDevice
end

association Repair_RaiseStaff_Staff between
  Repair[0..*] role Repair_RaiseStaff_Owner
  Staff[0..1] role RaiseStaff
end

association Staff_Boss_Staff between
  Staff[0..*] role Staff_Boss_Owner
  Staff[0..1] role Boss
end

constraints

context OperationContext
  inv createStaffDefinitionPreconditionTypecheck:
    let id : Integer = self.id in
          let name : String = self.name in
          let pswd : String = self.pswd in
          let phone : String = self.phone in
          let role : Integer = self.role in
          let bossid : Integer = self.bossid in
          let oldStaff : Staff = Staff.allInstances()->any(s|s.Id = id) in
          let boss : Staff = Staff.allInstances()->any(b|b.Id = bossid) in
          let hasBoss : Boolean = if boss.oclIsUndefined() = true 
    		then false 
    		else true 
    		endif in
          oldStaff.oclIsUndefined() = true and
    		(bossid<=0 or
    		hasBoss = true)
