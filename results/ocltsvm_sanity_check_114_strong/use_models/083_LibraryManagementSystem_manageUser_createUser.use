constraints

context OperationContext
  inv createUserDefinitionPreconditionTypecheck:
    let userid : String = self.userid in
          let name : String = self.name in
          let sex : String = self.sex in
          let password : String = self.password in
          let email : String = self.email in
          let faculty : String = self.faculty in
          let loanednumber : Integer = self.loanednumber in
          let borrowstatus : String = self.borrowstatus in
          let suspensiondays : Integer = self.suspensiondays in
          let overduefee : Real = self.overduefee in
          let existingUser : User = User.allInstances()->any(o|o.UserID = userid) in
          existingUser.oclIsUndefined() = true and
    		userid<>'' and
    		name<>'' and
    		password<>'' and
    		email<>'' and
    		faculty<>''
