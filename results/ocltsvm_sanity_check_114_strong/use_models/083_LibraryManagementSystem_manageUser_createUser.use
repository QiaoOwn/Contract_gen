enum BorrowStatus { NORMAL, SUSPEND }
enum CopyStatus { AVAILABLE, INPROCESSING, LIBUSEONLY, LOANED, ONHOLDSHELF }
enum Position { ASSISTANTPROFESSORS, ASSOCIATEPROFESSOR, CHAIRPROFESSOR, PROFESSOR }
enum Programme { BACHELOR, GRADUATED, MASTER, PHD, PROGRAMMING }
enum Sex { F, M }
enum Status { HASRETIRED, INPOSITION }

class Administrator
attributes
  AdminID : String
  UserName : String
  Password : String
end

class Book
attributes
  CallNo : String
  Title : String
  Edition : String
  Author : String
  Publisher : String
  Description : String
  ISBn : String
  CopyNum : Integer
end

class BookCopy
attributes
  Barcode : String
  Status : CopyStatus
  Location : String
  IsReserved : Boolean
end

class Faculty
attributes
  Position : Position
  Status : Status
end

class Librarian
attributes
  LibrarianID : String
  Name : String
  Password : String
end

class Loan
attributes
  LoanDate : String
  RenewDate : String
  DueDate : String
  ReturnDate : String
  RenewedTimes : Integer
  IsReturned : Boolean
  OverDueFee : Real
  OverDue3Days : Boolean
  OverDue10Days : Boolean
  OverDue17Days : Boolean
  OverDue31Days : Boolean
end

class ManageUserCRUDService
end

