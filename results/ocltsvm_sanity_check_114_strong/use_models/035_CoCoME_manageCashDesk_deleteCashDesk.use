constraints

context OperationContext
  inv deleteCashDeskDefinitionPreconditionTypecheck:
    let id : Integer = self.id in
          let cashDesk : CashDesk = CashDesk.allInstances()->any(o|o.Id = id) in
          let containedSales : Set(Sale) = cashDesk.ContainedSales in
          cashDesk.oclIsUndefined() = false and
    		CashDesk.allInstances()->includes(cashDesk) and
    		containedSales->isEmpty() = true
