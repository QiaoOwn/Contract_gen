Contract ManageBookCRUDService::createBook(callno:String,title:String,edition:String,author:String,publisher:String,description:String,isbn:String,copynum:Integer): Boolean {
          precondition:
          callno <> null and callno <> '' and
	title <> null and title <> '' and
	edition <> null and edition <> '' and
	author <> null and author <> '' and
	publisher <> null and publisher <> '' and
	description <> null and description <> '' and
	isbn <> null and isbn <> '' and
	copynum <> null and copynum > 0 and
	Book.allInstance()->forAll(b | b.CallNo <> callno)
            postcondition:
          (result = true implies
		Book.allInstance()->exists(b |
			b.oclIsNew() and
			b.CallNo = callno and
			b.Title = title and
			b.Edition = edition and
			b.Author = author and
			b.Publisher = publisher and
			b.Description = description and
			b.ISBn = isbn and
			b.CopyNum = copynum and
			b.Copys->isEmpty() and
			b.Subject->isEmpty()
		)
	) and
	(result = true implies Book.allInstance()->size() = Book.allInstance()->size() + 1) and
	(result = false implies Book.allInstance()->size() = Book.allInstance()->size())
            
        }