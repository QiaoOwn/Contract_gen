Contract LibraryManagementSystemSystem::borrowBook(uid:String,barcode:String): Boolean {
          precondition:
          User.allInstance()->exists(u | u.UserID = uid) and
  BookCopy.allInstance()->exists(c | c.Barcode = barcode) and
  let u : User = User.allInstance()->any(x | x.UserID = uid),
      c : BookCopy = BookCopy.allInstance()->any(x | x.Barcode = barcode)
  in
    u.BorrowStatus <> BorrowStatus::SUSPEND and
    u.LoanedNumber < 5 and
    (c.Status = CopyStatus::AVAILABLE or
     (c.IsReserved = true and c.ReservationRecord->exists(r | r.ReservedUser.UserID = uid)))
            postcondition:
          let u : User = User.allInstance()->any(x | x.UserID = uid),
      c : BookCopy = BookCopy.allInstance()->any(x | x.Barcode = barcode),
      newLoan : Loan = Loan.allInstance()->any(l |
        l.oclIsNew() and
        l.LoanedUser = u and
        l.LoanedCopy = c and
        l.IsReturned = false)
  in
    result = true and
    Loan.allInstance()->exists(l |
      l.oclIsNew() and
      l = newLoan and
      l.LoanedUser = u and
      l.LoanedCopy = c and
      l.IsReturned = false and
      l.LoanDate = Date::now() and
      l.RenewedTimes = 0 and
      l.ReturnDate.oclIsUndefined()) and
    u.LoanedBook = u.LoanedBook@pre->including(newLoan) and
    u.LoanedNumber = u.LoanedNumber@pre + 1 and
    c.LoanedRecord = c.LoanedRecord@pre->including(newLoan) and
    c.Status = CopyStatus::LOANED
            
        }