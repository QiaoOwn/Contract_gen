Contract CoCoMESystem::closeCashDesk(cashDeskID:Integer): Boolean {
          precondition:
          cashDeskID <> null and
    CashDesk.allInstance()->exists(cd | cd.Id = cashDeskID) and
    CashDesk.allInstance()->any(cd | cd.Id = cashDeskID).IsOpened = true
            postcondition:
          let cd : CashDesk = CashDesk.allInstance()->any(c | c.Id = cashDeskID) in
    cd.IsOpened = false and
    result = true and
    cd.Id = cd.Id@pre and
    cd.Name = cd.Name@pre and
    cd.BelongedStore = cd.BelongedStore@pre and
    cd.ContainedSales = cd.ContainedSales@pre and
    Store.allInstance()->forAll(s |
        s.Id = s.Id@pre and
        s.Name = s.Name@pre and
        s.Address = s.Address@pre and
        s.IsOpened = s.IsOpened@pre and
        s.AssociationCashdeskes = s.AssociationCashdeskes@pre and
        s.Productcatalogs = s.Productcatalogs@pre and
        s.Items = s.Items@pre and
        s.Cashiers = s.Cashiers@pre and
        s.Sales = s.Sales@pre
    ) and
    Cashier.allInstance()->forAll(ca |
        ca.Id = ca.Id@pre and
        ca.Name = ca.Name@pre and
        ca.WorkedStore = ca.WorkedStore@pre
    )
            
        }