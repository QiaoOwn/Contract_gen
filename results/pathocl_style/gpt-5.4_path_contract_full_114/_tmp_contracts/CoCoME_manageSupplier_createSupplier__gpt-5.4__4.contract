Contract ManageSupplierCRUDService::createSupplier(id:Integer,name:String): Boolean {
          precondition:
          id <> null and
  name <> null and
  name <> '' and
  Supplier.allInstance()->forAll(s | s.Id <> id)
            postcondition:
          (result = true implies
    Supplier.allInstance()->exists(s |
      s.oclIsNew() and
      s.Id = id and
      s.Name = name
    )
  ) and
  (result = false implies
    Supplier.allInstance()->forAll(s |
      not (s.oclIsNew() and s.Id = id and s.Name = name)
    )
  )
            
        }