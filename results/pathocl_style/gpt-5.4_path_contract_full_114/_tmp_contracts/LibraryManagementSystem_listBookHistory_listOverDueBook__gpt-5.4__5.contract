Contract ListBookHistory::listOverDueBook(uid:String): Set(BookCopy) {
          precondition:
          uid <> null and uid <> ''
            postcondition:
          result = BookCopy.allInstance()->select(bc |
    bc.LoanedRecord->exists(l |
      l.LoanedUser.oclIsUndefined() = false and
      l.LoanedUser.id = uid and
      l.IsReturned = false and
      l.OverDueFee > 0
    )
  )->asSet()
            
        }