Contract AirportSystem::createStaff(id:Integer,name:String,pswd:String,phone:String,role:Integer,bossid:Integer): Boolean {
          precondition:
          Staff.allInstance()->forAll(s | s.Id <> id)
            postcondition:
          result = true and
    Staff.allInstance()->exists(s |
        s.oclIsNew() and
        s.Id = id and
        s.Name = name and
        s.Password = pswd and
        s.Phone = phone and
        s.Role = role and
        ((Staff.allInstance()->exists(b | not b.oclIsNew() and b.Id = bossid) and s.Boss = Staff.allInstance()->any(b | not b.oclIsNew() and b.Id = bossid)) or
         (Staff.allInstance()->forAll(b | b.oclIsNew() or b.Id <> bossid) and s.Boss.oclIsUndefined()))
    ) and
    Staff.allInstance()->select(s | s.Id = id)->size() = 1
            
        }