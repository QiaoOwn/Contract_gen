Contract ProcessSaleService::makeCashPayment(amount:Real): Boolean {
          precondition:
          amount > 0 and
  CashDesk.allInstance()->exists(cd |
    cd.IsOpened = true and
    cd.ContainedSales->exists(s |
      s.oclIsUndefined() = false
    )
  )
            postcondition:
          if result = true then
    Payment.allInstance()->exists(p |
      p.AmountTendered = amount and
      p.BelongedSale.oclIsUndefined() = false and
      CashDesk.allInstance()->exists(cd |
        cd.IsOpened = true and
        cd.ContainedSales->includes(p.BelongedSale)
      ) and
      p.oclIsTypeOf(CashPayment) and
      p.oclAsType(CashPayment).Balance = amount - p.BelongedSale.Total
    )
  else
    Payment.allInstance()->forAll(p |
      not (p.AmountTendered = amount and
      p.BelongedSale.oclIsUndefined() = false and
      CashDesk.allInstance()->exists(cd |
        cd.IsOpened = true and
        cd.ContainedSales->includes(p.BelongedSale)
      ))
    )
  endif
            
        }