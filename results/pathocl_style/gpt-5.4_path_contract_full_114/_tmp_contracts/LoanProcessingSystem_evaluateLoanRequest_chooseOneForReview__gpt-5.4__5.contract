Contract EvaluateLoanRequestModule::chooseOneForReview(requestid:Integer): LoanRequest {
          precondition:
          requestid <> null and
  LoanRequest.allInstance()->exists(lr |
    lr.RequestID = requestid and
    lr.Status = LoanRequestStatus::REFERENCESVALIDATED
  )
            postcondition:
          let reviewedRequest : LoanRequest = LoanRequest.allInstance()->any(lr | lr.RequestID = requestid) in
    result = reviewedRequest and
    reviewedRequest.Status = LoanRequestStatus::READYFORREVIEW and
    LoanRequest.allInstance()->forAll(lr |
      lr.RequestID <> requestid implies lr.Status = lr.Status@pre
    )
            
        }