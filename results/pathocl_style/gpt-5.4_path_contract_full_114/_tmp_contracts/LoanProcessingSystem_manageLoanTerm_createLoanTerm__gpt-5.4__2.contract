Contract ManageLoanTermCRUDService::createLoanTerm(itemid:Integer,content:String): Boolean {
          precondition:
          itemid <> null and
    content <> null and
    LoanTerm.allInstance()->forAll(lt | lt.ItemID <> itemid)
            postcondition:
          let newLoanTerm : LoanTerm = LoanTerm.allInstance()->any(lt |
        lt.oclIsNew() and
        lt.ItemID = itemid and
        lt.Content = content
    ) in
    result = true and
    LoanTerm.allInstance()->includes(newLoanTerm) and
    LoanTerm.allInstance()->size() = LoanTerm.allInstance()->size() + 1 and
    newLoanTerm.ItemID = itemid and
    newLoanTerm.Content = content
            
        }