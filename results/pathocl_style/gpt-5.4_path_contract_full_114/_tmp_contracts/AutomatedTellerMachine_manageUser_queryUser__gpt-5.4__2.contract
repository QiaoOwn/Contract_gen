Contract ManageUserCRUDService::queryUser(userid:Integer): User {
          precondition:
          userid <> null and
  User.allInstance()->exists(u | u.UserID = userid)
            postcondition:
          result <> null and
  result.oclIsTypeOf(User) and
  result.UserID = userid and
  User.allInstance()->includes(result) and
  User.allInstance()->size() = User.allInstance()->size() and
  BankCard.allInstance()->size() = BankCard.allInstance()->size() and
  User.allInstance()->forAll(u |
    User.allInstance()->exists(up |
      up.UserID = u.UserID and
      up.Name = u.Name and
      up.Address = u.Address
    )
  ) and
  BankCard.allInstance()->forAll(b |
    BankCard.allInstance()->exists(bp |
      bp.CardID = b.CardID and
      bp.CardStatus = b.CardStatus and
      bp.Catalog = b.Catalog and
      bp.Password = b.Password and
      bp.Balance = b.Balance
    )
  )
            
        }