Contract ManageSupplierCRUDService::querySupplier(id:Integer): Supplier {
          precondition:
          id <> null and Supplier.allInstance()->exists(s | s.Id = id)
            postcondition:
          result <> null and result.Id = id and
	Supplier.allInstance()->includes(result) and
	Supplier.allInstance()->size() = Supplier.allInstance()->size() and
	OrderProduct.allInstance()->forAll(op |
		op.Supplier = op.Supplier@pre and
		op.Id = op.Id@pre and
		op.Time = op.Time@pre and
		op.OrderStatus = op.OrderStatus@pre and
		op.Amount = op.Amount@pre
	)
            
        }