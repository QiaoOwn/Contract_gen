Contract ManageItemCRUDService::modifyItem(barcode:Integer,name:String,price:Real,stocknumber:Integer,orderprice:Real): Boolean {
          precondition:
          not barcode.oclIsUndefined() and
    not name.oclIsUndefined() and
    name <> '' and
    not price.oclIsUndefined() and
    not stocknumber.oclIsUndefined() and
    not orderprice.oclIsUndefined() and
    price >= 0 and
    stocknumber >= 0 and
    orderprice >= 0 and
    Item.allInstance()->exists(i | i.Barcode = barcode)
            postcondition:
          let item : Item = Item.allInstance()->any(i | i.Barcode = barcode) in
    item.Name = name and
    item.Price = price and
    item.StockNumber = stocknumber and
    item.OrderPrice = orderprice and
    item.Barcode = barcode and
    result = true
            
        }