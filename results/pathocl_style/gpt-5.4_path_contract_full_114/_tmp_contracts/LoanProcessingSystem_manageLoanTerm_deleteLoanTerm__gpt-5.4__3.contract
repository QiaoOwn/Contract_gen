Contract ManageLoanTermCRUDService::deleteLoanTerm(itemid:Integer): Boolean {
          precondition:
          itemid <> null and
  LoanTerm.allInstance()->exists(lt | lt.ItemID = itemid)
            postcondition:
          let deletedLoanTerm : Set(LoanTerm) = LoanTerm.allInstance()->select(lt | lt.ItemID = itemid) in
  result = true and
  LoanTerm.allInstance()->forAll(lt | lt.ItemID <> itemid) and
  LoanRequest.allInstance()->forAll(lr |
    lr.AttachedLoanTerms = lr.AttachedLoanTerms@pre->excludingAll(deletedLoanTerm)
  )
            
        }