Contract ManageCashDeskCRUDService::queryCashDesk(id:Integer): CashDesk {
          precondition:
          id <> null and CashDesk.allInstance()->exists(c | c.Id = id)
            postcondition:
          result <> null and
	result.oclIsTypeOf(CashDesk) and
	result.Id = id and
	CashDesk.allInstance()->one(c | c.Id = id and c = result) and
	CashDesk.allInstance()->size() = CashDesk.allInstance()->size() and
	Store.allInstance()->size() = Store.allInstance()->size() and
	Cashier.allInstance()->size() = Cashier.allInstance()->size() and
	ProductCatalog.allInstance()->size() = ProductCatalog.allInstance()->size()
            
        }