Contract AutomatedTellerMachineSystem::printReceipt(): Real {
          precondition:
          true
            postcondition:
          result = 0 and
    BankCard.allInstance()->forAll(c |
        BankCard.allInstance()->exists(d |
            c = d and
            c.CardID = d.CardID and
            c.CardStatus = d.CardStatus and
            c.Catalog = d.Catalog and
            c.Password = d.Password and
            c.Balance = d.Balance and
            c.BelongedUser = d.BelongedUser
        )
    ) and
    User.allInstance()->forAll(u |
        User.allInstance()->exists(v |
            u = v and
            u.UserID = v.UserID and
            u.Name = v.Name and
            u.Address = v.Address and
            u.OwnedCard = v.OwnedCard
        )
    )
            
        }