Contract ManageItemCRUDService::modifyItem(barcode:Integer,name:String,price:Real,stocknumber:Integer,orderprice:Real): Boolean {
          precondition:
          not barcode.oclIsUndefined() and
    not name.oclIsUndefined() and
    name <> '' and
    not price.oclIsUndefined() and
    not stocknumber.oclIsUndefined() and
    not orderprice.oclIsUndefined() and
    price >= 0 and
    stocknumber >= 0 and
    orderprice >= 0 and
    Store.allInstance()->exists(s |
        s.Items->exists(i | i.Barcode = barcode)
    )
            postcondition:
          if result = true then
        Store.allInstance()->exists(s |
            s.Items->exists(i |
                i.Barcode = barcode and
                i.Name = name and
                i.Price = price and
                i.StockNumber = stocknumber and
                i.OrderPrice = orderprice
            )
        ) and
        Store.allInstance()->forAll(s |
            s.Items->select(i | i.Barcode = barcode)->size() = 1
        )
    else
        Store.allInstance()->forAll(s |
            s.Items = s.Items@pre and
            s.Items->forAll(i |
                i.Barcode = barcode implies
                i.Name = i.Name@pre and
                i.Price = i.Price@pre and
                i.StockNumber = i.StockNumber@pre and
                i.OrderPrice = i.OrderPrice@pre
            )
        )
    endif
            
        }