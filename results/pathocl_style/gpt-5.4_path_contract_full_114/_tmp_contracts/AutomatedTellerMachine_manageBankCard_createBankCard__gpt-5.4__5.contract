Contract ManageBankCardCRUDService::createBankCard(cardid:Integer,cardstatus:CardStatus[NORMAL|SUSPEND|CANCEL],catalog:CardCatalog[CREDIT|DEPOSIT],password:Integer,balance:Real): Boolean {
          precondition:
          cardid <> null and
cardstatus <> null and
catalog <> null and
password <> null and
balance <> null and
BankCard.allInstance()->forAll(b | b.CardID <> cardid)
            postcondition:
          if result = true then
  BankCard.allInstance()->exists(b |
    b.oclIsNew() and
    b.CardID = cardid and
    b.CardStatus = cardstatus and
    b.Catalog = catalog and
    b.Password = password and
    b.Balance = balance
  ) and
  BankCard.allInstance()->size() = BankCard.allInstance()->size() + 1
else
  BankCard.allInstance()->size() = BankCard.allInstance()->size()
endif
            
        }