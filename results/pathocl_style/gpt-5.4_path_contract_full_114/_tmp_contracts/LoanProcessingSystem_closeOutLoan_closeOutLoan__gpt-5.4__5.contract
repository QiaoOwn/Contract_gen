Contract LoanProcessingSystemSystem::closeOutLoan(loanid:Integer): Boolean {
          precondition:
          loanid <> null and
    Loan.allInstance()->exists(l | l.LoanID = loanid) and
    Loan.allInstance()->any(l | l.LoanID = loanid).Status = LoanStatus::LSOPEN and
    Loan.allInstance()->any(l | l.LoanID = loanid).RemainAmountToPay = 0 and
    Loan.allInstance()->any(l | l.LoanID = loanid).IsPaidinFull = true
            postcondition:
          let loan : Loan = Loan.allInstance()->any(l | l.LoanID = loanid) in
    result = true and
    loan.Status = LoanStatus::CLOSED and
    loan.IsPaidinFull = true and
    loan.RemainAmountToPay = 0 and
    loan.BelongedLoanAccount.Status = LoanAccountStatus::HASPAIDINFULL and
    loan.BelongedLoanAccount.Balance = loan.BelongedLoanAccount.Balance@pre and
    loan.ReferedLoanRequest = loan.ReferedLoanRequest@pre and
    loan.BelongedLoanAccount = loan.BelongedLoanAccount@pre and
    Loan.allInstance()->excluding(loan)->forAll(l |
        l.oclIsNew() = false and
        l.LoanID = l.LoanID@pre and
        l.RemainAmountToPay = l.RemainAmountToPay@pre and
        l.Status = l.Status@pre and
        l.IsPaidinFull = l.IsPaidinFull@pre and
        l.StartDate = l.StartDate@pre and
        l.EndDate = l.EndDate@pre and
        l.CurrentOverDueDate = l.CurrentOverDueDate@pre and
        l.RePaymentDays = l.RePaymentDays@pre and
        l.RepaymentAmount = l.RepaymentAmount@pre and
        l.ReferedLoanRequest = l.ReferedLoanRequest@pre and
        l.BelongedLoanAccount = l.BelongedLoanAccount@pre
    )
            
        }