Contract ManageStoreCRUDService::queryStore(id:Integer): Store {
          precondition:
          id <> null and Store.allInstance()->exists(s | s.Id = id)
            postcondition:
          result <> null and
	result.Id = id and
	Store.allInstance()->includes(result) and
	Store.allInstance()->exists(s | s = result and
		s.Id = id and
		s.Name = result.Name and
		s.Address = result.Address and
		s.IsOpened = result.IsOpened and
		s.AssociationCashdeskes = result.AssociationCashdeskes and
		s.Productcatalogs = result.Productcatalogs and
		s.Cashiers = result.Cashiers
	)
            
        }