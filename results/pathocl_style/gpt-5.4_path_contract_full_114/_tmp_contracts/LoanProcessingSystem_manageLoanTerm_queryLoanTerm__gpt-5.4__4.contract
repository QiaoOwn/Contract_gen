Contract ManageLoanTermCRUDService::queryLoanTerm(itemid:Integer): LoanTerm {
          precondition:
          itemid <> null and LoanTerm.allInstance()->exists(lt | lt.ItemID = itemid)
            postcondition:
          result <> null and
	result.ItemID = itemid and
	LoanTerm.allInstance()->exists(lt | lt = result and lt.ItemID = itemid)
            
        }