Contract ManageProductCatalogCRUDService::createProductCatalog(id:Integer,name:String): Boolean {
          precondition:
          id <> null and
    name <> null and
    name <> '' and
    ProductCatalog.allInstance()->forAll(pc | pc.Id <> id)
            postcondition:
          let newCatalog : Set(ProductCatalog) = ProductCatalog.allInstance()->excludingAll(ProductCatalog.allInstance()) in
    result = true and
    newCatalog->size() = 1 and
    let pc : ProductCatalog = newCatalog->any(true) in
        pc.Id = id and
        pc.Name = name and
        pc.ContainedItems->isEmpty()
            
        }