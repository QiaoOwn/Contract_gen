Contract CoCoMESystem::changePrice(barcode:Integer,newPrice:Real): Boolean {
          precondition:
          barcode <> null and
    newPrice <> null and
    newPrice >= 0 and
    Store.allInstance()->exists(s | s.Items->exists(i | i.Barcode = barcode))
            postcondition:
          if Store.allInstance()->exists(s | s.Items->exists(i | i.Barcode = barcode)) and newPrice >= 0 then
        result = true and
        Store.allInstance()->forAll(s |
            s.Items->forAll(i |
                if i.Barcode = barcode then
                    i.Price = newPrice
                else
                    i.Price = i.Price@pre
                endif
            )
        ) and
        Store.allInstance()->forAll(s |
            s.Items->forAll(i |
                i.Barcode = barcode or
                (i.Barcode = i.Barcode@pre and
                 i.Name = i.Name@pre and
                 i.StockNumber = i.StockNumber@pre and
                 i.OrderPrice = i.OrderPrice@pre and
                 i.BelongedCatalog = i.BelongedCatalog@pre)
            )
        )
    else
        result = false and
        Store.allInstance()->forAll(s |
            s.Items->forAll(i |
                i.Barcode = i.Barcode@pre and
                i.Name = i.Name@pre and
                i.Price = i.Price@pre and
                i.StockNumber = i.StockNumber@pre and
                i.OrderPrice = i.OrderPrice@pre and
                i.BelongedCatalog = i.BelongedCatalog@pre
            )
        )
    endif
            
        }