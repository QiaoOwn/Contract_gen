Contract CoCoMESystem::closeStore(storeID:Integer): Boolean {
          precondition:
          Store.allInstance()->exists(s | s.Id = storeID and s.IsOpened = true)
            postcondition:
          let s : Store = Store.allInstance()->any(st | st.Id = storeID) in
result = true and
s.IsOpened = false and
s.AssociationCashdeskes->forAll(cd | cd.IsOpened = false)
            
        }