Contract CoCoMEOrderProducts::orderItem(barcode:Integer,quantity:Integer): Boolean {
          precondition:
          barcode <> null and
  quantity <> null and
  quantity > 0 and
  Store.allInstance()->exists(s |
    s.Items->exists(i | i.Barcode = barcode)
  )
            postcondition:
          let matchedItem : Item = Item.allInstance()->any(i | i.Barcode = barcode) in
  let matchedStore : Store = Store.allInstance()->any(s | s.Items->includes(matchedItem)) in
    result = true and
    OrderEntry.allInstance()->exists(oe |
      oe.Item = matchedItem and
      oe.Quantity = quantity and
      oe.SubAmount = matchedItem.OrderPrice * quantity
    ) and
    matchedStore.Items->includes(matchedItem) and
    matchedItem.Barcode = barcode and
    matchedItem.StockNumber = matchedItem.StockNumber@pre
            
        }