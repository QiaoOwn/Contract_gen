Contract ManageSupplierCRUDService::querySupplier(id:Integer): Supplier {
          precondition:
          id <> null and Supplier.allInstance()->exists(s | s.Id = id)
            postcondition:
          result <> null and
    result.Id = id and
    Supplier.allInstance()->includes(result) and
    Supplier.allInstance()->size() = Supplier.allInstance()->size()
            
        }