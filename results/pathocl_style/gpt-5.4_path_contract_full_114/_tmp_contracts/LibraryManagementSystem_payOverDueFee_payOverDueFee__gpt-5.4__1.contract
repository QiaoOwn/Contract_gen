Contract LibraryManagementSystemSystem::payOverDueFee(uid:String,fee:Real): Boolean {
          precondition:
          uid <> null and uid <> '' and
  fee <> null and fee > 0 and
  User.allInstance()->exists(u | u.UserID = uid) and
  User.allInstance()->any(u | u.UserID = uid).OverDueFee >= fee
            postcondition:
          let u : User = User.allInstance()->any(x | x.UserID = uid) in
    u.OverDueFee = u.OverDueFee@pre - fee and
    u.OverDueFee >= 0 and
    (if u.OverDueFee = 0 then
       u.BorrowStatus = BorrowStatus::NORMAL and u.SuspensionDays = 0
     else
       u.BorrowStatus = u.BorrowStatus@pre and u.SuspensionDays = u.SuspensionDays@pre
     endif) and
    result = true
            
        }