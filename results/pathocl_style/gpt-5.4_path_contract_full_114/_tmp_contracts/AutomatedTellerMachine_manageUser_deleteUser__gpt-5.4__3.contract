Contract ManageUserCRUDService::deleteUser(userid:Integer): Boolean {
          precondition:
          userid <> null and
  User.allInstance()->exists(u | u.UserID = userid)
            postcondition:
          let deletedUsers : Set(User) = User.allInstance()->select(u | u.UserID = userid) in
  let affectedCards : Set(BankCard) = BankCard.allInstance()->select(c | deletedUsers->includes(c.BelongedUser)) in
  deletedUsers->forAll(u | not User.allInstance()->includes(u)) and
  affectedCards->forAll(c | not BankCard.allInstance()->includes(c)) and
  BankCard.allInstance()->forAll(c | not deletedUsers->includes(c.BelongedUser)) and
  result = true
            
        }