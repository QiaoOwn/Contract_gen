Contract LibraryManagementSystemSystem::payOverDueFee(uid:String,fee:Real): Boolean {
          precondition:
          uid <> null and uid <> '' and
  fee <> null and fee > 0 and
  User.allInstance()->exists(u | u.UserID = uid) and
  let u : User = User.allInstance()->any(x | x.UserID = uid) in
    u.OverDueFee >= fee
            postcondition:
          let u : User = User.allInstance()->any(x | x.UserID = uid) in
    u.OverDueFee = u.OverDueFee@pre - fee and
    u.OverDueFee >= 0 and
    u.UserID = u.UserID@pre and
    u.Name = u.Name@pre and
    u.Sex = u.Sex@pre and
    u.Password = u.Password@pre and
    u.Email = u.Email@pre and
    u.Faculty = u.Faculty@pre and
    u.LoanedNumber = u.LoanedNumber@pre and
    u.BorrowStatus = u.BorrowStatus@pre and
    u.SuspensionDays = u.SuspensionDays@pre and
    u.LoanedBook = u.LoanedBook@pre and
    u.ReservedBook = u.ReservedBook@pre and
    u.RecommendedBook = u.RecommendedBook@pre and
    result = true
            
        }