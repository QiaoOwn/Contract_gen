Contract ListBookHistory::listRecommendBook(uid:String): Set(RecommendBook) {
          precondition:
          uid <> null and
  uid <> '' and
  User.allInstance()->exists(u | u.UserID = uid)
            postcondition:
          result = User.allInstance()->any(u | u.UserID = uid).RecommendedBook and
  User.allInstance()->forAll(u |
    u.UserID = uid implies result = u.RecommendedBook
  ) and
  RecommendBook.allInstance()->isEqual(RecommendBook.allInstance()) and
  User.allInstance()->isEqual(User.allInstance()) and
  Book.allInstance()->isEqual(Book.allInstance()) and
  BookCopy.allInstance()->isEqual(BookCopy.allInstance())
            
        }