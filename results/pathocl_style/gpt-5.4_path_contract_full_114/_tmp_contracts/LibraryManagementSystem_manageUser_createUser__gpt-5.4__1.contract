Contract ManageUserCRUDService::createUser(userid:String,name:String,sex:Sex [M|F],password:String,email:String,faculty:String,loanednumber:Integer,borrowstatus:BorrowStatus [NORMAL|SUSPEND],suspensiondays:Integer,overduefee:Real): Boolean {
          precondition:
          userid <> null and userid <> '' and
    name <> null and name <> '' and
    sex <> null and
    password <> null and password <> '' and
    email <> null and email <> '' and
    faculty <> null and faculty <> '' and
    loanednumber >= 0 and
    borrowstatus <> null and
    suspensiondays >= 0 and
    overduefee >= 0 and
    User.allInstance()->forAll(u | u.UserID <> userid)
            postcondition:
          if result = true then
        User.allInstance()->exists(u |
            u.oclIsNew() and
            u.UserID = userid and
            u.Name = name and
            u.Sex = sex and
            u.Password = password and
            u.Email = email and
            u.Faculty = faculty and
            u.LoanedNumber = loanednumber and
            u.BorrowStatus = borrowstatus and
            u.SuspensionDays = suspensiondays and
            u.OverDueFee = overduefee and
            u.LoanedBook->isEmpty() and
            User.allInstance()->one(x | x = u)
        ) and
        User.allInstance()->size() = User.allInstance()->size() + 1
    else
        User.allInstance() = User.allInstance()
    endif
            
        }