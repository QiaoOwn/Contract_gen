Contract CoCoMEOrderProducts::chooseSupplier(supplierID:Integer): Boolean {
          precondition:
          supplierID.oclIsUndefined() = false and
    Supplier.allInstance()->exists(s | s.Id = supplierID)
            postcondition:
          result = true and
    Supplier.allInstance()->exists(s | s.Id = supplierID)
            
        }