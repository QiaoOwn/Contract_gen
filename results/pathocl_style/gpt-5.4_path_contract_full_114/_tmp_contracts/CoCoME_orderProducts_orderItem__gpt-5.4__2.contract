Contract CoCoMEOrderProducts::orderItem(barcode:Integer,quantity:Integer): Boolean {
          precondition:
          barcode <> null and
  quantity <> null and
  quantity > 0 and
  Store.allInstance()->exists(s |
    s.Items->exists(i | i.Barcode = barcode)
  )
            postcondition:
          if Store.allInstance()->exists(s | s.Items->exists(i | i.Barcode = barcode)) and quantity > 0 then
    result = true and
    OrderEntry.allInstance()->exists(oe |
      oe.Quantity = quantity and
      oe.Item.Barcode = barcode and
      oe.SubAmount = oe.Item.OrderPrice * quantity
    )
  else
    result = false
  endif
            
        }