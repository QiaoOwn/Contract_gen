Contract LibraryManagementSystemSystem::payOverDueFee(uid:String,fee:Real): Boolean {
          precondition:
          uid <> null and uid <> '' and
  fee <> null and fee > 0 and
  User.allInstance()->exists(u | u.UserID = uid) and
  let u : User = User.allInstance()->any(x | x.UserID = uid) in
    u.OverDueFee >= fee
            postcondition:
          let u : User = User.allInstance()->any(x | x.UserID = uid) in
    (
      result = true and
      u.OverDueFee = u.OverDueFee@pre - fee and
      u.LoanedNumber = u.LoanedNumber@pre and
      u.BorrowStatus = u.BorrowStatus@pre and
      u.SuspensionDays = u.SuspensionDays@pre and
      u.LoanedBook->forAll(l |
        l.OverDueFee = l.OverDueFee@pre and
        l.IsReturned = l.IsReturned@pre and
        l.OverDue3Days = l.OverDue3Days@pre and
        l.OverDue10Days = l.OverDue10Days@pre and
        l.OverDue17Days = l.OverDue17Days@pre and
        l.OverDue31Days = l.OverDue31Days@pre
      ) and
      User.allInstance()->forAll(x | x <> u implies
        x.UserID = x.UserID@pre and
        x.Name = x.Name@pre and
        x.Sex = x.Sex@pre and
        x.Password = x.Password@pre and
        x.Email = x.Email@pre and
        x.Faculty = x.Faculty@pre and
        x.LoanedNumber = x.LoanedNumber@pre and
        x.BorrowStatus = x.BorrowStatus@pre and
        x.SuspensionDays = x.SuspensionDays@pre and
        x.OverDueFee = x.OverDueFee@pre
      )
    )
            
        }