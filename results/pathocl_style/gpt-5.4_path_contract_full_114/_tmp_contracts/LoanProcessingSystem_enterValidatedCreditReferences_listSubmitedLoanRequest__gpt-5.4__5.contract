Contract EnterValidatedCreditReferencesModule::listSubmitedLoanRequest(): Set(LoanRequest) {
          precondition:
          true
            postcondition:
          result = LoanRequest.allInstance()->select(lr | lr.Status = LoanRequestStatus::SUBMITTED)->asSet() and
  LoanRequest.allInstance() = LoanRequest.allInstance() and
  Loan.allInstance() = Loan.allInstance() and
  CheckingAccount.allInstance() = CheckingAccount.allInstance() and
  CreditHistory.allInstance() = CreditHistory.allInstance()
            
        }