Contract ManageLoanTermCRUDService::createLoanTerm(itemid:Integer,content:String): Boolean {
          precondition:
          itemid > 0 and
  content <> null and
  content <> '' and
  LoanTerm.allInstance()->forAll(lt | lt.ItemID <> itemid)
            postcondition:
          (result = true implies
    LoanTerm.allInstance()->exists(lt |
      lt.oclIsNew() and
      lt.ItemID = itemid and
      lt.Content = content
    )
  ) and
  (result = true implies
    LoanTerm.allInstance()->one(lt | lt.ItemID = itemid)
  ) and
  (result = false implies
    LoanTerm.allInstance()->forAll(lt |
      not (lt.oclIsNew() and lt.ItemID = itemid and lt.Content = content)
    )
  )
            
        }