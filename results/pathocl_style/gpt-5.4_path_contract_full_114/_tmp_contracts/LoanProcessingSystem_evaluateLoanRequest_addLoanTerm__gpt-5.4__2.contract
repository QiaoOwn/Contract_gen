Contract EvaluateLoanRequestModule::addLoanTerm(termid:Integer): Boolean {
          precondition:
          termid <> null and
  LoanTerm.allInstance()->exists(t | t.ItemID = termid) and
  LoanRequest.allInstance()->exists(lr |
    lr.Status = LoanRequestStatus::APPROVED and
    not lr.AttachedLoanTerms->exists(t | t.ItemID = termid)
  )
            postcondition:
          let term : LoanTerm = LoanTerm.allInstance()->any(t | t.ItemID = termid) in
  let targetRequests : Set(LoanRequest) = LoanRequest.allInstance()->select(lr |
    lr.Status = LoanRequestStatus::APPROVED and
    not lr.AttachedLoanTerms@pre->includes(term)
  ) in
  result = true and
  LoanRequest.allInstance()->forAll(lr |
    if targetRequests->includes(lr) then
      lr.AttachedLoanTerms = lr.AttachedLoanTerms@pre->including(term)
    else
      lr.AttachedLoanTerms = lr.AttachedLoanTerms@pre
    endif
  )
            
        }