Contract EvaluateLoanRequestModule::reviewCheckingAccount(): CheckingAccount {
          precondition:
          CheckingAccount.allInstance()->exists(ca |
    ca.Balance <> null and
    ca.Status <> null and
    ca.Status = Status::GOODSTANDING
  )
            postcondition:
          result <> null and
  result.oclIsTypeOf(CheckingAccount) and
  result.Balance = result.Balance@pre and
  result.Status = result.Status@pre and
  result.Status = Status::GOODSTANDING
            
        }