Contract AutomatedTellerMachineSystem::printReceipt(): Real {
          precondition:
          BankCard.allInstance()->exists(c | c.BelongedUser <> null and c.CardStatus <> null and c.Catalog <> null)
            postcondition:
          BankCard.allInstance()->forAll(c |
        c.CardID = c.CardID and
        c.CardStatus = c.CardStatus and
        c.Catalog = c.Catalog and
        c.Password = c.Password and
        c.Balance = c.Balance and
        c.BelongedUser = c.BelongedUser
    ) and
    User.allInstance()->forAll(u |
        u.UserID = u.UserID and
        u.Name = u.Name and
        u.Address = u.Address and
        u.OwnedCard = u.OwnedCard
    ) and
    result = 0.0
            
        }