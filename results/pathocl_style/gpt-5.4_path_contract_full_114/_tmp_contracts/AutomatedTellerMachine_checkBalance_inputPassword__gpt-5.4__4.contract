Contract AutomatedTellerMachineSystem::inputPassword(password:Integer): Boolean {
          precondition:
          password <> null and
  BankCard.allInstance()->exists(c | c.Password = password and c.CardStatus = CardStatus::NORMAL)
            postcondition:
          result = BankCard.allInstance()->exists(c | c.Password = password and c.CardStatus = CardStatus::NORMAL)
            
        }