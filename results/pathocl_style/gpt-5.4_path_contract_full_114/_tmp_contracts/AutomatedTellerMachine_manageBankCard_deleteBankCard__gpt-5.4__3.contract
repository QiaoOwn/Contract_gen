Contract ManageBankCardCRUDService::deleteBankCard(cardid:Integer): Boolean {
          precondition:
          cardid <> null and
  BankCard.allInstance()->exists(c | c.CardID = cardid)
            postcondition:
          let deletedCard : Set(BankCard) = BankCard.allInstance()->select(c | c.CardID = cardid) in
  result = true and
  deletedCard->forAll(c |
    not BankCard.allInstance()->includes(c) and
    c.BelongedUser <> null implies
      c.BelongedUser.OwnedCard = c.BelongedUser.OwnedCard@pre->excluding(c)
  ) and
  BankCard.allInstance()->size() = BankCard.allInstance()->size() - deletedCard->size()
            
        }