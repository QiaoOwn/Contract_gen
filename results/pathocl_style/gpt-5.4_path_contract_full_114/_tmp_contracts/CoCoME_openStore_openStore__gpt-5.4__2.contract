Contract CoCoMESystem::openStore(storeID:Integer): Boolean {
          precondition:
          Store.allInstance()->exists(s | s.Id = storeID and s.IsOpened = false)
            postcondition:
          let st : Store = Store.allInstance()->any(s | s.Id = storeID) in
    st.IsOpened = true and
    st.AssociationCashdeskes->forAll(cd | cd.IsOpened = false) and
    result = true
            
        }