Contract ManageUserCRUDService::createUser(userid:Integer,name:String,address:String): Boolean {
          precondition:
          userid.oclIsUndefined() = false and
    name.oclIsUndefined() = false and
    address.oclIsUndefined() = false and
    User.allInstance()->forAll(u | u.UserID <> userid)
            postcondition:
          (result = true implies
        User.allInstance()->exists(u |
            u.UserID = userid and
            u.Name = name and
            u.Address = address and
            u.OwnedCard->isEmpty()
        )
    ) and
    User.allInstance()->forAll(u1, u2 | u1 <> u2 implies u1.UserID <> u2.UserID)
            
        }