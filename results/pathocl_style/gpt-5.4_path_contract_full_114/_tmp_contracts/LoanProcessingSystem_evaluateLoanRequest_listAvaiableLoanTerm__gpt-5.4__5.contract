Contract EvaluateLoanRequestModule::listAvaiableLoanTerm(): Set(LoanTerm) {
          precondition:
          true
            postcondition:
          result = LoanTerm.allInstance()->asSet() and
	LoanTerm.allInstance()->forAll(lt |
		lt.ItemID = lt.ItemID and
		lt.Content = lt.Content
	) and
	LoanRequest.allInstance()->forAll(lr |
		lr.Status = lr.Status and
		lr.RequestID = lr.RequestID and
		lr.Name = lr.Name and
		lr.LoanAmount = lr.LoanAmount and
		lr.LoanPurpose = lr.LoanPurpose and
		lr.Income = lr.Income and
		lr.PhoneNumber = lr.PhoneNumber and
		lr.PostalAddress = lr.PostalAddress and
		lr.ZipCode = lr.ZipCode and
		lr.Email = lr.Email and
		lr.WorkReferences = lr.WorkReferences and
		lr.CreditReferences = lr.CreditReferences and
		lr.CheckingAccountNumber = lr.CheckingAccountNumber and
		lr.SecurityNumber = lr.SecurityNumber and
		lr.CreditScore = lr.CreditScore and
		lr.ApprovalLoan = lr.ApprovalLoan and
		lr.RequestedCAHistory = lr.RequestedCAHistory and
		lr.RequestedCreditHistory = lr.RequestedCreditHistory and
		lr.AttachedApprovalLetter = lr.AttachedApprovalLetter and
		lr.AttachedLoanAgreement = lr.AttachedLoanAgreement and
		lr.AttachedLoanTerms = lr.AttachedLoanTerms
	) and
	Loan.allInstance()->forAll(l |
		l.LoanID = l.LoanID and
		l.RemainAmountToPay = l.RemainAmountToPay and
		l.Status = l.Status and
		l.IsPaidinFull = l.IsPaidinFull and
		l.StartDate = l.StartDate and
		l.EndDate = l.EndDate and
		l.CurrentOverDueDate = l.CurrentOverDueDate and
		l.RePaymentDays = l.RePaymentDays and
		l.RepaymentAmount = l.RepaymentAmount and
		l.ReferedLoanRequest = l.ReferedLoanRequest and
		l.BelongedLoanAccount = l.BelongedLoanAccount
	) and
	LoanAccount.allInstance()->forAll(la |
		la.LoanAccountID = la.LoanAccountID and
		la.Balance = la.Balance and
		la.Status = la.Status
	)
            
        }