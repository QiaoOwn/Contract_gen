Contract CoCoMESystem::changePrice(barcode:Integer,newPrice:Real): Boolean {
          precondition:
          barcode <> null and
    newPrice <> null and
    newPrice >= 0 and
    Store.allInstance()->exists(s | s.Items->exists(i | i.Barcode = barcode))
            postcondition:
          let changedItems : Set(Item) = Item.allInstance()->select(i | i.Barcode = barcode) in
    if changedItems->notEmpty() then
        changedItems->forAll(i | i.Price = newPrice) and
        Item.allInstance()->select(i | i.Barcode <> barcode)->forAll(i | i.Price = i.Price@pre) and
        result = true
    else
        Item.allInstance()->forAll(i | i.Price = i.Price@pre) and
        result = false
    endif
            
        }