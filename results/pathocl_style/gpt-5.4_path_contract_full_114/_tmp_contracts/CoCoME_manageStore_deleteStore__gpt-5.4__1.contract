Contract ManageStoreCRUDService::deleteStore(id:Integer): Boolean {
          precondition:
          id <> null and
  Store.allInstance()->exists(s | s.Id = id)
            postcondition:
          let deletedStore : Set(Store) = Store.allInstance()->select(s | s.Id = id) in
  deletedStore->size() = 1 and
  Store.allInstance()->forAll(s | s.Id <> id) and
  CashDesk.allInstance()->forAll(cd | deletedStore->forAll(ds | cd.BelongedStore <> ds)) and
  Cashier.allInstance()->forAll(c | deletedStore->forAll(ds | c.WorkedStore <> ds)) and
  result = true
            
        }