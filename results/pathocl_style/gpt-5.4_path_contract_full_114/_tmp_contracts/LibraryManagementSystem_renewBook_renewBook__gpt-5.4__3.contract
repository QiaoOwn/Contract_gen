Contract LibraryManagementSystemSystem::renewBook(uid:String,barcode:String): Boolean {
          precondition:
          uid <> null and uid <> '' and
  barcode <> null and barcode <> '' and
  BookCopy.allInstance()->exists(b | b.Barcode = barcode) and
  BookCopy.allInstance()->any(b | b.Barcode = barcode).Status = CopyStatus::LOANED
            postcondition:
          let copy : BookCopy = BookCopy.allInstance()->any(b | b.Barcode = barcode) in
  result = true and
  copy.oclIsUndefined() = false and
  copy.Barcode = barcode and
  copy.Status = CopyStatus::LOANED and
  copy.BookBelongs = copy.BookBelongs@pre and
  copy.Location = copy.Location@pre and
  copy.IsReserved = copy.IsReserved@pre
            
        }