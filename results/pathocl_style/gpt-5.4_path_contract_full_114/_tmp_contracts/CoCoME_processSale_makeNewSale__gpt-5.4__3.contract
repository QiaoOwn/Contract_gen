Contract ProcessSaleService::makeNewSale(): Boolean {
          precondition:
          Store.allInstance()->exists(s |
        s.IsOpened = true and
        s.AssociationCashdeskes->exists(cd |
            cd.IsOpened = true and
            cd.BelongedStore = s
        )
    )
            postcondition:
          result = true and
    Sale.allInstance()->exists(ns |
        ns.oclIsNew() and
        ns.IsComplete = false and
        ns.IsReadytoPay = false and
        ns.Amount = 0 and
        ns.ContainedSalesLine->isEmpty() and
        ns.AssoicatedPayment.oclIsUndefined() and
        ns.Belongedstore.IsOpened = true and
        ns.BelongedCashDesk.IsOpened = true and
        ns.BelongedCashDesk.BelongedStore = ns.Belongedstore and
        ns.Belongedstore.Sales->includes(ns) and
        ns.BelongedCashDesk.ContainedSales->includes(ns)
    )
            
        }