Contract EnterValidatedCreditReferencesModule::chooseLoanRequest(requestid:Integer): LoanRequest {
          precondition:
          requestid <> null and
  LoanRequest.allInstance()->exists(lr |
    lr.RequestID = requestid and
    lr.Status = LoanRequestStatus::REFERENCESVALIDATED
  )
            postcondition:
          result <> null and
  result.oclIsTypeOf(LoanRequest) and
  result.RequestID = requestid and
  result.Status = LoanRequestStatus::REFERENCESVALIDATED and
  LoanRequest.allInstance()->includes(result) and
  LoanRequest.allInstance()->forAll(lr |
    lr.oclIsNew() = false and
    lr.RequestID = lr@RequestPre.RequestID and
    lr.Status = lr@RequestPre.Status and
    lr.Name = lr@RequestPre.Name and
    lr.LoanAmount = lr@RequestPre.LoanAmount and
    lr.LoanPurpose = lr@RequestPre.LoanPurpose and
    lr.Income = lr@RequestPre.Income and
    lr.PhoneNumber = lr@RequestPre.PhoneNumber and
    lr.PostalAddress = lr@RequestPre.PostalAddress and
    lr.ZipCode = lr@RequestPre.ZipCode and
    lr.Email = lr@RequestPre.Email and
    lr.WorkReferences = lr@RequestPre.WorkReferences and
    lr.CreditReferences = lr@RequestPre.CreditReferences and
    lr.CheckingAccountNumber = lr@RequestPre.CheckingAccountNumber and
    lr.SecurityNumber = lr@RequestPre.SecurityNumber and
    lr.CreditScore = lr@RequestPre.CreditScore
  ) and
  Loan.allInstance()->forAll(l | l = l@pre) and
  CheckingAccount.allInstance()->forAll(ca | ca = ca@pre) and
  CreditHistory.allInstance()->forAll(ch | ch = ch@pre)
            
        }