Contract ProcessSaleService::enterItem(barcode:Integer,quantity:Integer): Boolean {
          precondition:
          barcode <> null and
  quantity <> null and
  quantity > 0 and
  Store.allInstance()->exists(s |
    s.IsOpened = true and
    s.Items->exists(i | i.Barcode = barcode and i.StockNumber >= quantity)
  )
            postcondition:
          if result = true then
    Store.allInstance()->exists(s |
      s.IsOpened = true and
      s.Items->exists(i |
        i.Barcode = barcode and
        i.StockNumber = i.StockNumber@pre - quantity
      )
    )
  else
    Store.allInstance()->forAll(s |
      s.Items->forAll(i |
        i.StockNumber = i.StockNumber@pre
      )
    )
  endif
            
        }