Contract ManageUserCRUDService::createUser(userid:Integer,name:String,address:String): Boolean {
          precondition:
          userid <> null and
  name <> null and name <> '' and
  address <> null and address <> '' and
  User.allInstance()->forAll(u | u.UserID <> userid)
            postcondition:
          if result = true then
    User.allInstance()->exists(u |
      u.UserID = userid and
      u.Name = name and
      u.Address = address and
      u.OwnedCard->isEmpty()
    ) and
    User.allInstance()->size() = User.allInstance()->size() + 1
  else
    User.allInstance()->size() = User.allInstance()->size() and
    User.allInstance()->forAll(u |
      User.allInstance()->exists(up |
        up.UserID = u.UserID and
        up.Name = u.Name and
        up.Address = u.Address
      )
    )
  endif
            
        }