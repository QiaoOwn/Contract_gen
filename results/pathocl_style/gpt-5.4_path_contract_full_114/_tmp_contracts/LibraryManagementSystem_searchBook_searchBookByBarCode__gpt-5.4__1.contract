Contract SearchBook::searchBookByBarCode(barcode:String): Set(Book) {
          precondition:
          barcode <> null and barcode <> '' and BookCopy.allInstance()->exists(bc | bc.Barcode = barcode)
            postcondition:
          result = Book.allInstance()->select(b | b.Copys->exists(c | c.Barcode = barcode)) and
      Book.allInstance()->forAll(b |
        b.CallNo = b.CallNo and
        b.Title = b.Title and
        b.Edition = b.Edition and
        b.Author = b.Author and
        b.Publisher = b.Publisher and
        b.Description = b.Description and
        b.ISBn = b.ISBn and
        b.CopyNum = b.CopyNum and
        b.Copys = b.Copys and
        b.Subject = b.Subject
      ) and
      BookCopy.allInstance()->forAll(bc |
        bc.Barcode = bc.Barcode and
        bc.Status = bc.Status and
        bc.Location = bc.Location and
        bc.IsReserved = bc.IsReserved and
        bc.BookBelongs = bc.BookBelongs and
        bc.LoanedRecord = bc.LoanedRecord and
        bc.ReservationRecord = bc.ReservationRecord
      )
            
        }