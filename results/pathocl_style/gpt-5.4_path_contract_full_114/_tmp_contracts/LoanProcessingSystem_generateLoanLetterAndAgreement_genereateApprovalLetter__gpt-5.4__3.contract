Contract GenerateLoanLetterAndAgreementModule::genereateApprovalLetter(id:Integer): Boolean {
          precondition:
          id <> null and
  LoanRequest.allInstance()->exists(lr |
    lr.RequestID = id and
    lr.Status = LoanRequestStatus::APPROVED and
    lr.ApprovalLoan <> null and
    lr.RequestedCAHistory <> null and
    lr.RequestedCAHistory.Status = Status::GOODSTANDING
  )
            postcondition:
          let lr : LoanRequest = LoanRequest.allInstance()->any(r | r.RequestID = id) in
  result = true and
  lr.AttachedApprovalLetter <> null and
  ApprovalLetter.allInstance()->includes(lr.AttachedApprovalLetter) and
  lr.AttachedApprovalLetter.Content <> null and
  lr.AttachedApprovalLetter.Content <> '' and
  lr.Status = lr@pre.Status and
  lr.ApprovalLoan = lr@pre.ApprovalLoan and
  lr.RequestedCAHistory = lr@pre.RequestedCAHistory and
  LoanRequest.allInstance()->size() = LoanRequest.allInstance()->size() and
  Loan.allInstance()->size() = Loan.allInstance()->size() and
  CheckingAccount.allInstance()->size() = CheckingAccount.allInstance()->size() and
  ApprovalLetter.allInstance()->size() = ApprovalLetter.allInstance()->size() + 1
            
        }