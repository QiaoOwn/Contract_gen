Contract GenerateLoanLetterAndAgreementModule::genereateApprovalLetter(id:Integer): Boolean {
          precondition:
          LoanRequest.allInstance()->exists(lr |
    lr.RequestID = id and
    lr.Status = LoanRequestStatus::APPROVED and
    not lr.ApprovalLoan.oclIsUndefined() and
    lr.AttachedApprovalLetter.oclIsUndefined()
  )
            postcondition:
          let lr : LoanRequest = LoanRequest.allInstance()->any(r | r.RequestID = id) in
  let newLetter : ApprovalLetter = ApprovalLetter.allInstance()->any(al | al = lr.AttachedApprovalLetter) in
    result = true and
    not lr.AttachedApprovalLetter.oclIsUndefined() and
    not newLetter.oclIsUndefined() and
    newLetter.Content = 'Approval Letter for ' + lr.Name + ' regarding loan request ' + lr.RequestID.toString() + ' for amount ' + lr.LoanAmount.toString() and
    lr.Status = LoanRequestStatus::APPROVED and
    lr.ApprovalLoan = lr.ApprovalLoan
            
        }