Contract ProcessSaleService::makeNewSale(): Boolean {
          precondition:
          Store.allInstance()->exists(s |
        s.IsOpened = true and
        s.AssociationCashdeskes->exists(cd | cd.IsOpened = true and cd.BelongedStore = s)
    )
            postcondition:
          result = true implies
        Sale.allInstance()->exists(ns |
            not Sale.allInstance()->includes(ns) and
            ns.Time.oclIsUndefined() and
            ns.IsComplete = false and
            ns.Amount = 0.0 and
            ns.IsReadytoPay = false and
            ns.ContainedSalesLine->isEmpty() and
            ns.AssoicatedPayment.oclIsUndefined() and
            Store.allInstance()->exists(s |
                s.IsOpened = true and
                ns.Belongedstore = s and
                s.Sales->includes(ns) and
                CashDesk.allInstance()->exists(cd |
                    cd.IsOpened = true and
                    cd.BelongedStore = s and
                    ns.BelongedCashDesk = cd and
                    cd.ContainedSales->includes(ns)
                )
            )
        ) and
        Sale.allInstance()->size() = Sale.allInstance()->size() + 1
    and
    result = false implies
        Sale.allInstance()->size() = Sale.allInstance()->size() and
        Store.allInstance()->forAll(s | s.Sales = s.Sales@pre) and
        CashDesk.allInstance()->forAll(cd | cd.ContainedSales = cd.ContainedSales@pre)
            
        }