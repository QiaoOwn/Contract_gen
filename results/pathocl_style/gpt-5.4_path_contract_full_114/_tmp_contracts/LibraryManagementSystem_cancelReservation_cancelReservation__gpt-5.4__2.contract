Contract LibraryManagementSystemSystem::cancelReservation(uid:String,barcode:String): Boolean {
          precondition:
          uid <> null and uid <> '' and
    barcode <> null and barcode <> '' and
    BookCopy.allInstance()->exists(b | b.Barcode = barcode and b.IsReserved = true and
        b.ReservationRecord->exists(r | r.ReservedUser.UserID = uid))
            postcondition:
          let bc : BookCopy = BookCopy.allInstance()->any(b | b.Barcode = barcode) in
    if result = true then
        bc.IsReserved = false and
        bc.ReservationRecord->forAll(r | r.ReservedUser.UserID <> uid) and
        (bc.Status = CopyStatus::AVAILABLE or bc.Status = CopyStatus::LIBUSEONLY or bc.Status = CopyStatus::INPROCESSING or bc.Status = CopyStatus::LOANED or bc.Status = CopyStatus::ONHOLDSHELF)
    else
        bc.IsReserved = bc@pre.IsReserved and
        bc.Status = bc@pre.Status and
        bc.ReservationRecord = bc.ReservationRecord@pre
    endif
            
        }