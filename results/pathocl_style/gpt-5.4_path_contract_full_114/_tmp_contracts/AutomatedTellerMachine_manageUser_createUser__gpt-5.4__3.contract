Contract ManageUserCRUDService::createUser(userid:Integer,name:String,address:String): Boolean {
          precondition:
          userid <> null and name <> null and address <> null and
    User.allInstance()->forAll(u | u.UserID <> userid)
            postcondition:
          if User.allInstance()->exists(u | u.UserID = userid) then
        result = false and User.allInstance()->size() = User.allInstance()->size()
    else
        result = true and
        User.allInstance()->size() = User.allInstance()->size() + 1 and
        User.allInstance()->exists(u |
            not User.allInstance()->includes(u) and
            u.UserID = userid and
            u.Name = name and
            u.Address = address and
            u.OwnedCard->isEmpty()
        )
    endif
            
        }