Contract ManageUserCRUDService::modifyUser(userid:Integer,name:String,address:String): Boolean {
          precondition:
          userid <> null and name <> null and address <> null and
  User.allInstance()->exists(u | u.UserID = userid)
            postcondition:
          let u : User = User.allInstance()->any(x | x.UserID = userid) in
    u.Name = name and
    u.Address = address and
    result = true and
    User.allInstance()->size() = User.allInstance()->size() and
    u.UserID = u.UserID@pre and
    u.OwnedCard = u.OwnedCard@pre
            
        }