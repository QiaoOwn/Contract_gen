Contract ListBookHistory::listReservationBook(uid:String): Set(BookCopy) {
          precondition:
          uid <> null and uid <> '' and
BookCopy.allInstance()->exists(b |
  b.ReservationRecord->exists(r |
    r.ReservedUser.oclIsUndefined() = false and
    r.ReservedUser.Id = uid and
    r.IsReserveClosed = false
  )
)
            postcondition:
          result = BookCopy.allInstance()->select(b |
  b.ReservationRecord->exists(r |
    r.ReservedUser.oclIsUndefined() = false and
    r.ReservedUser.Id = uid and
    r.IsReserveClosed = false
  )
) and
BookCopy.allInstance()->forAll(b |
  b.Barcode = b.Barcode and
  b.Status = b.Status and
  b.Location = b.Location and
  b.IsReserved = b.IsReserved
) and
Book.allInstance()->forAll(bk |
  bk.CallNo = bk.CallNo and
  bk.Title = bk.Title and
  bk.Edition = bk.Edition and
  bk.Author = bk.Author and
  bk.Publisher = bk.Publisher and
  bk.Description = bk.Description and
  bk.ISBn = bk.ISBn and
  bk.CopyNum = bk.CopyNum
) and
Loan.allInstance()->forAll(l |
  l.LoanDate = l.LoanDate and
  l.RenewDate = l.RenewDate and
  l.DueDate = l.DueDate and
  l.ReturnDate = l.ReturnDate and
  l.RenewedTimes = l.RenewedTimes and
  l.IsReturned = l.IsReturned and
  l.OverDueFee = l.OverDueFee and
  l.OverDue3Days = l.OverDue3Days and
  l.OverDue10Days = l.OverDue10Days and
  l.OverDue17Days = l.OverDue17Days and
  l.OverDue31Days = l.OverDue31Days
) and
Reserve.allInstance()->forAll(r |
  r.ReserveDate = r.ReserveDate and
  r.IsReserveClosed = r.IsReserveClosed
)
            
        }