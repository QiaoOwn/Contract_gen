Contract EnterValidatedCreditReferencesModule::markRequestValid(): Boolean {
          precondition:
          ApprovalLetter.allInstance()->notEmpty() and
    CheckingAccount.allInstance()->notEmpty() and
    CreditHistory.allInstance()->notEmpty() and
    CheckingAccount.allInstance()->forAll(ca |
        ca.Balance >= 0 and
        ca.Status = Status::GOODSTANDING
    ) and
    CreditHistory.allInstance()->forAll(ch |
        ch.OutstandingDebt >= 0 and
        ch.BadDebits >= 0
    )
            postcondition:
          result = true and
    ApprovalLetter.allInstance()->forAll(al |
        al.Content = al.Content@pre
    ) and
    CheckingAccount.allInstance()->forAll(ca |
        ca.Balance = ca.Balance@pre and
        ca.Status = ca.Status@pre
    ) and
    CreditHistory.allInstance()->forAll(ch |
        ch.OutstandingDebt = ch.OutstandingDebt@pre and
        ch.BadDebits = ch.BadDebits@pre
    )
            
        }