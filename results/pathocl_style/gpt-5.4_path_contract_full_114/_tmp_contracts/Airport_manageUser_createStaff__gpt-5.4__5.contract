Contract AirportSystem::createStaff(id:Integer,name:String,pswd:String,phone:String,role:Integer,bossid:Integer): Boolean {
          precondition:
          Staff.allInstance()->forAll(s | s.Id <> id)
            postcondition:
          result = true and
  Staff.allInstance()->exists(s |
    s.oclIsNew() and
    s.Id = id and
    s.Name = name and
    s.Password = pswd and
    s.Phone = phone and
    s.Role = role and
    (if Staff.allInstance()->exists(b | not b.oclIsNew() and b.Id = bossid)
     then s.Boss = Staff.allInstance()->any(b | not b.oclIsNew() and b.Id = bossid)
     else s.Boss.oclIsUndefined()
     endif)
  ) and
  Staff.allInstance()->size() = Staff.allInstance()->size() + 1
            
        }