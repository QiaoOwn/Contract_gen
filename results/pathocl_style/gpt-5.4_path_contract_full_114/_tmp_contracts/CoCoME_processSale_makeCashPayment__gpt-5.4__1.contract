Contract ProcessSaleService::makeCashPayment(amount:Real): Boolean {
          precondition:
          amount > 0 and
    CashDesk.allInstance()->exists(cd | cd.IsOpened = true) and
    Sale.allInstance()->exists(s |
        CashDesk.allInstance()->exists(cd | cd.IsOpened = true and cd.ContainedSales->includes(s))
    )
            postcondition:
          if result = true then
        Payment.allInstance()->exists(p |
            p.oclIsTypeOf(CashPayment) and
            p.AmountTendered = amount and
            Sale.allInstance()->exists(s |
                p.BelongedSale = s and
                CashDesk.allInstance()->exists(cd | cd.IsOpened = true and cd.ContainedSales->includes(s))
            ) and
            p.oclAsType(CashPayment).Balance = amount - p.BelongedSale.Total
        )
    else
        Payment.allInstance()->forAll(p |
            not (
                p.oclIsTypeOf(CashPayment) and
                p.AmountTendered = amount and
                Sale.allInstance()->exists(s |
                    p.BelongedSale = s and
                    CashDesk.allInstance()->exists(cd | cd.IsOpened = true and cd.ContainedSales->includes(s))
                )
            )
        )
    endif
            
        }