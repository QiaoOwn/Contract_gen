Contract RepairService::approve(sid:Integer,rid:Integer,reject:Boolean,suggestion:String): ApprovalHistory {
          precondition:
          Staff.allInstance()->exists(s | s.Id = sid) and
    Repair.allInstance()->exists(r | r.Id = rid)
            postcondition:
          let r : Repair = Repair.allInstance()->any(x | x.Id = rid),
        s : Staff = Staff.allInstance()->any(x | x.Id = sid) in
    ApprovalHistory.allInstance()->exists(ah |
        ah = result and
        ah.oclIsNew() and
        ah.StaffId = sid and
        ah.Reject = reject and
        ah.Suggestion = suggestion and
        r.History = r.History@pre->including(ah) and
        r.Process = if reject then 0 else r.Process@pre + 1 endif
    )
            
        }