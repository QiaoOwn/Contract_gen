Contract LibraryManagementSystemSystem::renewBook(uid:String,barcode:String): Boolean {
          precondition:
          uid <> null and uid <> '' and
  barcode <> null and barcode <> '' and
  BookCopy.allInstance()->exists(b | b.Barcode = barcode) and
  BookCopy.allInstance()->any(b | b.Barcode = barcode).Status = CopyStatus::LOANED
            postcondition:
          let bc : BookCopy = BookCopy.allInstance()->any(b | b.Barcode = barcode) in
  result = true and
  bc.Status = bc@pre.Status and
  bc.Location = bc@pre.Location and
  bc.IsReserved = bc@pre.IsReserved and
  bc.BookBelongs = bc@pre.BookBelongs and
  Book.allInstance()->forAll(b |
    b.CallNo = b.CallNo@pre and
    b.Title = b.Title@pre and
    b.Edition = b.Edition@pre and
    b.Author = b.Author@pre and
    b.Publisher = b.Publisher@pre and
    b.Description = b.Description@pre and
    b.ISBn = b.ISBn@pre and
    b.CopyNum = b.CopyNum@pre and
    b.Copys = b.Copys@pre and
    b.Subject = b.Subject@pre
  ) and
  BookCopy.allInstance()->forAll(b |
    b <> bc implies
      b.Barcode = b.Barcode@pre and
      b.Status = b.Status@pre and
      b.Location = b.Location@pre and
      b.IsReserved = b.IsReserved@pre and
      b.BookBelongs = b.BookBelongs@pre
  ) and
  Subject.allInstance()->forAll(s |
    s.Name = s.Name@pre and
    s.SuperSubject = s.SuperSubject@pre and
    s.SubSubject = s.SubSubject@pre
  )
            
        }