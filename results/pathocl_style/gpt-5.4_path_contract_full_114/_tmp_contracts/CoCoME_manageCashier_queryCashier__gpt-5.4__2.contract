Contract ManageCashierCRUDService::queryCashier(id:Integer): Cashier {
          precondition:
          id <> null and Cashier.allInstance()->exists(c | c.Id = id)
            postcondition:
          result <> null and result.Id = id and
  Cashier.allInstance()->includes(result) and
  Cashier.allInstance()->size() = Cashier.allInstance()->size() and
  Store.allInstance()->forAll(s |
    s.Cashiers->asSet() = s.Cashiers@pre->asSet()
  ) and
  CashDesk.allInstance()->forAll(cd |
    cd.BelongedStore = cd.BelongedStore@pre and
    cd.IsOpened = cd.IsOpened@pre and
    cd.Name = cd.Name@pre
  ) and
  Store.allInstance()->forAll(s |
    s.Id = s.Id@pre and
    s.Name = s.Name@pre and
    s.Address = s.Address@pre and
    s.IsOpened = s.IsOpened@pre
  )
            
        }