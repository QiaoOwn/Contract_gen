Contract ManageUserCRUDService::queryUser(userid:Integer): User {
          precondition:
          userid <> null and
  User.allInstance()->exists(u | u.UserID = userid)
            postcondition:
          result <> null and
  result.UserID = userid and
  User.allInstance()->includes(result) and
  User.allInstance()->size() = User.allInstance()->size() and
  BankCard.allInstance()->size() = BankCard.allInstance()->size() and
  User.allInstance()->forAll(u |
    u.oclIsNew() = false and
    u.UserID = u.UserID@pre and
    u.Name = u.Name@pre and
    u.Address = u.Address@pre and
    u.OwnedCard = u.OwnedCard@pre
  ) and
  BankCard.allInstance()->forAll(c |
    c.oclIsNew() = false and
    c.CardID = c.CardID@pre and
    c.CardStatus = c.CardStatus@pre and
    c.Catalog = c.Catalog@pre and
    c.Password = c.Password@pre and
    c.Balance = c.Balance@pre and
    c.BelongedUser = c.BelongedUser@pre
  )
            
        }