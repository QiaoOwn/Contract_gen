Contract ManageSupplierCRUDService::deleteSupplier(id:Integer): Boolean {
          precondition:
          id <> null and Supplier.allInstance()->exists(s | s.Id = id)
            postcondition:
          if Supplier.allInstance()->exists(s | s.Id = id) then
		Supplier.allInstance()->forAll(s | s.Id <> id) and
		result = true
	else
		result = false
	endif
            
        }