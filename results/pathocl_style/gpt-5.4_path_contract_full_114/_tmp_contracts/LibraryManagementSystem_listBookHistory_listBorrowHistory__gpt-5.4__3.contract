Contract ListBookHistory::listBorrowHistory(uid:String): Set(Loan) {
          precondition:
          uid <> null and
  uid <> '' and
  User.allInstance()->exists(u | u.UserID = uid)
            postcondition:
          result = User.allInstance()->any(u | u.UserID = uid).LoanedBook and
  User.allInstance()->any(u | u.UserID = uid).LoanedBook = User.allInstance()->any(u | u.UserID = uid)@pre.LoanedBook and
  Loan.allInstance() = Loan.allInstance() and
  User.allInstance() = User.allInstance() and
  BookCopy.allInstance() = BookCopy.allInstance() and
  Librarian.allInstance() = Librarian.allInstance()
            
        }