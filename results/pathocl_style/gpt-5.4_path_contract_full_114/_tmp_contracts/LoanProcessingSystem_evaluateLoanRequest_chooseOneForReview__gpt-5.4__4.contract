Contract EvaluateLoanRequestModule::chooseOneForReview(requestid:Integer): LoanRequest {
          precondition:
          LoanRequest.allInstance()->exists(lr |
		lr.RequestID = requestid and
		lr.Status = LoanRequestStatus::APPROVED
	)
            postcondition:
          let selectedRequest : LoanRequest = LoanRequest.allInstance()->any(lr | lr.RequestID = requestid) in
	result = selectedRequest and
	selectedRequest.Status = LoanRequestStatus::READYFORREVIEW and
	LoanRequest.allInstance()->forAll(lr |
		lr.RequestID <> requestid implies
		lr.Status = lr.Status@pre
	)
            
        }