Contract ManageCashDeskCRUDService::createCashDesk(id:Integer,name:String,isopened:Boolean): Boolean {
          precondition:
          id.oclIsUndefined() = false and
    name.oclIsUndefined() = false and
    isopened.oclIsUndefined() = false and
    CashDesk.allInstance()->forAll(cd | cd.Id <> id)
            postcondition:
          result = true and
    CashDesk.allInstance()->exists(cd |
        cd.Id = id and
        cd.Name = name and
        cd.IsOpened = isopened
    ) and
    CashDesk.allInstance()->size() = CashDesk.allInstance()->size() + 1 and
    CashDesk.allInstance()->forAll(cd |
        CashDesk.allInstance()->exists(cd2 |
            cd2.Id = cd.Id and
            cd2.Name = cd.Name and
            cd2.IsOpened = cd.IsOpened and
            cd2.BelongedStore = cd.BelongedStore
        )
    )
            
        }