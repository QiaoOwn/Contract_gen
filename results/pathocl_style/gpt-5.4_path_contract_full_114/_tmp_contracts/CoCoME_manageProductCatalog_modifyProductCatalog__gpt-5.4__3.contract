Contract ManageProductCatalogCRUDService::modifyProductCatalog(id:Integer,name:String): Boolean {
          precondition:
          id <> null and
  name <> null and
  name <> '' and
  ProductCatalog.allInstance()->exists(pc | pc.Id = id)
            postcondition:
          ProductCatalog.allInstance()->exists(pc |
    pc.Id = id and
    pc.Name = name
  ) and
  ProductCatalog.allInstance()->select(pc | pc.Id = id)->size() = 1 and
  result = true
            
        }