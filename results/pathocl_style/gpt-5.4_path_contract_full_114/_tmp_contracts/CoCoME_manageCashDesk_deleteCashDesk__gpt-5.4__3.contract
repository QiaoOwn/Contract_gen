Contract ManageCashDeskCRUDService::deleteCashDesk(id:Integer): Boolean {
          precondition:
          id <> null and
    CashDesk.allInstance()->exists(cd | cd.Id = id)
            postcondition:
          let cd : Set(CashDesk) = CashDesk.allInstance()->select(c | c.Id = id) in
    CashDesk.allInstance()->forAll(c | c.Id <> id) and
    Store.allInstance()->forAll(s | s.AssociationCashdeskes->forAll(c | c.Id <> id)) and
    result = true
            
        }