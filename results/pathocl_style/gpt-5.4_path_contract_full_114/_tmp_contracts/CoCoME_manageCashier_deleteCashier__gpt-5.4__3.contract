Contract ManageCashierCRUDService::deleteCashier(id:Integer): Boolean {
          precondition:
          id <> null and
	Cashier.allInstance()->exists(c | c.Id = id)
            postcondition:
          (
		Cashier.allInstance()->exists(c | c.Id = id) implies
		let cashier : Cashier = Cashier.allInstance()->any(c | c.Id = id) in
			not Cashier.allInstance()->exists(c | c.Id = id) and
			cashier.WorkedStore@pre.Cashiers = cashier.WorkedStore.Cashiers->includingAll(cashier.WorkedStore@pre.Cashiers)->excluding(cashier) and
			result = true
	) and
	(
		not Cashier.allInstance()->exists(c | c.Id = id) implies
			result = false
	)
            
        }