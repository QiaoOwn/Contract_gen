Contract EnterValidatedCreditReferencesModule::markRequestValid(): Boolean {
          precondition:
          true
            postcondition:
          result = true and
    ApprovalLetter.allInstance()->forAll(a | a.Content <> null and a.Content <> '') and
    CheckingAccount.allInstance()->forAll(c | c.Balance >= 0 and c.Status <> null) and
    CreditHistory.allInstance()->forAll(h | h.OutstandingDebt >= 0 and h.BadDebits >= 0)
            
        }