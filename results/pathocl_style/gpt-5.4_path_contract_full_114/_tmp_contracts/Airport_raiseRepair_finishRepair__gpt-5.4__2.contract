Contract RepairService::finishRepair(id:Integer,sid:Integer,did:Integer,res:String): Boolean {
          precondition:
          Repair.allInstance()->exists(r |
        r.Id = id and
        r.RelatedDevice.Id = did and
        r.RelatedDevice.Contacts.Id = sid and
        r.RelatedDevice.Contacts.Role = 1
    )
            postcondition:
          Repair.allInstance()->exists(r |
        r.Id = id and
        r.RelatedDevice.Id = did and
        r.Process = 3 and
        r.Result = res
    ) and
    result = true
            
        }