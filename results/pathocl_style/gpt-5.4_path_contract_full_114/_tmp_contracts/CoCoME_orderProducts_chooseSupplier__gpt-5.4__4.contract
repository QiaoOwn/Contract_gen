Contract CoCoMEOrderProducts::chooseSupplier(supplierID:Integer): Boolean {
          precondition:
          supplierID <> null and
    Supplier.allInstance()->exists(s | s.Id = supplierID)
            postcondition:
          (result = true implies Supplier.allInstance()->exists(s | s.Id = supplierID)) and
    (result = false implies not Supplier.allInstance()->exists(s | s.Id = supplierID))
            
        }