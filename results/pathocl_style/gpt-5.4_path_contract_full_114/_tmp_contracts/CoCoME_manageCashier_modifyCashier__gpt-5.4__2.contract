Contract ManageCashierCRUDService::modifyCashier(id:Integer,name:String): Boolean {
          precondition:
          id <> null and
  name <> null and
  name <> '' and
  Cashier.allInstance()->exists(c | c.Id = id)
            postcondition:
          let c : Cashier = Cashier.allInstance()->any(x | x.Id = id) in
    result = true and
    c.Name = name and
    c.Id = id and
    Cashier.allInstance()->size() = Cashier.allInstance()->size() and
    c.WorkedStore = c.WorkedStore@pre and
    Store.allInstance()->forAll(s |
      s.Id = s.Id@pre and
      s.Name = s.Name@pre and
      s.Address = s.Address@pre and
      s.IsOpened = s.IsOpened@pre and
      s.AssociationCashdeskes = s.AssociationCashdeskes@pre and
      s.Productcatalogs = s.Productcatalogs@pre and
      s.Items = s.Items@pre and
      s.Cashiers = s.Cashiers@pre and
      s.Sales = s.Sales@pre
    )
            
        }