Contract AutomatedTellerMachineSystem::withdrawCash(quantity:Integer): Boolean {
          precondition:
          quantity <> null and
    quantity > 0
            postcondition:
          result = true implies
        self.oclIsTypeOf(AutomatedTellerMachineSystem)
    and
    result = false implies
        self.oclIsTypeOf(AutomatedTellerMachineSystem)
            
        }