Contract LibraryManagementSystemSystem::recommendBook(uid:String,callNo:String,title:String,edition:String,author:String,publisher:String,description:String,isbn:String): Boolean {
          precondition:
          uid <> null and uid <> '' and
callNo <> null and callNo <> '' and
title <> null and title <> '' and
edition <> null and edition <> '' and
author <> null and author <> '' and
publisher <> null and publisher <> '' and
description <> null and description <> '' and
isbn <> null and isbn <> '' and
Book.allInstance()->exists(b |
    b.CallNo = callNo and
    b.Title = title and
    b.Edition = edition and
    b.Author = author and
    b.Publisher = publisher and
    b.Description = description and
    b.ISBn = isbn
) and
RecommendBook.allInstance()->forAll(r |
    not (r.RecommendUser.oclIsUndefined()) implies r.RecommendUser.UID <> uid or
    r.oclIsNew()
)
            postcondition:
          result = true and
RecommendBook.allInstance()->exists(r |
    r.oclIsNew() and
    not r.RecommendUser.oclIsUndefined() and
    r.RecommendUser.UID = uid
) and
Book.allInstance()->exists(b |
    b.CallNo = callNo and
    b.Title = title and
    b.Edition = edition and
    b.Author = author and
    b.Publisher = publisher and
    b.Description = description and
    b.ISBn = isbn
)
            
        }