Contract ProcessSaleService::endSale(): Real {
          precondition:
          Sale.allInstance()->exists(s |
        not s.IsComplete and
        s.IsReadytoPay and
        s.Belongedstore <> null and
        s.BelongedCashDesk <> null and
        s.Belongedstore.IsOpened and
        s.BelongedCashDesk.IsOpened and
        s.BelongedCashDesk.BelongedStore = s.Belongedstore and
        s.Belongedstore.Sales->includes(s) and
        s.BelongedCashDesk.ContainedSales->includes(s) and
        s.ContainedSalesLine->notEmpty()
    )
            postcondition:
          let sale : Sale = Sale.allInstance()->any(s |
        not s@pre.IsComplete and
        s@pre.IsReadytoPay and
        s@pre.Belongedstore <> null and
        s@pre.BelongedCashDesk <> null and
        s@pre.Belongedstore.IsOpened and
        s@pre.BelongedCashDesk.IsOpened and
        s@pre.BelongedCashDesk.BelongedStore = s@pre.Belongedstore and
        s@pre.Belongedstore.Sales->includes(s) and
        s@pre.BelongedCashDesk.ContainedSales->includes(s) and
        s@pre.ContainedSalesLine->notEmpty()
    ) in
    sale.IsComplete = true and
    sale.IsReadytoPay = sale@pre.IsReadytoPay and
    sale.Amount = sale.ContainedSalesLine->collect(sl | sl.Subamount)->sum() and
    result = sale.Amount and
    sale.Belongedstore = sale@pre.Belongedstore and
    sale.BelongedCashDesk = sale@pre.BelongedCashDesk and
    sale.ContainedSalesLine = sale@pre.ContainedSalesLine and
    sale.Belongedstore.Sales->includes(sale) and
    sale.BelongedCashDesk.ContainedSales->includes(sale) and
    Sale.allInstance()->forAll(s |
        s <> sale implies
        s.IsComplete = s.IsComplete@pre and
        s.IsReadytoPay = s.IsReadytoPay@pre and
        s.Amount = s.Amount@pre and
        s.Belongedstore = s.Belongedstore@pre and
        s.BelongedCashDesk = s.BelongedCashDesk@pre and
        s.ContainedSalesLine = s.ContainedSalesLine@pre
    )
            
        }