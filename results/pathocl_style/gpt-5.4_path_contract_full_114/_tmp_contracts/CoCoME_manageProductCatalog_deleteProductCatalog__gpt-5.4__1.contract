Contract ManageProductCatalogCRUDService::deleteProductCatalog(id:Integer): Boolean {
          precondition:
          ProductCatalog.allInstance()->exists(pc | pc.Id = id)
            postcondition:
          let pc : ProductCatalog = ProductCatalog.allInstance()->any(p | p.Id = id) in
	ProductCatalog.allInstance()->excludes(pc) and
	Store.allInstance()->forAll(s | s.Productcatalogs->excludes(pc)) and
	result = true
            
        }