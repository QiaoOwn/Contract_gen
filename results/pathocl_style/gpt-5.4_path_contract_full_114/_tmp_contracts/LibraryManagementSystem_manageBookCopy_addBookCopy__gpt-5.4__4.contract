Contract ManageBookCopyCRUDService::addBookCopy(callNo:String,barcode:String,location:String): Boolean {
          precondition:
          callNo <> null and callNo <> '' and
	barcode <> null and barcode <> '' and
	location <> null and location <> '' and
	Book.allInstance()->exists(b | b.CallNo = callNo) and
	BookCopy.allInstance()->forAll(c | c.Barcode <> barcode)
            postcondition:
          if result = true then
		BookCopy.allInstance()->exists(c |
			c.oclIsNew() and
			c.Barcode = barcode and
			c.Location = location and
			c.Status = CopyStatus::AVAILABLE and
			c.IsReserved = false and
			c.BookBelongs.CallNo = callNo
		) and
		Book.allInstance()->any(b | b.CallNo = callNo).Copys->exists(c |
			c.Barcode = barcode and
			c.Location = location
		) and
		Book.allInstance()->any(b | b.CallNo = callNo).CopyNum =
			Book.allInstance()->any(b | b.CallNo = callNo).CopyNum@pre + 1
	else
		BookCopy.allInstance() = BookCopy.allInstance() and
		Book.allInstance()->forAll(b | b.CopyNum = b.CopyNum@pre)
	endif
            
        }