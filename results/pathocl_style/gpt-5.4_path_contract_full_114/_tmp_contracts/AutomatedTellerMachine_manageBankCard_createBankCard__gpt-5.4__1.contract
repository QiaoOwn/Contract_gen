Contract ManageBankCardCRUDService::createBankCard(cardid:Integer,cardstatus:CardStatus[NORMAL|SUSPEND|CANCEL],catalog:CardCatalog[CREDIT|DEPOSIT],password:Integer,balance:Real): Boolean {
          precondition:
          cardid <> null and
    cardstatus <> null and
    catalog <> null and
    password <> null and
    balance <> null and
    not BankCard.allInstance()->exists(b | b.CardID = cardid) and
    balance >= 0
            postcondition:
          if result = true then
        BankCard.allInstance()->exists(b |
            b.oclIsNew() and
            b.CardID = cardid and
            b.CardStatus = cardstatus and
            b.Catalog = catalog and
            b.Password = password and
            b.Balance = balance
        ) and
        BankCard.allInstance()->select(b | b.CardID = cardid)->size() = 1
    else
        BankCard.allInstance()->forAll(b |
            not (b.oclIsNew() and b.CardID = cardid)
        )
    endif
            
        }