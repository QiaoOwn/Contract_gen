Contract LibraryManagementSystemSystem::listRecommendBook(uid:String): Set(RecommendBook) {
          precondition:
          uid <> null and
  User.allInstance()->exists(u | u.UserID = uid)
            postcondition:
          result = User.allInstance()->any(u | u.UserID = uid).RecommendedBook and
  RecommendBook.allInstance() = RecommendBook.allInstance() and
  User.allInstance() = User.allInstance() and
  Book.allInstance() = Book.allInstance()
            
        }