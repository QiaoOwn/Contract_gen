Contract LoanProcessingSystemSystem::loanPayment(loanid:Integer): Boolean {
          precondition:
          loanid <> null and
  Loan.allInstance()->exists(l | l.LoanID = loanid and l.Status = LoanStatus::LSOPEN and l.IsPaidinFull = false and l.RemainAmountToPay > 0 and l.BelongedLoanAccount <> null)
            postcondition:
          let loan : Loan = Loan.allInstance()->any(l | l.LoanID = loanid) in
  let acc : LoanAccount = loan.BelongedLoanAccount in
  (
    if loan@pre.RemainAmountToPay - loan@pre.RepaymentAmount <= 0 then
      loan.RemainAmountToPay = 0 and
      loan.IsPaidinFull = true and
      loan.Status = LoanStatus::CLOSED and
      acc.Status = LoanAccountStatus::HASPAIDINFULL and
      result = true
    else
      loan.RemainAmountToPay = loan@pre.RemainAmountToPay - loan@pre.RepaymentAmount and
      loan.IsPaidinFull = false and
      loan.Status = LoanStatus::LSOPEN and
      acc.Status = acc@pre.Status and
      result = true
    endif
  ) and
  acc.Balance = acc@pre.Balance and
  loan.LoanID = loan@pre.LoanID and
  loan.StartDate = loan@pre.StartDate and
  loan.EndDate = loan@pre.EndDate and
  loan.CurrentOverDueDate = loan@pre.CurrentOverDueDate and
  loan.RePaymentDays = loan@pre.RePaymentDays and
  loan.RepaymentAmount = loan@pre.RepaymentAmount and
  loan.ReferedLoanRequest = loan@pre.ReferedLoanRequest and
  acc.LoanAccountID = acc@pre.LoanAccountID
            
        }