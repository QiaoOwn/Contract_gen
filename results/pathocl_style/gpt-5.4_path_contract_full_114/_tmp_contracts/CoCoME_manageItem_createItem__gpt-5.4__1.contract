Contract ManageItemCRUDService::createItem(barcode:Integer,name:String,price:Real,stocknumber:Integer,orderprice:Real): Boolean {
          precondition:
          barcode <> null and
  name <> null and name <> '' and
  price <> null and
  stocknumber <> null and
  orderprice <> null and
  price >= 0 and
  stocknumber >= 0 and
  orderprice >= 0 and
  Store.allInstance()->exists(s |
    s.IsOpened = true and
    s.Items->forAll(i | i.Barcode <> barcode)
  )
            postcondition:
          if result = true then
    Store.allInstance()->exists(s |
      s.IsOpened = true and
      s.Items = s.Items@pre->including(
        Item.allInstance()->any(i |
          not Item.allInstance()->includes(i) and
          i.Barcode = barcode and
          i.Name = name and
          i.Price = price and
          i.StockNumber = stocknumber and
          i.OrderPrice = orderprice
        )
      )
    ) and
    Item.allInstance()->exists(i |
      not Item.allInstance()->includes(i) and
      i.Barcode = barcode and
      i.Name = name and
      i.Price = price and
      i.StockNumber = stocknumber and
      i.OrderPrice = orderprice
    )
  else
    Item.allInstance() = Item.allInstance() and
    Store.allInstance()->forAll(s | s.Items = s.Items@pre)
  endif
            
        }