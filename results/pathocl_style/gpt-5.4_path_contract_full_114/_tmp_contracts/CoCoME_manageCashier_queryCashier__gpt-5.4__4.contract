Contract ManageCashierCRUDService::queryCashier(id:Integer): Cashier {
          precondition:
          id <> null and
	Cashier.allInstance()->exists(c | c.Id = id)
            postcondition:
          result <> null and
	result.Id = id and
	Cashier.allInstance()->includes(result) and
	Cashier.allInstance() = Cashier.allInstance() and
	Store.allInstance() = Store.allInstance() and
	CashDesk.allInstance() = CashDesk.allInstance() and
	ProductCatalog.allInstance() = ProductCatalog.allInstance()
            
        }