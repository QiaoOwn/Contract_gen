Contract CoCoMESystem::openStore(storeID:Integer): Boolean {
          precondition:
          storeID <> null and
  Store.allInstance()->exists(s | s.Id = storeID) and
  Store.allInstance()->any(s | s.Id = storeID).IsOpened = false
            postcondition:
          let s : Store = Store.allInstance()->any(st | st.Id = storeID) in
    s.IsOpened = true and
    result = true and
    Store.allInstance()->excluding(s)->forAll(st |
      st.IsOpened = st.IsOpened@pre
    ) and
    s.AssociationCashdeskes = s.AssociationCashdeskes@pre and
    s.Productcatalogs = s.Productcatalogs@pre and
    s.Items = s.Items@pre and
    s.Cashiers = s.Cashiers@pre and
    s.Sales = s.Sales@pre
            
        }