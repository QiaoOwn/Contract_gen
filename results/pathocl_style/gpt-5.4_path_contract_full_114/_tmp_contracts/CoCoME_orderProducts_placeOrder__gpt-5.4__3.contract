Contract CoCoMEOrderProducts::placeOrder(): Boolean {
          precondition:
          CashDesk.allInstance()->exists(cd |
    cd.IsOpened = true and
    cd.BelongedStore.IsOpened = true and
    cd.BelongedStore.Productcatalogs->notEmpty() and
    cd.ContainedSales->exists(s |
      s.IsComplete = false and
      s.IsReadytoPay = false and
      s.BelongedCashDesk = cd and
      s.Belongedstore = cd.BelongedStore and
      s.ContainedSalesLine->notEmpty()
    )
  )
            postcondition:
          if result = true then
    CashDesk.allInstance()->exists(cd |
      cd.IsOpened = true and
      cd.BelongedStore.IsOpened = true and
      cd.ContainedSales->exists(s |
        s.IsComplete = false and
        s.BelongedCashDesk = cd and
        s.Belongedstore = cd.BelongedStore and
        s.ContainedSalesLine->notEmpty() and
        s.IsReadytoPay = true
      )
    )
  else
    CashDesk.allInstance()->forAll(cd |
      cd.ContainedSales->forAll(s |
        s.oclIsNew() implies false
      )
    ) and
    Sale.allInstance()->forAll(s |
      s.IsReadytoPay = s.IsReadytoPay@pre and
      s.IsComplete = s.IsComplete@pre and
      s.Amount = s.Amount@pre
    )
  endif
            
        }