Contract ManageBankCardCRUDService::modifyBankCard(cardid:Integer,cardstatus:CardStatus[NORMAL|SUSPEND|CANCEL],catalog:CardCatalog[CREDIT|DEPOSIT],password:Integer,balance:Real): Boolean {
          precondition:
          cardid <> null and
  cardstatus <> null and
  catalog <> null and
  password <> null and
  balance <> null and
  BankCard.allInstance()->exists(b | b.CardID = cardid)
            postcondition:
          let bc : BankCard = BankCard.allInstance()->any(b | b.CardID = cardid) in
    bc.CardStatus = cardstatus and
    bc.Catalog = catalog and
    bc.Password = password and
    bc.Balance = balance and
    bc.BelongedUser = bc.BelongedUser@pre and
    User.allInstance()->forAll(u |
      u.OwnedCard = u.OwnedCard@pre
    ) and
    result = true
            
        }