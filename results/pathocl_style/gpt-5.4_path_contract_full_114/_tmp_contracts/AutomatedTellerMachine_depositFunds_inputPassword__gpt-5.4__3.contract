Contract AutomatedTellerMachineSystem::inputPassword(password:Integer): Boolean {
          precondition:
          password <> null and
    BankCard.allInstance()->exists(c | c.Password = password and c.CardStatus = CardStatus::NORMAL)
            postcondition:
          result = BankCard.allInstance()->exists(c | c.Password = password and c.CardStatus = CardStatus::NORMAL) and
    BankCard.allInstance()->forAll(c |
        c.CardID = c.CardID and
        c.CardStatus = c.CardStatus and
        c.Catalog = c.Catalog and
        c.Password = c.Password and
        c.Balance = c.Balance and
        c.BelongedUser = c.BelongedUser
    )
            
        }