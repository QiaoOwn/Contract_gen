Contract CoCoMEOrderProducts::makeNewOrder(orderid:Integer): Boolean {
          precondition:
          orderid <> null and
	self.cashDesk <> null and
	self.cashDesk.IsOpened = true and
	self.cashDesk.BelongedStore <> null and
	self.cashDesk.BelongedStore.IsOpened = true and
	self.cashDesk.BelongedStore.Productcatalogs->notEmpty() and
	self.cashDesk.ContainedSales->forAll(s | s.Id <> orderid)
            postcondition:
          if result = true then
		self.cashDesk.ContainedSales->exists(s |
			s.Id = orderid and
			self.cashDesk.ContainedSales = self.cashDesk.ContainedSales@pre->including(s) and
			self.cashDesk.BelongedStore.Sales = self.cashDesk.BelongedStore.Sales@pre->including(s)
		)
	else
		self.cashDesk.ContainedSales = self.cashDesk.ContainedSales@pre and
		self.cashDesk.BelongedStore.Sales = self.cashDesk.BelongedStore.Sales@pre
	endif
            
        }