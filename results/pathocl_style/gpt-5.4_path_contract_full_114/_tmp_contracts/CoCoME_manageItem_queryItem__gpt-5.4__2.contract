Contract ManageItemCRUDService::queryItem(barcode:Integer): Item {
          precondition:
          barcode <> null and
Store.allInstance()->exists(s | s.Items->exists(i | i.Barcode = barcode))
            postcondition:
          result <> null and
result.Barcode = barcode and
Store.allInstance()->exists(s | s.Items->includes(result)) and
Item.allInstance() = Item.allInstance() and
Store.allInstance() = Store.allInstance()
            
        }