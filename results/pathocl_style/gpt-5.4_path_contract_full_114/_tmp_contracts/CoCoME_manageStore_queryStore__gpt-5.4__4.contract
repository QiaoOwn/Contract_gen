Contract ManageStoreCRUDService::queryStore(id:Integer): Store {
          precondition:
          id <> null and Store.allInstance()->exists(s | s.Id = id)
            postcondition:
          result <> null and
    result.oclIsTypeOf(Store) and
    result.Id = id and
    result = Store.allInstance()->any(s | s.Id = id) and
    Store.allInstance()->includes(result) and
    Store.allInstance()->size() = Store.allInstance()->size() and
    CashDesk.allInstance()->size() = CashDesk.allInstance()->size() and
    Cashier.allInstance()->size() = Cashier.allInstance()->size() and
    ProductCatalog.allInstance()->size() = ProductCatalog.allInstance()->size()
            
        }