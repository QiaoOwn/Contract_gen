Contract ManageLoanTermCRUDService::deleteLoanTerm(itemid:Integer): Boolean {
          precondition:
          LoanTerm.allInstance()->exists(lt | lt.ItemID = itemid)
            postcondition:
          (
		LoanTerm.allInstance()->one(lt | lt.ItemID = itemid@pre) and
		LoanTerm.allInstance()->size() = LoanTerm.allInstance()->size() - 1 and
		LoanRequest.allInstance()->forAll(lr |
			lr.AttachedLoanTerms = lr.AttachedLoanTerms@pre->excluding(
				LoanTerm.allInstance()->any(lt | lt.ItemID = itemid)
			)
		) and
		result = true
	)
	or
	(
		LoanTerm.allInstance()->forAll(lt |
			lt.ItemID <> itemid implies LoanTerm.allInstance()->includes(lt)
		) and
		result = false
	)
            
        }