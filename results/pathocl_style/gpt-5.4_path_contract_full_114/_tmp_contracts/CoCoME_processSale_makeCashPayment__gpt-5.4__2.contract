Contract ProcessSaleService::makeCashPayment(amount:Real): Boolean {
          precondition:
          amount.oclIsUndefined() = false and
    amount > 0 and
    CashDesk.allInstance()->exists(cd |
        cd.IsOpened = true and
        cd.ContainedSales->exists(s |
            s.oclIsUndefined() = false
        )
    )
            postcondition:
          if result = true then
        Payment.allInstance()->exists(p |
            p.AmountTendered = amount and
            p.BelongedSale.oclIsUndefined() = false and
            CashDesk.allInstance()->exists(cd |
                cd.IsOpened = true and
                cd.ContainedSales->includes(p.BelongedSale)
            )
        ) and
        CashPayment.allInstance()->exists(cp |
            cp.AmountTendered = amount and
            cp.BelongedSale.oclIsUndefined() = false and
            CashDesk.allInstance()->exists(cd |
                cd.IsOpened = true and
                cd.ContainedSales->includes(cp.BelongedSale)
            )
        )
    else
        Payment.allInstance() = Payment.allInstance() and
        CashPayment.allInstance() = CashPayment.allInstance()
    endif
            
        }