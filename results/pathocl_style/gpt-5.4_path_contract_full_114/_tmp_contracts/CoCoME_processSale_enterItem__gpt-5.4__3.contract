Contract ProcessSaleService::enterItem(barcode:Integer,quantity:Integer): Boolean {
          precondition:
          barcode <> null and
    quantity <> null and
    quantity > 0 and
    Item.allInstance()->exists(i | i.Barcode = barcode) and
    CashDesk.allInstance()->exists(cd |
        cd.IsOpened = true and
        cd.BelongedStore.Items->exists(i | i.Barcode = barcode and i.StockNumber >= quantity)
    )
            postcondition:
          if result = true then
        OrderEntry.allInstance()->exists(oe |
            oe.Quantity = quantity and
            oe.Item.Barcode = barcode and
            oe.SubAmount = oe.Item.Price * quantity
        )
    else
        OrderEntry.allInstance() = OrderEntry.allInstance()
    endif and
    Item.allInstance()->forAll(i |
        if i.Barcode = barcode and result = true then
            i.StockNumber = i.StockNumber@pre - quantity
        else
            i.StockNumber = i.StockNumber@pre
        endif
    )
            
        }