Contract LibraryManagementSystemSystem::cancelReservation(uid:String,barcode:String): Boolean {
          precondition:
          uid <> null and uid <> '' and
    barcode <> null and barcode <> '' and
    BookCopy.allInstance()->exists(b | b.Barcode = barcode) and
    BookCopy.allInstance()->any(b | b.Barcode = barcode).IsReserved = true and
    BookCopy.allInstance()->any(b | b.Barcode = barcode).ReservationRecord->notEmpty()
            postcondition:
          let copy : BookCopy = BookCopy.allInstance()->any(b | b.Barcode = barcode) in
    if result = true then
        copy.IsReserved = false and
        copy.ReservationRecord->isEmpty() and
        (copy.Status = CopyStatus::AVAILABLE or copy.Status = CopyStatus::LIBUSEONLY or copy.Status = CopyStatus::INPROCESSING or copy.Status = CopyStatus::LOANED)
    else
        copy.IsReserved = copy.IsReserved@pre and
        copy.Status = copy.Status@pre and
        copy.ReservationRecord = copy.ReservationRecord@pre
    endif
            
        }