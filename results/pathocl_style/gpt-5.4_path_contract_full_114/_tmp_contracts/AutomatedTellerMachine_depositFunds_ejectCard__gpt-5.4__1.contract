Contract AutomatedTellerMachineSystem::ejectCard(): Boolean {
          precondition:
          true
            postcondition:
          result = true and
    BankCard.allInstance()->forAll(c |
        c.CardID = c@pre.CardID and
        c.CardStatus = c@pre.CardStatus and
        c.Catalog = c@pre.Catalog and
        c.Password = c@pre.Password and
        c.Balance = c@pre.Balance and
        c.BelongedUser = c@pre.BelongedUser
    ) and
    User.allInstance()->forAll(u |
        u.UserID = u@pre.UserID and
        u.Name = u@pre.Name and
        u.Address = u@pre.Address and
        u.OwnedCard = u@pre.OwnedCard
    )
            
        }