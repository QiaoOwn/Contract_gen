Contract RepairService::feedback(id:Integer,sid:Integer,score:Integer,des:String): Boolean {
          precondition:
          Repair.allInstance()->exists(r |
    r.Id = id and
    r.RaiseStaff.Id = sid and
    r.RaiseStaff.Role = 0 and
    r.Process = 2
  ) and
  score >= 1 and score <= 5
            postcondition:
          let r : Repair = Repair.allInstance()->any(x | x.Id = id) in
    r.Score = score and
    (
      if score >= 4 then
        r.Close = true and
        r.Process = r.Process@pre and
        r.Description = r.Description@pre
      else
        r.Close = false and
        r.Process = 0 and
        r.Description = des
      endif
    ) and
    result = true
            
        }