Contract CoCoMESystem::openStore(storeID:Integer): Boolean {
          precondition:
          Store.allInstance()->exists(s | s.Id = storeID and s.IsOpened = false)
            postcondition:
          let st : Store = Store.allInstance()->any(s | s.Id = storeID) in
    st.IsOpened = true and
    st.AssociationCashdeskes->forAll(cd | cd.IsOpened = cd.IsOpened@pre) and
    st.Cashiers = st.Cashiers@pre and
    st.Productcatalogs = st.Productcatalogs@pre and
    st.Items = st.Items@pre and
    st.Sales = st.Sales@pre and
    result = true
            
        }