Contract AirportSystem::createStaff(id:Integer,name:String,pswd:String,phone:String,role:Integer,bossid:Integer): Boolean {
          precondition:
          Staff.allInstance()->forAll(s | s.Id <> id)
            postcondition:
          let newStaff : Set(Staff) = Staff.allInstance()->select(s |
    s.Id = id and
    s.Name = name and
    s.Password = pswd and
    s.Phone = phone and
    s.Role = role
  ) in
  newStaff->size() = 1 and
  (Staff.allInstance()->exists(b | b.Id = bossid)
    implies newStaff->any(true).Boss = Staff.allInstance()->any(b | b.Id = bossid)) and
  (not Staff.allInstance()->exists(b | b.Id = bossid)
    implies newStaff->any(true).Boss.oclIsUndefined()) and
  result = true
            
        }