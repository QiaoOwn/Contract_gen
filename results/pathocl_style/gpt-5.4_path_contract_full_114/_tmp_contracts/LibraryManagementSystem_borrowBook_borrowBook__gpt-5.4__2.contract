Contract LibraryManagementSystemSystem::borrowBook(uid:String,barcode:String): Boolean {
          precondition:
          User.allInstance()->exists(u |
        u.UserID = uid and
        u.BorrowStatus <> BorrowStatus::SUSPEND and
        u.LoanedNumber < 10
    ) and
    BookCopy.allInstance()->exists(c |
        c.Barcode = barcode and
        (c.Status = CopyStatus::AVAILABLE or
         (c.IsReserved = true and Reserve.allInstance()->exists(r | r.ReservedUser = User.allInstance()->any(u | u.UserID = uid) and r.ReservedCopy = c)))
    )
            postcondition:
          let u : User = User.allInstance()->any(x | x.UserID = uid),
        c : BookCopy = BookCopy.allInstance()->any(x | x.Barcode = barcode),
        newLoan : Loan = Loan.allInstance()->any(l | l.oclIsNew() and l.LoanedUser = u and l.LoanedCopy = c and l.IsReturned = false)
    in
    result = true and
    newLoan.oclIsNew() and
    u.LoanedBook = u.LoanedBook@pre->including(newLoan) and
    c.LoanedRecord = c.LoanedRecord@pre->including(newLoan) and
    newLoan.LoanedUser = u and
    newLoan.LoanedCopy = c and
    newLoan.IsReturned = false and
    newLoan.RenewedTimes = 0 and
    c.Status = CopyStatus::LOANED and
    u.LoanedNumber = u.LoanedNumber@pre + 1 and
    (u.Faculty = 'Student' implies newLoan.DueDate > newLoan.LoanDate) and
    (u.Faculty <> 'Student' implies newLoan.DueDate > newLoan.LoanDate)
            
        }