Contract CoCoMESystem::changePrice(barcode:Integer,newPrice:Real): Boolean {
          precondition:
          barcode <> null and
    newPrice <> null and
    newPrice >= 0 and
    Store.allInstance()->exists(s | s.Items->exists(i | i.Barcode = barcode))
            postcondition:
          if Store.allInstance()->exists(s | s.Items->exists(i | i.Barcode = barcode)) and newPrice >= 0 then
        let targetItem : Item = Store.allInstance()->collect(s | s.Items)->flatten()->any(i | i.Barcode = barcode) in
        targetItem.Price = newPrice and
        result = true and
        Item.allInstance()->excluding(targetItem)->forAll(i |
            i.Price = i.Price@pre and
            i.Barcode = i.Barcode@pre and
            i.Name = i.Name@pre and
            i.StockNumber = i.StockNumber@pre and
            i.OrderPrice = i.OrderPrice@pre
        )
    else
        result = false and
        Item.allInstance()->forAll(i |
            i.Price = i.Price@pre and
            i.Barcode = i.Barcode@pre and
            i.Name = i.Name@pre and
            i.StockNumber = i.StockNumber@pre and
            i.OrderPrice = i.OrderPrice@pre
        )
    endif
            
        }