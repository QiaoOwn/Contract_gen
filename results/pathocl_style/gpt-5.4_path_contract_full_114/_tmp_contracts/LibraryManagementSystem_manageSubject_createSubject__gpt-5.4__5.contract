Contract ManageSubjectCRUDService::createSubject(name:String): Boolean {
          precondition:
          not name.oclIsUndefined() and
  name <> '' and
  Subject.allInstance()->forAll(s | s.Name <> name)
            postcondition:
          if result = true then
    Subject.allInstance()->exists(s |
      s.oclIsNew() and
      s.Name = name and
      s.SuperSubject->isEmpty() and
      s.SubSubject->isEmpty()
    ) and
    Subject.allInstance()->one(s | s.Name = name)
  else
    Subject.allInstance()->forAll(s |
      not s.oclIsNew()
    ) and
    Subject.allInstance()->forAll(s |
      s.Name <> name
    )
  endif
            
        }