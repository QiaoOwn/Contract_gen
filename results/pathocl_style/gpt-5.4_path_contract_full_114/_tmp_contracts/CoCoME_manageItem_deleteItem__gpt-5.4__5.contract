Contract ManageItemCRUDService::deleteItem(barcode:Integer): Boolean {
          precondition:
          barcode <> null and
  Store.allInstance()->exists(s | s.Items->exists(i | i.Barcode = barcode))
            postcondition:
          if Store.allInstance()->exists(s | s.Items@pre->exists(i | i.Barcode = barcode)) then
    result = true and
    Store.allInstance()->forAll(s |
      s.Items->forAll(i | i.Barcode <> barcode)
    ) and
    Store.allInstance()->forAll(s |
      s.Items->size() = s.Items@pre->select(i | i.Barcode <> barcode)->size()
    )
  else
    result = false and
    Store.allInstance()->forAll(s |
      s.Items = s.Items@pre
    )
  endif
            
        }