Contract ManageBankCardCRUDService::queryBankCard(cardid:Integer): BankCard {
          precondition:
          cardid <> null and
    BankCard.allInstance()->exists(b | b.CardID = cardid)
            postcondition:
          result <> null and
    result.CardID = cardid and
    BankCard.allInstance()->includes(result) and
    BankCard.allInstance()->forAll(b |
        b.oclIsTypeOf(BankCard) implies
        b.CardID = b.CardID and
        b.CardStatus = b.CardStatus and
        b.Catalog = b.Catalog and
        b.Password = b.Password and
        b.Balance = b.Balance and
        b.BelongedUser = b.BelongedUser
    )
            
        }