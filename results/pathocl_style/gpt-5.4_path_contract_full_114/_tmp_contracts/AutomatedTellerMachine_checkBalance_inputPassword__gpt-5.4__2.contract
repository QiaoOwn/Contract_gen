Contract AutomatedTellerMachineSystem::inputPassword(password:Integer): Boolean {
          precondition:
          password <> null and
    self.currentCard <> null and
    BankCard.allInstance()->includes(self.currentCard) and
    self.currentCard.CardStatus = CardStatus::NORMAL
            postcondition:
          result = (self.currentCard.Password = password) and
    self.currentCard.CardID = self.currentCard@pre.CardID and
    self.currentCard.CardStatus = self.currentCard@pre.CardStatus and
    self.currentCard.Catalog = self.currentCard@pre.Catalog and
    self.currentCard.Password = self.currentCard@pre.Password and
    self.currentCard.Balance = self.currentCard@pre.Balance and
    self.currentCard.BelongedUser = self.currentCard@pre.BelongedUser
            
        }