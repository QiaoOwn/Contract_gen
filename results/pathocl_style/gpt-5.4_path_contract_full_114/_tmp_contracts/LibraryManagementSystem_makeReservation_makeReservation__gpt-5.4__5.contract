Contract LibraryManagementSystemSystem::makeReservation(uid:String,barcode:String): Boolean {
          precondition:
          uid <> null and uid <> '' and
  barcode <> null and barcode <> '' and
  BookCopy.allInstance()->exists(b | b.Barcode = barcode) and
  BookCopy.allInstance()->any(b | b.Barcode = barcode).Status <> CopyStatus::LOANED and
  BookCopy.allInstance()->any(b | b.Barcode = barcode).Status <> CopyStatus::INPROCESSING and
  BookCopy.allInstance()->any(b | b.Barcode = barcode).IsReserved = false
            postcondition:
          let copy : BookCopy = BookCopy.allInstance()->any(b | b.Barcode = barcode) in
    if result = true then
      copy.IsReserved = true and
      copy.ReservationRecord->size() = copy.ReservationRecord@pre->size() + 1 and
      BookCopy.allInstance()->excluding(copy)->forAll(b |
        b.IsReserved = b.IsReserved@pre and
        b.Status = b.Status@pre and
        b.Location = b.Location@pre
      )
    else
      copy.IsReserved = copy.IsReserved@pre and
      copy.ReservationRecord->size() = copy.ReservationRecord@pre->size() and
      BookCopy.allInstance()->forAll(b |
        b.IsReserved = b.IsReserved@pre and
        b.Status = b.Status@pre and
        b.Location = b.Location@pre
      )
    endif
            
        }