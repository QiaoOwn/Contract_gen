Contract CoCoMESystem::openCashDesk(cashDeskID:Integer): Boolean {
          precondition:
          cashDeskID <> null and
  CashDesk.allInstance()->exists(cd |
    cd.Id = cashDeskID and
    cd.BelongedStore <> null and
    cd.BelongedStore.IsOpened = true and
    cd.IsOpened = false
  )
            postcondition:
          let cd : CashDesk = CashDesk.allInstance()->any(c | c.Id = cashDeskID) in
    cd.IsOpened = true and
    result = true and
    CashDesk.allInstance()->forAll(c |
      c.Id = cashDeskID implies c.IsOpened = true
    ) and
    CashDesk.allInstance()->forAll(c |
      c.Id <> cashDeskID implies c.IsOpened = c.IsOpened@pre
    )
            
        }