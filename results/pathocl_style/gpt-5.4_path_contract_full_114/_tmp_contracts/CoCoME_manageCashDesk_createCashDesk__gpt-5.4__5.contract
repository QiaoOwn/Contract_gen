Contract ManageCashDeskCRUDService::createCashDesk(id:Integer,name:String,isopened:Boolean): Boolean {
          precondition:
          id > 0 and
    name <> null and
    name <> '' and
    CashDesk.allInstance()->forAll(cd | cd.Id <> id)
            postcondition:
          if result = true then
        CashDesk.allInstance()->exists(cd |
            cd.Id = id and
            cd.Name = name and
            cd.IsOpened = isopened
        ) and
        CashDesk.allInstance()->size() = CashDesk.allInstance()->size() + 1
    else
        CashDesk.allInstance() = CashDesk.allInstance()
    endif
            
        }