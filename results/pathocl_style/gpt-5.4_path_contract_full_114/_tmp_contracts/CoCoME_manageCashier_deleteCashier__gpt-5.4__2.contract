Contract ManageCashierCRUDService::deleteCashier(id:Integer): Boolean {
          precondition:
          id <> null and
	Cashier.allInstance()->exists(c | c.Id = id)
            postcondition:
          let c : Cashier = Cashier.allInstance()->any(x | x.Id = id) in
	result = true and
	not Cashier.allInstance()->exists(x | x.Id = id) and
	Store.allInstance()->forAll(s |
		s.Cashiers = s.Cashiers@pre->excluding(c)
	)
            
        }