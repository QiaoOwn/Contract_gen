Contract CoCoMEOrderProducts::orderItem(barcode:Integer,quantity:Integer): Boolean {
          precondition:
          barcode <> null and quantity <> null and quantity > 0 and
Store.allInstance()->exists(s |
        s.Items->exists(i | i.Barcode = barcode)
    )
            postcondition:
          result = true implies
        Store.allInstance()->exists(s |
            s.Items->exists(i |
                i.Barcode = barcode and
                i.StockNumber = i.StockNumber@pre + quantity
            )
        ) and
Store.allInstance()->forAll(s |
        s.Items->forAll(i |
            i.Barcode <> barcode implies
                i.StockNumber = i.StockNumber@pre and
                i.Name = i.Name@pre and
                i.Price = i.Price@pre and
                i.OrderPrice = i.OrderPrice@pre
        )
    ) and
result = false implies
        Store.allInstance()->forAll(s |
            s.Items->forAll(i |
                i.StockNumber = i.StockNumber@pre and
                i.Name = i.Name@pre and
                i.Price = i.Price@pre and
                i.OrderPrice = i.OrderPrice@pre
            )
        )
            
        }