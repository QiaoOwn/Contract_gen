Contract ProcessSaleService::endSale(): Real {
          precondition:
          Sale.allInstance()->exists(s |
        s.IsReadytoPay = true and
        s.IsComplete = false and
        s.Belongedstore <> null and
        s.BelongedCashDesk <> null and
        s.Belongedstore.IsOpened = true and
        s.BelongedCashDesk.IsOpened = true and
        s.BelongedCashDesk.BelongedStore = s.Belongedstore and
        s.Belongedstore.AssociationCashdeskes->includes(s.BelongedCashDesk) and
        s.Belongedstore.Sales->includes(s) and
        s.BelongedCashDesk.ContainedSales->includes(s) and
        s.ContainedSalesLine->notEmpty()
    )
            postcondition:
          let endedSale : Set(Sale) = Sale.allInstance()->select(s |
        s.IsComplete = true and
        s.IsReadytoPay = true and
        s.Belongedstore <> null and
        s.BelongedCashDesk <> null and
        s.Belongedstore.IsOpened = true and
        s.BelongedCashDesk.IsOpened = true and
        s.BelongedCashDesk.BelongedStore = s.Belongedstore and
        s.Belongedstore.AssociationCashdeskes->includes(s.BelongedCashDesk) and
        s.Belongedstore.Sales->includes(s) and
        s.BelongedCashDesk.ContainedSales->includes(s) and
        s.ContainedSalesLine->notEmpty()
    ) in
    endedSale->exists(s |
        result = s.Amount and
        s.Amount = s.ContainedSalesLine.Subamount->sum()
    ) and
    endedSale->forAll(s |
        s.Amount = s.ContainedSalesLine.Subamount->sum()
    )
            
        }