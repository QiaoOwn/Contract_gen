Contract CoCoMEOrderProducts::makeNewOrder(orderid:Integer): Boolean {
          precondition:
          orderid <> null and
	self.BelongedStore <> null and
	self.IsOpened = true and
	self.BelongedStore.IsOpened = true and
	self.BelongedStore.Productcatalogs->notEmpty() and
	self.BelongedStore.Sales->forAll(s | s.Id <> orderid)
            postcondition:
          result = true and
	self.BelongedStore.Sales->exists(s |
		s.Id = orderid and
		self.BelongedStore.Sales = self.BelongedStore.Sales@pre->including(s)
	) and
	self.ContainedSales->exists(s |
		s.Id = orderid and
		self.ContainedSales = self.ContainedSales@pre->including(s)
	) and
	self.BelongedStore.Sales->size() = self.BelongedStore.Sales@pre->size() + 1 and
	self.ContainedSales->size() = self.ContainedSales@pre->size() + 1
            
        }