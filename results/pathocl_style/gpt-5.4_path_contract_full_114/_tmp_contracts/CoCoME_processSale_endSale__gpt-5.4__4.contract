Contract ProcessSaleService::endSale(): Real {
          precondition:
          let sale : Sale = Sale.allInstance()->any(s |
        not s.IsComplete and
        s.IsReadytoPay and
        s.Belongedstore.IsOpened and
        s.BelongedCashDesk.IsOpened
    ) in
    sale <> null and
    sale.Belongedstore <> null and
    sale.BelongedCashDesk <> null and
    sale.BelongedCashDesk.BelongedStore = sale.Belongedstore and
    sale.Belongedstore.Sales->includes(sale) and
    sale.BelongedCashDesk.ContainedSales->includes(sale) and
    sale.ContainedSalesLine->notEmpty() and
    sale.ContainedSalesLine->forAll(li |
        li.BelongedSale = sale and
        li.Quantity > 0 and
        li.Subamount >= 0 and
        li.BelongedItem <> null
    )
            postcondition:
          let sale : Sale = Sale.allInstance()->any(s |
        s.oclIsInState(s.oclType())
    ) in
    let targetSale : Sale = Sale.allInstance()->any(s |
        s.IsComplete and
        s.IsReadytoPay and
        s.Belongedstore.IsOpened and
        s.BelongedCashDesk.IsOpened and
        s.Belongedstore.Sales->includes(s) and
        s.BelongedCashDesk.ContainedSales->includes(s)
    ) in
    targetSale.IsComplete = true and
    targetSale.Amount = targetSale.ContainedSalesLine->collect(li | li.Subamount)->sum() and
    result = targetSale.Amount and
    targetSale.BelongedCashDesk.BelongedStore = targetSale.Belongedstore and
    targetSale.ContainedSalesLine->forAll(li | li.BelongedSale = targetSale)
            
        }