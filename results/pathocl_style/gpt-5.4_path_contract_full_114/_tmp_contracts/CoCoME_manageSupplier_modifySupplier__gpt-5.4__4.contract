Contract ManageSupplierCRUDService::modifySupplier(id:Integer,name:String): Boolean {
          precondition:
          id <> null and
  name <> null and
  Supplier.allInstance()->exists(s | s.Id = id)
            postcondition:
          Supplier.allInstance()->exists(s | s.Id = id and s.Name = name) and
  Supplier.allInstance()->forAll(s |
    s.Id = id implies s.Name = name
  ) and
  result = true
            
        }