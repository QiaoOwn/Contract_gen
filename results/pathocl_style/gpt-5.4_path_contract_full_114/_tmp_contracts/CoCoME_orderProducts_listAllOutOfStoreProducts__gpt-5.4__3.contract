Contract CoCoMEOrderProducts::listAllOutOfStoreProducts(): Set(Item) {
          precondition:
          true
            postcondition:
          result = Store.allInstance()->collect(s | s.Items)->flatten()->asSet()->select(i | i.StockNumber = 0) and
  Store.allInstance()->forAll(s | s.oclIsTypeOf(Store)) and
  Item.allInstance()->forAll(i | i.oclIsTypeOf(Item))
            
        }