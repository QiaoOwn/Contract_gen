Contract ManageUserCRUDService::deleteUser(userid:Integer): Boolean {
          precondition:
          userid <> null and
  User.allInstance()->exists(u | u.UserID = userid) and
  User.allInstance()->select(u | u.UserID = userid)->size() = 1
            postcondition:
          let deletedUser : Set(User) = User.allInstance()->select(u | u.UserID = userid) in
  deletedUser->size() = 1 and
  User.allInstance()->forAll(u | u.UserID <> userid) and
  BankCard.allInstance()->forAll(c | c.BelongedUser <> deletedUser->any(true)) and
  result = true
            
        }