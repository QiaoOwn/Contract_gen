Contract CoCoMEOrderProducts::placeOrder(): Boolean {
          precondition:
          CashDesk.allInstance()->exists(cd |
    cd.IsOpened = true and
    cd.BelongedStore <> null and
    cd.BelongedStore.IsOpened = true and
    cd.BelongedStore.Productcatalogs->notEmpty()
  )
            postcondition:
          result = true implies
    Sale.allInstance()->exists(s |
      s.IsComplete = false and
      s.IsReadytoPay = true and
      s.BelongedCashDesk <> null and
      s.BelongedCashDesk.IsOpened = true and
      s.Belongedstore = s.BelongedCashDesk.BelongedStore and
      s.Belongedstore.IsOpened = true and
      s.BelongedCashDesk.ContainedSales->includes(s) and
      s.Belongedstore.Sales->includes(s)
    )
  and
  result = false implies
    Sale.allInstance() = Sale.allInstance()
            
        }