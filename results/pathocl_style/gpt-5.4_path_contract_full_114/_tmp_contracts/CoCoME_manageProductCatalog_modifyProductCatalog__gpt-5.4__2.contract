Contract ManageProductCatalogCRUDService::modifyProductCatalog(id:Integer,name:String): Boolean {
          precondition:
          id <> null and
  name <> null and
  ProductCatalog.allInstance()->exists(pc | pc.Id = id)
            postcondition:
          let pc : ProductCatalog = ProductCatalog.allInstance()->any(p | p.Id = id) in
    pc.Name = name and
    result = true and
    ProductCatalog.allInstance()->one(p | p.Id = id) and
    pc.ContainedItems = pc.ContainedItems@pre and
    Store.allInstance()->forAll(s |
      s.Id = s.Id@pre and
      s.Name = s.Name@pre and
      s.Address = s.Address@pre and
      s.IsOpened = s.IsOpened@pre and
      s.AssociationCashdeskes = s.AssociationCashdeskes@pre and
      s.Productcatalogs = s.Productcatalogs@pre and
      s.Items = s.Items@pre and
      s.Cashiers = s.Cashiers@pre and
      s.Sales = s.Sales@pre
    ) and
    CashDesk.allInstance()->forAll(cd |
      cd.Id = cd.Id@pre and
      cd.Name = cd.Name@pre and
      cd.IsOpened = cd.IsOpened@pre and
      cd.ContainedSales = cd.ContainedSales@pre and
      cd.BelongedStore = cd.BelongedStore@pre
    ) and
    Cashier.allInstance()->forAll(c |
      c.Id = c.Id@pre and
      c.Name = c.Name@pre and
      c.WorkedStore = c.WorkedStore@pre
    ) and
    ProductCatalog.allInstance()->excluding(pc)->forAll(other |
      other.Id = other.Id@pre and
      other.Name = other.Name@pre and
      other.ContainedItems = other.ContainedItems@pre
    )
            
        }