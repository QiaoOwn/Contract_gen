Contract ManageLoanTermCRUDService::queryLoanTerm(itemid:Integer): LoanTerm {
          precondition:
          itemid <> null and
  LoanTerm.allInstance()->exists(lt | lt.ItemID = itemid)
            postcondition:
          result <> null and
  result.ItemID = itemid and
  LoanTerm.allInstance() = LoanTerm.allInstance() and
  Loan.allInstance() = Loan.allInstance() and
  LoanRequest.allInstance() = LoanRequest.allInstance() and
  LoanAccount.allInstance() = LoanAccount.allInstance()
            
        }