Contract ManageUserCRUDService::deleteUser(userid:Integer): Boolean {
          precondition:
          userid.oclIsUndefined() = false and
  User.allInstance()->exists(u | u.UserID = userid)
            postcondition:
          let deletedUsers : Set(User) = User.allInstance()->select(u | u.UserID = userid) in
  let deletedCards : Set(BankCard) = BankCard.allInstance()->select(c | deletedUsers->includes(c.BelongedUser)) in
    result = true and
    User.allInstance()->forAll(u | u.UserID <> userid) and
    deletedCards->forAll(c | not BankCard.allInstance()->includes(c)) and
    BankCard.allInstance()->forAll(c | c.BelongedUser.UserID <> userid)
            
        }