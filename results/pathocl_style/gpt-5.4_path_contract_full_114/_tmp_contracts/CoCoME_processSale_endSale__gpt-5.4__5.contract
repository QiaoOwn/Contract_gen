Contract ProcessSaleService::endSale(): Real {
          precondition:
          Sale.allInstance()->exists(s |
        not s.IsComplete and
        s.IsReadytoPay and
        not s.ContainedSalesLine->isEmpty() and
        s.Belongedstore.IsOpened and
        s.BelongedCashDesk.IsOpened and
        s.BelongedCashDesk.BelongedStore = s.Belongedstore and
        s.Belongedstore.Sales->includes(s) and
        s.BelongedCashDesk.ContainedSales->includes(s)
    )
            postcondition:
          let completedSale : Sale = Sale.allInstance()->any(s |
        s.IsComplete and
        s.IsReadytoPay and
        s.Belongedstore.IsOpened and
        s.BelongedCashDesk.IsOpened and
        s.BelongedCashDesk.BelongedStore = s.Belongedstore and
        s.Belongedstore.Sales->includes(s) and
        s.BelongedCashDesk.ContainedSales->includes(s)
    ) in
    completedSale.ContainedSalesLine->notEmpty() and
    completedSale.Amount = completedSale.ContainedSalesLine->collect(Subamount)->sum() and
    result = completedSale.Amount
            
        }