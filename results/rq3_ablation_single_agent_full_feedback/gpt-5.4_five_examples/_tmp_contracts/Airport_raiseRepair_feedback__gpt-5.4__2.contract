Contract RepairService::feedback(id: Integer, sid: Integer, score: Integer, des: String): Boolean {
  definition:
    repair: Repair = Repair.allInstance()->any(r | r.Id = id), staff: Staff = Staff.allInstance()->any(s | s.Id = sid), highScore:Boolean = if score >= 4 then true else false endif
  precondition:
    repair.oclIsUndefined() = false and staff.oclIsUndefined() = false and repair.RaiseStaff = staff and staff.Role = 1 and repair.Process = 3 and score >= 1 and score <= 5
  postcondition:
    repair.Score = score and repair.Close = highScore and if highScore = true then repair.Process = repair.Process@pre and repair.Description = repair.Description@pre else repair.Description = des and repair.Process = 0 endif and result = true
}