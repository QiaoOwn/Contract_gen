Contract LoanProcessingSystemSystem::loanPayment(loanid: Integer): Boolean {
  definition:
    loan: Loan = Loan.allInstance()->any(o | o.LoanID = loanid), loanAccount: LoanAccount = loan.BelongedLoanAccount, repaymentAmount: Real = loan.RepaymentAmount, remainAfterPayment: Real = loan.RemainAmountToPay - repaymentAmount
  precondition:
    loan.oclIsUndefined() = false and Loan.allInstance()->includes(loan) and loanAccount.oclIsUndefined() = false and loan.Status = LoanStatus::LSOPEN and loan.IsPaidinFull = false and repaymentAmount > 0 and loan.RemainAmountToPay >= repaymentAmount
  postcondition:
    loan.RemainAmountToPay = remainAfterPayment and loanAccount.Balance = loanAccount.Balance@pre + repaymentAmount and loan.IsPaidinFull = if remainAfterPayment = 0 then true else false endif and loan.Status = if remainAfterPayment = 0 then LoanStatus::CLOSED else LoanStatus::LSOPEN endif and loanAccount.Status = if remainAfterPayment = 0 then LoanAccountStatus::HASPAIDINFULL else LoanAccountStatus::NORMAL endif and result = true
}