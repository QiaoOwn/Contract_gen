Contract AutomatedTellerMachineSystem::inputCard(cardid: Integer): Boolean {
  definition:
    bankCard: BankCard = BankCard.allInstance()->any(o | o.CardID = cardid)
  precondition:
    cardid.oclIsTypeOf(Integer) and bankCard.oclIsUndefined() = false and BankCard.allInstance()->includes(bankCard) and bankCard.CardStatus = CardStatus::NORMAL
  postcondition:
    self.InputCard = bankCard and self.CardIDValidated = true and result = true
}