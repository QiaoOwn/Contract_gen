Contract CoCoMESystem::openCashDesk(cashDeskID: Integer): Boolean {
  definition:
    cashDesk: CashDesk = CashDesk.allInstance()->any(o | o.Id = cashDeskID), currentStore: Store = cashDesk.BelongedStore
  precondition:
    cashDesk.oclIsUndefined() = false and currentStore.oclIsUndefined() = false and cashDesk.IsOpened = false and currentStore.IsOpened = true
  postcondition:
    cashDesk.IsOpened = true and self.CurrentCashDesk = cashDesk and self.CurrentStore = currentStore and result = true
}