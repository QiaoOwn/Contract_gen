Contract ManageStoreCRUDService::modifyStore(id: Integer, name: String, address: String, isopened: Boolean): Boolean {
  definition:
    store: Store = Store.allInstance()->any(o | o.Id = id)
  precondition:
    id > 0 and store.oclIsUndefined() = false and Store.allInstance()->includes(store)
  postcondition:
    store.Name = name and store.Address = address and store.IsOpened = isopened and result = true
}