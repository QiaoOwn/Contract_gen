Contract AutomatedTellerMachineSystem::depositFunds(quantity: Real): Boolean {
  definition:
    inputCard: BankCard = self.InputCard
  precondition:
    self.PasswordValidated = true and self.CardIDValidated = true and self.IsDeposit = true and inputCard.oclIsUndefined() = false and BankCard.allInstance()->includes(inputCard) and quantity > 0 and inputCard.CardStatus = BankCard::NORMAL
  postcondition:
    inputCard.Balance = inputCard.Balance@pre + quantity and self.DepositedNumber = quantity and result = true
}