Contract EnterValidatedCreditReferencesModule::chooseLoanRequest(requestid: Integer): LoanRequest {
  definition:
    loanRequest: LoanRequest = LoanRequest.allInstance()->any(o | o.RequestID = requestid)
  precondition:
    loanRequest.oclIsUndefined() = false and LoanRequest.allInstance()->includes(loanRequest) and loanRequest.Status = LoanRequestStatus::SUBMITTED
  postcondition:
    self.CurrentLoanRequest = loanRequest and result = loanRequest
}