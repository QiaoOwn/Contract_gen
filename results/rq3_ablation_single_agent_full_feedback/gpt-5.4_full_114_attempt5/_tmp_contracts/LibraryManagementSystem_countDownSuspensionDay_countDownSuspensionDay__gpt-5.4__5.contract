Contract LibraryManagementSystemSystem::countDownSuspensionDay(): void {
  definition:
    users:Set(User) = User.allInstance()->select(u | u.SuspensionDays > 0)
  precondition:
    users.isEmpty() = false
  postcondition:
    users->forAll(u:User | u.SuspensionDays = u.SuspensionDays@pre - 1 and if u.SuspensionDays@pre - 1 = 0 then u.BorrowStatus = BorrowStatus::SUSPEND else u.BorrowStatus = u.BorrowStatus@pre endif)
}