Contract AutomatedTellerMachineSystem::ejectCard(): Boolean {
  definition:
    inputCard: BankCard = self.InputCard, success: Boolean = if inputCard.oclIsUndefined() = false then true else false endif
  precondition:
    inputCard.oclIsUndefined() = false and BankCard.allInstance()->includes(inputCard)
  postcondition:
    self.InputCard = null and self.CardIDValidated = false and self.PasswordValidated = false and result = success
}