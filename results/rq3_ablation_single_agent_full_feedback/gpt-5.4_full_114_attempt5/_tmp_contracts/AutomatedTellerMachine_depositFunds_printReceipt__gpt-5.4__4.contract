Contract AutomatedTellerMachineSystem::printReceipt(): Real {
  definition:
    inputCard: BankCard = self.InputCard
  precondition:
    inputCard.oclIsUndefined() = false and BankCard.allInstance()->includes(inputCard) and self.CardIDValidated = true and self.PasswordValidated = true and self.IsDeposit = true and self.DepositedNumber > 0 and inputCard.CardStatus = BankCard::NORMAL
  postcondition:
    result = self.DepositedNumber
}