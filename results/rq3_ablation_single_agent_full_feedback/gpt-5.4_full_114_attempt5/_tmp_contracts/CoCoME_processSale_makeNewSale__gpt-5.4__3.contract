Contract ProcessSaleService::makeNewSale(): Boolean {
  definition:
    openedStores:Set(Store) = Store.allInstance()->select(s | s.IsOpened = true)
  precondition:
    openedStores.isEmpty() = false
  postcondition:
    let sale:Sale in sale.oclIsNew() and Sale.allInstance()->includes(sale) and sale.IsComplete = false and sale.Amount = 0.0 and sale.IsReadytoPay = false and result = true
}