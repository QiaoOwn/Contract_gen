Contract AutomatedTellerMachineSystem::ejectCard(): Boolean {
  definition:
    inputCard: BankCard = self.InputCard
  precondition:
    inputCard.oclIsUndefined() = false and BankCard.allInstance()->includes(inputCard)
  postcondition:
    self.InputCard = null and self.CardIDValidated = false and self.PasswordValidated = false and self.IsWithdraw = false and self.IsDeposit = false and self.WithdrawedNumber = 0 and self.DepositedNumber = 0 and result = true
}