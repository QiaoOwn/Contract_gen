Contract ManageItemCRUDService::deleteItem(barcode: Integer): Boolean {
  definition:
    item: Item = Item.allInstance()->any(i | i.Barcode = barcode),
    salesLineItems:Set(SalesLineItem) = SalesLineItem.allInstance()->select(sli | sli.BelongedItem = item),
    orderEntries:Set(OrderEntry) = OrderEntry.allInstance()->select(oe | oe.Item = item),
    catalog:ProductCatalog = item.BelongedCatalog
  precondition:
    item.oclIsUndefined() = false and Item.allInstance()->includes(item) and salesLineItems.isEmpty() = true and orderEntries.isEmpty() = true
  postcondition:
    Item.allInstance()->excludes(item) and catalog.ContainedItems->excludes(item) and result = true
}