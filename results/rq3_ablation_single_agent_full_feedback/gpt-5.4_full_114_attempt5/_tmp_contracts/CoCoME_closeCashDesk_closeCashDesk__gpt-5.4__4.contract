Contract CoCoMESystem::closeCashDesk(cashDeskID: Integer): Boolean {
  definition:
    cashDesk: CashDesk = CashDesk.allInstance()->any(o | o.Id = cashDeskID), unfinishedSales: Set(Sale) = cashDesk.ContainedSales->select(o | o.IsComplete = false)
  precondition:
    cashDesk.oclIsUndefined() = false and CashDesk.allInstance()->includes(cashDesk) and cashDesk.Id = cashDeskID and cashDesk.IsOpened = true and unfinishedSales.isEmpty() = true
  postcondition:
    cashDesk.IsOpened = false and self.CurrentCashDesk = null and result = true
}