Contract ManageBankCardCRUDService::createBankCard(cardid: Integer, cardstatus: CardStatus, catalog: CardCatalog, password: Integer, balance: Real): Boolean {
  definition:
    bankCard: BankCard = BankCard.allInstance()->any(o | o.CardID = cardid)
  precondition:
    cardid.oclIsTypeOf(Integer) and cardstatus.oclIsTypeOf(CardStatus) and catalog.oclIsTypeOf(CardCatalog) and password.oclIsTypeOf(Integer) and balance.oclIsTypeOf(Real) and bankCard.oclIsUndefined() = true and balance >= 0
  postcondition:
    let newBankCard:BankCard in newBankCard.oclIsNew() and BankCard.allInstance()->includes(newBankCard) and newBankCard.CardID = cardid and newBankCard.CardStatus = cardstatus and newBankCard.Catalog = catalog and newBankCard.Password = password and newBankCard.Balance = balance and result = true
}