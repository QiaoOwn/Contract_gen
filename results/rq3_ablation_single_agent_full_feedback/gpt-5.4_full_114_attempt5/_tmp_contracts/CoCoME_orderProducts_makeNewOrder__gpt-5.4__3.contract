Contract CoCoMEOrderProducts::makeNewOrder(orderid: Integer): Boolean {
  definition:
    sameOrder:OrderProduct = OrderProduct.allInstance()->any(o | o.Id = orderid)
  precondition:
    sameOrder.oclIsUndefined() = true and OrderProduct.allInstance()->isUnique(o:OrderProduct | o.Id)
  postcondition:
    let newOrder:OrderProduct in newOrder.oclIsNew() and OrderProduct.allInstance()->includes(newOrder) and newOrder.Id = orderid and newOrder.OrderStatus = OrderProduct::NEW and newOrder.Amount = 0 and self.CurrentOrderProduct = newOrder and result = true
}