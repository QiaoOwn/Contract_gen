Contract EvaluateLoanRequestModule::addLoanTerm(termid: Integer): Boolean {
  definition:
    currentLoanRequest: LoanRequest = self.CurrentLoanRequest, loanTerm: LoanTerm = LoanTerm.allInstance()->any(o | o.ItemID = termid), existingLoanTerms: Set(LoanTerm) = currentLoanRequest.AttachedLoanTerms->select(o | o.ItemID = termid)
  precondition:
    termid.oclIsTypeOf(Integer) and currentLoanRequest.oclIsUndefined() = false and LoanRequest.allInstance()->includes(currentLoanRequest) and loanTerm.oclIsUndefined() = false and LoanTerm.allInstance()->includes(loanTerm) and existingLoanTerms.isEmpty() = true
  postcondition:
    self.CurrentLoanRequest.AttachedLoanTerms->includes(loanTerm) and result = true
}