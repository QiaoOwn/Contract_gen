Contract LoanProcessingSystemSystem::loanPayment(loanid: Integer): Boolean {
  definition:
    loan: Loan = Loan.allInstance()->any(o | o.LoanID = loanid), loanAccount: LoanAccount = loan.BelongedLoanAccount, repaymentAmount: Real = loan.RepaymentAmount, isPaidInFullAfterPayment: Boolean = if loan.RemainAmountToPay = repaymentAmount then true else false endif
  precondition:
    loan.oclIsUndefined() = false and Loan.allInstance()->includes(loan) and loanAccount.oclIsUndefined() = false and loan.Status = LoanStatus::LSOPEN and loan.IsPaidinFull = false and loan.RemainAmountToPay >= repaymentAmount and repaymentAmount > 0
  postcondition:
    loan.RemainAmountToPay = loan.RemainAmountToPay@pre - repaymentAmount and loanAccount.Balance = loanAccount.Balance@pre + repaymentAmount and loan.IsPaidinFull = isPaidInFullAfterPayment and if isPaidInFullAfterPayment = true then loan.Status = LoanStatus::CLOSED and loanAccount.Status = LoanAccountStatus::HASPAIDINFULL else loan.Status = loan.Status@pre and loanAccount.Status = loanAccount.Status@pre endif and result = true
}