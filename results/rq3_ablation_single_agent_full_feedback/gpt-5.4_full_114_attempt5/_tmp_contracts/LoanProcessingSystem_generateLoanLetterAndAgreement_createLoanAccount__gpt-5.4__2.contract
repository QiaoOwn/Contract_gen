Contract GenerateLoanLetterAndAgreementModule::createLoanAccount(loanaccountid: Integer, balance: Real, status: LoanAccountStatus[NORMAL|HASPAIDINFULL]): Boolean {
  definition:
    currentLoanRequest: LoanRequest = self.CurrentLoanRequests->any(o | o.RequestID = self.CurrentApprovalLetter.AttachedLoanRequest.RequestID),
    currentLoan: Loan = currentLoanRequest.ApprovalLoan,
    existingLoanAccount: LoanAccount = LoanAccount.allInstance()->any(o | o.LoanAccountID = loanaccountid)
  precondition:
    self.CurrentApprovalLetter.oclIsUndefined() = false and currentLoanRequest.oclIsUndefined() = false and currentLoan.oclIsUndefined() = false and existingLoanAccount.oclIsUndefined() = true and loanaccountid > 0 and balance >= 0
  postcondition:
    let newLoanAccount: LoanAccount in newLoanAccount.oclIsNew() and LoanAccount.allInstance()->includes(newLoanAccount) and newLoanAccount.LoanAccountID = loanaccountid and newLoanAccount.Balance = balance and newLoanAccount.Status = status and currentLoan.BelongedLoanAccount = newLoanAccount and result = true
}