Contract GenerateLoanLetterAndAgreementModule::genereateApprovalLetter(id: Integer): Boolean {
  definition:
    loanRequest: LoanRequest = LoanRequest.allInstance()->any(o | o.RequestID = id)
  precondition:
    loanRequest.oclIsUndefined() = false and LoanRequest.allInstance()->includes(loanRequest) and loanRequest.Status = LoanRequestStatus::APPROVED and loanRequest.AttachedApprovalLetter.oclIsUndefined() = false
  postcondition:
    loanRequest.AttachedApprovalLetter.Content = "Approval Letter" and result = true
}