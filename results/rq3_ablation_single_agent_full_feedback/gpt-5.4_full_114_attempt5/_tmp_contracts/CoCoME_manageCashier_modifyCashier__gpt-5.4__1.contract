Contract ManageCashierCRUDService::modifyCashier(id: Integer, name: String): Boolean {
  definition:
    cashier: Cashier = Cashier.allInstance()->any(c | c.Id = id)
  precondition:
    cashier.oclIsUndefined() = false and name.oclIsTypeOf(String) and name <> ""
  postcondition:
    cashier.Name = name and result = true
}