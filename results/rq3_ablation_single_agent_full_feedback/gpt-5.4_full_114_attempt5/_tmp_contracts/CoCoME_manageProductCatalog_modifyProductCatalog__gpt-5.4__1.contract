Contract ManageProductCatalogCRUDService::modifyProductCatalog(id: Integer, name: String): Boolean {
  definition:
    productCatalog: ProductCatalog = ProductCatalog.allInstance()->any(o | o.Id = id)
  precondition:
    productCatalog.oclIsUndefined() = false and name.oclIsTypeOf(String) and name <> ""
  postcondition:
    productCatalog.Name = name and result = true
}