Contract AutomatedTellerMachineSystem::printReceipt(): Real {
  definition:
    inputCard: BankCard = self.InputCard, receiptAmount: Real = self.DepositedNumber
  precondition:
    inputCard.oclIsUndefined() = false and BankCard.allInstance()->includes(inputCard) and self.CardIDValidated = true and self.PasswordValidated = true and self.IsDeposit = true and receiptAmount > 0
  postcondition:
    result = receiptAmount
}