Contract EvaluateLoanRequestModule::listTenLoanRequest(): Set(LoanRequest) {
  definition:
    readyForReviewRequests:Set(LoanRequest) = LoanRequest.allInstance()->select(o | o.Status = LoanRequestStatus::READYFORREVIEW)
  precondition:
    readyForReviewRequests.isEmpty() = false
  postcondition:
    self.CurrentLoanRequests = readyForReviewRequests and result = self.CurrentLoanRequests
}