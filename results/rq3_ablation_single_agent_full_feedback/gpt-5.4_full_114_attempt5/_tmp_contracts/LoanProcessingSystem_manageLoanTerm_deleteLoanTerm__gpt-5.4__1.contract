Contract ManageLoanTermCRUDService::deleteLoanTerm(itemid: Integer): Boolean {
  definition:
    loanTerm: LoanTerm = LoanTerm.allInstance()->any(o | o.ItemID = itemid)
  precondition:
    loanTerm.oclIsUndefined() = false and LoanTerm.allInstance()->includes(loanTerm)
  postcondition:
    LoanTerm.allInstance()->excludes(loanTerm) and result = true
}