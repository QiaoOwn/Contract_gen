Contract AutomatedTellerMachineSystem::inputPassword(password: Integer): Boolean {
  definition:
    inputCard: BankCard = self.InputCard,
    validPassword: Boolean = if inputCard.Password = password then true else false endif
  precondition:
    password.oclIsTypeOf(Integer) and inputCard.oclIsUndefined() = false and BankCard.allInstance()->includes(inputCard) and self.CardIDValidated = true and inputCard.CardStatus = CardStatus::NORMAL
  postcondition:
    self.PasswordValidated = validPassword and result = validPassword
}