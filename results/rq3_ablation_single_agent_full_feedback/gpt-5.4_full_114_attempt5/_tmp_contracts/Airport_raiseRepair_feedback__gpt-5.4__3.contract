Contract RepairService::feedback(id: Integer, sid: Integer, score: Integer, des: String): Boolean {
  definition:
    repair: Repair = Repair.allInstance()->any(r | r.Id = id), staff: Staff = Staff.allInstance()->any(s | s.Id = sid), highScore:Boolean = if score >= 4 then true else false endif
  precondition:
    Repair.allInstance()->includes(repair) and Staff.allInstance()->includes(staff) and repair.RaiseStaff = staff and staff.Role = 1 and repair.Process = 3 and score >= 1 and score <= 5
  postcondition:
    if highScore = true then repair.Score = score and repair.Close = true and result = true else repair.Score = score and repair.Close = false and repair.Description = des and repair.Process = 0 and result = true endif
}