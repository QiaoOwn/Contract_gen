Contract EvaluateLoanRequestModule::approveLoanRequest(): Boolean {
  definition:
    
  precondition:
    CurrentLoanRequest.oclIsUndefined() = false and LoanRequest.allInstance()->includes(CurrentLoanRequest) and CurrentLoanRequest.Status = LoanRequestStatus::READYFORREVIEW
  postcondition:
    CurrentLoanRequest.Status = LoanRequestStatus::APPROVED and result = true
}