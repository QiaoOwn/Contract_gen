Contract ManageCashierCRUDService::createCashier(id: Integer, name: String): Boolean {
  definition:
    cashier: Cashier = Cashier.allInstance()->any(c | c.Id = id)
  precondition:
    cashier.oclIsUndefined() = true and name <> ""
  postcondition:
    let newCashier:Cashier in newCashier.oclIsNew() and Cashier.allInstance()->includes(newCashier) and newCashier.Id = id and newCashier.Name = name and result = true
}