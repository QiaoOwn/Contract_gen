Contract AutomatedTellerMachineSystem::checkBalance(): Real {
  definition:
    inputCard: BankCard = self.InputCard
  precondition:
    inputCard.oclIsUndefined() = false and BankCard.allInstance()->includes(inputCard) and self.PasswordValidated = true and self.CardIDValidated = true and inputCard.CardStatus = CardStatus::NORMAL
  postcondition:
    result = inputCard.Balance
}