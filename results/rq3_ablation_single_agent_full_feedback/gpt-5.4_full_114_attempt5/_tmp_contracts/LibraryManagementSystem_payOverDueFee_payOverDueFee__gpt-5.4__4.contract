Contract LibraryManagementSystemSystem::payOverDueFee(uid: String, fee: Real): Boolean {
  definition:
    user: User = User.allInstance()->any(u | u.UserID = uid)
  precondition:
    uid.oclIsUndefined() = false and fee.oclIsUndefined() = false and user.oclIsUndefined() = false and User.allInstance()->includes(user) and fee > 0 and user.OverDueFee >= fee
  postcondition:
    user.OverDueFee = fee and result = true
}