Contract CoCoMESystem::closeStore(storeID: Integer): Boolean {
  definition:
    store: Store = Store.allInstance()->any(s | s.Id = storeID),
    openedCashDesks: Set(CashDesk) = store.AssociationCashdeskes->select(c | c.IsOpened = true)
  precondition:
    store.oclIsUndefined() = false and Store.allInstance()->includes(store) and store.Id = storeID and store.IsOpened = true and openedCashDesks.isEmpty() = true
  postcondition:
    store.IsOpened = false and result = true
}