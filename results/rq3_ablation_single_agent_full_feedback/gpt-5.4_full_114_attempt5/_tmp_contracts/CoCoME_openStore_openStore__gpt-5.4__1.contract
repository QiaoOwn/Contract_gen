Contract CoCoMESystem::openStore(storeID: Integer): Boolean {
  definition:
    store: Store = Store.allInstance()->any(o | o.Id = storeID)
  precondition:
    store.oclIsUndefined() = false and Store.allInstance()->includes(store) and store.IsOpened = false
  postcondition:
    store.IsOpened = true and self.CurrentStore = store and result = true
}