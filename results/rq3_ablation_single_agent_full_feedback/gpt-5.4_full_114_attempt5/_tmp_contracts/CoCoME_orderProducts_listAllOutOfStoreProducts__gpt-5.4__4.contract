Contract CoCoMEOrderProducts::listAllOutOfStoreProducts(): Set(Item) {
  definition:
    outOfStoreProducts:Set(Item) = Item.allInstance()->select(i | i.StockNumber <= 0)
  precondition:
    Item.allInstance().oclIsTypeOf(Set(Item)) and outOfStoreProducts.oclIsTypeOf(Set(Item))
  postcondition:
    result = outOfStoreProducts
}