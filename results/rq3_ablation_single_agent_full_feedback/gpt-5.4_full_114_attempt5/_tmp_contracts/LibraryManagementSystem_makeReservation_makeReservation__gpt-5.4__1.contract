Contract LibraryManagementSystemSystem::makeReservation(uid: String, barcode: String): Boolean {
  definition:
    user: User = User.allInstance()->any(u | u.UserID = uid),
    copy: BookCopy = BookCopy.allInstance()->any(c | c.Barcode = barcode),
    openReservations: Set(Reserve) = copy.ReservationRecord->select(r | r.IsReserveClosed = false)
  precondition:
    uid.oclIsTypeOf(String) and barcode.oclIsTypeOf(String) and user.oclIsUndefined() = false and copy.oclIsUndefined() = false and user.BorrowStatus = BorrowStatus::NORMAL and user.OverDueFee = 0 and copy.Status = CopyStatus::LOANED and copy.IsReserved = false and openReservations.isEmpty() = true
  postcondition:
    let reserve: Reserve in reserve.oclIsNew() and Reserve.allInstance()->includes(reserve) and reserve.ReservedUser = user and reserve.ReservedCopy = copy and reserve.IsReserveClosed = false and user.ReservedBook->includes(reserve) and copy.ReservationRecord->includes(reserve) and copy.IsReserved = true and result = true
}