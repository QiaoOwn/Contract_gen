Contract ManageCashDeskCRUDService::queryCashDesk(id: Integer): CashDesk {
  definition:
    cashDesk: CashDesk = CashDesk.allInstance()->any(c | c.Id = id)
  precondition:
    id.oclIsTypeOf(Integer) and cashDesk.oclIsUndefined() = false and CashDesk.allInstance()->includes(cashDesk)
  postcondition:
    result = cashDesk
}