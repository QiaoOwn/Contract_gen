Contract ManageStoreCRUDService::deleteStore(id: Integer): Boolean {
  definition:
    store: Store = Store.allInstance()->any(o | o.Id = id)
  precondition:
    store.oclIsUndefined() = false and Store.allInstance()->includes(store) and store.AssociationCashdeskes.size() = 0 and store.Productcatalogs.size() = 0 and store.Items.size() = 0 and store.Cashiers.size() = 0 and store.Sales.size() = 0
  postcondition:
    Store.allInstance()->excludes(store) and result = true
}