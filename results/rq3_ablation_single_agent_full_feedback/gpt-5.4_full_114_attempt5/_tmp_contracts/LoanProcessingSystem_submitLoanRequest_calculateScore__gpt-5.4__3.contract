Contract SubmitLoanRequestModule::calculateScore(): Integer {
  definition:
    currentLoanRequest: LoanRequest = self.CurrentLoanRequest,
    requestedCreditHistory: CreditHistory = currentLoanRequest.RequestedCreditHistory,
    scoreValue: Integer = if requestedCreditHistory.BadDebits > 10 then 0 else 100 endif
  precondition:
    currentLoanRequest.oclIsUndefined() = false and requestedCreditHistory.oclIsUndefined() = false and LoanRequest.allInstance()->includes(currentLoanRequest) and currentLoanRequest.Status = LoanRequestStatus::REFERENCESVALIDATED
  postcondition:
    currentLoanRequest.CreditScore = scoreValue and result = scoreValue
}