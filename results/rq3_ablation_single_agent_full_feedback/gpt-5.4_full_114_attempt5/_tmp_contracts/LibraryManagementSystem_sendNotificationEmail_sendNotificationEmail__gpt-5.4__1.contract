Contract ThirdPartyServices::sendNotificationEmail(email: String): Boolean {
  definition:
    user: User = User.allInstance()->any(u | u.Email = email)
  precondition:
    email.oclIsTypeOf(String) and user.oclIsUndefined() = false
  postcondition:
    ThirdPartyServices.sendNotificationEmail(email) and result = true
}