Contract SubmitLoanRequestModule::calculateScore(): Integer {
  definition:
    currentLoanRequest: LoanRequest = self.CurrentLoanRequest,
    requestedCreditHistory: CreditHistory = currentLoanRequest.RequestedCreditHistory,
    scoreValue: Integer = 100 - requestedCreditHistory.BadDebits * 10
  precondition:
    currentLoanRequest.oclIsUndefined() = false and requestedCreditHistory.oclIsUndefined() = false and LoanRequest.allInstance()->includes(currentLoanRequest) and scoreValue >= 0
  postcondition:
    currentLoanRequest.CreditScore = scoreValue and result = scoreValue
}