Contract ManageItemCRUDService::queryItem(barcode: Integer): Item {
  definition:
    item: Item = Item.allInstance()->any(i | i.Barcode = barcode)
  precondition:
    barcode.oclIsTypeOf(Integer) and item.oclIsUndefined() = false and Item.allInstance()->includes(item)
  postcondition:
    result = item
}