Contract ListBookHistory::listOverDueBook(uid: String): Set(BookCopy) {
  definition:
    user: User = User.allInstance()->any(u | u.UserID = uid),
    loans: Set(Loan) = user.LoanedBook->select(l | l.IsReturned = false and l.OverDueFee > 0),
    bookCopies: Set(BookCopy) = loans->collect(l | l.LoanedCopy)
  precondition:
    uid.oclIsTypeOf(String) and user.oclIsUndefined() = false
  postcondition:
    result = bookCopies
}