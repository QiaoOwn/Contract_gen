Contract EvaluateLoanRequestModule::checkCreditHistory(): CreditHistory {
  definition:
    creditHistory: CreditHistory = CurrentLoanRequest.RequestedCreditHistory
  precondition:
    CurrentLoanRequest.oclIsUndefined() = false and LoanRequest.allInstance()->includes(CurrentLoanRequest) and creditHistory.oclIsUndefined() = false and CreditHistory.allInstance()->includes(creditHistory) and CurrentLoanRequest.Status = LoanRequestStatus::READYFORREVIEW
  postcondition:
    CurrentLoanRequest.RequestedCreditHistory = creditHistory and result = creditHistory
}