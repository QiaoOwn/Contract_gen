Contract ProcessSaleService::makeNewSale(): Boolean {
  definition:
    
  precondition:
    self.CurrentSale.oclIsUndefined() = true
  postcondition:
    let sale:Sale in sale.oclIsNew() and Sale.allInstance()->includes(sale) and sale.IsComplete = false and sale.Amount = 0.0 and sale.IsReadytoPay = false and self.CurrentSale = sale and result = true
}