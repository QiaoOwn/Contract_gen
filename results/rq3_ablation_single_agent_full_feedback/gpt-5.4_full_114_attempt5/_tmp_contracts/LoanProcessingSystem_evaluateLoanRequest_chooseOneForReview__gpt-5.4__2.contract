Contract EvaluateLoanRequestModule::chooseOneForReview(requestid: Integer): LoanRequest {
  definition:
    loanRequest: LoanRequest = LoanRequest.allInstance()->any(o | o.RequestID = requestid)
  precondition:
    loanRequest.oclIsUndefined() = false and LoanRequest.allInstance()->includes(loanRequest) and loanRequest.Status = LoanRequestStatus::READYFORREVIEW
  postcondition:
    result = loanRequest
}