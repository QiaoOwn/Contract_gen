Contract CoCoMEOrderProducts::listAllOutOfStoreProducts(): Set(Item) {
  definition:
    currentOrderProduct: OrderProduct = self.CurrentOrderProduct, allItems:Set(Item) = Item.allInstance(), outOfStoreProducts:Set(Item) = Item.allInstance()->select(i | i.StockNumber = 0)
  precondition:
    currentOrderProduct.oclIsUndefined() = false and OrderProduct.allInstance()->includes(currentOrderProduct) and allItems.isEmpty() = false
  postcondition:
    self.CurrentOrderProduct = currentOrderProduct and result = outOfStoreProducts
}