Contract LibraryManagementSystemSystem::cancelReservation(uid: String, barcode: String): Boolean {
  definition:
    user: User = User.allInstance()->any(u | u.UserID = uid),
    copy: BookCopy = BookCopy.allInstance()->any(c | c.Barcode = barcode),
    reserve: Reserve = Reserve.allInstance()->any(r | r.ReservedUser = user and r.ReservedCopy = copy),
    openReserves: Set(Reserve) = copy.ReservationRecord->select(r | r.IsReserveClosed = false)
  precondition:
    uid.oclIsTypeOf(String) and barcode.oclIsTypeOf(String) and user.oclIsUndefined() = false and copy.oclIsUndefined() = false and reserve.oclIsUndefined() = false and reserve.IsReserveClosed = false and User.allInstance()->includes(user) and BookCopy.allInstance()->includes(copy) and Reserve.allInstance()->includes(reserve)
  postcondition:
    reserve.IsReserveClosed = true and if openReserves.size() = 1 then copy.IsReserved = false else copy.IsReserved = true endif and result = true
}