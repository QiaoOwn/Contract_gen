Contract AutomatedTellerMachineSystem::inputPassword(password: Integer): Boolean {
  definition:
    inputCard: BankCard = self.InputCard, passwordMatched:Boolean = if inputCard.Password = password then true else false endif
  precondition:
    password.oclIsTypeOf(Integer) and inputCard.oclIsUndefined() = false and BankCard.allInstance()->includes(inputCard) and inputCard.CardStatus = CardStatus::NORMAL
  postcondition:
    self.PasswordValidated = passwordMatched and result = passwordMatched
}