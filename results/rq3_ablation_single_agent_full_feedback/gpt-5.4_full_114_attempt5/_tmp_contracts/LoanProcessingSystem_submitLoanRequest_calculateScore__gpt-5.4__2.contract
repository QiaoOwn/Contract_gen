Contract SubmitLoanRequestModule::calculateScore(): Integer {
  definition:
    currentLoanRequest: LoanRequest = self.CurrentLoanRequest,
    requestedCreditHistory: CreditHistory = currentLoanRequest.RequestedCreditHistory,
    requestedCheckingAccount: CheckingAccount = currentLoanRequest.RequestedCAHistory
  precondition:
    currentLoanRequest.oclIsUndefined() = false and requestedCreditHistory.oclIsUndefined() = false and requestedCheckingAccount.oclIsUndefined() = false and LoanRequest.allInstance()->includes(currentLoanRequest) and currentLoanRequest.Status = LoanRequestStatus::REFERENCESVALIDATED
  postcondition:
    if requestedCreditHistory.BadDebits > 10 then currentLoanRequest.CreditScore = 0 and result = 0 else currentLoanRequest.CreditScore = 100 - requestedCreditHistory.BadDebits * 10 and result = 100 - requestedCreditHistory.BadDebits * 10 endif
}