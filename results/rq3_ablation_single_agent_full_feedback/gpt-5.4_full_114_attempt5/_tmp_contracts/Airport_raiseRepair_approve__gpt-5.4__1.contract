Contract RepairService::approve(sid: Integer, rid: Integer, reject: Boolean, suggestion: String): ApprovalHistory {
  definition:
    repair: Repair = Repair.allInstance()->any(o | o.Id = rid),
    staff: Staff = Staff.allInstance()->any(o | o.Id = sid)
  precondition:
    Repair.allInstance()->includes(repair) and Staff.allInstance()->includes(staff)
  postcondition:
    let approvalHistory:ApprovalHistory in approvalHistory.oclIsNew() and ApprovalHistory.allInstance()->includes(approvalHistory) and approvalHistory.StaffId = sid and approvalHistory.Reject = reject and approvalHistory.Suggestion = suggestion and repair.History->includes(approvalHistory) and if reject = true then repair.Process = 0 else repair.Process = repair.Process@pre + 1 endif and result = approvalHistory
}