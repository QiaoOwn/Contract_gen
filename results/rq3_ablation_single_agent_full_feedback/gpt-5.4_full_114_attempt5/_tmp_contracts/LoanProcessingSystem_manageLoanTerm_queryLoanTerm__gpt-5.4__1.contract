Contract ManageLoanTermCRUDService::queryLoanTerm(itemid: Integer): LoanTerm {
  definition:
    loanTerm: LoanTerm = LoanTerm.allInstance()->any(o | o.ItemID = itemid)
  precondition:
    itemid.oclIsTypeOf(Integer) and loanTerm.oclIsUndefined() = false and LoanTerm.allInstance()->includes(loanTerm)
  postcondition:
    result = loanTerm
}