Contract ProcessSaleService::makeCashPayment(amount: Real): Boolean {
  definition:
    currentSale: Sale = self.CurrentSale
  precondition:
    amount > 0 and currentSale.oclIsUndefined() = false and Sale.allInstance()->includes(currentSale) and currentSale.IsReadytoPay = true and currentSale.IsComplete = false and self.CurrentPaymentMethod = PaymentMethod::CASH and amount >= currentSale.Amount
  postcondition:
    currentSale.IsComplete = true and result = true
}