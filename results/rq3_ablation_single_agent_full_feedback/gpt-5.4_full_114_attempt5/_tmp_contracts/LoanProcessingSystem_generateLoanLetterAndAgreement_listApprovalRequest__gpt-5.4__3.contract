Contract GenerateLoanLetterAndAgreementModule::listApprovalRequest(): Set(LoanRequest) {
  definition:
    approvalRequests:Set(LoanRequest) = LoanRequest.allInstance()->select(o | o.Status = LoanRequestStatus::READYFORREVIEW)
  precondition:
    approvalRequests.isEmpty() = false
  postcondition:
    self.CurrentLoanRequests = approvalRequests and result = approvalRequests
}