Contract AutomatedTellerMachineSystem::printReceipt(): Real {
  definition:
    inputCard: BankCard = self.InputCard, receiptAmount: Real = self.WithdrawedNumber
  precondition:
    inputCard.oclIsUndefined() = false and BankCard.allInstance()->includes(inputCard) and self.PasswordValidated = true and self.CardIDValidated = true and self.IsWithdraw = true and receiptAmount > 0 and inputCard.CardStatus = CardStatus::NORMAL and inputCard.Balance >= receiptAmount
  postcondition:
    result = receiptAmount
}