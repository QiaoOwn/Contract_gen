Contract LibraryManagementSystemSystem::cancelReservation(uid: String, barcode: String): Boolean {
  definition:
    user: User = User.allInstance()->any(u | u.UserID = uid),
    copy: BookCopy = BookCopy.allInstance()->any(c | c.Barcode = barcode),
    reserve: Reserve = Reserve.allInstance()->any(r | r.ReservedUser = user and r.ReservedCopy = copy and r.IsReserveClosed = false),
    otherOpenReserves: Set(Reserve) = copy.ReservationRecord->select(r | r.IsReserveClosed = false and r <> reserve)
  precondition:
    uid.oclIsTypeOf(String) and barcode.oclIsTypeOf(String) and user.oclIsUndefined() = false and copy.oclIsUndefined() = false and reserve.oclIsUndefined() = false and User.allInstance()->includes(user) and BookCopy.allInstance()->includes(copy) and Reserve.allInstance()->includes(reserve)
  postcondition:
    Reserve.allInstance()->excludes(reserve) and user.ReservedBook->excludes(reserve) and copy.ReservationRecord->excludes(reserve) and copy.IsReserved = if otherOpenReserves.isEmpty() = true then false else true endif and result = true
}