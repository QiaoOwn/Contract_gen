Contract CoCoMEOrderProducts::makeNewOrder(orderid: Integer): Boolean {
  definition:
    sameOrder:OrderProduct = OrderProduct.allInstance()->any(o | o.Id = orderid)
  precondition:
    sameOrder.oclIsUndefined() = true and orderid > 0
  postcondition:
    let newOrder:OrderProduct in newOrder.oclIsNew() and OrderProduct.allInstance()->includes(newOrder) and newOrder.Id = orderid and newOrder.OrderStatus = OrderStatus::NEW and newOrder.Amount = 0 and result = true
}