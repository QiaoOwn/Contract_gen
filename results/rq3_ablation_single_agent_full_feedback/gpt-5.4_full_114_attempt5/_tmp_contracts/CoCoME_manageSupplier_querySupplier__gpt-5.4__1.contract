Contract ManageSupplierCRUDService::querySupplier(id: Integer): Supplier {
  definition:
    supplier: Supplier = Supplier.allInstance()->any(o | o.Id = id)
  precondition:
    id.oclIsTypeOf(Integer) and supplier.oclIsUndefined() = false and Supplier.allInstance()->includes(supplier)
  postcondition:
    result = supplier
}