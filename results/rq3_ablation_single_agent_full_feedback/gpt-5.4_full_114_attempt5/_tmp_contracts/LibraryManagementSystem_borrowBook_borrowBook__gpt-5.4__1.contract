Contract LibraryManagementSystemSystem::borrowBook(uid: String, barcode: String): Boolean {
  definition:
    user: User = User.allInstance()->any(u | u.UserID = uid),
    copy: BookCopy = BookCopy.allInstance()->any(c | c.Barcode = barcode),
    activeReserves: Set(Reserve) = copy.ReservationRecord->select(r | r.IsReserveClosed = false),
    sameUserReserve: Reserve = activeReserves->any(r | r.ReservedUser = user),
    hasReserve:Boolean = if activeReserves.isEmpty() = true then false else true endif,
    isStudent:Boolean = if user.oclIsTypeOf(Student) then true else false endif
  precondition:
    user.oclIsUndefined() = false and copy.oclIsUndefined() = false and user.BorrowStatus = BorrowStatus::NORMAL and user.LoanedNumber < 10 and (copy.Status = CopyStatus::AVAILABLE or copy.Status = CopyStatus::ONHOLDSHELF) and (hasReserve = false or sameUserReserve.oclIsUndefined() = false)
  postcondition:
    let loan:Loan in loan.oclIsNew() and Loan.allInstance()->includes(loan) and loan.LoanedUser = user and loan.LoanedCopy = copy and loan.IsReturned = false and loan.RenewedTimes = 0 and loan.OverDueFee = 0 and loan.OverDue3Days = false and loan.OverDue10Days = false and loan.OverDue17Days = false and loan.OverDue31Days = false and user.LoanedBook->includes(loan) and copy.LoanedRecord->includes(loan) and user.LoanedNumber = user.LoanedNumber@pre + 1 and copy.Status = CopyStatus::LOANED and if sameUserReserve.oclIsUndefined() = false then sameUserReserve.IsReserveClosed = true else true endif and if isStudent = true then loan.DueDate = loan.LoanDate.After(30) else loan.DueDate = loan.LoanDate.After(60) endif and result = true
}