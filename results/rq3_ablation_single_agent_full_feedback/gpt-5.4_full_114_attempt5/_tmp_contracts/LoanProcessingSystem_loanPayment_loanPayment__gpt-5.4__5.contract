Contract LoanProcessingSystemSystem::loanPayment(loanid: Integer): Boolean {
  definition:
    loan: Loan = Loan.allInstance()->any(o | o.LoanID = loanid), loanAccount: LoanAccount = loan.BelongedLoanAccount, repaymentAmount: Real = loan.RepaymentAmount, paidInFullAfterPayment: Boolean = if loan.RemainAmountToPay = repaymentAmount then true else false endif
  precondition:
    loan.oclIsUndefined() = false and Loan.allInstance()->includes(loan) and loanAccount.oclIsUndefined() = false and loan.Status = LoanStatus::LSOPEN and loan.IsPaidinFull = false and repaymentAmount > 0 and loan.RemainAmountToPay >= repaymentAmount
  postcondition:
    loan.RemainAmountToPay = loan.RemainAmountToPay@pre - repaymentAmount and loanAccount.Balance = loanAccount.Balance@pre + repaymentAmount and loan.IsPaidinFull = paidInFullAfterPayment and loan.Status = if paidInFullAfterPayment = true then LoanStatus::CLOSED else LoanStatus::LSOPEN endif and loanAccount.Status = if paidInFullAfterPayment = true then LoanAccountStatus::HASPAIDINFULL else LoanAccountStatus::NORMAL endif and result = true
}