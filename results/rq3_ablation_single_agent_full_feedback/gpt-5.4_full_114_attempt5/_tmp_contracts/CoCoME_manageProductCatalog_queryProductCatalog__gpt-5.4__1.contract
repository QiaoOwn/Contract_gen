Contract ManageProductCatalogCRUDService::queryProductCatalog(id: Integer): ProductCatalog {
  definition:
    productCatalog: ProductCatalog = ProductCatalog.allInstance()->any(o | o.Id = id)
  precondition:
    id.oclIsTypeOf(Integer) and productCatalog.oclIsUndefined() = false and ProductCatalog.allInstance()->includes(productCatalog)
  postcondition:
    result = productCatalog
}