Contract EvaluateLoanRequestModule::listAvaiableLoanTerm(): Set(LoanTerm) {
  definition:
    currentLoanRequest: LoanRequest = self.CurrentLoanRequest, availableLoanTerms: Set(LoanTerm) = currentLoanRequest.AttachedLoanTerms
  precondition:
    currentLoanRequest.oclIsUndefined() = false and LoanRequest.allInstance()->includes(currentLoanRequest) and availableLoanTerms.isEmpty() = false
  postcondition:
    result = availableLoanTerms
}