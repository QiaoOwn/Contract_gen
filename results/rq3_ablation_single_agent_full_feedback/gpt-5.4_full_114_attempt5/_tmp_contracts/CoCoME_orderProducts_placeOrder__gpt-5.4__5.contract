Contract CoCoMEOrderProducts::placeOrder(): Boolean {
  definition:
    currentOrderProduct: OrderProduct = CurrentOrderProduct,
    containedEntries: Set(OrderEntry) = currentOrderProduct.ContainedEntries,
    supplier: Supplier = currentOrderProduct.Supplier
  precondition:
    currentOrderProduct.oclIsUndefined() = false and OrderProduct.allInstance()->includes(currentOrderProduct) and containedEntries.isEmpty() = false and supplier.oclIsUndefined() = false and currentOrderProduct.OrderStatus = OrderStatus::NEW
  postcondition:
    currentOrderProduct.OrderStatus = OrderStatus::REQUESTED and result = true
}