Contract ManageBankCardCRUDService::deleteBankCard(cardid: Integer): Boolean {
  definition:
    bankCard: BankCard = BankCard.allInstance()->any(o | o.CardID = cardid)
  precondition:
    bankCard.oclIsUndefined() = false and BankCard.allInstance()->includes(bankCard)
  postcondition:
    BankCard.allInstance()->excludes(bankCard) and result = true
}