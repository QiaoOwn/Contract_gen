Contract AutomatedTellerMachineSystem::printReceipt(): Real {
  definition:
    inputCard: BankCard = self.InputCard
  precondition:
    inputCard.oclIsUndefined() = false and BankCard.allInstance()->includes(inputCard) and self.PasswordValidated = true and self.CardIDValidated = true and self.IsWithdraw = true and self.WithdrawedNumber > 0 and inputCard.CardStatus = CardStatus::NORMAL
  postcondition:
    result = self.WithdrawedNumber
}