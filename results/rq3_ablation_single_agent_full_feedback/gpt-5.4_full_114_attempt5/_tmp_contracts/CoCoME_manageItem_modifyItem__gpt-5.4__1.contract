Contract ManageItemCRUDService::modifyItem(barcode: Integer, name: String, price: Real, stocknumber: Integer, orderprice: Real): Boolean {
  definition:
    item: Item = Item.allInstance()->any(i | i.Barcode = barcode)
  precondition:
    item.oclIsUndefined() = false and name.oclIsTypeOf(String) and price.oclIsTypeOf(Real) and stocknumber.oclIsTypeOf(Integer) and orderprice.oclIsTypeOf(Real) and price >= 0 and stocknumber >= 0 and orderprice >= 0
  postcondition:
    item.Name = name and item.Price = price and item.StockNumber = stocknumber and item.OrderPrice = orderprice and result = true
}