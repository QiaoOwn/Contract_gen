Contract AutomatedTellerMachineSystem::depositFunds(quantity: Real): Boolean {
  definition:
    
  precondition:
    self.PasswordValidated = true and self.CardIDValidated = true and self.IsDeposit = true and self.InputCard.oclIsUndefined() = false and BankCard.allInstance()->includes(self.InputCard) and quantity > 0 and self.InputCard.CardStatus = CardStatus::NORMAL
  postcondition:
    self.InputCard.Balance = self.InputCard.Balance@pre + quantity and self.DepositedNumber = quantity and result = true
}