Contract CoCoMEOrderProducts::orderItem(barcode: Integer, quantity: Integer): Boolean {
  definition:
    currentOrderProduct: OrderProduct = self.CurrentOrderProduct,
    item: Item = Item.allInstance()->any(i | i.Barcode = barcode)
  precondition:
    currentOrderProduct.oclIsUndefined() = false and item.oclIsUndefined() = false and quantity > 0 and currentOrderProduct.OrderStatus = OrderStatus::NEW
  postcondition:
    let orderEntry:OrderEntry in orderEntry.oclIsNew() and OrderEntry.allInstance()->includes(orderEntry) and orderEntry.Quantity = quantity and orderEntry.SubAmount = item.OrderPrice * quantity and orderEntry.Item = item and currentOrderProduct.ContainedEntries->includes(orderEntry) and currentOrderProduct.Amount = currentOrderProduct.Amount@pre + orderEntry.SubAmount and result = true
}