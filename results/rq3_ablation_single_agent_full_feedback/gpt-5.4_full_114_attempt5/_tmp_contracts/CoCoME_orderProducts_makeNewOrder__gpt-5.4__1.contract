Contract CoCoMEOrderProducts::makeNewOrder(orderid: Integer): Boolean {
  definition:
    currentOrderProduct: OrderProduct = self.CurrentOrderProduct
  precondition:
    orderid.oclIsTypeOf(Integer) and currentOrderProduct.oclIsUndefined() = true and OrderProduct.allInstance()->isUnique(o:OrderProduct | o.Id)
  postcondition:
    let newOrder:OrderProduct in newOrder.oclIsNew() and OrderProduct.allInstance()->includes(newOrder) and newOrder.Id = orderid and newOrder.OrderStatus = OrderStatus::NEW and self.CurrentOrderProduct = newOrder and result = true
}