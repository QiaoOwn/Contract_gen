Contract ManageStoreCRUDService::deleteStore(id: Integer): Boolean {
  definition:
    store: Store = Store.allInstance()->any(o | o.Id = id)
  precondition:
    id.oclIsTypeOf(Integer) and store.oclIsUndefined() = false and Store.allInstance()->includes(store) and store.AssociationCashdeskes->isEmpty() and store.Productcatalogs->isEmpty() and store.Items->isEmpty() and store.Cashiers->isEmpty() and store.Sales->isEmpty()
  postcondition:
    Store.allInstance()->excludes(store) and result = true
}