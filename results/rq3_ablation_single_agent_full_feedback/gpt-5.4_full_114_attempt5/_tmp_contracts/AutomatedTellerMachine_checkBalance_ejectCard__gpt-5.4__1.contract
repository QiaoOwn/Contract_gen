Contract AutomatedTellerMachineSystem::ejectCard(): Boolean {
  definition:
    inputCard: BankCard = self.InputCard
  precondition:
    inputCard.oclIsUndefined() = false and BankCard.allInstance()->includes(inputCard) and self.CardIDValidated = true and self.PasswordValidated = true
  postcondition:
    self.InputCard = null and self.CardIDValidated = false and self.PasswordValidated = false and result = true
}