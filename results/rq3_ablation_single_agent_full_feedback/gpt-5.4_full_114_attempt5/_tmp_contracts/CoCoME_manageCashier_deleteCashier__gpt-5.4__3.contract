Contract ManageCashierCRUDService::deleteCashier(id: Integer): Boolean {
  definition:
    cashier: Cashier = Cashier.allInstance()->any(c | c.Id = id)
  precondition:
    cashier.oclIsUndefined() = false and Cashier.allInstance()->includes(cashier)
  postcondition:
    Cashier.allInstance()->excludes(cashier) and result = true
}