Contract ManageCashDeskCRUDService::modifyCashDesk(id: Integer, name: String, isopened: Boolean): Boolean {
  definition:
    cashDesk: CashDesk = CashDesk.allInstance()->any(o | o.Id = id)
  precondition:
    cashDesk.oclIsUndefined() = false and name.oclIsTypeOf(String) and isopened.oclIsTypeOf(Boolean)
  postcondition:
    cashDesk.Name = name and cashDesk.IsOpened = isopened and result = true
}