Contract SearchBook::searchBookByBarCode(barcode: String): Set(Book) {
  definition:
    bookCopies:Set(BookCopy) = BookCopy.allInstance()->select(o | o.Barcode = barcode), matchedBooks:Set(Book) = Book.allInstance()->select(o | o.Copys->exists(c:BookCopy | c.Barcode = barcode))
  precondition:
    barcode.oclIsTypeOf(String) and bookCopies.isEmpty() = false
  postcondition:
    result = matchedBooks
}