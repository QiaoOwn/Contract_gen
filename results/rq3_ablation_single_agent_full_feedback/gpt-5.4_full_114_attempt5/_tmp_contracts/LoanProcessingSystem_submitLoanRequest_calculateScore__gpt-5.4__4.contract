Contract SubmitLoanRequestModule::calculateScore(): Integer {
  definition:
    currentLoanRequest: LoanRequest = LoanRequest.allInstance()->any(o | o.Status = LoanRequestStatus::REFERENCESVALIDATED),
    requestedCreditHistory: CreditHistory = currentLoanRequest.RequestedCreditHistory,
    scoreValue: Integer = if requestedCreditHistory.BadDebits > 10 then 0 else 100 endif
  precondition:
    currentLoanRequest.oclIsUndefined() = false and requestedCreditHistory.oclIsUndefined() = false and LoanRequest.allInstance()->includes(currentLoanRequest)
  postcondition:
    currentLoanRequest.CreditScore = scoreValue and result = scoreValue
}