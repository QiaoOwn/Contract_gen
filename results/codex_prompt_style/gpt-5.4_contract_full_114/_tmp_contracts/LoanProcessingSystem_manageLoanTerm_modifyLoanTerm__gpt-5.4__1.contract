Contract ManageLoanTermCRUDService::modifyLoanTerm(itemid:Integer,content:String): Boolean {
          precondition:
          itemid <> null and
  content <> null and
  LoanTerm.allInstance()->exists(lt | lt.ItemID = itemid)
            postcondition:
          let lt : LoanTerm = LoanTerm.allInstance()->any(x | x.ItemID = itemid) in
    lt.Content = content and
    LoanTerm.allInstance()->size() = LoanTerm.allInstance()->size() and
    result = true
            
        }