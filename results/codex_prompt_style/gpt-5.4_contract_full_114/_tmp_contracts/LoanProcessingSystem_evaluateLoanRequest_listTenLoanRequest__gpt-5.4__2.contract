Contract EvaluateLoanRequestModule::listTenLoanRequest(): Set(LoanRequest) {
          precondition:
          LoanRequest.allInstance()->exists(lr | lr.Status = LoanRequestStatus::REFERENCESVALIDATED or lr.Status = LoanRequestStatus::READYFORREVIEW)
            postcondition:
          result = LoanRequest.allInstance()->select(lr | lr.Status = LoanRequestStatus::REFERENCESVALIDATED or lr.Status = LoanRequestStatus::READYFORREVIEW)->asSet() and
result->size() <= 10 and
result->forAll(lr | LoanRequest.allInstance()->includes(lr)) and
LoanRequest.allInstance()->forAll(lr |
  lr.oclIsTypeOf(LoanRequest) and
  lr.Status = lr.Status and
  lr.RequestID = lr.RequestID and
  lr.Name = lr.Name and
  lr.LoanAmount = lr.LoanAmount and
  lr.LoanPurpose = lr.LoanPurpose and
  lr.Income = lr.Income and
  lr.PhoneNumber = lr.PhoneNumber and
  lr.PostalAddress = lr.PostalAddress and
  lr.ZipCode = lr.ZipCode and
  lr.Email = lr.Email and
  lr.WorkReferences = lr.WorkReferences and
  lr.CreditReferences = lr.CreditReferences and
  lr.CheckingAccountNumber = lr.CheckingAccountNumber and
  lr.SecurityNumber = lr.SecurityNumber and
  lr.CreditScore = lr.CreditScore
)
            
        }