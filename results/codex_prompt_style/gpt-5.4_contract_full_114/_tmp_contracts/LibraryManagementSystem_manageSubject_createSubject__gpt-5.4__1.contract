Contract ManageSubjectCRUDService::createSubject(name:String): Boolean {
          precondition:
          name <> null and name <> '' and Subject.allInstance()->forAll(s | s.Name <> name)
            postcondition:
          (result = true implies
    Subject.allInstance()->exists(s |
      s.oclIsNew() and
      s.Name = name and
      s.SuperSubject.oclIsUndefined() and
      s.SubSubject.oclIsUndefined()
    )
  ) and
  (result = false implies
    Subject.allInstance()->forAll(s | not s.oclIsNew())
  ) and
  Subject.allInstance()->forAll(s1, s2 | s1 <> s2 implies s1.Name <> s2.Name)
            
        }