Contract ManageLoanTermCRUDService::queryLoanTerm(itemid:Integer): LoanTerm {
          precondition:
          itemid <> null and
  LoanTerm.allInstance()->exists(lt | lt.ItemID = itemid)
            postcondition:
          result <> null and
  result.ItemID = itemid and
  LoanTerm.allInstance()->includes(result) and
  LoanTerm.allInstance()->size() = LoanTerm.allInstance()->size() and
  LoanRequest.allInstance()->size() = LoanRequest.allInstance()->size() and
  Loan.allInstance()->size() = Loan.allInstance()->size() and
  CheckingAccount.allInstance()->size() = CheckingAccount.allInstance()->size() and
  CreditHistory.allInstance()->size() = CreditHistory.allInstance()->size() and
  LoanAccount.allInstance()->size() = LoanAccount.allInstance()->size() and
  ApprovalLetter.allInstance()->size() = ApprovalLetter.allInstance()->size() and
  LoanAgreement.allInstance()->size() = LoanAgreement.allInstance()->size()
            
        }