Contract ManageCashierCRUDService::createCashier(id:Integer,name:String): Boolean {
          precondition:
          id.oclIsUndefined() = false and
  name.oclIsUndefined() = false and
  name <> '' and
  Cashier.allInstance()->forAll(c | c.Id <> id)
            postcondition:
          result = true and
  Cashier.allInstance()->exists(c |
    c.Id = id and
    c.Name = name
  ) and
  Cashier.allInstance()->size() = Cashier.allInstance()->size() + 1 and
  Cashier.allInstance()->one(c |
    c.Id = id and
    c.Name = name
  )
            
        }