Contract ManageSubjectCRUDService::createSubject(name:String): Boolean {
          precondition:
          name <> null and name <> '' and Subject.allInstance()->forAll(s | s.Name <> name)
            postcondition:
          if Subject.allInstance()->exists(s | s.oclIsNew() and s.Name = name) then
        result = true and
        Subject.allInstance()->one(s | s.oclIsNew() and s.Name = name)
      else
        result = false
      endif
            
        }