Contract ManageLoanTermCRUDService::deleteLoanTerm(itemid:Integer): Boolean {
          precondition:
          itemid <> null and LoanTerm.allInstance()->exists(lt | lt.ItemID = itemid)
            postcondition:
          if LoanTerm.allInstance()->exists(lt | lt.ItemID = itemid) then
        LoanTerm.allInstance()->forAll(lt | lt.ItemID <> itemid) and
        LoanRequest.allInstance()->forAll(lr | lr.AttachedLoanTerms = lr.AttachedLoanTerms@pre->excluding(LoanTerm.allInstance()->any(lt | lt.ItemID = itemid))) and
        result = true
      else
        LoanTerm.allInstance() = LoanTerm.allInstance() and
        LoanRequest.allInstance()->forAll(lr | lr.AttachedLoanTerms = lr.AttachedLoanTerms@pre) and
        result = false
      endif
            
        }