Contract SearchBook::searchBookByTitle(title:String): Set(Book) {
          precondition:
          title <> null and title <> ''
            postcondition:
          result = Book.allInstance()->select(b | b.Title = title) and
    Book.allInstance()->forAll(b |
        b.CallNo = b@pre.CallNo and
        b.Title = b@pre.Title and
        b.Edition = b@pre.Edition and
        b.Author = b@pre.Author and
        b.Publisher = b@pre.Publisher and
        b.Description = b@pre.Description and
        b.ISBn = b@pre.ISBn and
        b.CopyNum = b@pre.CopyNum
    ) and
    User.allInstance()->forAll(u |
        u.UserID = u@pre.UserID and
        u.Name = u@pre.Name and
        u.Sex = u@pre.Sex and
        u.Password = u@pre.Password and
        u.Email = u@pre.Email and
        u.Faculty = u@pre.Faculty and
        u.LoanedNumber = u@pre.LoanedNumber and
        u.BorrowStatus = u@pre.BorrowStatus and
        u.SuspensionDays = u@pre.SuspensionDays and
        u.OverDueFee = u@pre.OverDueFee
    ) and
    BookCopy.allInstance()->forAll(c |
        c.Barcode = c@pre.Barcode and
        c.Status = c@pre.Status and
        c.Location = c@pre.Location and
        c.IsReserved = c@pre.IsReserved
    ) and
    Loan.allInstance()->forAll(l |
        l.LoanDate = l@pre.LoanDate and
        l.RenewDate = l@pre.RenewDate and
        l.DueDate = l@pre.DueDate and
        l.ReturnDate = l@pre.ReturnDate and
        l.RenewedTimes = l@pre.RenewedTimes and
        l.IsReturned = l@pre.IsReturned and
        l.OverDueFee = l@pre.OverDueFee and
        l.OverDue3Days = l@pre.OverDue3Days and
        l.OverDue10Days = l@pre.OverDue10Days and
        l.OverDue17Days = l@pre.OverDue17Days and
        l.OverDue31Days = l@pre.OverDue31Days
    ) and
    Reserve.allInstance()->forAll(r |
        r.ReserveDate = r@pre.ReserveDate and
        r.IsReserveClosed = r@pre.IsReserveClosed
    ) and
    RecommendBook.allInstance()->forAll(rb |
        rb.RecommendDate = rb@pre.RecommendDate
    )
            
        }