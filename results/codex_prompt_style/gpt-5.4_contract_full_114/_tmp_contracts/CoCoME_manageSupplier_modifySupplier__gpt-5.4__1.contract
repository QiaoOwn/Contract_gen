Contract ManageSupplierCRUDService::modifySupplier(id:Integer,name:String): Boolean {
          precondition:
          id <> null and
	name <> null and
	Supplier.allInstance()->exists(s | s.Id = id)
            postcondition:
          let s : Supplier = Supplier.allInstance()->any(x | x.Id = id) in
	s.Name = name and
	s.Id = id and
	result = true and
	Supplier.allInstance()->size() = Supplier.allInstance()->size() and
	Supplier.allInstance()->forAll(x |
		x.Id <> id implies
			x.Name = x.Name@pre and x.Id = x.Id@pre
	)
            
        }