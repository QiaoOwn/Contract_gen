Contract ManageStoreCRUDService::modifyStore(id:Integer,name:String,address:String,isopened:Boolean): Boolean {
          precondition:
          id <> null and name <> null and address <> null and isopened <> null and Store.allInstance()->exists(s | s.Id = id)
            postcondition:
          if Store.allInstance()->exists(s | s.Id = id) then
    Store.allInstance()->exists(s |
        s.Id = id and
        s.Name = name and
        s.Address = address and
        s.IsOpened = isopened
    ) and
    result = true
else
    result = false
endif
            
        }