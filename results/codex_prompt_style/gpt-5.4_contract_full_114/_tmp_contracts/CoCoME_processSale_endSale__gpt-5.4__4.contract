Contract ProcessSaleService::endSale(): Real {
          precondition:
          not CurrentSale.oclIsUndefined() and
  CurrentSale.IsComplete = false and
  CurrentSale.ContainedSalesLine->notEmpty() and
  CurrentSale.ContainedSalesLine->forAll(sli |
    not sli.BelongedItem.oclIsUndefined() and
    sli.Quantity > 0 and
    sli.Subamount = sli.Quantity * sli.BelongedItem.Price
  ) and
  CurrentSale.Amount = CurrentSale.ContainedSalesLine->collect(Subamount)->sum() and
  CurrentSale.Belongedstore.IsOpened = true and
  CurrentSale.BelongedCashDesk.IsOpened = true
            postcondition:
          CurrentSale.IsReadytoPay = true and
  CurrentSale.IsComplete = false and
  result = CurrentSale.Amount and
  CurrentSale.Amount = CurrentSale.ContainedSalesLine->collect(Subamount)->sum() and
  CurrentSale.ContainedSalesLine->forAll(sli | sli.BelongedSale = CurrentSale)
            
        }