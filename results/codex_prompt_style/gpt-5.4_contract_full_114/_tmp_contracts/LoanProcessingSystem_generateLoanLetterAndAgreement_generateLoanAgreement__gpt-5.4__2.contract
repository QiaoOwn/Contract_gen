Contract GenerateLoanLetterAndAgreementModule::generateLoanAgreement(): Boolean {
          precondition:
          CurrentLoanRequest <> null and
    CurrentLoanRequest.Status = LoanRequestStatus::APPROVED and
    CurrentLoanRequest.ApprovalLoan <> null and
    CurrentLoanRequest.AttachedLoanTerms <> null and
    CurrentLoanRequest.AttachedLoanTerms->size() > 0 and
    CurrentLoanRequest.AttachedLoanAgreement = null
            postcondition:
          result = true and
    CurrentLoanAgreement <> null and
    CurrentLoanRequest.AttachedLoanAgreement = CurrentLoanAgreement and
    CurrentLoanAgreement.oclIsNew() and
    CurrentLoanAgreement.Content <> '' and
    CurrentLoanRequest.Status = CurrentLoanRequest@pre.Status and
    CurrentLoanRequest.ApprovalLoan = CurrentLoanRequest@pre.ApprovalLoan and
    CurrentLoanRequest.AttachedLoanTerms = CurrentLoanRequest@pre.AttachedLoanTerms and
    CurrentLoanRequests = CurrentLoanRequests@pre
            
        }