Contract AutomatedTellerMachineSystem::printReceipt(): Real {
          precondition:
          InputCard <> null and
  CardIDValidated = true and
  PasswordValidated = true and
  InputCard.CardStatus = CardStatus::NORMAL and
  ((IsWithdraw = true and WithdrawedNumber >= 0) or
   (IsDeposit = true and DepositedNumber >= 0))
            postcondition:
          InputCard = InputCard@pre and
  CardIDValidated = CardIDValidated@pre and
  PasswordValidated = PasswordValidated@pre and
  IsWithdraw = IsWithdraw@pre and
  IsDeposit = IsDeposit@pre and
  WithdrawedNumber = WithdrawedNumber@pre and
  DepositedNumber = DepositedNumber@pre and
  result = (if IsWithdraw@pre = true then WithdrawedNumber@pre else DepositedNumber@pre endif)
            
        }