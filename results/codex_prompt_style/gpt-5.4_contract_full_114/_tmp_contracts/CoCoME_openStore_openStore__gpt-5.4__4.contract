Contract CoCoMESystem::openStore(storeID:Integer): Boolean {
          precondition:
          Store.allInstance()->exists(s | s.Id = storeID and s.IsOpened = false)
            postcondition:
          let s : Store = Store.allInstance()->any(st | st.Id = storeID) in
    s.IsOpened = true and
    CurrentStore = s and
    result = true
            
        }