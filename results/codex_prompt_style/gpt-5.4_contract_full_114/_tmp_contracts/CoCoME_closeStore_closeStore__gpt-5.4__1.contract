Contract CoCoMESystem::closeStore(storeID:Integer): Boolean {
          precondition:
          storeID <> null and
    Store.allInstance()->exists(s | s.Id = storeID and s.IsOpened = true) and
    Store.allInstance()->any(s | s.Id = storeID) = CurrentStore and
    CurrentStore.AssociationCashdeskes->forAll(cd |
        cd.ContainedSales->forAll(sa | sa.IsComplete = true)
    )
            postcondition:
          CurrentStore.IsOpened = false and
    CurrentStore.AssociationCashdeskes->forAll(cd | cd.IsOpened = false) and
    result = true and
    Store.allInstance()->excluding(CurrentStore)->forAll(s |
        s.IsOpened = s.IsOpened@pre
    ) and
    CurrentStore.Productcatalogs = CurrentStore.Productcatalogs@pre and
    CurrentStore.Items = CurrentStore.Items@pre and
    CurrentStore.Cashiers = CurrentStore.Cashiers@pre and
    CurrentStore.Sales = CurrentStore.Sales@pre
            
        }