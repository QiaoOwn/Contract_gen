Contract CoCoMEOrderProducts::listAllOutOfStoreProducts(): Set(Item) {
          precondition:
          true
            postcondition:
          result = Item.allInstance()->select(i | i.StockNumber = 0) and
  Item.allInstance() = Item.allInstance() and
  Store.allInstance() = Store.allInstance() and
  ProductCatalog.allInstance() = ProductCatalog.allInstance() and
  CashDesk.allInstance() = CashDesk.allInstance() and
  Sale.allInstance() = Sale.allInstance() and
  Cashier.allInstance() = Cashier.allInstance() and
  SalesLineItem.allInstance() = SalesLineItem.allInstance() and
  Payment.allInstance() = Payment.allInstance() and
  CashPayment.allInstance() = CashPayment.allInstance() and
  CardPayment.allInstance() = CardPayment.allInstance() and
  OrderEntry.allInstance() = OrderEntry.allInstance() and
  Supplier.allInstance() = Supplier.allInstance() and
  OrderProduct.allInstance() = OrderProduct.allInstance() and
  CurrentOrderProduct = CurrentOrderProduct@pre
            
        }