Contract ManageLoanTermCRUDService::createLoanTerm(itemid:Integer,content:String): Boolean {
          precondition:
          itemid <> null and
    content <> null and
    content <> '' and
    LoanTerm.allInstance()->forAll(lt | lt.ItemID <> itemid)
            postcondition:
          result = true and
    LoanTerm.allInstance()->exists(lt |
        lt.oclIsNew() and
        lt.ItemID = itemid and
        lt.Content = content
    ) and
    LoanTerm.allInstance()->size() = LoanTerm.allInstance()->size() + 1 and
    LoanTerm.allInstance()->forAll(lt |
        LoanTerm.allInstance()->exists(lt2 |
            lt2 = lt and
            lt2.ItemID = lt.ItemID and
            lt2.Content = lt.Content
        )
    )
            
        }