Contract ManageCashDeskCRUDService::createCashDesk(id:Integer,name:String,isopened:Boolean): Boolean {
          precondition:
          id.oclIsUndefined() = false and
    name.oclIsUndefined() = false and
    isopened.oclIsUndefined() = false and
    CashDesk.allInstance()->forAll(cd | cd.Id <> id)
            postcondition:
          result = true and
    CashDesk.allInstance()->exists(cd |
        cd.oclIsNew() and
        cd.Id = id and
        cd.Name = name and
        cd.IsOpened = isopened
    ) and
    CashDesk.allInstance()->select(cd | cd.Id = id)->size() = 1
            
        }