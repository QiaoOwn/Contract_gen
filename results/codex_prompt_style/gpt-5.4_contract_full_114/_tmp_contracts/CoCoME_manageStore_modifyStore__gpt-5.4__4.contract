Contract ManageStoreCRUDService::modifyStore(id:Integer,name:String,address:String,isopened:Boolean): Boolean {
          precondition:
          not id.oclIsUndefined() and
	not name.oclIsUndefined() and
	not address.oclIsUndefined() and
	not isopened.oclIsUndefined() and
	Store.allInstance()->exists(s | s.Id = id)
            postcondition:
          Store.allInstance()->exists(s |
		s.Id = id and
		s.Name = name and
		s.Address = address and
		s.IsOpened = isopened
	) and
	Store.allInstance()->size() = Store.allInstance()->size() and
	result = true
            
        }