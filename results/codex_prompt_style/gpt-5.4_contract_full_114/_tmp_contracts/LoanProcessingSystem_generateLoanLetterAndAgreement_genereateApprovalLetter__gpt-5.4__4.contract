Contract GenerateLoanLetterAndAgreementModule::genereateApprovalLetter(id:Integer): Boolean {
          precondition:
          id <> null and
  LoanRequest.allInstance()->exists(lr | lr.RequestID = id) and
  LoanRequest.allInstance()->any(lr | lr.RequestID = id).Status = LoanRequestStatus::APPROVED
            postcondition:
          let lr : LoanRequest = LoanRequest.allInstance()->any(lr | lr.RequestID = id) in
  result = true and
  CurrentLoanRequest = lr and
  CurrentApprovalLetter <> null and
  CurrentLoanAgreement <> null and
  lr.AttachedApprovalLetter = CurrentApprovalLetter and
  lr.AttachedLoanAgreement = CurrentLoanAgreement and
  CurrentApprovalLetter.Content <> null and
  CurrentApprovalLetter.Content <> '' and
  CurrentLoanAgreement.Content <> null and
  CurrentLoanAgreement.Content <> '' and
  lr.Status = LoanRequestStatus::APPROVED
            
        }