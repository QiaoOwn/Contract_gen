Contract CoCoMESystem::openCashDesk(cashDeskID:Integer): Boolean {
          precondition:
          cashDeskID <> null and
    CurrentStore <> null and
    CurrentStore.IsOpened = true and
    CurrentStore.AssociationCashdeskes->exists(cd | cd.Id = cashDeskID) and
    CurrentStore.AssociationCashdeskes->any(cd | cd.Id = cashDeskID).IsOpened = false
            postcondition:
          let cd : CashDesk = CurrentStore.AssociationCashdeskes->any(c | c.Id = cashDeskID) in
    cd.IsOpened = true and
    CurrentCashDesk = cd and
    result = true and
    CurrentStore = CurrentStore@pre and
    CurrentStore.AssociationCashdeskes->size() = CurrentStore.AssociationCashdeskes@pre->size() and
    cd.BelongedStore = CurrentStore
            
        }