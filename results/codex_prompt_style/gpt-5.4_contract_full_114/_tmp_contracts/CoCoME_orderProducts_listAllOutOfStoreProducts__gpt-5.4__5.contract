Contract CoCoMEOrderProducts::listAllOutOfStoreProducts(): Set(Item) {
          precondition:
          true
            postcondition:
          result = Item.allInstance()->select(i | i.StockNumber = 0)
  and Item.allInstance() = Item.allInstance()
  and OrderProduct.allInstance() = OrderProduct.allInstance()
  and OrderEntry.allInstance() = OrderEntry.allInstance()
  and Supplier.allInstance() = Supplier.allInstance()
            
        }