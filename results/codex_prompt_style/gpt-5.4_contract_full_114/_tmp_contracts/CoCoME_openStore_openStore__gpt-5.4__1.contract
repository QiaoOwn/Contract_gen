Contract CoCoMESystem::openStore(storeID:Integer): Boolean {
          precondition:
          Store.allInstance()->exists(s | s.Id = storeID and s.IsOpened = false)
            postcondition:
          let s : Store = Store.allInstance()->any(x | x.Id = storeID) in
    s.IsOpened = true and
    CurrentStore = s and
    result = true and
    Store.allInstance()->forAll(st | st = s or st.IsOpened = st.IsOpened@pre) and
    CashDesk.allInstance()->forAll(cd | cd.IsOpened = cd.IsOpened@pre) and
    Sale.allInstance()->forAll(sa | sa.IsComplete = sa.IsComplete@pre and sa.Amount = sa.Amount@pre and sa.IsReadytoPay = sa.IsReadytoPay@pre)
            
        }