Contract LoanProcessingSystemSystem::closeOutLoan(loanid:Integer): Boolean {
          precondition:
          loanid <> null and
  Loan.allInstance()->exists(l | l.LoanID = loanid) and
  Loan.allInstance()->any(l | l.LoanID = loanid).Status = LoanStatus::LSOPEN and
  Loan.allInstance()->any(l | l.LoanID = loanid).IsPaidinFull = true and
  Loan.allInstance()->any(l | l.LoanID = loanid).RemainAmountToPay = 0
            postcondition:
          let loan : Loan = Loan.allInstance()->any(l | l.LoanID = loanid) in
  result = true and
  loan.Status = LoanStatus::CLOSED and
  loan.IsPaidinFull = true and
  loan.RemainAmountToPay = 0 and
  loan.BelongedLoanAccount.Status = LoanAccountStatus::HASPAIDINFULL and
  loan.BelongedLoanAccount.Balance = 0 and
  Loan.allInstance()->excluding(loan)->forAll(l |
    l.oclIsTypeOf(Loan) implies
    l.LoanID = l@pre.LoanID and
    l.RemainAmountToPay = l@pre.RemainAmountToPay and
    l.Status = l@pre.Status and
    l.IsPaidinFull = l@pre.IsPaidinFull and
    l.StartDate = l@pre.StartDate and
    l.EndDate = l@pre.EndDate and
    l.CurrentOverDueDate = l@pre.CurrentOverDueDate and
    l.RePaymentDays = l@pre.RePaymentDays and
    l.RepaymentAmount = l@pre.RepaymentAmount
  )
            
        }