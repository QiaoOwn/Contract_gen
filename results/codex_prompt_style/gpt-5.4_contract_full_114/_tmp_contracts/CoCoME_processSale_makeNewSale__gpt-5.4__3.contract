Contract ProcessSaleService::makeNewSale(): Boolean {
          precondition:
          CurrentSale.oclIsUndefined() and
    Store.allInstance()->exists(s |
        s.IsOpened = true and
        s.AssociationCashdeskes->exists(cd | cd.IsOpened = true)
    )
            postcondition:
          result = true and
    CurrentSale <> null and
    CurrentSale.oclIsNew() and
    CurrentSale.IsComplete = false and
    CurrentSale.IsReadytoPay = false and
    CurrentSale.Amount = 0 and
    CurrentSale.ContainedSalesLine->isEmpty() and
    CurrentSale.AssoicatedPayment.oclIsUndefined() and
    Store.allInstance()->exists(s |
        s.IsOpened = true and
        s.Sales->includes(CurrentSale) and
        CurrentSale.Belongedstore = s and
        s.AssociationCashdeskes->exists(cd |
            cd.IsOpened = true and
            cd.ContainedSales->includes(CurrentSale) and
            CurrentSale.BelongedCashDesk = cd
        )
    )
            
        }