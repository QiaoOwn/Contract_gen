Contract LoanProcessingSystemSystem::closeOutLoan(loanid:Integer): Boolean {
          precondition:
          Loan.allInstance()->exists(l | l.LoanID = loanid and l.Status = LoanStatus::LSOPEN and l.IsPaidinFull = true and l.RemainAmountToPay = 0 and not l.BelongedLoanAccount.oclIsUndefined())
            postcondition:
          let loan : Loan = Loan.allInstance()->any(l | l.LoanID = loanid) in
  result = true and
  loan.Status = LoanStatus::CLOSED and
  loan.IsPaidinFull = true and
  loan.RemainAmountToPay = 0 and
  loan.BelongedLoanAccount.Status = LoanAccountStatus::HASPAIDINFULL and
  loan.BelongedLoanAccount.Balance = 0 and
  Loan.allInstance()->excluding(loan)->forAll(l |
    l.LoanID = l@pre.LoanID and
    l.Status = l@pre.Status and
    l.IsPaidinFull = l@pre.IsPaidinFull and
    l.RemainAmountToPay = l@pre.RemainAmountToPay and
    l.BelongedLoanAccount.Balance = l.BelongedLoanAccount.Balance@pre and
    l.BelongedLoanAccount.Status = l.BelongedLoanAccount.Status@pre
  )
            
        }