Contract RepairService::finishRepair(id:Integer,sid:Integer,did:Integer,res:String): Boolean {
          precondition:
          Device.allInstance()->exists(d | d.Id = did and d.Contacts.Id = sid and d.Contacts.Role = 3) and
    Repair.allInstance()->exists(r | r.Id = id and r.RelatedDevice.Id = did)
            postcondition:
          Repair.allInstance()->exists(r |
        r.Id = id and
        r.RelatedDevice.Id = did and
        r.Process = 4 and
        r.Result = res
    ) and
    result = true
            
        }