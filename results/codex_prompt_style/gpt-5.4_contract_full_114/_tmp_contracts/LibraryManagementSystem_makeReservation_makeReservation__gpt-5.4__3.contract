Contract LibraryManagementSystemSystem::makeReservation(uid:String,barcode:String): Boolean {
          precondition:
          uid <> null and uid <> '' and
  barcode <> null and barcode <> '' and
  User.allInstance()->exists(u | u.UserID = uid) and
  BookCopy.allInstance()->exists(bc | bc.Barcode = barcode) and
  let u : User = User.allInstance()->any(x | x.UserID = uid),
      bc : BookCopy = BookCopy.allInstance()->any(x | x.Barcode = barcode) in
    u.BorrowStatus = BorrowStatus::NORMAL and
    bc.Status = CopyStatus::AVAILABLE and
    bc.IsReserved = false and
    u.ReservedBook->forAll(r | r.IsReserveClosed = true or r.ReservedCopy.Barcode <> barcode)
            postcondition:
          let u : User = User.allInstance()->any(x | x.UserID = uid),
      bc : BookCopy = BookCopy.allInstance()->any(x | x.Barcode = barcode),
      newR : Set(Reserve) = Reserve.allInstance() - Reserve.allInstance() in
    result = true and
    newR->size() = 1 and
    let r : Reserve = newR->any(x | true) in
      r.ReservedUser = u and
      r.ReservedCopy = bc and
      r.IsReserveClosed = false and
      u.ReservedBook = u.ReservedBook@pre->including(r) and
      bc.ReservationRecord = bc.ReservationRecord@pre->including(r) and
      bc.IsReserved = true and
      User.allInstance()->excluding(u)->forAll(x | x.ReservedBook = x.ReservedBook@pre) and
      BookCopy.allInstance()->excluding(bc)->forAll(x | x.IsReserved = x.IsReserved@pre and x.ReservationRecord = x.ReservationRecord@pre)
            
        }