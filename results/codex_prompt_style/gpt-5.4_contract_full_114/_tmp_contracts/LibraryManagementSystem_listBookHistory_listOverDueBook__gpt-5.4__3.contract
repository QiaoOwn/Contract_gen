Contract ListBookHistory::listOverDueBook(uid:String): Set(BookCopy) {
          precondition:
          uid <> null and uid <> '' and User.allInstance()->exists(u | u.UserID = uid)
            postcondition:
          result = User.allInstance()->any(u | u.UserID = uid).LoanedBook
    ->select(l | l.IsReturned = false and (l.OverDueFee > 0.0 or l.OverDue3Days = true or l.OverDue10Days = true or l.OverDue17Days = true or l.OverDue31Days = true))
    ->collect(l | l.LoanedCopy)
    ->asSet()
  and User.allInstance()->forAll(u |
    u.UserID = uid implies
      u.UserID = u.UserID and
      u.Name = u.Name and
      u.Sex = u.Sex and
      u.Password = u.Password and
      u.Email = u.Email and
      u.Faculty = u.Faculty and
      u.LoanedNumber = u.LoanedNumber and
      u.BorrowStatus = u.BorrowStatus and
      u.SuspensionDays = u.SuspensionDays and
      u.OverDueFee = u.OverDueFee
  )
            
        }