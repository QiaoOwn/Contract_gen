Contract SearchBook::searchBookByBarCode(barcode:String): Set(Book) {
          precondition:
          barcode <> null and barcode <> '' and BookCopy.allInstance()->exists(bc | bc.Barcode = barcode)
            postcondition:
          result = Book.allInstance()->select(b | b.Copys->exists(c | c.Barcode = barcode)) and
      Book.allInstance()->forAll(b | b.oclIsNew() = false) and
      BookCopy.allInstance()->forAll(c | c.oclIsNew() = false) and
      Loan.allInstance()->forAll(l | l.oclIsNew() = false) and
      Reserve.allInstance()->forAll(r | r.oclIsNew() = false) and
      User.allInstance()->forAll(u | u.oclIsNew() = false)
            
        }