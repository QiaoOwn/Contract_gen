Contract ManageProductCatalogCRUDService::queryProductCatalog(id:Integer): ProductCatalog {
          precondition:
          id <> null and ProductCatalog.allInstance()->exists(pc | pc.Id = id)
            postcondition:
          result <> null and result.Id = id and
ProductCatalog.allInstance()->includes(result) and
ProductCatalog.allInstance()->size() = ProductCatalog.allInstance()->size() and
Store.allInstance()->forAll(s |
    s.Productcatalogs = s.Productcatalogs@pre and
    s.Items = s.Items@pre and
    s.AssociationCashdeskes = s.AssociationCashdeskes@pre and
    s.Cashiers = s.Cashiers@pre and
    s.Sales = s.Sales@pre
) and
Item.allInstance()->forAll(i |
    i.BelongedCatalog = i.BelongedCatalog@pre and
    i.Barcode = i.Barcode@pre and
    i.Name = i.Name@pre and
    i.Price = i.Price@pre and
    i.StockNumber = i.StockNumber@pre and
    i.OrderPrice = i.OrderPrice@pre
) and
ProductCatalog.allInstance()->forAll(pc |
    pc.Id = pc.Id@pre and
    pc.Name = pc.Name@pre and
    pc.ContainedItems = pc.ContainedItems@pre
)
            
        }