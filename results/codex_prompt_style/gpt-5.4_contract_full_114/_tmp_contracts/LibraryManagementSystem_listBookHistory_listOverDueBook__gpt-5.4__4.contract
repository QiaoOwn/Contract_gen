Contract ListBookHistory::listOverDueBook(uid:String): Set(BookCopy) {
          precondition:
          uid <> null and uid <> '' and User.allInstance()->exists(u | u.UserID = uid)
            postcondition:
          result = User.allInstance()->any(u | u.UserID = uid).LoanedBook
              ->select(l | l.IsReturned = false and (l.OverDueFee > 0 or l.OverDue3Days = true or l.OverDue10Days = true or l.OverDue17Days = true or l.OverDue31Days = true))
              ->collect(l | l.LoanedCopy)
              ->asSet()
and User.allInstance()->any(u | u.UserID = uid).LoanedBook = User.allInstance()->any(u | u.UserID = uid).LoanedBook@pre
and BookCopy.allInstance() = BookCopy.allInstance()
and Loan.allInstance() = Loan.allInstance()
            
        }