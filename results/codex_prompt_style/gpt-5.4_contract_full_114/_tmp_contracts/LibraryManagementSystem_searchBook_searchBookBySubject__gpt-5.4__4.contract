Contract SearchBook::searchBookBySubject(subject:String): Set(Book) {
          precondition:
          subject <> null and subject <> '' and Subject.allInstance()->exists(s | s.Name = subject)
            postcondition:
          result = Book.allInstance()->select(b | b.Subject->exists(s | s.Name = subject))->asSet() and
      Book.allInstance()->forAll(b |
        b.oclIsTypeOf(Book) implies
        b.CallNo = b.CallNo@pre and
        b.Title = b.Title@pre and
        b.Edition = b.Edition@pre and
        b.Author = b.Author@pre and
        b.Publisher = b.Publisher@pre and
        b.Description = b.Description@pre and
        b.ISBn = b.ISBn@pre and
        b.CopyNum = b.CopyNum@pre and
        b.Copys = b.Copys@pre and
        b.Subject = b.Subject@pre
      )
            
        }