Contract LibraryManagementSystemSystem::cancelReservation(uid:String,barcode:String): Boolean {
          precondition:
          uid <> null and uid <> '' and
  barcode <> null and barcode <> '' and
  User.allInstance()->exists(u | u.UserID = uid) and
  BookCopy.allInstance()->exists(bc | bc.Barcode = barcode) and
  Reserve.allInstance()->exists(r |
    r.ReservedUser.UserID = uid and
    r.ReservedCopy.Barcode = barcode and
    r.IsReserveClosed = false
  )
            postcondition:
          result = true and
  Reserve.allInstance()->exists(r |
    r.ReservedUser.UserID = uid and
    r.ReservedCopy.Barcode = barcode and
    r.IsReserveClosed = true
  ) and
  User.allInstance()->any(u | u.UserID = uid).ReservedBook =
    User.allInstance()->any(u | u.UserID = uid).ReservedBook@pre->excluding(
      Reserve.allInstance()->any(r |
        r.ReservedUser.UserID = uid and
        r.ReservedCopy.Barcode = barcode and
        r.IsReserveClosed = false
      )@pre
    ) and
  BookCopy.allInstance()->any(bc | bc.Barcode = barcode).ReservationRecord =
    BookCopy.allInstance()->any(bc | bc.Barcode = barcode).ReservationRecord@pre->excluding(
      Reserve.allInstance()->any(r |
        r.ReservedUser.UserID = uid and
        r.ReservedCopy.Barcode = barcode and
        r.IsReserveClosed = false
      )@pre
    ) and
  if BookCopy.allInstance()->any(bc | bc.Barcode = barcode).ReservationRecord->isEmpty()
  then
    BookCopy.allInstance()->any(bc | bc.Barcode = barcode).IsReserved = false
  else
    BookCopy.allInstance()->any(bc | bc.Barcode = barcode).IsReserved = true
  endif
            
        }