Contract EvaluateLoanRequestModule::listTenLoanRequest(): Set(LoanRequest) {
          precondition:
          true
            postcondition:
          result = LoanRequest.allInstance()->select(lr |
    lr.Status = LoanRequestStatus::READYFORREVIEW
  )->asSet()
  and result->size() <= 10
  and CurrentLoanRequests = result
  and LoanRequest.allInstance()->isEqualTo(LoanRequest.allInstance())
  and Loan.allInstance()->isEqualTo(Loan.allInstance())
  and LoanTerm.allInstance()->isEqualTo(LoanTerm.allInstance())
  and CheckingAccount.allInstance()->isEqualTo(CheckingAccount.allInstance())
  and CreditHistory.allInstance()->isEqualTo(CreditHistory.allInstance())
  and LoanAccount.allInstance()->isEqualTo(LoanAccount.allInstance())
  and ApprovalLetter.allInstance()->isEqualTo(ApprovalLetter.allInstance())
  and LoanAgreement.allInstance()->isEqualTo(LoanAgreement.allInstance())
            
        }