Contract CoCoMESystem::changePrice(barcode:Integer,newPrice:Real): Boolean {
          precondition:
          barcode <> null and newPrice <> null and newPrice > 0 and
     Item.allInstance()->exists(i | i.Barcode = barcode)
            postcondition:
          let it : Item = Item.allInstance()->any(i | i.Barcode = barcode) in
      it.Price = newPrice and
      result = true and
      Item.allInstance()->forAll(i |
        i.Barcode = barcode implies i.Price = newPrice
      )
            
        }