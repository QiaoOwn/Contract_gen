Contract EvaluateLoanRequestModule::approveLoanRequest(): Boolean {
          precondition:
          CurrentLoanRequest <> null and
	CurrentLoanRequests <> null and
	CurrentLoanRequests->includes(CurrentLoanRequest) and
	CurrentLoanRequest.Status = LoanRequestStatus::REFERENCESVALIDATED and
	CurrentLoanRequest.RequestedCAHistory <> null and
	CurrentLoanRequest.RequestedCreditHistory <> null and
	CurrentLoanRequest.ApprovalLoan = null
            postcondition:
          result = true and
	CurrentLoanRequest.Status = LoanRequestStatus::APPROVED and
	CurrentLoanRequest.ApprovalLoan <> null and
	CurrentLoanRequest.ApprovalLoan.ReferedLoanRequest = CurrentLoanRequest and
	CurrentLoanRequest.ApprovalLoan.RemainAmountToPay = CurrentLoanRequest.LoanAmount and
	CurrentLoanRequest.ApprovalLoan.Status = LoanStatus::LSOPEN and
	CurrentLoanRequest.ApprovalLoan.IsPaidinFull = false and
	CurrentLoanRequest.ApprovalLoan.BelongedLoanAccount <> null and
	CurrentLoanRequest.ApprovalLoan.BelongedLoanAccount.Balance = CurrentLoanRequest.LoanAmount and
	CurrentLoanRequest.ApprovalLoan.BelongedLoanAccount.Status = LoanAccountStatus::NORMAL and
	CurrentLoanRequests = CurrentLoanRequests@pre->including(CurrentLoanRequest)
            
        }