Contract LibraryManagementSystemSystem::makeReservation(uid:String,barcode:String): Boolean {
          precondition:
          uid <> null and uid <> '' and
  barcode <> null and barcode <> '' and
  User.allInstance()->exists(u | u.UserID = uid) and
  BookCopy.allInstance()->exists(c | c.Barcode = barcode) and
  let u : User = User.allInstance()->any(x | x.UserID = uid),
      c : BookCopy = BookCopy.allInstance()->any(x | x.Barcode = barcode) in
    u.BorrowStatus = BorrowStatus::NORMAL and
    c.Status = CopyStatus::AVAILABLE and
    c.IsReserved = false and
    Reserve.allInstance()->forAll(r |
      not (r.ReservedUser = u and r.ReservedCopy = c and r.IsReserveClosed = false)
    )
            postcondition:
          let u : User = User.allInstance()->any(x | x.UserID = uid),
      c : BookCopy = BookCopy.allInstance()->any(x | x.Barcode = barcode) in
    result = true and
    Reserve.allInstance()->exists(r |
      r.oclIsNew() and
      r.ReservedUser = u and
      r.ReservedCopy = c and
      r.IsReserveClosed = false and
      u.ReservedBook->includes(r) and
      c.ReservationRecord->includes(r)
    ) and
    c.IsReserved = true and
    u.LoanedNumber = u.LoanedNumber@pre and
    u.BorrowStatus = u.BorrowStatus@pre and
    u.SuspensionDays = u.SuspensionDays@pre and
    u.OverDueFee = u.OverDueFee@pre and
    c.Status = c.Status@pre and
    User.allInstance()->excluding(u)->forAll(x |
      x.UserID = x.UserID@pre and
      x.Name = x.Name@pre and
      x.Sex = x.Sex@pre and
      x.Password = x.Password@pre and
      x.Email = x.Email@pre and
      x.Faculty = x.Faculty@pre and
      x.LoanedNumber = x.LoanedNumber@pre and
      x.BorrowStatus = x.BorrowStatus@pre and
      x.SuspensionDays = x.SuspensionDays@pre and
      x.OverDueFee = x.OverDueFee@pre
    ) and
    BookCopy.allInstance()->excluding(c)->forAll(x |
      x.Barcode = x.Barcode@pre and
      x.Status = x.Status@pre and
      x.Location = x.Location@pre and
      x.IsReserved = x.IsReserved@pre
    )
            
        }