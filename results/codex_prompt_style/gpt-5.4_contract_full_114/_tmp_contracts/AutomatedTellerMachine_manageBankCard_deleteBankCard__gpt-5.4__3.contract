Contract ManageBankCardCRUDService::deleteBankCard(cardid:Integer): Boolean {
          precondition:
          cardid <> null and
  BankCard.allInstance()->exists(b | b.CardID = cardid)
            postcondition:
          let deletedCards : Set(BankCard) = BankCard.allInstance()->select(b | b.CardID = cardid) in
  result = true and
  deletedCards->forAll(b |
    not BankCard.allInstance()->includes(b) and
    if b.BelongedUser <> null then
      not b.BelongedUser.OwnedCard->includes(b)
    else
      true
    endif
  ) and
  BankCard.allInstance()->forAll(b | b.CardID <> cardid)
            
        }