Contract CoCoMEOrderProducts::chooseSupplier(supplierID:Integer): Boolean {
          precondition:
          CurrentOrderProduct <> null and
  Supplier.allInstance()->exists(s | s.Id = supplierID) and
  CurrentOrderProduct.OrderStatus = OrderStatus::NEW
            postcondition:
          let selectedSupplier : Supplier = Supplier.allInstance()->any(s | s.Id = supplierID) in
    CurrentOrderProduct.Supplier = selectedSupplier and
    CurrentOrderProduct.OrderStatus = OrderStatus::REQUESTED and
    CurrentOrderProduct.Id = CurrentOrderProduct@pre.Id and
    CurrentOrderProduct.Time = CurrentOrderProduct@pre.Time and
    CurrentOrderProduct.Amount = CurrentOrderProduct@pre.Amount and
    CurrentOrderProduct.ContainedEntries = CurrentOrderProduct@pre.ContainedEntries and
    result = true
            
        }