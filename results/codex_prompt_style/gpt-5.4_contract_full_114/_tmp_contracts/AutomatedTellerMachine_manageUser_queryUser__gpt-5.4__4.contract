Contract ManageUserCRUDService::queryUser(userid:Integer): User {
          precondition:
          userid <> null and
    User.allInstance()->exists(u | u.UserID = userid)
            postcondition:
          result <> null and
    result.UserID = userid and
    User.allInstance()->includes(result) and
    User.allInstance()->forAll(u |
        u.oclIsUndefined() = false implies
        u.UserID = u.UserID and
        u.Name = u.Name and
        u.Address = u.Address
    ) and
    BankCard.allInstance()->forAll(c |
        c.oclIsUndefined() = false implies
        c.CardID = c.CardID and
        c.CardStatus = c.CardStatus and
        c.Catalog = c.Catalog and
        c.Password = c.Password and
        c.Balance = c.Balance and
        c.BelongedUser = c.BelongedUser
    )
            
        }