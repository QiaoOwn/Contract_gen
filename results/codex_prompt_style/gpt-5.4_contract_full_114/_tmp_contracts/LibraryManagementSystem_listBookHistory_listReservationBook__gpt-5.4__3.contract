Contract ListBookHistory::listReservationBook(uid:String): Set(BookCopy) {
          precondition:
          uid <> null and uid <> '' and User.allInstance()->exists(u | u.UserID = uid)
            postcondition:
          result = User.allInstance()->any(u | u.UserID = uid).ReservedBook->collect(r | r.ReservedCopy)->asSet()
and User.allInstance()->any(u | u.UserID = uid).ReservedBook = User.allInstance()->any(u | u.UserID = uid).ReservedBook@pre
and User.allInstance()->forAll(u | u.oclIsUndefined() = false implies
    u.UserID = u.UserID@pre and
    u.Name = u.Name@pre and
    u.Sex = u.Sex@pre and
    u.Password = u.Password@pre and
    u.Email = u.Email@pre and
    u.Faculty = u.Faculty@pre and
    u.LoanedNumber = u.LoanedNumber@pre and
    u.BorrowStatus = u.BorrowStatus@pre and
    u.SuspensionDays = u.SuspensionDays@pre and
    u.OverDueFee = u.OverDueFee@pre
)
and BookCopy.allInstance()->forAll(bc |
    bc.Barcode = bc.Barcode@pre and
    bc.Status = bc.Status@pre and
    bc.Location = bc.Location@pre and
    bc.IsReserved = bc.IsReserved@pre and
    bc.BookBelongs = bc.BookBelongs@pre and
    bc.LoanedRecord = bc.LoanedRecord@pre and
    bc.ReservationRecord = bc.ReservationRecord@pre
)
and Reserve.allInstance()->forAll(r |
    r.ReserveDate = r.ReserveDate@pre and
    r.IsReserveClosed = r.IsReserveClosed@pre and
    r.ReservedCopy = r.ReservedCopy@pre and
    r.ReservedUser = r.ReservedUser@pre
)
            
        }