Contract ManageStoreCRUDService::deleteStore(id:Integer): Boolean {
          precondition:
          Store.allInstance()->exists(s | s.Id = id)
            postcondition:
          if Store.allInstance()->exists(s | s.Id = id) then
    Store.allInstance()->size() = Store.allInstance()->size() - 1 and
    Store.allInstance()->exists(s |
        s.Id = id and
        not Store.allInstance()->includes(s)
    ) and
    result = true
else
    Store.allInstance()->size() = Store.allInstance()->size() and
    result = false
endif
            
        }