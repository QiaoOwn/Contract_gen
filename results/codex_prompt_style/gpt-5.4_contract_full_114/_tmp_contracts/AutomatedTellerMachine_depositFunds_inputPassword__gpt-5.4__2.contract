Contract AutomatedTellerMachineSystem::inputPassword(password:Integer): Boolean {
          precondition:
          InputCard <> null and
  CardIDValidated = true and
  InputCard.CardStatus = CardStatus::NORMAL
            postcondition:
          PasswordValidated = (InputCard.Password = password) and
  result = PasswordValidated and
  DepositedNumber = DepositedNumber and
  IsDeposit = IsDeposit and
  CardIDValidated = CardIDValidated and
  InputCard = InputCard and
  InputCard.Balance = InputCard.Balance and
  InputCard.CardStatus = InputCard.CardStatus and
  InputCard.Catalog = InputCard.Catalog and
  InputCard.Password = InputCard.Password and
  InputCard.BelongedUser = InputCard.BelongedUser
            
        }