Contract ManageCashDeskCRUDService::createCashDesk(id:Integer,name:String,isopened:Boolean): Boolean {
          precondition:
          id > 0 and
  name <> '' and
  CashDesk.allInstance()->forAll(cd | cd.Id <> id)
            postcondition:
          let newCashDesk : Set(CashDesk) = CashDesk.allInstance()->select(cd | cd.Id = id) in
  result = true and
  newCashDesk->size() = 1 and
  newCashDesk->forAll(cd |
    cd.Name = name and
    cd.IsOpened = isopened
  )
            
        }