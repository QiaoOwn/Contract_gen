Contract AutomatedTellerMachineSystem::ejectCard(): Boolean {
          precondition:
          InputCard <> null and CardIDValidated = true and PasswordValidated = true
            postcondition:
          result = true and InputCard@post = null and CardIDValidated@post = false and PasswordValidated@post = false and BankCard.allInstance()->includes(InputCard@pre) and InputCard@pre.Balance = InputCard.Balance and InputCard@pre.CardStatus = InputCard.CardStatus and InputCard@pre.Catalog = InputCard.Catalog and InputCard@pre.Password = InputCard.Password and InputCard@pre.BelongedUser = InputCard.BelongedUser
            
        }