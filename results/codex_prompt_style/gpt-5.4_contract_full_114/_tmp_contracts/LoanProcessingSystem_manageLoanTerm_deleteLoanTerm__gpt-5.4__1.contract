Contract ManageLoanTermCRUDService::deleteLoanTerm(itemid:Integer): Boolean {
          precondition:
          itemid <> null and
  LoanTerm.allInstance()->exists(lt | lt.ItemID = itemid)
            postcondition:
          LoanTerm.allInstance()->forAll(lt | lt.ItemID <> itemid) and
  LoanRequest.allInstance()->forAll(lr | lr.AttachedLoanTerms->forAll(lt | lt.ItemID <> itemid)) and
  result = true
            
        }