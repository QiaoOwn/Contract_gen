Contract SearchBook::searchBookByBarCode(barcode:String): Set(Book) {
          precondition:
          barcode <> null and barcode <> ''
            postcondition:
          result = Book.allInstance()->select(b |
    b.Copys->exists(c | c.Barcode = barcode)
  ) and
  Book.allInstance()->forAll(b |
    b.oclIsNew() = false
  ) and
  BookCopy.allInstance()->forAll(c |
    c.oclIsNew() = false
  ) and
  User.allInstance()->forAll(u |
    u.oclIsNew() = false
  ) and
  Loan.allInstance()->forAll(l |
    l.oclIsNew() = false
  ) and
  Reserve.allInstance()->forAll(r |
    r.oclIsNew() = false
  ) and
  RecommendBook.allInstance()->forAll(rb |
    rb.oclIsNew() = false
  ) and
  Subject.allInstance()->forAll(s |
    s.oclIsNew() = false
  ) and
  Administrator.allInstance()->forAll(a |
    a.oclIsNew() = false
  ) and
  Librarian.allInstance()->forAll(lb |
    lb.oclIsNew() = false
  )
            
        }