Contract CoCoMESystem::openStore(storeID:Integer): Boolean {
          precondition:
          storeID <> null and
  Store.allInstance()->exists(s | s.Id = storeID) and
  Store.allInstance()->any(s | s.Id = storeID).IsOpened = false
            postcondition:
          CurrentStore = Store.allInstance()->any(s | s.Id = storeID) and
  CurrentStore.IsOpened = true and
  result = true and
  Store.allInstance()->select(s | s.Id <> storeID)->forAll(s |
    s.IsOpened = s.IsOpened@pre
  ) and
  CashDesk.allInstance()->forAll(cd |
    cd.IsOpened = cd.IsOpened@pre
  ) and
  Sale.allInstance()->forAll(sa |
    sa.IsComplete = sa.IsComplete@pre and
    sa.Amount = sa.Amount@pre and
    sa.IsReadytoPay = sa.IsReadytoPay@pre
  )
            
        }