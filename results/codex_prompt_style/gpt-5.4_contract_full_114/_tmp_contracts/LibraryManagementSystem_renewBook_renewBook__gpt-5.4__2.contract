Contract LibraryManagementSystemSystem::renewBook(uid:String,barcode:String): Boolean {
          precondition:
          uid <> null and uid <> '' and
    barcode <> null and barcode <> '' and
    User.allInstance()->exists(u |
        u.UserID = uid and
        u.BorrowStatus = BorrowStatus::NORMAL and
        u.LoanedBook->exists(l |
            l.LoanedCopy.Barcode = barcode and
            l.IsReturned = false
        )
    ) and
    BookCopy.allInstance()->exists(bc |
        bc.Barcode = barcode and
        bc.Status = CopyStatus::LOANED
    )
            postcondition:
          let u : User = User.allInstance()->any(x | x.UserID = uid) in
    let l : Loan = u.LoanedBook@pre->any(x |
        x.LoanedCopy.Barcode = barcode and x.IsReturned = false
    ) in
    result = true and
    l.IsReturned = false and
    l.LoanedUser = u and
    l.LoanedCopy.Barcode = barcode and
    l.RenewedTimes = l.RenewedTimes@pre + 1 and
    l.RenewDate <> null and
    l.DueDate > l.DueDate@pre and
    u.LoanedBook = u.LoanedBook@pre and
    BookCopy.allInstance()->any(bc | bc.Barcode = barcode).Status = CopyStatus::LOANED
            
        }