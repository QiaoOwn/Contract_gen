Contract AutomatedTellerMachineSystem::inputCard(cardid:Integer): Boolean {
          precondition:
          cardid <> null and
  BankCard.allInstance()->exists(c | c.CardID = cardid and c.CardStatus = CardStatus::NORMAL)
            postcondition:
          if BankCard.allInstance()->exists(c | c.CardID = cardid and c.CardStatus = CardStatus::NORMAL) then
    result = true and
    InputCard = BankCard.allInstance()->any(c | c.CardID = cardid) and
    CardIDValidated = true and
    PasswordValidated = PasswordValidated@pre and
    BankCard.allInstance()->forAll(c |
      c.CardID = c.CardID@pre and
      c.CardStatus = c.CardStatus@pre and
      c.Catalog = c.Catalog@pre and
      c.Password = c.Password@pre and
      c.Balance = c.Balance@pre
    ) and
    User.allInstance()->forAll(u |
      u.UserID = u.UserID@pre and
      u.Name = u.Name@pre and
      u.Address = u.Address@pre
    )
  else
    result = false and
    InputCard = InputCard@pre and
    CardIDValidated = false and
    PasswordValidated = PasswordValidated@pre and
    BankCard.allInstance()->forAll(c |
      c.CardID = c.CardID@pre and
      c.CardStatus = c.CardStatus@pre and
      c.Catalog = c.Catalog@pre and
      c.Password = c.Password@pre and
      c.Balance = c.Balance@pre
    ) and
    User.allInstance()->forAll(u |
      u.UserID = u.UserID@pre and
      u.Name = u.Name@pre and
      u.Address = u.Address@pre
    )
  endif
            
        }