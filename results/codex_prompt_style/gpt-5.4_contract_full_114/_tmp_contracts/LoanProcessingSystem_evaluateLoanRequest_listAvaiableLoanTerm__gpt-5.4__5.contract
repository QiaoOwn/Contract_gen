Contract EvaluateLoanRequestModule::listAvaiableLoanTerm(): Set(LoanTerm) {
          precondition:
          CurrentLoanRequest <> null and
	CurrentLoanRequest.Status = LoanRequestStatus::READYFORREVIEW
            postcondition:
          result = CurrentLoanRequest.AttachedLoanTerms and
	CurrentLoanRequest.AttachedLoanTerms = CurrentLoanRequest.AttachedLoanTerms@pre and
	CurrentLoanRequest.Status = CurrentLoanRequest.Status@pre and
	CurrentLoanRequests = CurrentLoanRequests@pre
            
        }