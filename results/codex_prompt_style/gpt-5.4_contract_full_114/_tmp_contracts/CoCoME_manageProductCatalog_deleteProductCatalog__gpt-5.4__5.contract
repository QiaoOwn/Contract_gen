Contract ManageProductCatalogCRUDService::deleteProductCatalog(id:Integer): Boolean {
          precondition:
          id.oclIsUndefined() = false and
	ProductCatalog.allInstance()->exists(pc | pc.Id = id)
            postcondition:
          let pc : ProductCatalog = ProductCatalog.allInstance()->any(p | p.Id = id) in
	ProductCatalog.allInstance()->excluding(pc) = ProductCatalog.allInstance() and
	Item.allInstance()->forAll(i |
		i.BelongedCatalog <> pc
	) and
	Store.allInstance()->forAll(s |
		s.Productcatalogs = s.Productcatalogs@pre->excluding(pc)
	) and
	result = true
            
        }