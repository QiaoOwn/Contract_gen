Contract CoCoMESystem::closeCashDesk(cashDeskID:Integer): Boolean {
          precondition:
          cashDeskID <> null and
  CurrentStore <> null and
  CurrentCashDesk <> null and
  CurrentStore.AssociationCashdeskes->includes(CurrentCashDesk) and
  CurrentCashDesk.Id = cashDeskID and
  CurrentCashDesk.IsOpened = true and
  CurrentCashDesk.ContainedSales->forAll(s | s.IsComplete = true)
            postcondition:
          CurrentCashDesk.IsOpened = false and
  CurrentStore.AssociationCashdeskes->includes(CurrentCashDesk) and
  CurrentCashDesk.Id = cashDeskID and
  result = true
            
        }