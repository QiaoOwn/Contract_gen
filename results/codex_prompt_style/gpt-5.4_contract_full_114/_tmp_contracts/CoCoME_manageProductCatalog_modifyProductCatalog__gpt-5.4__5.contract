Contract ManageProductCatalogCRUDService::modifyProductCatalog(id:Integer,name:String): Boolean {
          precondition:
          id.oclIsUndefined() = false and
	name.oclIsUndefined() = false and
	ProductCatalog.allInstance()->exists(pc | pc.Id = id)
            postcondition:
          let pc : ProductCatalog = ProductCatalog.allInstance()->any(p | p.Id = id) in
		pc.Name = name and
		result = true and
		ProductCatalog.allInstance()->size() = ProductCatalog.allInstance()->size() and
		ProductCatalog.allInstance()->forAll(p |
			p.Id = id implies p = pc
		)
            
        }