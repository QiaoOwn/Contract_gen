Contract CoCoMESystem::changePrice(barcode:Integer,newPrice:Real): Boolean {
          precondition:
          barcode > 0 and
    newPrice >= 0 and
    Store.allInstance()->exists(s | s.Items->exists(i | i.Barcode = barcode))
            postcondition:
          let targetItem : Item = Store.allInstance()->collect(s | s.Items)->flatten()->any(i | i.Barcode = barcode) in
    targetItem.Price = newPrice and
    result = true and
    Item.allInstance()->excluding(targetItem)->forAll(i | i.Price = i.Price@pre) and
    targetItem.Barcode = targetItem.Barcode@pre and
    targetItem.Name = targetItem.Name@pre and
    targetItem.StockNumber = targetItem.StockNumber@pre and
    targetItem.OrderPrice = targetItem.OrderPrice@pre and
    Store.allInstance()->forAll(s |
        s.Id = s.Id@pre and
        s.Name = s.Name@pre and
        s.Address = s.Address@pre and
        s.IsOpened = s.IsOpened@pre and
        s.AssociationCashdeskes = s.AssociationCashdeskes@pre and
        s.Productcatalogs = s.Productcatalogs@pre and
        s.Items = s.Items@pre and
        s.Cashiers = s.Cashiers@pre and
        s.Sales = s.Sales@pre
    )
            
        }