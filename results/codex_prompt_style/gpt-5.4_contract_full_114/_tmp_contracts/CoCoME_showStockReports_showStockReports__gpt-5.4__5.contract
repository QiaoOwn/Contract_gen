Contract CoCoMESystem::showStockReports(): Set(Item) {
          precondition:
          Store.allInstance()->exists(s | s.IsOpened = true)
            postcondition:
          result = Store.allInstance()->select(s | s.IsOpened = true)->collect(i | i.Items)->asSet()
and Store.allInstance() = Store.allInstance()
and ProductCatalog.allInstance() = ProductCatalog.allInstance()
and CashDesk.allInstance() = CashDesk.allInstance()
and Sale.allInstance() = Sale.allInstance()
and Cashier.allInstance() = Cashier.allInstance()
and SalesLineItem.allInstance() = SalesLineItem.allInstance()
and Item.allInstance() = Item.allInstance()
and Payment.allInstance() = Payment.allInstance()
and CashPayment.allInstance() = CashPayment.allInstance()
and CardPayment.allInstance() = CardPayment.allInstance()
and OrderEntry.allInstance() = OrderEntry.allInstance()
and Supplier.allInstance() = Supplier.allInstance()
and OrderProduct.allInstance() = OrderProduct.allInstance()
            
        }