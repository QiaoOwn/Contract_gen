Contract LibraryManagementSystemSystem::countDownSuspensionDay(): void {
          precondition:
          true
            postcondition:
          User.allInstance()->forAll(u |
    ((u@pre.SuspensionDays > 0 and u@pre.LoanedBook->exists(l | l.IsReturned = false and l.OverDue3Days = true)) implies
      (u.SuspensionDays = u@pre.SuspensionDays - 1 and
       (if u.SuspensionDays = 0 then u.BorrowStatus = BorrowStatus::SUSPEND else u.BorrowStatus = u@pre.BorrowStatus endif)
      )
    ) and
    ((not (u@pre.SuspensionDays > 0 and u@pre.LoanedBook->exists(l | l.IsReturned = false and l.OverDue3Days = true))) implies
      (u.SuspensionDays = u@pre.SuspensionDays and u.BorrowStatus = u@pre.BorrowStatus)
    )
  )
            
        }