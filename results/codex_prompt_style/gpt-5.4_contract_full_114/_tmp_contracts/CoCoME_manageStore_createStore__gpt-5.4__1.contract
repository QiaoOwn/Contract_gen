Contract ManageStoreCRUDService::createStore(id:Integer,name:String,address:String,isopened:Boolean): Boolean {
          precondition:
          id.oclIsUndefined() = false and
    name.oclIsUndefined() = false and
    address.oclIsUndefined() = false and
    isopened.oclIsUndefined() = false and
    Store.allInstance()->forAll(s | s.Id <> id)
            postcondition:
          Store.allInstance()->exists(s |
        s.Id = id and
        s.Name = name and
        s.Address = address and
        s.IsOpened = isopened
    ) and
    Store.allInstance()->size() = Store.allInstance()->size() + 1 and
    result = true
            
        }