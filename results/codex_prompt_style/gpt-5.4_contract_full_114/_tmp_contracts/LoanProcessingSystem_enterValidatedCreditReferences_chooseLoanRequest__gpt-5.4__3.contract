Contract EnterValidatedCreditReferencesModule::chooseLoanRequest(requestid:Integer): LoanRequest {
          precondition:
          LoanRequest.allInstance()->exists(lr | lr.RequestID = requestid and lr.Status = LoanRequestStatus::SUBMITTED)
            postcondition:
          CurrentLoanRequest = result and
	result.RequestID = requestid and
	result.Status = LoanRequestStatus::REFERENCESVALIDATED and
	LoanRequest.allInstance()->one(lr | lr = result and lr.RequestID = requestid) and
	LoanRequest.allInstance()->forAll(lr |
		(lr.RequestID = requestid implies lr.Status = LoanRequestStatus::REFERENCESVALIDATED) and
		(lr.RequestID <> requestid implies lr.Status = lr.Status@pre)
	)
            
        }