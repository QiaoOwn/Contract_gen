Contract ManageCashierCRUDService::queryCashier(id:Integer): Cashier {
          precondition:
          id <> null and Cashier.allInstance()->exists(c | c.Id = id)
            postcondition:
          result <> null and result.Id = id and Cashier.allInstance()->includes(result) and Cashier.allInstance()->size() = Cashier.allInstance()->size()
            
        }