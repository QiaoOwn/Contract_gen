Contract GenerateLoanLetterAndAgreementModule::genereateApprovalLetter(id:Integer): Boolean {
          precondition:
          id.oclIsUndefined() = false and
  CurrentLoanRequests->exists(lr | lr.RequestID = id) and
  CurrentLoanRequest = CurrentLoanRequests->any(lr | lr.RequestID = id) and
  CurrentLoanRequest.Status = LoanRequestStatus::APPROVED and
  CurrentLoanRequest.ApprovalLoan <> null and
  CurrentLoanRequest.AttachedLoanTerms->notEmpty() and
  CurrentLoanRequest.AttachedApprovalLetter = null and
  CurrentLoanRequest.AttachedLoanAgreement = null
            postcondition:
          result = true and
  CurrentLoanRequest = CurrentLoanRequests->any(lr | lr.RequestID = id) and
  CurrentApprovalLetter.oclIsNew() and
  CurrentLoanAgreement.oclIsNew() and
  CurrentLoanRequest.AttachedApprovalLetter = CurrentApprovalLetter and
  CurrentLoanRequest.AttachedLoanAgreement = CurrentLoanAgreement and
  CurrentApprovalLetter.Content <> '' and
  CurrentLoanAgreement.Content <> '' and
  CurrentLoanRequest.Status = LoanRequestStatus::APPROVED
            
        }