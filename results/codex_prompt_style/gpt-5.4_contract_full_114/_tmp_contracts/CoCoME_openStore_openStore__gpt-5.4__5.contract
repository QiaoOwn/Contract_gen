Contract CoCoMESystem::openStore(storeID:Integer): Boolean {
          precondition:
          Store.allInstance()->exists(s | s.Id = storeID and s.IsOpened = false)
            postcondition:
          let s : Store = Store.allInstance()->any(x | x.Id = storeID) in
s.IsOpened = true and
CurrentStore = s and
result = true and
Store.allInstance()->excluding(s)->forAll(st | st.IsOpened = st.IsOpened@pre) and
CashDesk.allInstance()->forAll(cd | cd.IsOpened = cd.IsOpened@pre) and
Sale.allInstance()->forAll(sa |
    sa.IsComplete = sa.IsComplete@pre and
    sa.Amount = sa.Amount@pre and
    sa.IsReadytoPay = sa.IsReadytoPay@pre
) and
Cashier.allInstance()->forAll(c | c.Name = c.Name@pre and c.Id = c.Id@pre) and
Item.allInstance()->forAll(i |
    i.Barcode = i.Barcode@pre and
    i.Name = i.Name@pre and
    i.Price = i.Price@pre and
    i.StockNumber = i.StockNumber@pre and
    i.OrderPrice = i.OrderPrice@pre
) and
ProductCatalog.allInstance()->forAll(pc |
    pc.Id = pc.Id@pre and
    pc.Name = pc.Name@pre
)
            
        }