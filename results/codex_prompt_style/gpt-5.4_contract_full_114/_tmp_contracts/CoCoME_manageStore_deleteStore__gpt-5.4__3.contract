Contract ManageStoreCRUDService::deleteStore(id:Integer): Boolean {
          precondition:
          id <> null and Store.allInstance()->exists(s | s.Id = id)
            postcondition:
          if Store.allInstance()->exists(s | s.Id = id) then
		Store.allInstance()->forAll(s | s.Id <> id) and
		result = true
	else
		result = false
	endif
            
        }