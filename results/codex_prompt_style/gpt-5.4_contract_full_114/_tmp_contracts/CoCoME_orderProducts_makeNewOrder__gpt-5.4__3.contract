Contract CoCoMEOrderProducts::makeNewOrder(orderid:Integer): Boolean {
          precondition:
          orderid <> null and
  OrderProduct.allInstance()->forAll(op | op.Id <> orderid)
            postcondition:
          CurrentOrderProduct <> null and
  CurrentOrderProduct.oclIsNew() and
  CurrentOrderProduct.Id = orderid and
  CurrentOrderProduct.OrderStatus = OrderStatus::NEW and
  CurrentOrderProduct.ContainedEntries->isEmpty() and
  CurrentOrderProduct.Amount = 0 and
  result = true
            
        }