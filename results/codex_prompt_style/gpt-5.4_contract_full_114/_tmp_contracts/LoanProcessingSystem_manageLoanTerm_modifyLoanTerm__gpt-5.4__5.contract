Contract ManageLoanTermCRUDService::modifyLoanTerm(itemid:Integer,content:String): Boolean {
          precondition:
          itemid <> null and
    content <> null and
    LoanTerm.allInstance()->exists(lt | lt.ItemID = itemid)
            postcondition:
          LoanTerm.allInstance()->exists(lt |
        lt.ItemID = itemid and
        lt.Content = content
    ) and
    LoanTerm.allInstance()->forAll(lt |
        lt.ItemID <> itemid implies
        lt.Content = lt.Content@pre
    ) and
    result = true
            
        }