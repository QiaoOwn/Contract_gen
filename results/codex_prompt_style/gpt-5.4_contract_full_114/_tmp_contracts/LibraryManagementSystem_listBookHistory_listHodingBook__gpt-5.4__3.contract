Contract ListBookHistory::listHodingBook(uid:String): Set(Loan) {
          precondition:
          uid <> null and
  User.allInstance()->exists(u | u.UserID = uid)
            postcondition:
          result = User.allInstance()->any(u | u.UserID = uid).LoanedBook->asSet() and
  User.allInstance()->forAll(u |
    u.UserID = uid implies u.LoanedBook->asSet() = result
  )
            
        }