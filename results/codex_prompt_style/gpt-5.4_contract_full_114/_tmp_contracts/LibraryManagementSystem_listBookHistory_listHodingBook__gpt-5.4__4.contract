Contract ListBookHistory::listHodingBook(uid:String): Set(Loan) {
          precondition:
          not uid.oclIsUndefined() and
  uid <> '' and
  User.allInstance()->exists(u | u.UserID = uid)
            postcondition:
          result = User.allInstance()->any(u | u.UserID = uid).LoanedBook and
  User.allInstance()->forAll(u |
    u.UserID = uid implies u.LoanedBook = result
  ) and
  User.allInstance()->forAll(u |
    u.LoanedBook = u.LoanedBook@pre and
    u.ReservedBook = u.ReservedBook@pre and
    u.RecommendedBook = u.RecommendedBook@pre and
    u.LoanedNumber = u.LoanedNumber@pre and
    u.BorrowStatus = u.BorrowStatus@pre and
    u.SuspensionDays = u.SuspensionDays@pre and
    u.OverDueFee = u.OverDueFee@pre
  ) and
  Loan.allInstance()->forAll(l |
    l.LoanedUser = l.LoanedUser@pre and
    l.LoanedCopy = l.LoanedCopy@pre and
    l.LoanLibrarian = l.LoanLibrarian@pre and
    l.ReturnLibrarian = l.ReturnLibrarian@pre and
    l.LoanDate = l.LoanDate@pre and
    l.RenewDate = l.RenewDate@pre and
    l.DueDate = l.DueDate@pre and
    l.ReturnDate = l.ReturnDate@pre and
    l.RenewedTimes = l.RenewedTimes@pre and
    l.IsReturned = l.IsReturned@pre and
    l.OverDueFee = l.OverDueFee@pre and
    l.OverDue3Days = l.OverDue3Days@pre and
    l.OverDue10Days = l.OverDue10Days@pre and
    l.OverDue17Days = l.OverDue17Days@pre and
    l.OverDue31Days = l.OverDue31Days@pre
  )
            
        }