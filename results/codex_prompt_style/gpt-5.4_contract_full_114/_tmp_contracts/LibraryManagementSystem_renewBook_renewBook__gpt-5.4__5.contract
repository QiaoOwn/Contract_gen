Contract LibraryManagementSystemSystem::renewBook(uid:String,barcode:String): Boolean {
          precondition:
          uid <> null and uid <> '' and
  barcode <> null and barcode <> '' and
  User.allInstance()->exists(u | u.UserID = uid) and
  BookCopy.allInstance()->exists(c | c.Barcode = barcode) and
  let u : User = User.allInstance()->any(x | x.UserID = uid),
      c : BookCopy = BookCopy.allInstance()->any(x | x.Barcode = barcode),
      l : Loan = Loan.allInstance()->any(x | x.LoanedUser = u and x.LoanedCopy = c and x.IsReturned = false)
  in
    Loan.allInstance()->exists(x | x.LoanedUser = u and x.LoanedCopy = c and x.IsReturned = false) and
    u.BorrowStatus = BorrowStatus::NORMAL and
    c.Status = CopyStatus::LOANED and
    l.OverDueFee = 0 and
    l.OverDue3Days = false and
    l.OverDue10Days = false and
    l.OverDue17Days = false and
    l.OverDue31Days = false and
    c.ReservationRecord->select(r | r.IsReserveClosed = false)->isEmpty()
            postcondition:
          let u : User = User.allInstance()->any(x | x.UserID = uid),
      c : BookCopy = BookCopy.allInstance()->any(x | x.Barcode = barcode),
      l : Loan = Loan.allInstance()->any(x | x.LoanedUser = u and x.LoanedCopy = c and x.IsReturned = false)
  in
    result = true and
    l.RenewedTimes = l.RenewedTimes@pre + 1 and
    l.RenewDate <> null and
    l.DueDate > l.DueDate@pre and
    l.IsReturned = false and
    l.LoanedUser = u and
    l.LoanedCopy = c and
    u.LoanedNumber = u.LoanedNumber@pre and
    u.BorrowStatus = u.BorrowStatus@pre and
    c.Status = c.Status@pre and
    Loan.allInstance()->size() = Loan.allInstance()->size() and
    User.allInstance()->size() = User.allInstance()->size() and
    BookCopy.allInstance()->size() = BookCopy.allInstance()->size()
            
        }