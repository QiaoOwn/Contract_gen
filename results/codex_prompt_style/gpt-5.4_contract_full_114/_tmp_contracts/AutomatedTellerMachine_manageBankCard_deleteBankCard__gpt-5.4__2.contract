Contract ManageBankCardCRUDService::deleteBankCard(cardid:Integer): Boolean {
          precondition:
          cardid <> null and
  BankCard.allInstance()->exists(b | b.CardID = cardid)
            postcondition:
          let deletedCards : Set(BankCard) = BankCard.allInstance()->select(b | b.CardID = cardid) in
  result = true and
  deletedCards->forAll(b | not BankCard.allInstance()->includes(b)) and
  User.allInstance()->forAll(u | deletedCards->forAll(b | not u.OwnedCard->includes(b)))
            
        }