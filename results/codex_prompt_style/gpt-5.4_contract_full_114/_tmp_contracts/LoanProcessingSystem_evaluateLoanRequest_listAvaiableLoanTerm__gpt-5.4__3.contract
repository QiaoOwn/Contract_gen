Contract EvaluateLoanRequestModule::listAvaiableLoanTerm(): Set(LoanTerm) {
          precondition:
          CurrentLoanRequest <> null and
     CurrentLoanRequests <> null and
     CurrentLoanRequests->includes(CurrentLoanRequest) and
     CurrentLoanRequest.Status = LoanRequestStatus::READYFORREVIEW
            postcondition:
          result = CurrentLoanRequest.AttachedLoanTerms and
      CurrentLoanRequest = CurrentLoanRequest@pre and
      CurrentLoanRequests = CurrentLoanRequests@pre and
      LoanTerm.allInstance() = LoanTerm.allInstance() and
      LoanRequest.allInstance() = LoanRequest.allInstance() and
      Loan.allInstance() = Loan.allInstance() and
      CheckingAccount.allInstance() = CheckingAccount.allInstance() and
      CreditHistory.allInstance() = CreditHistory.allInstance() and
      LoanAccount.allInstance() = LoanAccount.allInstance() and
      ApprovalLetter.allInstance() = ApprovalLetter.allInstance() and
      LoanAgreement.allInstance() = LoanAgreement.allInstance()
            
        }