Contract SearchBook::searchBookByTitle(title:String): Set(Book) {
          precondition:
          not title.oclIsUndefined() and title <> ''
            postcondition:
          result = Book.allInstance()->select(b | b.Title = title) and
    Book.allInstance()->forAll(b |
        b.CallNo = b.CallNo and
        b.Title = b.Title and
        b.Edition = b.Edition and
        b.Author = b.Author and
        b.Publisher = b.Publisher and
        b.Description = b.Description and
        b.ISBn = b.ISBn and
        b.CopyNum = b.CopyNum
    ) and
    User.allInstance()->forAll(u |
        u.UserID = u.UserID and
        u.Name = u.Name and
        u.Sex = u.Sex and
        u.Password = u.Password and
        u.Email = u.Email and
        u.Faculty = u.Faculty and
        u.LoanedNumber = u.LoanedNumber and
        u.BorrowStatus = u.BorrowStatus and
        u.SuspensionDays = u.SuspensionDays and
        u.OverDueFee = u.OverDueFee
    ) and
    BookCopy.allInstance()->forAll(c |
        c.Barcode = c.Barcode and
        c.Status = c.Status and
        c.Location = c.Location and
        c.IsReserved = c.IsReserved
    ) and
    Loan.allInstance()->forAll(l |
        l.LoanDate = l.LoanDate and
        l.RenewDate = l.RenewDate and
        l.DueDate = l.DueDate and
        l.ReturnDate = l.ReturnDate and
        l.RenewedTimes = l.RenewedTimes and
        l.IsReturned = l.IsReturned and
        l.OverDueFee = l.OverDueFee and
        l.OverDue3Days = l.OverDue3Days and
        l.OverDue10Days = l.OverDue10Days and
        l.OverDue17Days = l.OverDue17Days and
        l.OverDue31Days = l.OverDue31Days
    ) and
    Reserve.allInstance()->forAll(r |
        r.ReserveDate = r.ReserveDate and
        r.IsReserveClosed = r.IsReserveClosed
    ) and
    RecommendBook.allInstance()->forAll(rb |
        rb.RecommendDate = rb.RecommendDate
    ) and
    Subject.allInstance()->forAll(s |
        s.Name = s.Name
    )
            
        }