Contract GenerateLoanLetterAndAgreementModule::listApprovalRequest(): Set(LoanRequest) {
          precondition:
          true
            postcondition:
          result = LoanRequest.allInstance()->select(lr |
    lr.Status = LoanRequestStatus::APPROVED
  )->asSet() and
  CurrentLoanRequests = result and
  CurrentLoanRequests->forAll(lr | lr.Status = LoanRequestStatus::APPROVED) and
  LoanRequest.allInstance()->forAll(lr |
    lr.Status = LoanRequestStatus::APPROVED implies CurrentLoanRequests->includes(lr)
  )
            
        }