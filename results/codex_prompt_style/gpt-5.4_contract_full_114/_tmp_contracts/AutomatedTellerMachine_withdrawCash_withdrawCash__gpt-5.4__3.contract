Contract AutomatedTellerMachineSystem::withdrawCash(quantity:Integer): Boolean {
          precondition:
          quantity > 0 and
  InputCard <> null and
  CardIDValidated = true and
  PasswordValidated = true and
  IsWithdraw = true and
  InputCard.CardStatus = CardStatus::NORMAL and
  quantity <= InputCard.Balance
            postcondition:
          if result = true then
    InputCard.Balance = InputCard.Balance@pre - quantity and
    WithdrawedNumber = quantity and
    IsWithdraw = true and
    IsDeposit = IsDeposit@pre and
    DepositedNumber = DepositedNumber@pre and
    InputCard.CardID = InputCard.CardID@pre and
    InputCard.CardStatus = InputCard.CardStatus@pre and
    InputCard.Catalog = InputCard.Catalog@pre and
    InputCard.Password = InputCard.Password@pre and
    InputCard.BelongedUser = InputCard.BelongedUser@pre and
    CardIDValidated = CardIDValidated@pre and
    PasswordValidated = PasswordValidated@pre
  else
    InputCard.Balance = InputCard.Balance@pre and
    WithdrawedNumber = WithdrawedNumber@pre and
    IsWithdraw = IsWithdraw@pre and
    IsDeposit = IsDeposit@pre and
    DepositedNumber = DepositedNumber@pre and
    InputCard.CardID = InputCard.CardID@pre and
    InputCard.CardStatus = InputCard.CardStatus@pre and
    InputCard.Catalog = InputCard.Catalog@pre and
    InputCard.Password = InputCard.Password@pre and
    InputCard.BelongedUser = InputCard.BelongedUser@pre and
    CardIDValidated = CardIDValidated@pre and
    PasswordValidated = PasswordValidated@pre
  endif
            
        }