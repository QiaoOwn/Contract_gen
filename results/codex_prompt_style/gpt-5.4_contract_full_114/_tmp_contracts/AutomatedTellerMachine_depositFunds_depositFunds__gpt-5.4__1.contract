Contract AutomatedTellerMachineSystem::depositFunds(quantity:Real): Boolean {
          precondition:
          quantity > 0 and
  InputCard <> null and
  CardIDValidated = true and
  PasswordValidated = true and
  InputCard.CardStatus = CardStatus::NORMAL
            postcondition:
          InputCard.Balance = InputCard.Balance@pre + quantity and
  DepositedNumber = quantity and
  IsDeposit = true and
  result = true
            
        }