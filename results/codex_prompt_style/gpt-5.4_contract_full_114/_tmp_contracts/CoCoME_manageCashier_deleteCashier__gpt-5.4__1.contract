Contract ManageCashierCRUDService::deleteCashier(id:Integer): Boolean {
          precondition:
          id <> null and
	Cashier.allInstance()->exists(c | c.Id = id)
            postcondition:
          if Cashier.allInstance()->exists(c | c.Id = id) then
		Cashier.allInstance()->size() = Cashier.allInstance()->size() - 1 and
		not Cashier.allInstance()->exists(c | c.Id = id) and
		Store.allInstance()->forAll(s |
			s.Cashiers = s.Cashiers@pre->excluding(Cashier.allInstance()->any(c | c.Id = id))
		) and
		result = true
	else
		Cashier.allInstance()->size() = Cashier.allInstance()->size() and
		Store.allInstance()->forAll(s | s.Cashiers = s.Cashiers@pre) and
		result = false
	endif
            
        }