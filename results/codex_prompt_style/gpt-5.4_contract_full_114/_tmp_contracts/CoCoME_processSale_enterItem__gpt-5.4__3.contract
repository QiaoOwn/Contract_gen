Contract ProcessSaleService::enterItem(barcode:Integer,quantity:Integer): Boolean {
          precondition:
          CurrentSale <> null and
    barcode <> null and
    quantity <> null and
    quantity > 0 and
    CurrentSale.IsComplete = false and
    CurrentSale.IsReadytoPay = false and
    Item.allInstance()->exists(i | i.Barcode = barcode and i.StockNumber >= quantity)
            postcondition:
          let matchedItem : Item = Item.allInstance()->any(i | i.Barcode = barcode) in
    SalesLineItem.allInstance()->exists(sli |
        sli.oclIsNew() and
        sli.BelongedSale = CurrentSale and
        sli.BelongedItem = matchedItem and
        sli.Quantity = quantity and
        sli.Subamount = matchedItem.Price * quantity
    ) and
    CurrentSale.ContainedSalesLine->includes(
        SalesLineItem.allInstance()->any(sli |
            sli.BelongedSale = CurrentSale and
            sli.BelongedItem = matchedItem and
            sli.Quantity = quantity and
            sli.oclIsNew()
        )
    ) and
    matchedItem.StockNumber = matchedItem.StockNumber@pre - quantity and
    CurrentSale.Amount = CurrentSale.Amount@pre + (matchedItem.Price * quantity) and
    result = true
            
        }