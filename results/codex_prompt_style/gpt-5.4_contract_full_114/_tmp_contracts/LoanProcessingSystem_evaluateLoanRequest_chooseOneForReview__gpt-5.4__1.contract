Contract EvaluateLoanRequestModule::chooseOneForReview(requestid:Integer): LoanRequest {
          precondition:
          CurrentLoanRequests->notEmpty() and
  CurrentLoanRequests->exists(lr | lr.RequestID = requestid) and
  CurrentLoanRequests->exists(lr | lr.RequestID = requestid and lr.Status = LoanRequestStatus::REFERENCESVALIDATED)
            postcondition:
          CurrentLoanRequest = CurrentLoanRequests->any(lr | lr.RequestID = requestid) and
  result = CurrentLoanRequest and
  result.RequestID = requestid and
  result.Status = LoanRequestStatus::REFERENCESVALIDATED and
  CurrentLoanRequests = CurrentLoanRequests@pre and
  LoanRequest.allInstance() = LoanRequest.allInstance() and
  Loan.allInstance() = Loan.allInstance() and
  LoanTerm.allInstance() = LoanTerm.allInstance() and
  CheckingAccount.allInstance() = CheckingAccount.allInstance() and
  CreditHistory.allInstance() = CreditHistory.allInstance() and
  LoanAccount.allInstance() = LoanAccount.allInstance() and
  ApprovalLetter.allInstance() = ApprovalLetter.allInstance() and
  LoanAgreement.allInstance() = LoanAgreement.allInstance()
            
        }