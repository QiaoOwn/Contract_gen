Contract SubmitLoanRequestModule::calculateScore(): Integer {
          precondition:
          not CurrentLoanRequest.oclIsUndefined() and
  CurrentLoanRequest.RequestedCAHistory <> null and
  CurrentLoanRequest.RequestedCreditHistory <> null and
  CurrentLoanRequest.Status = LoanRequestStatus::REFERENCESVALIDATED
            postcondition:
          CurrentLoanRequest = CurrentLoanRequest@pre and
  result = CurrentLoanRequest.RequestedCreditHistory.BadDebits * 10 + CurrentLoanRequest.RequestedCreditHistory.OutstandingDebt.div(1000).floor() + (if CurrentLoanRequest.RequestedCAHistory.Status = Status::SUSPENDED then 50 else 0 endif) and
  result >= 0
            
        }