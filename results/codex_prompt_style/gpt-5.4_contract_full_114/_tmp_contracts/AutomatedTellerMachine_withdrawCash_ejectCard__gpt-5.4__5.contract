Contract AutomatedTellerMachineSystem::ejectCard(): Boolean {
          precondition:
          InputCard <> null and
  CardIDValidated = true and
  PasswordValidated = true and
  InputCard.CardStatus = CardStatus::NORMAL
            postcondition:
          InputCard = null and
  result = true and
  CardIDValidated = false and
  PasswordValidated = false and
  IsWithdraw = false and
  IsDeposit = false and
  WithdrawedNumber = 0 and
  DepositedNumber = 0
            
        }