Contract ManageItemCRUDService::queryItem(barcode:Integer): Item {
          precondition:
          barcode <> null and
    Item.allInstance()->exists(i | i.Barcode = barcode)
            postcondition:
          result <> null and
    result.oclIsTypeOf(Item) and
    result.Barcode = barcode and
    Item.allInstance()->includes(result) and
    Item.allInstance()->size() = Item.allInstance()->size() and
    Store.allInstance()->forAll(s | s.Items = s.Items@pre) and
    ProductCatalog.allInstance()->forAll(pc | pc.ContainedItems = pc.ContainedItems@pre)
            
        }