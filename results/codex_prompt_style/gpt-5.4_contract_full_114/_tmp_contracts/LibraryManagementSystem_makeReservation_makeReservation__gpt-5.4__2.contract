Contract LibraryManagementSystemSystem::makeReservation(uid:String,barcode:String): Boolean {
          precondition:
          uid <> null and uid <> '' and
    barcode <> null and barcode <> '' and
    User.allInstance()->exists(u | u.UserID = uid) and
    BookCopy.allInstance()->exists(c | c.Barcode = barcode) and
    let u : User = User.allInstance()->any(x | x.UserID = uid),
        c : BookCopy = BookCopy.allInstance()->any(x | x.Barcode = barcode)
    in
        u.BorrowStatus = BorrowStatus::NORMAL and
        c.Status = CopyStatus::AVAILABLE and
        c.IsReserved = false and
        Reserve.allInstance()->forAll(r |
            not (r.ReservedUser = u and r.ReservedCopy = c and r.IsReserveClosed = false)
        )
            postcondition:
          let u : User = User.allInstance()->any(x | x.UserID = uid),
        c : BookCopy = BookCopy.allInstance()->any(x | x.Barcode = barcode)
    in
        result = true and
        Reserve.allInstance()->exists(r |
            r.oclIsNew() and
            r.ReservedUser = u and
            r.ReservedCopy = c and
            r.IsReserveClosed = false
        ) and
        u.ReservedBook = u.ReservedBook@pre->including(
            Reserve.allInstance()->any(r |
                r.oclIsNew() and
                r.ReservedUser = u and
                r.ReservedCopy = c and
                r.IsReserveClosed = false
            )
        ) and
        c.ReservationRecord = c.ReservationRecord@pre->including(
            Reserve.allInstance()->any(r |
                r.oclIsNew() and
                r.ReservedUser = u and
                r.ReservedCopy = c and
                r.IsReserveClosed = false
            )
        ) and
        c.IsReserved = true and
        c.Status = c.Status@pre and
        u.LoanedNumber = u.LoanedNumber@pre and
        u.BorrowStatus = u.BorrowStatus@pre and
        u.SuspensionDays = u.SuspensionDays@pre and
        u.OverDueFee = u.OverDueFee@pre
            
        }