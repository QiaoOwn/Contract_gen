Contract LibraryManagementSystemSystem::listRecommendBook(uid:String): Set(RecommendBook) {
          precondition:
          uid <> null and uid <> '' and User.allInstance()->exists(u | u.UserID = uid)
            postcondition:
          result = User.allInstance()->any(u | u.UserID = uid).RecommendedBook and
      User.allInstance()->any(u | u.UserID = uid).RecommendedBook = User.allInstance()->any(u | u.UserID = uid).RecommendedBook@pre and
      RecommendBook.allInstance() = RecommendBook.allInstance() and
      User.allInstance() = User.allInstance() and
      Book.allInstance() = Book.allInstance() and
      BookCopy.allInstance() = BookCopy.allInstance() and
      Loan.allInstance() = Loan.allInstance() and
      Reserve.allInstance() = Reserve.allInstance()
            
        }