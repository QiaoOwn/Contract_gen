Contract LibraryManagementSystemSystem::cancelReservation(uid:String,barcode:String): Boolean {
          precondition:
          uid <> null and uid <> '' and
  barcode <> null and barcode <> '' and
  User.allInstance()->exists(u | u.UserID = uid) and
  BookCopy.allInstance()->exists(bc | bc.Barcode = barcode) and
  Reserve.allInstance()->exists(r |
    r.ReservedUser.UserID = uid and
    r.ReservedCopy.Barcode = barcode and
    r.IsReserveClosed = false
  )
            postcondition:
          let u : User = User.allInstance()->any(x | x.UserID = uid),
      bc : BookCopy = BookCopy.allInstance()->any(x | x.Barcode = barcode),
      r : Reserve = Reserve.allInstance()->any(x |
        x.ReservedUser.UserID = uid and
        x.ReservedCopy.Barcode = barcode and
        x.IsReserveClosed = false@pre
      )
  in
    result = true and
    r.IsReserveClosed = true and
    u.ReservedBook = u.ReservedBook@pre->excluding(r) and
    bc.ReservationRecord = bc.ReservationRecord@pre->excluding(r) and
    (bc.ReservationRecord->forAll(x | x.IsReserveClosed = true) implies bc.IsReserved = false) and
    (bc.ReservationRecord->exists(x | x.IsReserveClosed = false) implies bc.IsReserved = bc.IsReserved@pre)
            
        }