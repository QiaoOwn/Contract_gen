Contract ManageUserCRUDService::deleteUser(userid:Integer): Boolean {
          precondition:
          User.allInstance()->exists(u | u.UserID = userid)
            postcondition:
          let deletedUsers : Set(User) = User.allInstance()->select(u | u.UserID = userid) in
    result = true and
    deletedUsers->forAll(u |
        not User.allInstance()->includes(u) and
        BankCard.allInstance()->forAll(c | c.BelongedUser <> u)
    )
            
        }