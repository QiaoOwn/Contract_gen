Contract ManageCashierCRUDService::queryCashier(id:Integer): Cashier {
          precondition:
          id.oclIsUndefined() = false and Cashier.allInstance()->exists(c | c.Id = id)
            postcondition:
          result.oclIsUndefined() = false and result.Id = id and Cashier.allInstance()->includes(result) and Cashier.allInstance() = Cashier.allInstance() and Store.allInstance() = Store.allInstance() and result = Cashier.allInstance()->any(c | c.Id = id)
            
        }