Contract ManageCashierCRUDService::deleteCashier(id:Integer): Boolean {
          precondition:
          id <> null and Cashier.allInstance()->exists(c | c.Id = id)
            postcondition:
          if Cashier.allInstance()->exists(c | c.Id = id) then
    let deletedCashier : Cashier = Cashier.allInstance()->any(c | c.Id = id) in
        result = true and
        Cashier.allInstance()->excluding(deletedCashier) = Cashier.allInstance() and
        Store.allInstance()->forAll(s |
            s.Cashiers = s.Cashiers@pre->excluding(deletedCashier)
        )
else
    result = false
endif
            
        }