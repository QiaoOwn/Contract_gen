Contract ProcessSaleService::makeCashPayment(amount:Real): Boolean {
          precondition:
          CurrentSale <> null and
    CurrentPaymentMethod = PaymentMethod::CASH and
    amount >= CurrentSale.Amount and
    CurrentSale.IsReadytoPay = true and
    CurrentSale.IsComplete = false and
    CurrentSale.AssoicatedPayment = null
            postcondition:
          result = true and
    CurrentSale.IsComplete = true and
    CurrentSale.AssoicatedPayment <> null and
    CurrentSale.AssoicatedPayment.oclIsTypeOf(CashPayment) and
    CurrentSale.AssoicatedPayment.AmountTendered = amount and
    CurrentSale.AssoicatedPayment.BelongedSale = CurrentSale and
    CurrentSale.Amount = CurrentSale@pre.Amount and
    CurrentSale.ContainedSalesLine = CurrentSale@pre.ContainedSalesLine and
    CurrentSale.Belongedstore = CurrentSale@pre.Belongedstore and
    CurrentSale.BelongedCashDesk = CurrentSale@pre.BelongedCashDesk and
    CurrentSale.Time = CurrentSale@pre.Time and
    CurrentSale.IsReadytoPay = CurrentSale@pre.IsReadytoPay and
    CashPayment.allInstance()->exists(cp |
        cp = CurrentSale.AssoicatedPayment and
        cp.AmountTendered = amount and
        cp.Balance = amount - CurrentSale.Amount
    )
            
        }