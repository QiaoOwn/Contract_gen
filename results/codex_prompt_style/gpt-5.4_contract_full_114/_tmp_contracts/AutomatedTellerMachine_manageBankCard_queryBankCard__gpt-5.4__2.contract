Contract ManageBankCardCRUDService::queryBankCard(cardid:Integer): BankCard {
          precondition:
          not cardid.oclIsUndefined() and
BankCard.allInstance()->exists(b | b.CardID = cardid)
            postcondition:
          result = BankCard.allInstance()->any(b | b.CardID = cardid) and
BankCard.allInstance()->size() = BankCard.allInstance()->size() and
User.allInstance()->size() = User.allInstance()->size()
            
        }