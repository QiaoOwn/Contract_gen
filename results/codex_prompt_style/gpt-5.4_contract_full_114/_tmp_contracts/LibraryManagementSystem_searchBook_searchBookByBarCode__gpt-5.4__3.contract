Contract SearchBook::searchBookByBarCode(barcode:String): Set(Book) {
          precondition:
          barcode <> null and barcode <> '' and
  BookCopy.allInstance()->exists(bc | bc.Barcode = barcode)
            postcondition:
          result = Book.allInstance()->select(b | b.Copys->exists(c | c.Barcode = barcode)) and
  Book.allInstance()->forAll(b |
    b.oclIsNew() = false and
    b.CallNo = b.CallNo@pre and
    b.Title = b.Title@pre and
    b.Edition = b.Edition@pre and
    b.Author = b.Author@pre and
    b.Publisher = b.Publisher@pre and
    b.Description = b.Description@pre and
    b.ISBn = b.ISBn@pre and
    b.CopyNum = b.CopyNum@pre
  ) and
  BookCopy.allInstance()->forAll(c |
    c.oclIsNew() = false and
    c.Barcode = c.Barcode@pre and
    c.Status = c.Status@pre and
    c.Location = c.Location@pre and
    c.IsReserved = c.IsReserved@pre and
    c.BookBelongs = c.BookBelongs@pre
  )
            
        }