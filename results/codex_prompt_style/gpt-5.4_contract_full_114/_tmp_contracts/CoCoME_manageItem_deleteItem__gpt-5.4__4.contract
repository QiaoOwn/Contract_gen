Contract ManageItemCRUDService::deleteItem(barcode:Integer): Boolean {
          precondition:
          barcode <> null and
    Item.allInstance()->exists(i | i.Barcode = barcode)
            postcondition:
          let deletedItems : Set(Item) = Item.allInstance()->select(i | i.Barcode = barcode) in
    deletedItems->forAll(i |
        not Item.allInstance()->includes(i) and
        Store.allInstance()->forAll(s | not s.Items->includes(i)) and
        ProductCatalog.allInstance()->forAll(pc | pc.ContainedItems <> i) and
        SalesLineItem.allInstance()->forAll(sli | sli.BelongedItem <> i)
    ) and
    result = true
            
        }