Contract ManageLibrarianCRUDService::createLibrarian(librarianid:String,name:String,password:String): Boolean {
          precondition:
          librarianid <> null and librarianid <> '' and
  name <> null and name <> '' and
  password <> null and password <> '' and
  Librarian.allInstance()->forAll(l | l.LibrarianID <> librarianid)
            postcondition:
          (result = true implies
    Librarian.allInstance()->exists(l |
      l.oclIsNew() and
      l.LibrarianID = librarianid and
      l.Name = name and
      l.Password = password
    )
  ) and
  (result = true implies
    Librarian.allInstance()->size() = Librarian.allInstance()->size() + 1
  ) and
  (result = false implies
    Librarian.allInstance()->size() = Librarian.allInstance()->size()
  ) and
  Librarian.allInstance()->forAll(l |
    Librarian.allInstance()->exists(lp | lp = l) implies
      l.LibrarianID = l.LibrarianID@pre and
      l.Name = l.Name@pre and
      l.Password = l.Password@pre
  )
            
        }