Contract EvaluateLoanRequestModule::addLoanTerm(termid:Integer): Boolean {
          precondition:
          CurrentLoanRequest <> null and
    CurrentLoanRequest.Status = LoanRequestStatus::APPROVED and
    termid > 0 and
    LoanTerm.allInstance()->exists(lt | lt.ItemID = termid) and
    not CurrentLoanRequest.AttachedLoanTerms->exists(lt | lt.ItemID = termid)
            postcondition:
          let addedTerm : LoanTerm = LoanTerm.allInstance()->any(lt | lt.ItemID = termid) in
    CurrentLoanRequest.AttachedLoanTerms = CurrentLoanRequest.AttachedLoanTerms@pre->including(addedTerm) and
    CurrentLoanRequest.Status = CurrentLoanRequest.Status@pre and
    result = true
            
        }