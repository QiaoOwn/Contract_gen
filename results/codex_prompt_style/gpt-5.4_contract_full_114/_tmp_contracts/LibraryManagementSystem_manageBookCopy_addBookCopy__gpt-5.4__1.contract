Contract ManageBookCopyCRUDService::addBookCopy(callNo:String,barcode:String,location:String): Boolean {
          precondition:
          callNo <> null and callNo <> '' and
    barcode <> null and barcode <> '' and
    location <> null and location <> '' and
    Book.allInstance()->exists(b | b.CallNo = callNo) and
    BookCopy.allInstance()->forAll(bc | bc.Barcode <> barcode)
            postcondition:
          if result = true then
        BookCopy.allInstance()->exists(bc |
            bc.oclIsNew() and
            bc.Barcode = barcode and
            bc.Location = location and
            bc.Status = CopyStatus::AVAILABLE and
            bc.IsReserved = false and
            bc.BookBelongs = Book.allInstance()->any(b | b.CallNo = callNo) and
            bc.LoanedRecord->isEmpty() and
            bc.ReservationRecord->isEmpty()
        ) and
        Book.allInstance()->any(b | b.CallNo = callNo).Copys->includes(
            BookCopy.allInstance()->any(bc | bc.Barcode = barcode)
        ) and
        Book.allInstance()->any(b | b.CallNo = callNo).CopyNum = Book.allInstance()->any(b | b.CallNo = callNo).CopyNum@pre + 1
    else
        BookCopy.allInstance()->forAll(bc | not (bc.oclIsNew() and bc.Barcode = barcode)) and
        Book.allInstance()->forAll(b |
            b.CopyNum = b.CopyNum@pre and
            b.Copys = b.Copys@pre
        )
    endif
            
        }