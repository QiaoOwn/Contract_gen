Contract EvaluateLoanRequestModule::chooseOneForReview(requestid:Integer): LoanRequest {
          precondition:
          LoanRequest.allInstance()->exists(lr | lr.RequestID = requestid and lr.Status = LoanRequestStatus::REFERENCESVALIDATED)
            postcondition:
          result = CurrentLoanRequest and
  result.RequestID = requestid and
  CurrentLoanRequests = CurrentLoanRequests@pre and
  LoanRequest.allInstance() = LoanRequest.allInstance() and
  result.oclIsTypeOf(LoanRequest) and
  result.Status = LoanRequestStatus::REFERENCESVALIDATED
            
        }