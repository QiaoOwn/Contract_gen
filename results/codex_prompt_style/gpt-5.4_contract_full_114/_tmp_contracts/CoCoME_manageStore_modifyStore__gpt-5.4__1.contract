Contract ManageStoreCRUDService::modifyStore(id:Integer,name:String,address:String,isopened:Boolean): Boolean {
          precondition:
          id <> null and
name <> null and
address <> null and
isopened <> null and
Store.allInstance()->exists(s | s.Id = id)
            postcondition:
          let s : Store = Store.allInstance()->any(x | x.Id = id) in
s.Id = id and
s.Name = name and
s.Address = address and
s.IsOpened = isopened and
result = true and
Store.allInstance()->size() = Store.allInstance()->size() and
s.AssociationCashdeskes = s.AssociationCashdeskes@pre and
s.Productcatalogs = s.Productcatalogs@pre and
s.Items = s.Items@pre and
s.Cashiers = s.Cashiers@pre and
s.Sales = s.Sales@pre
            
        }