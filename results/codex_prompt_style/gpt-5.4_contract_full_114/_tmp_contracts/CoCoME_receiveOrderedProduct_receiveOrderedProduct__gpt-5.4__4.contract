Contract CoCoMESystem::receiveOrderedProduct(orderID:Integer): Boolean {
          precondition:
          OrderProduct.allInstance()->exists(op | op.Id = orderID and op.OrderStatus = OrderStatus::REQUESTED)
            postcondition:
          let order : OrderProduct = OrderProduct.allInstance()->any(op | op.Id = orderID) in
    order.OrderStatus = OrderStatus::RECEIVED and
    order.ContainedEntries->forAll(oe |
        oe.Item.StockNumber = oe.Item.StockNumber@pre + oe.Quantity
    ) and
    result = true
            
        }