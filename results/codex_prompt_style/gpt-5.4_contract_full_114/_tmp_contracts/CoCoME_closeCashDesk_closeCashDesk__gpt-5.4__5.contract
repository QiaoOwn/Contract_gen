Contract CoCoMESystem::closeCashDesk(cashDeskID:Integer): Boolean {
          precondition:
          cashDeskID <> null and
    CurrentStore <> null and
    CurrentCashDesk <> null and
    CurrentStore.AssociationCashdeskes->includes(CurrentCashDesk) and
    CurrentCashDesk.Id = cashDeskID and
    CurrentCashDesk.IsOpened = true and
    CurrentCashDesk.ContainedSales->forAll(s | s.IsComplete = true)
            postcondition:
          CurrentCashDesk.IsOpened = false and
    result = true and
    CurrentStore.AssociationCashdeskes = CurrentStore.AssociationCashdeskes@pre and
    CurrentStore.Productcatalogs = CurrentStore.Productcatalogs@pre and
    CurrentStore.Items = CurrentStore.Items@pre and
    CurrentStore.Cashiers = CurrentStore.Cashiers@pre and
    CurrentStore.Sales = CurrentStore.Sales@pre and
    CurrentCashDesk.ContainedSales = CurrentCashDesk.ContainedSales@pre and
    CurrentCashDesk.BelongedStore = CurrentCashDesk.BelongedStore@pre
            
        }