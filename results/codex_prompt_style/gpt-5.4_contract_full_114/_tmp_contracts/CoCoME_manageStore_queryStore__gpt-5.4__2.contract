Contract ManageStoreCRUDService::queryStore(id:Integer): Store {
          precondition:
          id.oclIsUndefined() = false and Store.allInstance()->exists(s | s.Id = id)
            postcondition:
          result.oclIsUndefined() = false and result.Id = id and
      Store.allInstance()->exists(s | s = result) and
      Store.allInstance()->size() = Store.allInstance()->size() and
      result.Name = result.Name@pre and
      result.Address = result.Address@pre and
      result.IsOpened = result.IsOpened@pre and
      result.AssociationCashdeskes = result.AssociationCashdeskes@pre and
      result.Productcatalogs = result.Productcatalogs@pre and
      result.Items = result.Items@pre and
      result.Cashiers = result.Cashiers@pre and
      result.Sales = result.Sales@pre
            
        }