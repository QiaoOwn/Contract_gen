Contract ManageLoanTermCRUDService::queryLoanTerm(itemid:Integer): LoanTerm {
          precondition:
          LoanTerm.allInstance()->exists(lt | lt.ItemID = itemid)
            postcondition:
          result <> null and
	result.ItemID = itemid and
	LoanTerm.allInstance()->includes(result) and
	LoanTerm.allInstance()->size() = LoanTerm.allInstance()->size() and
	LoanRequest.allInstance()->forAll(lr |
		lr.AttachedLoanTerms = lr.AttachedLoanTerms@pre
	)
            
        }