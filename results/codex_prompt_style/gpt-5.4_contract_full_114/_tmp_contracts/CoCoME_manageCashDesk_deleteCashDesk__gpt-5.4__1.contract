Contract ManageCashDeskCRUDService::deleteCashDesk(id:Integer): Boolean {
          precondition:
          id <> null and
	CashDesk.allInstance()->exists(cd | cd.Id = id) and
	CashDesk.allInstance()->any(cd | cd.Id = id).ContainedSales->isEmpty()
            postcondition:
          let cd : CashDesk = CashDesk.allInstance()->any(c | c.Id = id) in
	result = true and
	CashDesk.allInstance()->excluding(cd) = CashDesk.allInstance()->excluding(cd) and
	not CashDesk.allInstance()->includes(cd) and
	cd.BelongedStore <> null implies
		not cd.BelongedStore.AssociationCashdeskes->includes(cd)
            
        }