Contract EnterValidatedCreditReferencesModule::chooseLoanRequest(requestid:Integer): LoanRequest {
          precondition:
          LoanRequest.allInstance()->exists(lr | lr.RequestID = requestid and lr.Status = LoanRequestStatus::SUBMITTED)
            postcondition:
          CurrentLoanRequest = LoanRequest.allInstance()->any(lr | lr.RequestID = requestid and lr.Status = LoanRequestStatus::SUBMITTED) and
    CurrentLoanRequest.Status = LoanRequestStatus::REFERENCESVALIDATED and
    result = CurrentLoanRequest and
    LoanRequest.allInstance()->forAll(lr |
        lr.RequestID = requestid implies lr = CurrentLoanRequest
    ) and
    LoanRequest.allInstance()->forAll(lr |
        lr <> CurrentLoanRequest implies lr.Status = lr.Status@pre
    )
            
        }