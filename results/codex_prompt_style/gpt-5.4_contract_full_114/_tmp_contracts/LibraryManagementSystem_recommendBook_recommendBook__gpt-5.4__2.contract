Contract LibraryManagementSystemSystem::recommendBook(uid:String,callNo:String,title:String,edition:String,author:String,publisher:String,description:String,isbn:String): Boolean {
          precondition:
          uid <> '' and
  callNo <> '' and
  title <> '' and
  author <> '' and
  publisher <> '' and
  isbn <> '' and
  User.allInstance()->exists(u | u.UserID = uid) and
  RecommendBook.allInstance()->forAll(r |
    not (r.RecommendUser.UserID = uid and
         r.RecommendUser.RecommendedBook->includes(r))
  )
            postcondition:
          if result = true then
    User.allInstance()->exists(u |
      u.UserID = uid and
      u.RecommendedBook->size() = u.RecommendedBook@pre->size() + 1 and
      u.RecommendedBook->exists(r |
        not u.RecommendedBook@pre->includes(r) and
        r.RecommendUser = u and
        r.RecommendDate <> null
      )
    ) and
    RecommendBook.allInstance()->size() = RecommendBook.allInstance()->size() + 1
  else
    RecommendBook.allInstance()->size() = RecommendBook.allInstance()->size() and
    User.allInstance()->forAll(u |
      u.RecommendedBook->size() = u.RecommendedBook@pre->size()
    )
  endif
            
        }