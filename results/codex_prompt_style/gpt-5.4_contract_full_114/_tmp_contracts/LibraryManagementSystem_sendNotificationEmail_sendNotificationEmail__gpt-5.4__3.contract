Contract ThirdPartyServices::sendNotificationEmail(email:String): Boolean {
          precondition:
          email <> null and email <> '' and User.allInstance()->exists(u | u.Email = email)
            postcondition:
          result = true and User.allInstance()->exists(u | u.Email = email) and User.allInstance()->forAll(u |
    u.UserID = u.UserID and
    u.Name = u.Name and
    u.Sex = u.Sex and
    u.Password = u.Password and
    u.Email = u.Email and
    u.Faculty = u.Faculty and
    u.LoanedNumber = u.LoanedNumber and
    u.BorrowStatus = u.BorrowStatus and
    u.SuspensionDays = u.SuspensionDays and
    u.OverDueFee = u.OverDueFee
)
            
        }