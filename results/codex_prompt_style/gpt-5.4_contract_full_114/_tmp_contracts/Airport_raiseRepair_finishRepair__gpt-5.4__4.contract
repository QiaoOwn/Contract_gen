Contract RepairService::finishRepair(id:Integer,sid:Integer,did:Integer,res:String): Boolean {
          precondition:
          Staff.allInstance()->exists(s | s.Id = sid and
        Device.allInstance()->exists(d | d.Id = did and d.Contacts = s) and
        s.Role = 3
    ) and
    Repair.allInstance()->exists(r | r.Id = id and r.RelatedDevice.Id = did)
            postcondition:
          Repair.allInstance()->exists(r | r.Id = id and
        r.Process = 4 and
        r.Result = res
    ) and
    result = true
            
        }