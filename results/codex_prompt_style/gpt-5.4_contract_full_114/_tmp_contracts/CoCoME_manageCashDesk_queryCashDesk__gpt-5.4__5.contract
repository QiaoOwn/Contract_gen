Contract ManageCashDeskCRUDService::queryCashDesk(id:Integer): CashDesk {
          precondition:
          id <> null and CashDesk.allInstance()->exists(cd | cd.Id = id)
            postcondition:
          result <> null and
	result.Id = id and
	CashDesk.allInstance()->includes(result) and
	CashDesk.allInstance()->isEqual(CashDesk.allInstance()) and
	Store.allInstance()->isEqual(Store.allInstance()) and
	ProductCatalog.allInstance()->isEqual(ProductCatalog.allInstance()) and
	Sale.allInstance()->isEqual(Sale.allInstance()) and
	Cashier.allInstance()->isEqual(Cashier.allInstance()) and
	SalesLineItem.allInstance()->isEqual(SalesLineItem.allInstance()) and
	Item.allInstance()->isEqual(Item.allInstance()) and
	Payment.allInstance()->isEqual(Payment.allInstance()) and
	CashPayment.allInstance()->isEqual(CashPayment.allInstance()) and
	CardPayment.allInstance()->isEqual(CardPayment.allInstance()) and
	OrderEntry.allInstance()->isEqual(OrderEntry.allInstance()) and
	Supplier.allInstance()->isEqual(Supplier.allInstance()) and
	OrderProduct.allInstance()->isEqual(OrderProduct.allInstance())
            
        }