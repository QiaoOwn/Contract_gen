Contract ManageCashDeskCRUDService::deleteCashDesk(id:Integer): Boolean {
          precondition:
          id.oclIsUndefined() = false and
    CashDesk.allInstance()->exists(cd | cd.Id = id) and
    let cd : CashDesk = CashDesk.allInstance()->any(c | c.Id = id) in
        cd.ContainedSales->isEmpty()
            postcondition:
          let deletedCd : CashDesk = CashDesk.allInstance()->any(c | c.Id = id) in
        CashDesk.allInstance()->forAll(c | c.Id <> id) and
        Store.allInstance()->forAll(s | not s.AssociationCashdeskes->includes(deletedCd)) and
        result = true
            
        }