Contract ManageStoreCRUDService::queryStore(id:Integer): Store {
          precondition:
          id <> null and Store.allInstance()->exists(s | s.Id = id)
            postcondition:
          result <> null and result.Id = id and
      Store.allInstance()->includes(result) and
      Store.allInstance()->size() = Store.allInstance()->size() and
      ProductCatalog.allInstance()->size() = ProductCatalog.allInstance()->size() and
      CashDesk.allInstance()->size() = CashDesk.allInstance()->size() and
      Sale.allInstance()->size() = Sale.allInstance()->size() and
      Cashier.allInstance()->size() = Cashier.allInstance()->size() and
      SalesLineItem.allInstance()->size() = SalesLineItem.allInstance()->size() and
      Item.allInstance()->size() = Item.allInstance()->size() and
      Payment.allInstance()->size() = Payment.allInstance()->size() and
      OrderEntry.allInstance()->size() = OrderEntry.allInstance()->size() and
      Supplier.allInstance()->size() = Supplier.allInstance()->size() and
      OrderProduct.allInstance()->size() = OrderProduct.allInstance()->size()
            
        }