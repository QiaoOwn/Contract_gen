Contract LoanProcessingSystemSystem::closeOutLoan(loanid:Integer): Boolean {
          precondition:
          loanid <> null and
    Loan.allInstance()->exists(l | l.LoanID = loanid and l.Status = LoanStatus::LSOPEN and l.IsPaidinFull = true and l.RemainAmountToPay = 0 and l.BelongedLoanAccount <> null)
            postcondition:
          if Loan.allInstance()->exists(l | l.LoanID = loanid@pre and l.Status = LoanStatus::LSOPEN and l.IsPaidinFull = true and l.RemainAmountToPay = 0) then
        result = true and
        Loan.allInstance()->exists(l |
            l.LoanID = loanid@pre and
            l.Status = LoanStatus::CLOSED and
            l.IsPaidinFull = true and
            l.RemainAmountToPay = 0 and
            l.BelongedLoanAccount.Status = LoanAccountStatus::HASPAIDINFULL
        ) and
        Loan.allInstance()->forAll(l |
            l.LoanID <> loanid@pre implies
            l.Status = l.Status@pre and
            l.IsPaidinFull = l.IsPaidinFull@pre and
            l.RemainAmountToPay = l.RemainAmountToPay@pre
        )
    else
        result = false
    endif
            
        }