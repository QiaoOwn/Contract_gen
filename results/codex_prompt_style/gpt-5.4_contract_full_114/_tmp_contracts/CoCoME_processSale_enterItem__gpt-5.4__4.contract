Contract ProcessSaleService::enterItem(barcode:Integer,quantity:Integer): Boolean {
          precondition:
          CurrentSale <> null and
  barcode > 0 and
  quantity > 0 and
  Item.allInstance()->exists(i | i.Barcode = barcode) and
  CurrentSale.IsComplete = false and
  CurrentSale.IsReadytoPay = false
            postcondition:
          let matchedItem : Item = Item.allInstance()->any(i | i.Barcode = barcode) in
  let newLine : Set(SalesLineItem) = CurrentSale.ContainedSalesLine - CurrentSale.ContainedSalesLine@pre in
  result = true and
  CurrentSale.ContainedSalesLine->size() = CurrentSale.ContainedSalesLine@pre->size() + 1 and
  newLine->size() = 1 and
  CurrentSaleLine = newLine->any(s | true) and
  CurrentSale.ContainedSalesLine->includes(CurrentSaleLine) and
  CurrentSaleLine.BelongedSale = CurrentSale and
  CurrentSaleLine.BelongedItem = matchedItem and
  CurrentSaleLine.Quantity = quantity and
  CurrentSaleLine.Subamount = matchedItem.Price * quantity and
  CurrentSale.Amount = CurrentSale.Amount@pre + CurrentSaleLine.Subamount and
  CurrentSale.IsComplete = false and
  CurrentSale.IsReadytoPay = false
            
        }