Contract ManageBankCardCRUDService::queryBankCard(cardid:Integer): BankCard {
          precondition:
          cardid <> null and BankCard.allInstance()->exists(b | b.CardID = cardid)
            postcondition:
          result <> null and result.CardID = cardid and
BankCard.allInstance()->includes(result) and
BankCard.allInstance() = BankCard.allInstance() and
User.allInstance() = User.allInstance()
            
        }