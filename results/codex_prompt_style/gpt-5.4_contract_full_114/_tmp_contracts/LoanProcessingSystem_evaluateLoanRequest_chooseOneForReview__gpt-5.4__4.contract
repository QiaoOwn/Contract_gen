Contract EvaluateLoanRequestModule::chooseOneForReview(requestid:Integer): LoanRequest {
          precondition:
          requestid <> null and
  CurrentLoanRequests->exists(lr | lr.RequestID = requestid) and
  CurrentLoanRequests->exists(lr |
    lr.RequestID = requestid and
    (lr.Status = LoanRequestStatus::SUBMITTED or
     lr.Status = LoanRequestStatus::REFERENCESVALIDATED or
     lr.Status = LoanRequestStatus::READYFORREVIEW)
  )
            postcondition:
          result = CurrentLoanRequests->any(lr | lr.RequestID = requestid) and
  CurrentLoanRequest = result and
  result.RequestID = requestid and
  result.Status = LoanRequestStatus::READYFORREVIEW and
  CurrentLoanRequests = CurrentLoanRequests@pre and
  CurrentLoanRequests->forAll(lr |
    lr.RequestID <> requestid implies
    lr.Status = lr.Status@pre
  )
            
        }