Contract EvaluateLoanRequestModule::checkCreditHistory(): CreditHistory {
          precondition:
          CurrentLoanRequest <> null and
     CurrentLoanRequest.RequestedCreditHistory <> null and
     CurrentLoanRequest.Status = LoanRequestStatus::REFERENCESVALIDATED
            postcondition:
          result = CurrentLoanRequest.RequestedCreditHistory and
      CurrentLoanRequest.RequestedCreditHistory = result and
      CurrentLoanRequest.Status = CurrentLoanRequest.Status@pre and
      CurrentLoanRequest.RequestID = CurrentLoanRequest.RequestID@pre and
      CurrentLoanRequest.Name = CurrentLoanRequest.Name@pre and
      CurrentLoanRequest.LoanAmount = CurrentLoanRequest.LoanAmount@pre and
      CurrentLoanRequest.LoanPurpose = CurrentLoanRequest.LoanPurpose@pre and
      CurrentLoanRequest.Income = CurrentLoanRequest.Income@pre and
      CurrentLoanRequest.PhoneNumber = CurrentLoanRequest.PhoneNumber@pre and
      CurrentLoanRequest.PostalAddress = CurrentLoanRequest.PostalAddress@pre and
      CurrentLoanRequest.ZipCode = CurrentLoanRequest.ZipCode@pre and
      CurrentLoanRequest.Email = CurrentLoanRequest.Email@pre and
      CurrentLoanRequest.WorkReferences = CurrentLoanRequest.WorkReferences@pre and
      CurrentLoanRequest.CreditReferences = CurrentLoanRequest.CreditReferences@pre and
      CurrentLoanRequest.CheckingAccountNumber = CurrentLoanRequest.CheckingAccountNumber@pre and
      CurrentLoanRequest.SecurityNumber = CurrentLoanRequest.SecurityNumber@pre and
      CurrentLoanRequest.CreditScore = CurrentLoanRequest.CreditScore@pre and
      result.OutstandingDebt = result.OutstandingDebt@pre and
      result.BadDebits = result.BadDebits@pre and
      CurrentLoanRequests = CurrentLoanRequests@pre
            
        }