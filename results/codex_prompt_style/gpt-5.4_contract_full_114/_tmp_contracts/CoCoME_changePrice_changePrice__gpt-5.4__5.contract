Contract CoCoMESystem::changePrice(barcode:Integer,newPrice:Real): Boolean {
          precondition:
          barcode <> null and newPrice <> null and newPrice > 0 and
     Item.allInstance()->exists(i | i.Barcode = barcode)
            postcondition:
          let item : Item = Item.allInstance()->any(i | i.Barcode = barcode) in
      item.Price = newPrice and
      result = true and
      Item.allInstance()->excluding(item)->forAll(i | i.Price = i.Price@pre) and
      item.Barcode = item.Barcode@pre and
      item.Name = item.Name@pre and
      item.StockNumber = item.StockNumber@pre and
      item.OrderPrice = item.OrderPrice@pre and
      item.BelongedCatalog = item.BelongedCatalog@pre
            
        }