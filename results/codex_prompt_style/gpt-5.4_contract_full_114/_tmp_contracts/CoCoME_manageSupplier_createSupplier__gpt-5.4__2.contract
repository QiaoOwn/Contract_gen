Contract ManageSupplierCRUDService::createSupplier(id:Integer,name:String): Boolean {
          precondition:
          id <> null and name <> null and name <> '' and Supplier.allInstance()->forAll(s | s.Id <> id)
            postcondition:
          Supplier.allInstance()->exists(s | s.Id = id and s.Name = name) and
      Supplier.allInstance()->size() = Supplier.allInstance()->size() + 1 and
      result = true
            
        }