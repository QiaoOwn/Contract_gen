Contract AutomatedTellerMachineSystem::inputPassword(password:Integer): Boolean {
          precondition:
          InputCard <> null and
  password <> null and
  CardIDValidated = true and
  InputCard.CardStatus = CardStatus::NORMAL
            postcondition:
          if InputCard.Password = password then
    PasswordValidated = true and
    result = true and
    InputCard = InputCard@pre and
    CardIDValidated = CardIDValidated@pre
  else
    PasswordValidated = false and
    result = false and
    InputCard = InputCard@pre and
    CardIDValidated = CardIDValidated@pre
  endif and
  BankCard.allInstance()->forAll(c |
    c.Balance = c.Balance@pre and
    c.Password = c.Password@pre and
    c.CardStatus = c.CardStatus@pre and
    c.Catalog = c.Catalog@pre and
    c.BelongedUser = c.BelongedUser@pre
  ) and
  User.allInstance()->forAll(u |
    u.UserID = u.UserID@pre and
    u.Name = u.Name@pre and
    u.Address = u.Address@pre and
    u.OwnedCard = u.OwnedCard@pre
  )
            
        }