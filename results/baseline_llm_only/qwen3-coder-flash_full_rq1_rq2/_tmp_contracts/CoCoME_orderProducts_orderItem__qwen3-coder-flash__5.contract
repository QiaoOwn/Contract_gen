Contract CoCoMEOrderProducts::orderItem(barcode:Integer,quantity:Integer): Boolean {
          definition:
          item:Item = Item.allInstance()->any(o:Item|o.Barcode=barcode), currentOrder:OrderProduct = CoCoMEOrderProducts.CurrentOrderProduct
            precondition:
          item.oclIsUndefined() = false and quantity > 0 and item.StockNumber >= quantity and currentOrder.oclIsUndefined() = false
            postcondition:
          let entry:OrderEntry in entry.oclIsNew() and entry.Quantity=quantity and entry.SubAmount=item.Price * quantity and currentOrder.ContainedEntries->includes(entry) and result=true
            
        }