Contract ManageBookCopyCRUDService::addBookCopy(callNo:String,barcode:String,location:String): Boolean {
          definition:
          book:Book = Book.allInstance()->any(b:Book|b.CallNo=callNo), copy:BookCopy = BookCopy.allInstance()->any(c:BookCopy|c.Barcode=barcode)
            precondition:
          book.oclIsUndefined() = false and copy.oclIsUndefined() = true and callNo <> '' and barcode <> '' and location <> ''
            postcondition:
          let newCopy:BookCopy in newCopy.oclIsNew() and newCopy.Barcode=barcode and newCopy.Location=location and newCopy.Status=CopyStatus.AVAILABLE and newCopy.IsReserved=false and book.Copys->includes(newCopy) and BookCopy.allInstance()->includes(newCopy) and result=true
            
        }