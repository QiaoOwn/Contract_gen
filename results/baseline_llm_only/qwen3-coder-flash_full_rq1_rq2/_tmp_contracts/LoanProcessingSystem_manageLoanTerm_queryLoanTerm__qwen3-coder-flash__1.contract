Contract ManageLoanTermCRUDService::queryLoanTerm(itemid:Integer): LoanTerm {
          definition:
          lt:LoanTerm = LoanTerm.allInstance()->any(o:LoanTerm|o.ItemID=itemid)
            precondition:
          lt.oclIsUndefined() = false
            postcondition:
          result = lt
            
        }