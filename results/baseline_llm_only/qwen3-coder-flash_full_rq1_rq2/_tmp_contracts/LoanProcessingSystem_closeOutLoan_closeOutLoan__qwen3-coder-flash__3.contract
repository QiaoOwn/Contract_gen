Contract LoanProcessingSystemSystem::closeOutLoan(loanid:Integer): Boolean {
          definition:
          ln:Loan = Loan.allInstance()->any(o:Loan|o.LoanID=loanid)
            precondition:
          ln.oclIsUndefined() = false and ln.Status <> LoanStatus::CLOSED
            postcondition:
          let l:Loan in l.oclIsNew() = false and l.Status = LoanStatus::CLOSED and l.IsPaidinFull = true and result = true
            
        }