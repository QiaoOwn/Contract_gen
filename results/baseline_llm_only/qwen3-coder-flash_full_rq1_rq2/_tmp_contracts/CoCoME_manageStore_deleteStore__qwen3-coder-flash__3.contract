Contract ManageStoreCRUDService::deleteStore(id:Integer): Boolean {
          definition:
          sto:Store = Store.allInstance()->any(s:Store|s.Id=id)
            precondition:
          sto.oclIsUndefined() = false
            postcondition:
          let s:Store in s.oclIsNew() = false and Store.allInstance()->excludes(s) and result=true
            
        }