Contract LibraryManagementSystemSystem::cancelReservation(uid:String,barcode:String): Boolean {
          definition:
          usr:User = User.allInstance()->any(u:User|u.UserID=uid), bc:BookCopy = BookCopy.allInstance()->any(b:BookCopy|b.Barcode=barcode), res:Reserve = Reserve.allInstance()->any(r:Reserve|r.ReservedCopy=bc and r.ReservedUser=usr)
            precondition:
          usr.oclIsUndefined() = false and bc.oclIsUndefined() = false and res.oclIsUndefined() = false and bc.IsReserved = true
            postcondition:
          let r:Reserve in r.oclIsNew() = false and Reserve.allInstance()->excludes(r) and bc.IsReserved = false and result = true
            
        }