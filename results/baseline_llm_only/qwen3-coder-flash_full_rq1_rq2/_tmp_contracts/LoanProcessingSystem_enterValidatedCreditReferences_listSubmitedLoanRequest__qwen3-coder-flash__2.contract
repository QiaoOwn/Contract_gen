Contract EnterValidatedCreditReferencesModule::listSubmitedLoanRequest(): Set(LoanRequest) {
          definition:
          submittedRequests:Set(LoanRequest) = LoanRequest.allInstance()->select(lr:LoanRequest|lr.Status = LoanRequestStatus::SUBMITTED)
            precondition:
          self.CurrentLoanRequest.oclIsUndefined() = true and self.CurrentLoanRequests.oclIsUndefined() = true
            postcondition:
          result = submittedRequests
            
        }