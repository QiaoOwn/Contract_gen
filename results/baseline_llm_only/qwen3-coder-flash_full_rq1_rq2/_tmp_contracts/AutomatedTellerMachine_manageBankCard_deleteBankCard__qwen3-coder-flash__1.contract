Contract ManageBankCardCRUDService::deleteBankCard(cardid:Integer): Boolean {
          definition:
          bc:BankCard = BankCard.allInstance()->any(o:BankCard|o.CardID=cardid)
            precondition:
          bc.oclIsUndefined() = false and bc.CardStatus <> BankCard::CANNEL
            postcondition:
          let deletedCard:BankCard in deletedCard.oclIsNew() = false and BankCard.allInstance()->excludes(deletedCard) and result = true
            
        }