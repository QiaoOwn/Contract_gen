Contract AutomatedTellerMachineSystem::inputCard(cardid:Integer): Boolean {
          definition:
          card:BankCard = BankCard.allInstance()->any(c:BankCard|c.CardID=cardid)
            precondition:
          card.oclIsUndefined() = false and card.CardStatus = NORMAL and self.PasswordValidated = false and self.CardIDValidated = false
            postcondition:
          let c:BankCard in c.oclIsNew() and self.InputCard = c and self.CardIDValidated = true and result = true
            
        }