Contract ManageCashierCRUDService::queryCashier(id:Integer): Cashier {
          definition:
          cashier:Cashier = Cashier.allInstance()->any(c:Cashier|c.Id=id)
            precondition:
          id <> null and cashier.oclIsUndefined() = false
            postcondition:
          result = cashier
            
        }