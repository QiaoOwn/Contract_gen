Contract ManageBankCardCRUDService::queryBankCard(cardid:Integer): BankCard {
          definition:
          bc:BankCard = BankCard.allInstance()->any(o:BankCard|o.CardID=cardid)
            precondition:
          cardid <> null and bc.oclIsUndefined() = false
            postcondition:
          result = bc
            
        }