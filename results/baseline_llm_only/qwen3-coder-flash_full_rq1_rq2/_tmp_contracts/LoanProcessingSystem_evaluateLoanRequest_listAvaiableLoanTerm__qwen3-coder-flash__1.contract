Contract EvaluateLoanRequestModule::listAvaiableLoanTerm(): Set(LoanTerm) {
          definition:
          loanTerms:Set(LoanTerm) = LoanTerm.allInstance()
            precondition:
          CurrentLoanRequest.oclIsUndefined() = false and CurrentLoanRequest.Status <> LoanRequestStatus::APPROVED and CurrentLoanRequest.Status <> LoanRequestStatus::READYFORREVIEW
            postcondition:
          result = loanTerms
            
        }