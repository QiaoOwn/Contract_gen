Contract AutomatedTellerMachineSystem::inputPassword(password:Integer): Boolean {
          definition:
          card:BankCard = BankCard.allInstance()->any(c:BankCard|c.CardID=self.InputCard.CardID), user:User = card.BelongedUser
            precondition:
          self.InputCard.oclIsUndefined() = false and card.oclIsUndefined() = false and card.CardStatus = BankCard::NORMAL and card.Catalog = BankCard::DESPOSIT and card.Password = password
            postcondition:
          let r:Boolean in r = (card.Password = password) and self.PasswordValidated = r and result = r
            
        }