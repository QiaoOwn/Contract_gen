Contract AutomatedTellerMachineSystem::inputPassword(password:Integer): Boolean {
          definition:
          card:BankCard = BankCard.allInstance()->any(c:BankCard|c.CardID=InputCard.CardID), user:User = card.BelongedUser
            precondition:
          InputCard.oclIsUndefined() = false and card.oclIsUndefined() = false and card.CardStatus=NORMAL and card.Password=password
            postcondition:
          let c:BankCard in c.oclIsNew() and c.CardID=InputCard.CardID and PasswordValidated=true and result=true
            
        }