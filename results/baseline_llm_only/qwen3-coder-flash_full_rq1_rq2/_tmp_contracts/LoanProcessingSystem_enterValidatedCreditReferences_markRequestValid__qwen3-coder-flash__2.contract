Contract EnterValidatedCreditReferencesModule::markRequestValid(): Boolean {
          definition:
          req:LoanRequest = CurrentLoanRequest
            precondition:
          req.oclIsUndefined() = false and req.Status = LoanRequestStatus::SUBMITTED
            postcondition:
          let r:LoanRequest in r.oclIsNew() = false and r.Status = LoanRequestStatus::REFERENCESVALIDATED and result = true
            
        }