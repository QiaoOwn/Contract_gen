Contract ManageCashierCRUDService::modifyCashier(id:Integer,name:String): Boolean {
          definition:
          cashier:Cashier = Cashier.allInstance()->any(c:Cashier|c.Id=id), store:Store = cashier.WorkedStore
            precondition:
          cashier.oclIsUndefined() = false and store.oclIsUndefined() = false and name <> ''
            postcondition:
          let c:Cashier in c.oclIsNew() = false and c.Id = id and c.Name = name and result = true
            
        }