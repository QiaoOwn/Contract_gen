Contract ManageCashierCRUDService::createCashier(id:Integer,name:String): Boolean {
          definition:
          cashier:Cashier = Cashier.allInstance()->any(c:Cashier|c.Id=id), store:Store = Store.allInstance()->any(s:Store|s.Cashiers->includes(cashier))
            precondition:
          cashier.oclIsUndefined() = true and id <> null and name <> null and name <> ''
            postcondition:
          let c:Cashier in c.oclIsNew() and c.Id=id and c.Name=name and Cashier.allInstance()->includes(c) and result=true
            
        }