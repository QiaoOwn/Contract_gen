Contract ManageSupplierCRUDService::deleteSupplier(id:Integer): Boolean {
          definition:
          sup:Supplier = Supplier.allInstance()->any(s:Supplier|s.Id=id)
            precondition:
          sup.oclIsUndefined() = false
            postcondition:
          let s:Supplier in s.oclIsNew() = false and Supplier.allInstance()->excludes(s) and result=true
            
        }