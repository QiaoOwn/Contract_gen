Contract ManageProductCatalogCRUDService::queryProductCatalog(id:Integer): ProductCatalog {
          definition:
          pc:ProductCatalog = ProductCatalog.allInstance()->any(o:ProductCatalog|o.Id=id)
            precondition:
          id <> null and pc.oclIsUndefined() = false
            postcondition:
          result = pc
            
        }