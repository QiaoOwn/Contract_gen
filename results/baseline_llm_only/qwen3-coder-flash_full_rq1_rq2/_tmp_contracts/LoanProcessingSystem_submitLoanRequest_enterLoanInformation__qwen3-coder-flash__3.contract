Contract SubmitLoanRequestModule::enterLoanInformation(requestid:Integer,name:String,loanamount:Real,loanpurpose:String,income:Real,phonenumber:Integer,postaladdress:String,zipcode:Integer,email:String,workreferences:String,creditreferences:String,checkingaccountnumber:Integer,securitynumber:Integer): Boolean {
          definition:
          req:LoanRequest = LoanRequest.allInstance()->any(r:LoanRequest|r.RequestID=requestid)
            precondition:
          req.oclIsUndefined() = true and requestid <> null and name <> null and loanamount > 0 and loanpurpose <> null and income > 0 and phonenumber <> null and postaladdress <> null and zipcode <> null and email <> null and workreferences <> null and creditreferences <> null and checkingaccountnumber <> null and securitynumber <> null
            postcondition:
          let r:LoanRequest in r.oclIsNew() and r.RequestID=requestid and r.Name=name and r.LoanAmount=loanamount and r.LoanPurpose=loanpurpose and r.Income=income and r.PhoneNumber=phonenumber and r.PostalAddress=postaladdress and r.ZipCode=zipcode and r.Email=email and r.WorkReferences=workreferences and r.CreditReferences=creditreferences and r.CheckingAccountNumber=checkingaccountnumber and r.SecurityNumber=securitynumber and r.Status=LoanRequestStatus::SUBMITTED and LoanRequest.allInstance()->includes(r) and result=true
            
        }