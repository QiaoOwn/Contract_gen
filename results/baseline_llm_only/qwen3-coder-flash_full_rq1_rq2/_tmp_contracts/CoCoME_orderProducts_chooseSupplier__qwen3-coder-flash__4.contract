Contract CoCoMEOrderProducts::chooseSupplier(supplierID:Integer): Boolean {
          definition:
          sup:Supplier = Supplier.allInstance()->any(s:Supplier|s.Id=supplierID), ord:OrderProduct = self.CurrentOrderProduct
            precondition:
          sup.oclIsUndefined() = false and ord.oclIsUndefined() = false and ord.OrderStatus = OrderStatus::NEW
            postcondition:
          ord.Supplier = sup and ord.OrderStatus = OrderStatus::REQUESTED and result = true
            
        }