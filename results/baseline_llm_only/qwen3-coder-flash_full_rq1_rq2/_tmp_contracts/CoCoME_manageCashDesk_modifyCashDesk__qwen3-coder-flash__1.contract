Contract ManageCashDeskCRUDService::modifyCashDesk(id:Integer,name:String,isopened:Boolean): Boolean {
          definition:
          cd:CashDesk = CashDesk.allInstance()->any(c:CashDesk|c.Id=id)
            precondition:
          cd.oclIsUndefined() = false and id > 0 and name <> null and isopened <> null
            postcondition:
          let cd:CashDesk in cd.oclIsNew() = false and cd.Id = id and cd.Name = name and cd.IsOpened = isopened and result = true
            
        }