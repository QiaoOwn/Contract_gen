Contract GenerateLoanLetterAndAgreementModule::listApprovalRequest(): Set(LoanRequest) {
          definition:
          lr:Set(LoanRequest) = LoanRequest.allInstance()->select(o:LoanRequest|o.Status = LoanRequestStatus::SUBMITTED or o.Status = LoanRequestStatus::REFERENCESVALIDATED)
            precondition:
          CurrentLoanRequests.oclIsUndefined() = false and CurrentLoanRequests->size() > 0
            postcondition:
          result = lr
            
        }