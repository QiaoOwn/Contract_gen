Contract AutomatedTellerMachineSystem::printReceipt(): Real {
          definition:
          card:BankCard = BankCard.allInstance()->any(c:BankCard|c.CardID=InputCard.CardID), user:User = card.BelongedUser
            precondition:
          InputCard.oclIsUndefined() = false and CardIDValidated = true and PasswordValidated = true and card.oclIsUndefined() = false and card.CardStatus=NORMAL and IsWithdraw = true and WithdrawedNumber > 0 and card.Balance >= WithdrawedNumber
            postcondition:
          let receiptAmount:Real in receiptAmount = WithdrawedNumber and result = receiptAmount
            
        }