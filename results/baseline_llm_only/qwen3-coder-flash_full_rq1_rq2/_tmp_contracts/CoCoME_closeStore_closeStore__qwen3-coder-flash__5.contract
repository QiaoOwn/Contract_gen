Contract CoCoMESystem::closeStore(storeID:Integer): Boolean {
          definition:
          store:Store = Store.allInstance()->any(s:Store|s.Id=storeID)
            precondition:
          store.oclIsUndefined() = false and store.IsOpened = true
            postcondition:
          let s:Store in s.oclIsNew() = false and s.IsOpened = false and Store.allInstance()->includes(s) and result = true
            
        }