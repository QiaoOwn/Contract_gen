Contract GenerateLoanLetterAndAgreementModule::listApprovalRequest(): Set(LoanRequest) {
          definition:
          reqs:Set(LoanRequest) = LoanRequest.allInstance()->select(r:LoanRequest|r.Status = LoanRequestStatus::SUBMITTED or r.Status = LoanRequestStatus::REFERENCESVALIDATED)
            precondition:
          CurrentLoanRequests.oclIsUndefined() = false and CurrentLoanRequests.isEmpty() = false
            postcondition:
          result = reqs
            
        }