Contract AirportSystem::createStaff(id:Integer,name:String,pswd:String,phone:String,role:Integer,bossid:Integer): Boolean {
          definition:
          existingStaff:Set(Staff) = Staff.allInstance()->select(s:Staff|s.Id=id), boss:Staff = Staff.allInstance()->any(b:Staff|b.Id=bossid)
            precondition:
          existingStaff.isEmpty() = true and (bossid = -1 or boss.oclIsUndefined() = false)
            postcondition:
          let newStaff:Staff in newStaff.oclIsNew() and newStaff.Id=id and newStaff.Name=name and newStaff.Password=pswd and newStaff.Phone=phone and newStaff.Role=role and (bossid = -1 or newStaff.Boss=boss) and Staff.allInstance()->includes(newStaff) and result=true
            
        }