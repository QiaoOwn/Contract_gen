Contract ProcessSaleService::endSale(): Real {
          definition:
          currentSale:Sale = Sale.allInstance()->any(s:Sale|s.IsComplete=false), currentLine:Set(SalesLineItem) = currentSale.ContainedSalesLine
            precondition:
          currentSale.oclIsUndefined() = false and currentSale.IsReadytoPay = true and currentLine.isEmpty() = false
            postcondition:
          let s:Sale in s.oclIsNew() and s.IsComplete = true and s.Amount = currentLine->collect(l:SalesLineItem|l.Subamount)->sum() and Sale.allInstance()->includes(s) and result = s.Amount
            
        }