Contract AutomatedTellerMachineSystem::printReceipt(): Real {
          definition:
          card:BankCard = BankCard.allInstance()->any(c:BankCard|c.CardID=InputCard.CardID), user:User = card.BelongedUser
            precondition:
          InputCard.oclIsUndefined() = false and card.oclIsUndefined() = false and card.CardStatus=NORMAL and card.Catalog=DESPOSIT and PasswordValidated=true and CardIDValidated=true and IsDeposit=true
            postcondition:
          let receiptAmount:Real in receiptAmount = DepositedNumber and result = receiptAmount
            
        }