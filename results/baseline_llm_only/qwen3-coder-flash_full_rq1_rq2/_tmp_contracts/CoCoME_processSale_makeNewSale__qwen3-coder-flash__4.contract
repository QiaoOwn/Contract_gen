Contract ProcessSaleService::makeNewSale(): Boolean {
          definition:
          currentSale:Sale = Sale.allInstance()->any(s:Sale|s.oclIsNew() = true), currentSaleLine:SalesLineItem = SalesLineItem.allInstance()->any(s:SalesLineItem|s.oclIsNew() = true)
            precondition:
          CurrentSale.oclIsUndefined() = true and CurrentSaleLine.oclIsUndefined() = true
            postcondition:
          let s:Sale in s.oclIsNew() and s.IsComplete = false and s.IsReadytoPay = false and s.Amount = 0.0 and Sale.allInstance()->includes(s) and result = true
            
        }