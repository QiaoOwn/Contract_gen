Contract LibraryManagementSystemSystem::countDownSuspensionDay(): void {
          definition:
          users:Set(User) = User.allInstance()->select(u:User|u.BorrowStatus=SUSPEND and u.SuspensionDays > 0)
            precondition:
          users.isEmpty() = false
            postcondition:
          let u:User in u.oclIsNew() and u.BorrowStatus=SUSPEND and u.SuspensionDays = u.SuspensionDays@pre - 1
            
        }