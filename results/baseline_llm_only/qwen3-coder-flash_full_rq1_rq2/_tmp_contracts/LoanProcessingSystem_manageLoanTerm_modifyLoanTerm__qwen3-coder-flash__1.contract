Contract ManageLoanTermCRUDService::modifyLoanTerm(itemid:Integer,content:String): Boolean {
          definition:
          lt:LoanTerm = LoanTerm.allInstance()->any(o:LoanTerm|o.ItemID=itemid)
            precondition:
          lt.oclIsUndefined() = false and content <> ''
            postcondition:
          lt.Content = content and result = true
            
        }