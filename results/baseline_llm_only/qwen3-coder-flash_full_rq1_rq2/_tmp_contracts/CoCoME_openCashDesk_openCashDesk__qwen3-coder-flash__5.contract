Contract CoCoMESystem::openCashDesk(cashDeskID:Integer): Boolean {
          definition:
          cd:CashDesk = CashDesk.allInstance()->any(c:CashDesk|c.Id=cashDeskID), s:Store = cd.BelongedStore
            precondition:
          cd.oclIsUndefined() = false and s.oclIsUndefined() = false and cd.IsOpened = false and s.IsOpened = true
            postcondition:
          let c:CashDesk in c.oclIsNew() and c.IsOpened = true and result = true
            
        }