Contract EvaluateLoanRequestModule::listAvaiableLoanTerm(): Set(LoanTerm) {
          definition:
          loanTerms:Set(LoanTerm) = LoanTerm.allInstance()
            precondition:
          CurrentLoanRequest.oclIsUndefined() = false and CurrentLoanRequest.Status <> 'APPROVED' and CurrentLoanRequest.Status <> 'READYFORREVIEW'
            postcondition:
          result = loanTerms
            
        }