Contract AutomatedTellerMachineSystem::printReceipt(): Real {
          definition:
          card:BankCard = BankCard.allInstance()->any(c:BankCard|c.CardID=InputCard.CardID), usr:User = card.BelongedUser
            precondition:
          InputCard.oclIsUndefined() = false and CardIDValidated = true and PasswordValidated = true and card.oclIsUndefined() = false and card.CardStatus=NORMAL and usr.oclIsUndefined() = false
            postcondition:
          result = WithdrawedNumber
            
        }