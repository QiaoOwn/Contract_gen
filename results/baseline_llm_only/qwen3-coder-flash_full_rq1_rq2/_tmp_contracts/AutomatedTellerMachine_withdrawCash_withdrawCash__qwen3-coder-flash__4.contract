Contract AutomatedTellerMachineSystem::withdrawCash(quantity:Integer): Boolean {
          definition:
          card:BankCard = BankCard.allInstance()->any(c:BankCard|c.CardID=InputCard.CardID), user:User = card.BelongedUser
            precondition:
          InputCard.oclIsUndefined() = false and CardIDValidated = true and PasswordValidated = true and card.CardStatus = BankCard::NORMAL and card.Catalog = BankCard::DESPOSIT and card.Balance >= quantity and quantity > 0
            postcondition:
          let updatedCard:BankCard in updatedCard.oclIsNew() and updatedCard.Balance = card.Balance - quantity and result = true
            
        }