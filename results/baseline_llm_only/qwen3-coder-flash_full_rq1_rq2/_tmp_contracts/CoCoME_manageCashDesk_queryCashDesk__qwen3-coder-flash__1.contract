Contract ManageCashDeskCRUDService::queryCashDesk(id:Integer): CashDesk {
          definition:
          cd:CashDesk = CashDesk.allInstance()->any(c:CashDesk|c.Id=id)
            precondition:
          id <> null and cd.oclIsUndefined() = false
            postcondition:
          result = cd
            
        }