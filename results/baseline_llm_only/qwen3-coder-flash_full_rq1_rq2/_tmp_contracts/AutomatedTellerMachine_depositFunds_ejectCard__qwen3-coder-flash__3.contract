Contract AutomatedTellerMachineSystem::ejectCard(): Boolean {
          definition:
          card:BankCard = BankCard.allInstance()->any(c:BankCard|c.CardID=self.InputCard.CardID)
            precondition:
          self.InputCard.oclIsUndefined() = false and card.oclIsUndefined() = false and card.CardStatus = BankCard::NORMAL and card.Catalog = BankCard::DESPOSIT
            postcondition:
          let c:BankCard in c.oclIsNew() and c.CardStatus = BankCard::CANNEL and result = true
            
        }