Contract ManageSupplierCRUDService::modifySupplier(id:Integer,name:String): Boolean {
          definition:
          sup:Supplier = Supplier.allInstance()->any(s:Supplier|s.Id=id)
            precondition:
          id <> null and name <> null and sup.oclIsUndefined() = false
            postcondition:
          let s:Supplier in s.oclIsNew() = false and s.Name=name and Supplier.allInstance()->includes(s) and result=true
            
        }