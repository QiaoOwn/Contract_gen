Contract ListBookHistory::listReservationBook(uid:String): Set(BookCopy) {
          definition:
          usr:User = User.allInstance()->any(u:User|u.UserID=uid), res:Set(Reserve) = usr.ReservedBook
            precondition:
          usr.oclIsUndefined() = false and res.isEmpty() = false
            postcondition:
          result = res->collect(r:Reserve|r.ReservedCopy)
            
        }