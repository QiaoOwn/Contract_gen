Contract AutomatedTellerMachineSystem::inputCard(cardid:Integer): Boolean {
          definition:
          card:BankCard = BankCard.allInstance()->any(c:BankCard|c.CardID=cardid)
            precondition:
          card.oclIsUndefined() = false and card.CardStatus=NORMAL and self.CardIDValidated = true
            postcondition:
          let c:BankCard in c.oclIsNew() and c.CardID=cardid and self.InputCard=c and result=true
            
        }