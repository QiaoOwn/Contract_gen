Contract EvaluateLoanRequestModule::listTenLoanRequest(): Set(LoanRequest) {
          definition:
          loanRequests:Set(LoanRequest) = LoanRequest.allInstance()
            precondition:
          loanRequests->size() >= 0
            postcondition:
          result = loanRequests->select(lr:LoanRequest|lr.Status = LoanRequestStatus::SUBMITTED or lr.Status = LoanRequestStatus::REFERENCESVALIDATED or lr.Status = LoanRequestStatus::READYFORREVIEW)
            
        }