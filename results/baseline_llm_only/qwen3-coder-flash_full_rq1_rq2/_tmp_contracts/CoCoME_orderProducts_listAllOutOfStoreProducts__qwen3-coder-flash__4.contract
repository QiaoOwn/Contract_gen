Contract CoCoMEOrderProducts::listAllOutOfStoreProducts(): Set(Item) {
          definition:
          currentOrderProduct:OrderProduct = self.CurrentOrderProduct
            precondition:
          currentOrderProduct.oclIsUndefined() = false and currentOrderProduct.OrderStatus = OrderStatus::REQUESTED
            postcondition:
          let outOfStockItems:Set(Item) in outOfStockItems = Item.allInstance()->select(i:Item|i.StockNumber <= 0) and result = outOfStockItems
            
        }