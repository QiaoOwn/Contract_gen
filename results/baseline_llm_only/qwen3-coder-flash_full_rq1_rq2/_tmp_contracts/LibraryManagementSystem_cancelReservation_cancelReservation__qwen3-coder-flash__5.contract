Contract LibraryManagementSystemSystem::cancelReservation(uid:String,barcode:String): Boolean {
          definition:
          usr:User = User.allInstance()->any(u:User|u.UserID=uid), bkp:BookCopy = BookCopy.allInstance()->any(b:BookCopy|b.Barcode=barcode), res:Reserve = Reserve.allInstance()->any(r:Reserve|r.ReservedCopy=bkp and r.ReservedUser=usr)
            precondition:
          usr.oclIsUndefined() = false and bkp.oclIsUndefined() = false and bkp.IsReserved = true and res.oclIsUndefined() = false
            postcondition:
          let r:Reserve in r.oclIsNew() = false and Reserve.allInstance()->excludes(r) and bkp.IsReserved = false and result = true
            
        }