Contract GenerateLoanLetterAndAgreementModule::genereateApprovalLetter(id:Integer): Boolean {
          definition:
          lr:LoanRequest = LoanRequest.allInstance()->any(o:LoanRequest|o.RequestID=id), apprLetter:ApprovalLetter = ApprovalLetter.allInstance()->any(o:ApprovalLetter|o.Content='Approved'), loanAgreement:LoanAgreement = LoanAgreement.allInstance()->any(o:LoanAgreement|o.Content='Agreement')
            precondition:
          lr.oclIsUndefined() = false and lr.Status = LoanRequestStatus::SUBMITTED or lr.Status = LoanRequestStatus::REFERENCESVALIDATED or lr.Status = LoanRequestStatus::READYFORREVIEW and CurrentLoanRequests->includes(lr)
            postcondition:
          let la:LoanAgreement in la.oclIsNew() and la.Content = 'Agreement' and let al:ApprovalLetter in al.oclIsNew() and al.Content = 'Approved' and lr.AttachedApprovalLetter = al and lr.AttachedLoanAgreement = la and result = true
            
        }