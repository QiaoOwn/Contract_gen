Contract SubmitLoanRequestModule::calculateScore(): Integer {
          definition:
          lr:LoanRequest = self.CurrentLoanRequest
            precondition:
          lr.oclIsUndefined() = false and lr.Status <> 'APPROVED' and lr.Status <> 'READYFORREVIEW'
            postcondition:
          let score:Integer in score = lr.CreditScore and result = score
            
        }