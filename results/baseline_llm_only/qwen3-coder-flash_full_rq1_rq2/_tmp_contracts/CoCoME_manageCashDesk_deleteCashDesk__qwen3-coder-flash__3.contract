Contract ManageCashDeskCRUDService::deleteCashDesk(id:Integer): Boolean {
          definition:
          cd:CashDesk = CashDesk.allInstance()->any(c:CashDesk|c.Id=id)
            precondition:
          cd.oclIsUndefined() = false
            postcondition:
          CashDesk.allInstance()->excludes(cd) and result = true
            
        }