Contract AutomatedTellerMachineSystem::checkBalance(): Real {
          definition:
          card:BankCard = BankCard.allInstance()->any(c:BankCard|c.CardID=InputCard.CardID), user:User = card.BelongedUser
            precondition:
          InputCard.oclIsUndefined() = false and CardIDValidated = true and PasswordValidated = true and card.oclIsUndefined() = false and card.CardStatus=NORMAL and user.oclIsUndefined() = false
            postcondition:
          result = card.Balance
            
        }