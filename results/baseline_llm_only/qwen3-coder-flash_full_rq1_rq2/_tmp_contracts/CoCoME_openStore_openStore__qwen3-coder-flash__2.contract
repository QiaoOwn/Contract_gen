Contract CoCoMESystem::openStore(storeID:Integer): Boolean {
          definition:
          st:Store = Store.allInstance()->any(s:Store|s.Id=storeID)
            precondition:
          st.oclIsUndefined() = false and st.IsOpened = false
            postcondition:
          let s:Store in s.oclIsNew() or (s <> null and s.IsOpened = true) and Store.allInstance()->includes(s) and result = true
            
        }