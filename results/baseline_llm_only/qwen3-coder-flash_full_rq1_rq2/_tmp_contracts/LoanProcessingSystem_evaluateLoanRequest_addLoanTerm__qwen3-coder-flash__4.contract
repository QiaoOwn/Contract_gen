Contract EvaluateLoanRequestModule::addLoanTerm(termid:Integer): Boolean {
          definition:
          loanReq:LoanRequest = self.CurrentLoanRequest, term:LoanTerm = LoanTerm.allInstance()->any(l:LoanTerm|l.ItemID=termid)
            precondition:
          loanReq.oclIsUndefined() = false and term.oclIsUndefined() = true and loanReq.Status <> LoanRequestStatus.APPROVED and loanReq.Status <> LoanRequestStatus.READYFORREVIEW
            postcondition:
          let t:LoanTerm in t.oclIsNew() and t.ItemID=termid and loanReq.AttachedLoanTerms->includes(t) and result=true
            
        }