Contract AutomatedTellerMachineSystem::checkBalance(): Real {
          definition:
          card:BankCard = BankCard.allInstance()->any(c:BankCard|c.CardID=self.InputCard.CardID), user:User = card.BelongedUser
            precondition:
          self.InputCard.oclIsUndefined() = false and card.oclIsUndefined() = false and card.CardStatus = BankCard::NORMAL and self.CardIDValidated = true and self.PasswordValidated = true
            postcondition:
          result = card.Balance
            
        }