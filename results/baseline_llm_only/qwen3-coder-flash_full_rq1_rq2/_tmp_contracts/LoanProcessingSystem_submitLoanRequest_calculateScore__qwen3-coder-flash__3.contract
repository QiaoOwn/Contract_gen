Contract SubmitLoanRequestModule::calculateScore(): Integer {
          definition:
          loanReq:LoanRequest = SubmitLoanRequestModule.CurrentLoanRequest
            precondition:
          loanReq.oclIsUndefined() = false and loanReq.Status = LoanRequestStatus::SUBMITTED
            postcondition:
          let score:Integer in score = loanReq.CreditScore and result = score
            
        }