Contract AutomatedTellerMachineSystem::inputPassword(password:Integer): Boolean {
          definition:
          card:BankCard = BankCard.allInstance()->any(c:BankCard|c.CardID=self.InputCard.CardID), user:User = card.BelongedUser
            precondition:
          self.InputCard.oclIsUndefined() = false and card.oclIsUndefined() = false and card.CardStatus = BankCard::NORMAL and card.Password = password
            postcondition:
          let c:BankCard in c.oclIsNew() and self.PasswordValidated = true and result = true
            
        }