Contract AutomatedTellerMachineSystem::ejectCard(): Boolean {
          definition:
          card:BankCard = BankCard.allInstance()->any(c:BankCard|c.CardID=InputCard.CardID)
            precondition:
          InputCard.oclIsUndefined() = false and card.oclIsUndefined() = false and card.CardStatus = BankCard::NORMAL and PasswordValidated = true
            postcondition:
          let c:BankCard in c.oclIsNew() and c.CardStatus = BankCard::CANNEL and result=true
            
        }