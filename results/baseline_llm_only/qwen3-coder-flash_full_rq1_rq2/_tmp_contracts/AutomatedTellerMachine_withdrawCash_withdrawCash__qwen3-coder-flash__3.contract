Contract AutomatedTellerMachineSystem::withdrawCash(quantity:Integer): Boolean {
          definition:
          card:BankCard = BankCard.allInstance()->any(c:BankCard|c.CardID=InputCard.CardID), user:User = card.BelongedUser
            precondition:
          InputCard.oclIsUndefined() = false and CardIDValidated = true and PasswordValidated = true and card.oclIsUndefined() = false and card.CardStatus=NORMAL and card.Balance >= quantity and IsWithdraw = true
            postcondition:
          let updatedCard:BankCard in updatedCard.oclIsNew() = false and updatedCard.Balance = card.Balance - quantity and result = true
            
        }