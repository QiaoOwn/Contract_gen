Contract EvaluateLoanRequestModule::listTenLoanRequest(): Set(LoanRequest) {
          definition:
          loanRequests:Set(LoanRequest) = LoanRequest.allInstance()->select(lr:LoanRequest|lr.Status = LoanRequestStatus::SUBMITTED or lr.Status = LoanRequestStatus::REFERENCESVALIDATED)
            precondition:
          loanRequests.isEmpty() = false
            postcondition:
          result = loanRequests
            
        }