Contract AutomatedTellerMachineSystem::ejectCard(): Boolean {
          definition:
          inputCard:BankCard = self.InputCard
            precondition:
          inputCard.oclIsUndefined() = false and BankCard.allInstance()->includes(inputCard) and inputCard.CardStatus = BankCard::NORMAL
            postcondition:
          result = true and self.InputCard.oclIsUndefined() = true
            
        }