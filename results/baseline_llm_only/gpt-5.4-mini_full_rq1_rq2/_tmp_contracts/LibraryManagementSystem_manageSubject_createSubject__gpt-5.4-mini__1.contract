Contract ManageSubjectCRUDService::createSubject(name:String): Boolean {
          definition:
          subject:Subject = Subject.allInstance()->any(s:Subject|s.Name=name)
            precondition:
          subject.oclIsUndefined() = true and name.oclIsUndefined() = false and name <> ""
            postcondition:
          let s:Subject in s.oclIsNew() and s.Name=name and Subject.allInstance()->includes(s) and result=true
            
        }