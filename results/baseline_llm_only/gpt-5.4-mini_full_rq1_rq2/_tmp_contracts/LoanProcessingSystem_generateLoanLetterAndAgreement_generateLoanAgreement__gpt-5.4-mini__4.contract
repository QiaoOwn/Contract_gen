Contract GenerateLoanLetterAndAgreementModule::generateLoanAgreement(): Boolean {
          definition:
          currentLoanRequest:LoanRequest = CurrentLoanRequest
            precondition:
          currentLoanRequest.oclIsUndefined() = false and currentLoanRequest.Status = LoanRequestStatus::APPROVED and currentLoanRequest.AttachedApprovalLetter.oclIsUndefined() = false and currentLoanRequest.AttachedLoanAgreement.oclIsUndefined() = false
            postcondition:
          CurrentApprovalLetter.oclIsUndefined() = false and CurrentLoanAgreement.oclIsUndefined() = false and CurrentLoanRequest = currentLoanRequest and result = true
            
        }