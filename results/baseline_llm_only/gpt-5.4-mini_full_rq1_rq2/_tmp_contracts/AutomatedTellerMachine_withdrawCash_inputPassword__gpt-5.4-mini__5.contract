Contract AutomatedTellerMachineSystem::inputPassword(password:Integer): Boolean {
          definition:
          card:BankCard = self.InputCard
            precondition:
          card.oclIsUndefined() = false and card.Password = password and card.CardStatus = BankCard::NORMAL
            postcondition:
          self.PasswordValidated = true and result = true
            
        }