Contract RepairService::feedback(id:Integer,sid:Integer,score:Integer,des:String): Boolean {
          definition:
          rep:Repair = Repair.allInstance()->any(r:Repair|r.Id=id), sta:Staff = Staff.allInstance()->any(s:Staff|s.Id=sid), isGroundStaff: Boolean = sta.Role = 1, isFinished: Boolean = rep.Process = 2, isHighScore: Boolean = score >= 4
            precondition:
          rep.oclIsUndefined() = false and sta.oclIsUndefined() = false and rep.RaiseStaff = sta and isGroundStaff = true and isFinished = true
            postcondition:
          rep.Score = score and (isHighScore = true implies rep.Close = true) and (isHighScore = false implies rep.Close = false and rep.Description = des and rep.Process = 0) and result = true
            
        }