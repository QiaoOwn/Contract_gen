Contract ManageStoreCRUDService::modifyStore(id:Integer,name:String,address:String,isopened:Boolean): Boolean {
          definition:
          store:Store = Store.allInstance()->any(s:Store|s.Id=id)
            precondition:
          store.oclIsUndefined() = false and name <> null and address <> null and isopened <> null
            postcondition:
          store.Id = id and store.Name = name and store.Address = address and store.IsOpened = isopened and result = true
            
        }