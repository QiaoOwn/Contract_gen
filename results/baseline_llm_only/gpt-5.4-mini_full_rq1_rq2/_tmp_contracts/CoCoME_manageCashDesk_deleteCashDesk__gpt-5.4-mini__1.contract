Contract ManageCashDeskCRUDService::deleteCashDesk(id:Integer): Boolean {
          definition:
          cashDesk:CashDesk = CashDesk.allInstance()->any(c:CashDesk|c.Id=id), relatedSale:Sale = Sale.allInstance()->any(s:Sale|s.BelongedCashDesk = cashDesk)
            precondition:
          cashDesk.oclIsUndefined() = false and relatedSale.oclIsUndefined() = true
            postcondition:
          let c:CashDesk in c.oclIsNew() = false and CashDesk.allInstance()->excludes(c) and result = true
            
        }