Contract AutomatedTellerMachineSystem::printReceipt(): Real {
          definition:
          card:BankCard = self.InputCard
            precondition:
          card.oclIsUndefined() = false and BankCard.allInstance()->includes(card) and card.CardStatus = BankCard::NORMAL and self.PasswordValidated = true and self.IsWithdraw = true
            postcondition:
          result = 0
            
        }