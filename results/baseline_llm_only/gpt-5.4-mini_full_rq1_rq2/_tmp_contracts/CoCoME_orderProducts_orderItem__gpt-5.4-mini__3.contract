Contract CoCoMEOrderProducts::orderItem(barcode:Integer,quantity:Integer): Boolean {
          definition:
          currentOrderProduct:OrderProduct = self.CurrentOrderProduct, item:Item = Item.allInstance()->any(i:Item|i.Barcode=barcode)
            precondition:
          currentOrderProduct.oclIsUndefined() = false and item.oclIsUndefined() = false and quantity > 0
            postcondition:
          currentOrderProduct.ContainedEntries = currentOrderProduct.ContainedEntries and result = true
            
        }