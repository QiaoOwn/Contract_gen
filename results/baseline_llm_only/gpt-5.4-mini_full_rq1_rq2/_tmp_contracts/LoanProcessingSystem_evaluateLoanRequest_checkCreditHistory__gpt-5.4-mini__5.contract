Contract EvaluateLoanRequestModule::checkCreditHistory(): CreditHistory {
          definition:
          curReq:LoanRequest = self.CurrentLoanRequest
            precondition:
          curReq.oclIsUndefined() = false and curReq.RequestedCreditHistory.oclIsUndefined() = false
            postcondition:
          result = curReq.RequestedCreditHistory
            
        }