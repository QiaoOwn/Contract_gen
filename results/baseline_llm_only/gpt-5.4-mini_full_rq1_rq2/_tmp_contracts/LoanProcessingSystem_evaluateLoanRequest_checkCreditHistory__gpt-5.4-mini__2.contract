Contract EvaluateLoanRequestModule::checkCreditHistory(): CreditHistory {
          definition:
          currentLoanRequest:LoanRequest = self.CurrentLoanRequest
            precondition:
          currentLoanRequest.oclIsUndefined() = false and currentLoanRequest.RequestedCreditHistory.oclIsUndefined() = false
            postcondition:
          result = currentLoanRequest.RequestedCreditHistory
            
        }