Contract ProcessSaleService::endSale(): Real {
          definition:
          currSale:Sale = self.CurrentSale
            precondition:
          currSale.oclIsUndefined() = false and currSale.IsComplete = false and currSale.IsReadytoPay = true
            postcondition:
          currSale.IsComplete = true and currSale.IsReadytoPay = false and result = currSale.Amount
            
        }