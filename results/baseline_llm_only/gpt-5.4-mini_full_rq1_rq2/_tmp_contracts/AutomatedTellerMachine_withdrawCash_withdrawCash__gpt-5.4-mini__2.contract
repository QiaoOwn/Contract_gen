Contract AutomatedTellerMachineSystem::withdrawCash(quantity:Integer): Boolean {
          definition:
          card:BankCard = InputCard
            precondition:
          card.oclIsUndefined() = false and self.PasswordValidated = true and self.CardIDValidated = true and self.IsWithdraw = true and card.CardStatus = BankCard::NORMAL and card.Catalog = BankCard::CREDIT and card.Balance >= quantity
            postcondition:
          card.Balance = card.Balance@pre - quantity and self.WithdrawedNumber = quantity and result = true
            
        }