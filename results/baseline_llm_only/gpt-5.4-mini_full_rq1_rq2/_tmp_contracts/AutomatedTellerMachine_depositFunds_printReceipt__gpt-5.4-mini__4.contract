Contract AutomatedTellerMachineSystem::printReceipt(): Real {
          definition:
          inputCard:BankCard = self.InputCard
            precondition:
          inputCard.oclIsUndefined() = false and self.CardIDValidated = true and self.PasswordValidated = true and self.IsDeposit = true and inputCard.CardStatus = BankCard::NORMAL and inputCard.Catalog = BankCard::DESPOSIT
            postcondition:
          result = inputCard.Balance
            
        }