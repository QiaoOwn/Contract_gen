Contract ManageCashDeskCRUDService::queryCashDesk(id:Integer): CashDesk {
          definition:
          cashDesk:CashDesk = CashDesk.allInstance()->any(c:CashDesk|c.Id=id)
            precondition:
          cashDesk.oclIsUndefined() = false
            postcondition:
          result = cashDesk
            
        }