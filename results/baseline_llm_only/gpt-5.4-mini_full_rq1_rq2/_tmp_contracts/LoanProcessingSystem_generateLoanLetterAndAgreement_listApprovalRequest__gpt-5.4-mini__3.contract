Contract GenerateLoanLetterAndAgreementModule::listApprovalRequest(): Set(LoanRequest) {
          definition:
          approvedRequests: Set(LoanRequest) = LoanRequest.allInstance()->select(r:LoanRequest|r.Status = LoanRequestStatus::APPROVED)
            precondition:
          approvedRequests.isEmpty() = false
            postcondition:
          result = approvedRequests
            
        }