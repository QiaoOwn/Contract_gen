Contract ProcessSaleService::endSale(): Real {
          definition:
          currentSale:Sale = self.CurrentSale
            precondition:
          currentSale.oclIsUndefined() = false and currentSale.IsComplete = false and currentSale.IsReadytoPay = true
            postcondition:
          currentSale.IsComplete = true and currentSale.IsReadytoPay = false and result = currentSale.Amount
            
        }