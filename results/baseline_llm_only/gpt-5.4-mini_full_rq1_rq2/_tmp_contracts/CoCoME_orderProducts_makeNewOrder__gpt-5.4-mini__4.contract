Contract CoCoMEOrderProducts::makeNewOrder(orderid:Integer): Boolean {
          definition:
          currentOrderProduct:OrderProduct = CurrentOrderProduct, supplier:Supplier = Supplier.allInstance()->any(s:Supplier|s.oclIsUndefined() = false)
            precondition:
          currentOrderProduct.oclIsUndefined() = true and supplier.oclIsUndefined() = false and OrderProduct.allInstance()->excludes(OrderProduct.allInstance()->any(o:OrderProduct|o.Id=orderid))
            postcondition:
          let op:OrderProduct in op.oclIsNew() and op.Id=orderid and op.Time=oclUndefined and op.OrderStatus=OrderProduct::NEW and op.Amount=0 and op.Supplier=supplier and op.ContainedEntries->isEmpty() and OrderProduct.allInstance()->includes(op) and result=true
            
        }