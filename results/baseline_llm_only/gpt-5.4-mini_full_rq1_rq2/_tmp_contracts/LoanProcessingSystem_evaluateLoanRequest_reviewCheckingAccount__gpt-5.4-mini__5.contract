Contract EvaluateLoanRequestModule::reviewCheckingAccount(): CheckingAccount {
          definition:
          currReq:LoanRequest = self.CurrentLoanRequest
            precondition:
          currReq.oclIsUndefined() = false and currReq.RequestedCAHistory.oclIsUndefined() = false and currReq.Status = LoanRequestStatus::REFERENCESVALIDATED
            postcondition:
          result = currReq.RequestedCAHistory
            
        }