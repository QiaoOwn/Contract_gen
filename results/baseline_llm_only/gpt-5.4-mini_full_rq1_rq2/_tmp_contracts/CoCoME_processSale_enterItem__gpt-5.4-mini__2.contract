Contract ProcessSaleService::enterItem(barcode:Integer,quantity:Integer): Boolean {
          definition:
          curSale:Sale = self.CurrentSale, curLine:SalesLineItem = self.CurrentSaleLine, item:Item = Item.allInstance()->any(i:Item|i.Barcode=barcode), saleItems:Set(SalesLineItem) = curSale.ContainedSalesLine
            precondition:
          curSale.oclIsUndefined() = false and curLine.oclIsUndefined() = false and item.oclIsUndefined() = false and curSale.IsComplete = false and curSale.IsReadytoPay = false and quantity > 0 and curSale.ContainedSalesLine->excludes(curLine) and item.StockNumber >= quantity
            postcondition:
          let newLine:SalesLineItem in newLine.oclIsNew() and newLine.Quantity=quantity and newLine.BelongedSale=curSale and newLine.BelongedItem=item and curSale.ContainedSalesLine->includes(newLine) and item.StockNumber=item.StockNumber@pre - quantity and result=true
            
        }