Contract CoCoMESystem::receiveOrderedProduct(orderID:Integer): Boolean {
          definition:
          ord:OrderProduct = OrderProduct.allInstance()->any(o:OrderProduct|o.Id=orderID)
            precondition:
          ord.oclIsUndefined() = false and ord.OrderStatus = OrderProduct::REQUESTED
            postcondition:
          ord.OrderStatus = OrderProduct::RECEIVED and result = true
            
        }