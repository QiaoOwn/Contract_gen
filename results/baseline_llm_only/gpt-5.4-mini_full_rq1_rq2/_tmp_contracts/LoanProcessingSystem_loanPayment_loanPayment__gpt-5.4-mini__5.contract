Contract LoanProcessingSystemSystem::loanPayment(loanid:Integer): Boolean {
          definition:
          loan:Loan = Loan.allInstance()->any(o:Loan|o.LoanID=loanid)
            precondition:
          loan.oclIsUndefined() = false and loan.Status = LoanStatus::LSOPEN and loan.IsPaidinFull = false
            postcondition:
          loan.IsPaidinFull = true and loan.Status = LoanStatus::CLOSED and loan.RemainAmountToPay = 0
            
        }