Contract CoCoMESystem::closeCashDesk(cashDeskID:Integer): Boolean {
          definition:
          curCashDesk:CashDesk = CashDesk.allInstance()->any(c:CashDesk|c.Id=cashDeskID)
            precondition:
          curCashDesk.oclIsUndefined() = false and curCashDesk.IsOpened = true and curCashDesk.BelongedStore.oclIsUndefined() = false and curCashDesk.BelongedStore.IsOpened = true
            postcondition:
          curCashDesk.IsOpened = false and result = true
            
        }