Contract CoCoMESystem::closeCashDesk(cashDeskID:Integer): Boolean {
          definition:
          currentCashDesk:CashDesk = self.CurrentCashDesk
            precondition:
          currentCashDesk.oclIsUndefined() = false and CashDesk.allInstance()->includes(currentCashDesk) and currentCashDesk.Id = cashDeskID and currentCashDesk.IsOpened = true
            postcondition:
          currentCashDesk.IsOpened = false and self.CurrentCashDesk = currentCashDesk and result = true
            
        }