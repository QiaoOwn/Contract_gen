Contract ListBookHistory::listReservationBook(uid:String): Set(BookCopy) {
          definition:
          u:User = User.allInstance()->any(o:User|o.UserID=uid)
            precondition:
          u.oclIsUndefined() = false
            postcondition:
          result = u.ReservedBook->collect(r:Reserve|r.ReservedCopy)
            
        }