Contract AirportSystem::createStaff(id:Integer,name:String,pswd:String,phone:String,role:Integer,bossid:Integer): Boolean {
          definition:
          existingStaff:Staff = Staff.allInstance()->any(s:Staff|s.Id=id), bossStaff:Staff = Staff.allInstance()->any(b:Staff|b.Id=bossid)
            precondition:
          existingStaff.oclIsUndefined() = true and bossStaff.oclIsUndefined() = true or bossStaff.oclIsUndefined() = false and Staff.allInstance()->excludes(existingStaff)
            postcondition:
          let s:Staff in s.oclIsNew() and s.Id=id and s.Name=name and s.Password=pswd and s.Phone=phone and s.Role=role and (bossStaff.oclIsUndefined() = false implies s.Boss=bossStaff) and Staff.allInstance()->includes(s) and result=true
            
        }