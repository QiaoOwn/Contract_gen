Contract EvaluateLoanRequestModule::checkCreditHistory(): CreditHistory {
          definition:
          curRequest:LoanRequest = CurrentLoanRequest, creditHistory:CreditHistory = curRequest.RequestedCreditHistory
            precondition:
          curRequest.oclIsUndefined() = false and creditHistory.oclIsUndefined() = false
            postcondition:
          result = creditHistory
            
        }