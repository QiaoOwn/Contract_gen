Contract AutomatedTellerMachineSystem::printReceipt(): Real {
          definition:
          inputCard:BankCard = self.InputCard
            precondition:
          inputCard.oclIsUndefined() = false and self.PasswordValidated = true and self.CardIDValidated = true and self.IsWithdraw = true and self.IsDeposit = false and inputCard.CardStatus = BankCard::NORMAL and inputCard.Catalog = CardCatalog::DESPOSIT
            postcondition:
          result = 0.0 and self.PasswordValidated = @pre.PasswordValidated and self.CardIDValidated = @pre.CardIDValidated and self.InputCard = @pre.InputCard and self.IsWithdraw = @pre.IsWithdraw and self.IsDeposit = @pre.IsDeposit and self.WithdrawedNumber = @pre.WithdrawedNumber and self.DepositedNumber = @pre.DepositedNumber
            
        }