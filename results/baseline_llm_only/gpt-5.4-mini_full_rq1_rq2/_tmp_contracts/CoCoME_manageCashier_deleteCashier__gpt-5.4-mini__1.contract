Contract ManageCashierCRUDService::deleteCashier(id:Integer): Boolean {
          definition:
          cashier:Cashier = Cashier.allInstance()->any(c:Cashier|c.Id=id)
            precondition:
          cashier.oclIsUndefined() = false
            postcondition:
          let c:Cashier in c.oclIsNew() = false and c.Id = cashier.Id and c.Name = cashier.Name and c.WorkedStore = cashier.WorkedStore and Cashier.allInstance()->excludes(c) and result = true
            
        }