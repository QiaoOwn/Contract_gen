Contract ListBookHistory::listBorrowHistory(uid:String): Set(Loan) {
          definition:
          u:User = User.allInstance()->any(o:User|o.UserID=uid), borrowedLoans:Set(Loan) = u.LoanedBook
            precondition:
          u.oclIsUndefined() = false
            postcondition:
          result = borrowedLoans
            
        }