Contract ProcessSaleService::makeNewSale(): Boolean {
          definition:
          curSale:Sale = CurrentSale
            precondition:
          curSale.oclIsUndefined() = false and curSale.IsComplete = false
            postcondition:
          let s:Sale in s.oclIsNew() and s.Time = self.CurrentSale.Time and s.IsComplete = false and s.Amount = self.CurrentSale.Amount and s.IsReadytoPay = self.CurrentSale.IsReadytoPay and s.Belongedstore = self.CurrentSale.Belongedstore and s.BelongedCashDesk = self.CurrentSale.BelongedCashDesk and s.ContainedSalesLine = self.CurrentSale.ContainedSalesLine and s.AssoicatedPayment = self.CurrentSale.AssoicatedPayment and Sale.allInstance()->includes(s) and result = true
            
        }