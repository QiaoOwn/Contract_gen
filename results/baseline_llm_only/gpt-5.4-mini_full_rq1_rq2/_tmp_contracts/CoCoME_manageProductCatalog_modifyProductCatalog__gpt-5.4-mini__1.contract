Contract ManageProductCatalogCRUDService::modifyProductCatalog(id:Integer,name:String): Boolean {
          definition:
          prodCat:ProductCatalog = ProductCatalog.allInstance()->any(p:ProductCatalog|p.Id=id)
            precondition:
          prodCat.oclIsUndefined() = false and name <> ''
            postcondition:
          prodCat.Name = name and result = true
            
        }