Contract LibraryManagementSystemSystem::cancelReservation(uid:String,barcode:String): Boolean {
          definition:
          usr:User = User.allInstance()->any(u:User|u.UserID=uid), copy:BookCopy = BookCopy.allInstance()->any(c:BookCopy|c.Barcode=barcode), reserve:Reserve = Reserve.allInstance()->any(r:Reserve|r.ReservedUser=usr and r.ReservedCopy=copy and r.IsReserveClosed=false)
            precondition:
          usr.oclIsUndefined() = false and copy.oclIsUndefined() = false and reserve.oclIsUndefined() = false and usr.ReservedBook->includes(reserve) and copy.ReservationRecord->includes(reserve)
            postcondition:
          reserve.IsReserveClosed = true and usr.ReservedBook->excludes(reserve) and copy.ReservationRecord->excludes(reserve) and copy.IsReserved = false and result = true
            
        }