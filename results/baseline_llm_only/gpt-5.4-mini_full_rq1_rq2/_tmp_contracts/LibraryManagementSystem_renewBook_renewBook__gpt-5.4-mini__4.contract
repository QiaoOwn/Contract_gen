Contract LibraryManagementSystemSystem::renewBook(uid:String,barcode:String): Boolean {
          definition:
          u:User = User.allInstance()->any(x:User|x.UserID=uid), c:BookCopy = BookCopy.allInstance()->any(x:BookCopy|x.Barcode=barcode), loan:Loan = Loan.allInstance()->any(x:Loan|x.LoanedUser=u and x.LoanedCopy=c and x.IsReturned=false)
            precondition:
          u.oclIsUndefined() = false and c.oclIsUndefined() = false and loan.oclIsUndefined() = false and loan.RenewedTimes < 3 and c.Status = BookCopy::LOANED
            postcondition:
          loan.RenewedTimes = loan.RenewedTimes@pre + 1 and loan.RenewDate = loan.DueDate@pre and loan.DueDate = loan.DueDate@pre and result = true
            
        }