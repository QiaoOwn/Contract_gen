Contract RepairService::finishRepair(id:Integer,sid:Integer,did:Integer,res:String): Boolean {
          definition:
          rep:Repair = Repair.allInstance()->any(o:Repair|o.Id=id), sta:Staff = Staff.allInstance()->any(o:Staff|o.Id=sid), dev:Device = Device.allInstance()->any(o:Device|o.Id=did)
            precondition:
          rep.oclIsUndefined() = false and sta.oclIsUndefined() = false and dev.oclIsUndefined() = false and dev.Contacts = sta and sta.Role = Staff::Worker
            postcondition:
          rep.Process = 1 and rep.Result = res and result = true
            
        }