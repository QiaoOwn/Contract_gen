Contract SubmitLoanRequestModule::enterLoanInformation(requestid:Integer,name:String,loanamount:Real,loanpurpose:String,income:Real,phonenumber:Integer,postaladdress:String,zipcode:Integer,email:String,workreferences:String,creditreferences:String,checkingaccountnumber:Integer,securitynumber:Integer): Boolean {
          definition:
          currentLoanRequest:LoanRequest = self.CurrentLoanRequest
            precondition:
          currentLoanRequest.oclIsUndefined() = false and currentLoanRequest.RequestID = requestid and currentLoanRequest.Name = name and currentLoanRequest.LoanAmount = loanamount and currentLoanRequest.LoanPurpose = loanpurpose and currentLoanRequest.Income = income and currentLoanRequest.PhoneNumber = phonenumber and currentLoanRequest.PostalAddress = postaladdress and currentLoanRequest.ZipCode = zipcode and currentLoanRequest.Email = email and currentLoanRequest.WorkReferences = workreferences and currentLoanRequest.CreditReferences = creditreferences and currentLoanRequest.CheckingAccountNumber = checkingaccountnumber and currentLoanRequest.SecurityNumber = securitynumber
            postcondition:
          self.CurrentLoanRequest.RequestID = requestid and self.CurrentLoanRequest.Name = name and self.CurrentLoanRequest.LoanAmount = loanamount and self.CurrentLoanRequest.LoanPurpose = loanpurpose and self.CurrentLoanRequest.Income = income and self.CurrentLoanRequest.PhoneNumber = phonenumber and self.CurrentLoanRequest.PostalAddress = postaladdress and self.CurrentLoanRequest.ZipCode = zipcode and self.CurrentLoanRequest.Email = email and self.CurrentLoanRequest.WorkReferences = workreferences and self.CurrentLoanRequest.CreditReferences = creditreferences and self.CurrentLoanRequest.CheckingAccountNumber = checkingaccountnumber and self.CurrentLoanRequest.SecurityNumber = securitynumber and self.CurrentLoanRequest.Status = LoanRequestStatus::SUBMITTED and result = true
            
        }