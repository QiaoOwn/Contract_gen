Contract ManageBankCardCRUDService::modifyBankCard(cardid:Integer,cardstatus:CardStatus[NORMAL|SUSPEND|CANCEL],catalog:CardCatalog[CREDIT|DEPOSIT],password:Integer,balance:Real): Boolean {
          definition:
          card:BankCard = BankCard.allInstance()->any(c:BankCard|c.CardID=cardid)
            precondition:
          card.oclIsUndefined() = false and cardstatus.oclIsUndefined() = false and catalog.oclIsUndefined() = false and password.oclIsUndefined() = false and balance.oclIsUndefined() = false
            postcondition:
          card.CardStatus = cardstatus and card.Catalog = catalog and card.Password = password and card.Balance = balance and result = true
            
        }