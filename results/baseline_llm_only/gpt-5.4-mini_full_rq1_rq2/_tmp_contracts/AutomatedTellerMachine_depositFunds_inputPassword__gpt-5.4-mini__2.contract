Contract AutomatedTellerMachineSystem::inputPassword(password:Integer): Boolean {
          definition:
          inputCard:BankCard = self.InputCard
            precondition:
          inputCard.oclIsUndefined() = false and inputCard.CardStatus = BankCard::NORMAL and inputCard.Password = password
            postcondition:
          self.PasswordValidated = true and result = true
            
        }