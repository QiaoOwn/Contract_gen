Contract EvaluateLoanRequestModule::reviewCheckingAccount(): CheckingAccount {
          definition:
          currentLoanRequest:LoanRequest = self.CurrentLoanRequest
            precondition:
          currentLoanRequest.oclIsUndefined() = false and currentLoanRequest.RequestedCAHistory.oclIsUndefined() = false
            postcondition:
          result = currentLoanRequest.RequestedCAHistory
            
        }