Contract CoCoMESystem::receiveOrderedProduct(orderID:Integer): Boolean {
          definition:
          order:OrderProduct = OrderProduct.allInstance()->any(o:OrderProduct|o.Id=orderID)
            precondition:
          order.oclIsUndefined() = false and order.OrderStatus = OrderProduct::REQUESTED
            postcondition:
          order.OrderStatus = OrderProduct::RECEIVED and result = true
            
        }