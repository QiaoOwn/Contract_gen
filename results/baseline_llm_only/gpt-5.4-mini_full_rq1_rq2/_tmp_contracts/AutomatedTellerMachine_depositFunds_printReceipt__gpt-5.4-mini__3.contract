Contract AutomatedTellerMachineSystem::printReceipt(): Real {
          definition:
          card:BankCard = self.InputCard
            precondition:
          card.oclIsUndefined() = false and self.CardIDValidated = true and self.PasswordValidated = true and self.IsDeposit = true and card.CardStatus = CardStatus::NORMAL and card.Catalog = CardCatalog::DESPOSIT
            postcondition:
          result = 0
            
        }