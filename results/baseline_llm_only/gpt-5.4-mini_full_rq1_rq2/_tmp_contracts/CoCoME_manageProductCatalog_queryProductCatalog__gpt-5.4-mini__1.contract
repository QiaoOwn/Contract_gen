Contract ManageProductCatalogCRUDService::queryProductCatalog(id:Integer): ProductCatalog {
          definition:
          catalog:ProductCatalog = ProductCatalog.allInstance()->any(p:ProductCatalog|p.Id=id)
            precondition:
          catalog.oclIsUndefined() = false
            postcondition:
          result = catalog
            
        }