Contract ProcessSaleService::makeNewSale(): Boolean {
          definition:
          curSale:Sale = CurrentSale, curLine:SalesLineItem = CurrentSaleLine, curPay:PaymentMethod = CurrentPaymentMethod
            precondition:
          curSale.oclIsUndefined() = true and curLine.oclIsUndefined() = true and curPay.oclIsUndefined() = true
            postcondition:
          let s:Sale in s.oclIsNew() and s.IsComplete = false and s.IsReadytoPay = false and s.Amount = 0.0 and Sale.allInstance()->includes(s) and result = true
            
        }