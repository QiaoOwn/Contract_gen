Contract ListBookHistory::listOverDueBook(uid:String): Set(BookCopy) {
          definition:
          u:User = User.allInstance()->any(o:User|o.UserID=uid), overdueBooks:Set(BookCopy) = u.LoanedBook->select(l:Loan|l.IsReturned = false and l.DueDate <> null)
            precondition:
          u.oclIsUndefined() = false and overdueBooks.isEmpty() = false
            postcondition:
          result = overdueBooks
            
        }