Contract AutomatedTellerMachineSystem::ejectCard(): Boolean {
          definition:
          inputCard:BankCard = self.InputCard
            precondition:
          inputCard.oclIsUndefined() = false and BankCard.allInstance()->includes(inputCard) and self.CardIDValidated = true and self.PasswordValidated = true and inputCard.CardStatus = BankCard::NORMAL
            postcondition:
          result = true
            
        }