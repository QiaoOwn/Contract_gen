Contract CoCoMEOrderProducts::listAllOutOfStoreProducts(): Set(Item) {
          definition:
          outOfStoreItems:Set(Item) = Item.allInstance()->select(i:Item|Store.allInstance()->select(s:Store|s.Items->includes(i))->isEmpty())
            precondition:
          outOfStoreItems.isEmpty() = false
            postcondition:
          result = outOfStoreItems
            
        }