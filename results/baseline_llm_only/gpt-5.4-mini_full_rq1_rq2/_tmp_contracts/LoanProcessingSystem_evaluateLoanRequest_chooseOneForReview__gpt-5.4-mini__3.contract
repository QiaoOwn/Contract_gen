Contract EvaluateLoanRequestModule::chooseOneForReview(requestid:Integer): LoanRequest {
          definition:
          curReq:LoanRequest = LoanRequest.allInstance()->any(r:LoanRequest|r.RequestID=requestid)
            precondition:
          curReq.oclIsUndefined() = false and curReq.Status = LoanRequestStatus::READYFORREVIEW
            postcondition:
          result = curReq
            
        }