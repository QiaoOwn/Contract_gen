Contract EvaluateLoanRequestModule::approveLoanRequest(): Boolean {
          definition:
          currentLoanRequest:LoanRequest = self.CurrentLoanRequest
            precondition:
          currentLoanRequest.oclIsUndefined() = false and currentLoanRequest.Status = LoanRequestStatus::REFERENCESVALIDATED
            postcondition:
          let approvedLoanRequest:LoanRequest in approvedLoanRequest = currentLoanRequest and approvedLoanRequest.Status = LoanRequestStatus::APPROVED and result = true
            
        }