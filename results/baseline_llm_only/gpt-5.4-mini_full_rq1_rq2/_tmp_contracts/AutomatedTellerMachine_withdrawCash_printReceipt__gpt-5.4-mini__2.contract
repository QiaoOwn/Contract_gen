Contract AutomatedTellerMachineSystem::printReceipt(): Real {
          definition:
          inputCard:BankCard = self.InputCard
            precondition:
          inputCard.oclIsUndefined() = false and BankCard.allInstance()->includes(inputCard) and inputCard.CardStatus = BankCard::NORMAL and self.CardIDValidated = true and self.PasswordValidated = true and self.IsWithdraw = true and self.IsDeposit = false
            postcondition:
          result = self.WithdrawedNumber
            
        }