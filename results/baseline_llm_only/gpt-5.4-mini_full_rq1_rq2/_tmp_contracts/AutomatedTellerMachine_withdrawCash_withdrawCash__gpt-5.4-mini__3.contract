Contract AutomatedTellerMachineSystem::withdrawCash(quantity:Integer): Boolean {
          definition:
          inputCard:BankCard = self.InputCard
            precondition:
          inputCard.oclIsUndefined() = false and quantity > 0 and self.PasswordValidated = true and self.CardIDValidated = true and self.IsWithdraw = true and inputCard.CardStatus = BankCard::NORMAL and inputCard.Catalog = BankCard::CREDIT and inputCard.Balance >= quantity
            postcondition:
          inputCard.Balance = inputCard.Balance@pre - quantity and self.WithdrawedNumber = quantity and self.IsWithdraw = true and result = true
            
        }