Contract ProcessSaleService::makeNewSale(): Boolean {
          definition:
          curSale:Sale = CurrentSale, curLine:SalesLineItem = CurrentSaleLine, payMethod:PaymentMethod = CurrentPaymentMethod
            precondition:
          curSale.oclIsUndefined() = false and curLine.oclIsUndefined() = false and curLine.BelongedSale.oclIsUndefined() = false and curSale.ContainedSalesLine->includes(curLine) and curSale.IsComplete = false and curSale.IsReadytoPay = false and curSale.AssoicatedPayment.oclIsUndefined() = true and payMethod.oclIsUndefined() = false
            postcondition:
          let s:Sale in s.oclIsNew() and s.Time = curSale.Time and s.IsComplete = false and s.IsReadytoPay = true and s.Amount = curSale.Amount and s.Belongedstore = curSale.Belongedstore and s.BelongedCashDesk = curSale.BelongedCashDesk and s.ContainedSalesLine = curSale.ContainedSalesLine and s.AssoicatedPayment = curSale.AssoicatedPayment and Sale.allInstance()->includes(s) and result = true
            
        }