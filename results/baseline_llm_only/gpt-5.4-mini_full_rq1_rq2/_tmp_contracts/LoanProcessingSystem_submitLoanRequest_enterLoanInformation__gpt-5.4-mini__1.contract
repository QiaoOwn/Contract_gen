Contract SubmitLoanRequestModule::enterLoanInformation(requestid:Integer,name:String,loanamount:Real,loanpurpose:String,income:Real,phonenumber:Integer,postaladdress:String,zipcode:Integer,email:String,workreferences:String,creditreferences:String,checkingaccountnumber:Integer,securitynumber:Integer): Boolean {
          definition:
          currentLoanRequest:LoanRequest = self.CurrentLoanRequest
            precondition:
          currentLoanRequest.oclIsUndefined() = false and currentLoanRequest.RequestID = requestid and currentLoanRequest.Status = LoanRequestStatus::INCOMPLETEINFORMATION and name <> '' and loanpurpose <> '' and postaladdress <> '' and email <> '' and workreferences <> '' and creditreferences <> ''
            postcondition:
          currentLoanRequest.Name = name and currentLoanRequest.LoanAmount = loanamount and currentLoanRequest.LoanPurpose = loanpurpose and currentLoanRequest.Income = income and currentLoanRequest.PhoneNumber = phonenumber and currentLoanRequest.PostalAddress = postaladdress and currentLoanRequest.ZipCode = zipcode and currentLoanRequest.Email = email and currentLoanRequest.WorkReferences = workreferences and currentLoanRequest.CreditReferences = creditreferences and currentLoanRequest.CheckingAccountNumber = checkingaccountnumber and currentLoanRequest.SecurityNumber = securitynumber and currentLoanRequest.Status = LoanRequestStatus::SUBMITTED and result = true
            
        }