Contract AutomatedTellerMachineSystem::withdrawCash(quantity:Integer): Boolean {
          definition:
          inputCard:BankCard = InputCard
            precondition:
          inputCard.oclIsUndefined() = false and CardIDValidated = true and PasswordValidated = true and IsWithdraw = true and inputCard.CardStatus = BankCard::NORMAL and inputCard.Catalog = BankCard::DESPOSIT and quantity > 0 and inputCard.Balance >= quantity
            postcondition:
          let b:BankCard in b = inputCard and b.Balance = inputCard.Balance - quantity and b.CardStatus = inputCard.CardStatus and b.Catalog = inputCard.Catalog and b.Password = inputCard.Password and b.CardID = inputCard.CardID and b.BelongedUser = inputCard.BelongedUser and result = true
            
        }