Contract AutomatedTellerMachineSystem::ejectCard(): Boolean {
          definition:
          inputCard:BankCard = self.InputCard
            precondition:
          inputCard.oclIsUndefined() = false and inputCard.CardStatus <> BankCard::CANNEL
            postcondition:
          inputCard.CardStatus = BankCard::NORMAL and self.InputCard.oclIsUndefined() = true and result = true
            
        }