Contract AutomatedTellerMachineSystem::printReceipt(): Real {
          definition:
          inputCard:BankCard = self.InputCard
            precondition:
          inputCard.oclIsUndefined() = false and CardIDValidated = true and PasswordValidated = true and IsDeposit = false and inputCard.CardStatus = BankCard::NORMAL and inputCard.Catalog = BankCard::DESPOSIT
            postcondition:
          result = 0.0 and self.InputCard = inputCard and CardIDValidated = true and PasswordValidated = true and IsDeposit = false
            
        }