Contract AutomatedTellerMachineSystem::inputCard(cardid:Integer): Boolean {
          definition:
          inputCard:BankCard = BankCard.allInstance()->any(o:BankCard|o.CardID=cardid)
            precondition:
          inputCard.oclIsUndefined() = false and inputCard.CardStatus = BankCard::NORMAL and self.CardIDValidated = true
            postcondition:
          self.InputCard = inputCard and self.CardIDValidated = true and result = true
            
        }