Contract ManageUserCRUDService::modifyUser(userid:Integer,name:String,address:String): Boolean {
          definition:
          u:User = User.allInstance()->any(o:User|o.UserID=userid)
            precondition:
          u.oclIsUndefined() = false and name.oclIsUndefined() = false and address.oclIsUndefined() = false
            postcondition:
          u.Name = name and u.Address = address and result = true
            
        }