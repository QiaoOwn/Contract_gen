Contract LibraryManagementSystemSystem::countDownSuspensionDay(): void {
          definition:
          overdueLoans:Set(Loan) = Loan.allInstance()->select(l:Loan|l.IsReturned = false and l.DueDate <> undefined and l.DueDate < today)
            precondition:
          true
            postcondition:
          overdueLoans->forAll(l:Loan|l.OverDueFee = l.OverDueFee@pre and l.OverDue3Days = l.OverDue3Days@pre and l.OverDue10Days = l.OverDue10Days@pre and l.OverDue17Days = l.OverDue17Days@pre and l.OverDue31Days = l.OverDue31Days@pre)
            
        }