Contract AutomatedTellerMachineSystem::ejectCard(): Boolean {
          definition:
          inputCard:BankCard = self.InputCard
            precondition:
          inputCard.oclIsUndefined() = false and BankCard.allInstance()->includes(inputCard) and inputCard.CardStatus = CardStatus::NORMAL
            postcondition:
          self.InputCard = inputCard and self.CardIDValidated = true and result = true
            
        }