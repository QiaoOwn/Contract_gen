Contract AutomatedTellerMachineSystem::checkBalance(): Real {
          definition:
          inputCard:BankCard = self.InputCard
            precondition:
          inputCard.oclIsUndefined() = false and self.PasswordValidated = true and self.CardIDValidated = true and inputCard.CardStatus = BankCard::NORMAL
            postcondition:
          result = inputCard.Balance
            
        }