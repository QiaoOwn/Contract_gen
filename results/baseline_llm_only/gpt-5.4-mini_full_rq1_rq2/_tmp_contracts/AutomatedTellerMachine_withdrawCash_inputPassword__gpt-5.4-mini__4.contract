Contract AutomatedTellerMachineSystem::inputPassword(password:Integer): Boolean {
          definition:
          inputCard:BankCard = self.InputCard
            precondition:
          inputCard.oclIsUndefined() = false and BankCard.allInstance()->includes(inputCard) and password = inputCard.Password and inputCard.CardStatus = BankCard::NORMAL
            postcondition:
          self.PasswordValidated = true and self.InputCard = inputCard and result = true
            
        }