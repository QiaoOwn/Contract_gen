Contract ManageBookCopyCRUDService::addBookCopy(callNo:String,barcode:String,location:String): Boolean {
          definition:
          existingBook:Book = Book.allInstance()->any(b:Book|b.CallNo=callNo)
            precondition:
          callNo <> '' and barcode <> '' and location <> '' and existingBook.oclIsUndefined() = false and BookCopy.allInstance()->select(c:BookCopy|c.Barcode=barcode)->isEmpty()
            postcondition:
          let newCopy:BookCopy in newCopy.oclIsNew() and newCopy.Barcode=barcode and newCopy.Location=location and newCopy.Status=CopyStatus::AVAILABLE and newCopy.IsReserved=false and newCopy.BookBelongs=existingBook and BookCopy.allInstance()->includes(newCopy) and existingBook.Copys->includes(newCopy) and result=true
            
        }