Contract AutomatedTellerMachineSystem::inputCard(cardid:Integer): Boolean {
          definition:
          inputCardObj:BankCard = BankCard.allInstance()->any(b:BankCard|b.CardID=cardid)
            precondition:
          inputCardObj.oclIsUndefined() = false and inputCardObj.CardStatus = BankCard::NORMAL and self.InputCard.oclIsUndefined() = true
            postcondition:
          self.InputCard = inputCardObj and self.CardIDValidated = true and result = true
            
        }