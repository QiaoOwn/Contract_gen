Contract CoCoMESystem::openStore(storeID:Integer): Boolean {
          definition:
          curStore:Store = Store.allInstance()->any(s:Store|s.Id=storeID)
            precondition:
          curStore.oclIsUndefined() = false and curStore.IsOpened = false
            postcondition:
          curStore.IsOpened = true and self.CurrentStore = curStore and result = true
            
        }