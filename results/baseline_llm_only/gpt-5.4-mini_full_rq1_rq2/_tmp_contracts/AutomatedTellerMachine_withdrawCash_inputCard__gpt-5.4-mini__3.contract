Contract AutomatedTellerMachineSystem::inputCard(cardid:Integer): Boolean {
          definition:
          inputCard:BankCard = BankCard.allInstance()->any(c:BankCard|c.CardID = cardid)
            precondition:
          inputCard.oclIsUndefined() = false and inputCard.CardStatus = BankCard::NORMAL
            postcondition:
          self.InputCard = inputCard and self.CardIDValidated = true and result = true
            
        }