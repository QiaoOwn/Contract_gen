Contract CoCoMESystem::openCashDesk(cashDeskID:Integer): Boolean {
          definition:
          cashDesk:CashDesk = CashDesk.allInstance()->any(c:CashDesk|c.Id=cashDeskID)
            precondition:
          cashDesk.oclIsUndefined() = false and cashDesk.IsOpened = false
            postcondition:
          cashDesk.IsOpened = true and CurrentCashDesk = cashDesk and result = true
            
        }