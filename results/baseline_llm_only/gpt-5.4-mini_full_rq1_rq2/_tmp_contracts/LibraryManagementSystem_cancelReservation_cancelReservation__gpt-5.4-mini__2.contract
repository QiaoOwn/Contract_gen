Contract LibraryManagementSystemSystem::cancelReservation(uid:String,barcode:String): Boolean {
          definition:
          user:User = User.allInstance()->any(o:User|o.UserID=uid), copy:BookCopy = BookCopy.allInstance()->any(o:BookCopy|o.Barcode=barcode), reserve:Reserve = Reserve.allInstance()->any(o:Reserve|o.ReservedUser=user and o.ReservedCopy=copy and o.IsReserveClosed=false)
            precondition:
          user.oclIsUndefined() = false and copy.oclIsUndefined() = false and reserve.oclIsUndefined() = false
            postcondition:
          let r:Reserve in r.oclIsNew() = false and r = reserve and r.IsReserveClosed = true and user.ReservedBook->excludes(r) and copy.ReservationRecord->excludes(r) and result = true
            
        }