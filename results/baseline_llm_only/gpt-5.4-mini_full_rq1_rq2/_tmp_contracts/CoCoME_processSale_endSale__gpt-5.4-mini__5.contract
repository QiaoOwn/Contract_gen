Contract ProcessSaleService::endSale(): Real {
          definition:
          curSale:Sale = self.CurrentSale
            precondition:
          curSale.oclIsUndefined() = false and curSale.IsComplete = false and curSale.IsReadytoPay = true
            postcondition:
          let s:Sale in s.oclIsNew() = false and s = curSale and s.IsComplete = true and s.IsReadytoPay = false and result = s.Amount
            
        }