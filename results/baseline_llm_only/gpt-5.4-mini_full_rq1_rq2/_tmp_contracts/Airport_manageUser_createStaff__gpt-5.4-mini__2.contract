Contract AirportSystem::createStaff(id:Integer,name:String,pswd:String,phone:String,role:Integer,bossid:Integer): Boolean {
          definition:
          existingStaff:Staff = Staff.allInstance()->any(o:Staff|o.Id=id), boss:Staff = Staff.allInstance()->any(o:Staff|o.Id=bossid)
            precondition:
          existingStaff.oclIsUndefined() = true and bossid = 0 or boss.oclIsUndefined() = false
            postcondition:
          let s:Staff in s.oclIsNew() and s.Id=id and s.Name=name and s.Password=pswd and s.Phone=phone and s.Role=role and (bossid = 0 or s.Boss=boss) and Staff.allInstance()->includes(s) and result=true
            
        }