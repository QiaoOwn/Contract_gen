Contract EnterValidatedCreditReferencesModule::markRequestValid(): Boolean {
          definition:
          currentLoanRequest:LoanRequest = self.CurrentLoanRequest
            precondition:
          currentLoanRequest.oclIsUndefined() = false and currentLoanRequest.Status = LoanRequestStatus::SUBMITTED
            postcondition:
          currentLoanRequest.Status = LoanRequestStatus::REFERENCESVALIDATED and result = true
            
        }