Contract LibraryManagementSystemSystem::renewBook(uid:String,barcode:String): Boolean {
          definition:
          u:User = User.allInstance()->any(o:User|o.UserID=uid), c:BookCopy = BookCopy.allInstance()->any(o:BookCopy|o.Barcode=barcode), l:Loan = c.LoanedRecord->any(o:Loan|o.IsReturned=false), canRenew = l.oclIsUndefined() = false and u.oclIsUndefined() = false and c.oclIsUndefined() = false and c.Status=CopyStatus::LOANED and l.LoanedUser=u and l.RenewedTimes<3
            precondition:
          u.oclIsUndefined() = false and c.oclIsUndefined() = false and l.oclIsUndefined() = false and canRenew = true
            postcondition:
          l.RenewDate = l.RenewDate@pre and l.DueDate = l.DueDate@pre and l.RenewedTimes = l.RenewedTimes@pre + 1 and result = true
            
        }