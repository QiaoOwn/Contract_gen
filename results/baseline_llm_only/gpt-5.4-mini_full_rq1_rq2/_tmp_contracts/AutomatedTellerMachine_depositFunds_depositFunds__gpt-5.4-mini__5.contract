Contract AutomatedTellerMachineSystem::depositFunds(quantity:Real): Boolean {
          definition:
          inputCard:BankCard = self.InputCard
            precondition:
          inputCard.oclIsUndefined() = false and self.PasswordValidated = true and self.CardIDValidated = true and self.IsDeposit = true and inputCard.CardStatus = BankCard::NORMAL and quantity > 0
            postcondition:
          inputCard.Balance = inputCard.Balance@pre + quantity and self.DepositedNumber = quantity and result = true
            
        }