Contract CoCoMEOrderProducts::listAllOutOfStoreProducts(): Set(Item) {
          definition:
          outOfStoreItems:Set(Item) = Item.allInstance()->select(i:Item|i.BelongedCatalog.oclIsUndefined() = true)
            precondition:
          outOfStoreItems.isEmpty() = false
            postcondition:
          result = outOfStoreItems
            
        }