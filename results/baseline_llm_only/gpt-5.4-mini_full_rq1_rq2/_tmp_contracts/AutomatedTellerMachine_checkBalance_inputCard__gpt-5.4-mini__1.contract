Contract AutomatedTellerMachineSystem::inputCard(cardid:Integer): Boolean {
          definition:
          inputCardOb:BankCard = BankCard.allInstance()->any(b:BankCard|b.CardID = cardid)
            precondition:
          inputCardOb.oclIsUndefined() = false and inputCardOb.CardStatus = BankCard::NORMAL
            postcondition:
          let inputCardOb:BankCard in inputCardOb.oclIsUndefined() = false and inputCardOb = self.InputCard and self.InputCard = inputCardOb and self.CardIDValidated = true and result = true
            
        }