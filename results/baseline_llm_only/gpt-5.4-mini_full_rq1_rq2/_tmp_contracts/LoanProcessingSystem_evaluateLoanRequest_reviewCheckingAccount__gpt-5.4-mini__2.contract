Contract EvaluateLoanRequestModule::reviewCheckingAccount(): CheckingAccount {
          definition:
          curLoanRequest:LoanRequest = self.CurrentLoanRequest, requestedCheckingAccount:CheckingAccount = curLoanRequest.RequestedCAHistory
            precondition:
          curLoanRequest.oclIsUndefined() = false and requestedCheckingAccount.oclIsUndefined() = false
            postcondition:
          result = requestedCheckingAccount
            
        }