Contract ListBookHistory::listHodingBook(uid:String): Set(Loan) {
          definition:
          u:User = User.allInstance()->any(o:User|o.UserID=uid), loanHistory:Set(Loan) = u.LoanedBook
            precondition:
          u.oclIsUndefined() = false
            postcondition:
          result = loanHistory
            
        }