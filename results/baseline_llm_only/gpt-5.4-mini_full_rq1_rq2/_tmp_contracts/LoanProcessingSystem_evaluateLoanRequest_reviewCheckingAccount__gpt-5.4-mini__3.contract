Contract EvaluateLoanRequestModule::reviewCheckingAccount(): CheckingAccount {
          definition:
          currentRequest:LoanRequest = self.CurrentLoanRequest, requestedCheckingAccount:CheckingAccount = currentRequest.RequestedCAHistory
            precondition:
          currentRequest.oclIsUndefined() = false and requestedCheckingAccount.oclIsUndefined() = false
            postcondition:
          result = requestedCheckingAccount
            
        }