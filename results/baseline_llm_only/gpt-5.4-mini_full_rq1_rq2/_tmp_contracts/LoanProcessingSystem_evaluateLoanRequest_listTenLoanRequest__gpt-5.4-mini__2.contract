Contract EvaluateLoanRequestModule::listTenLoanRequest(): Set(LoanRequest) {
          definition:
          currentLoanRequest:LoanRequest = self.CurrentLoanRequest, currentLoanRequests:Set(LoanRequest) = self.CurrentLoanRequests
            precondition:
          currentLoanRequest.oclIsUndefined() = false and currentLoanRequests.oclIsUndefined() = false and currentLoanRequests->includes(currentLoanRequest)
            postcondition:
          result = currentLoanRequests
            
        }