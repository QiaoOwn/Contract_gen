Contract EnterValidatedCreditReferencesModule::chooseLoanRequest(requestid:Integer): LoanRequest {
          definition:
          currentRequest:LoanRequest = LoanRequest.allInstance()->any(r:LoanRequest|r.RequestID=requestid)
            precondition:
          currentRequest.oclIsUndefined() = false
            postcondition:
          result = currentRequest
            
        }