Contract LibraryManagementSystemSystem::cancelReservation(uid:String,barcode:String): Boolean {
          definition:
          usr:User = User.allInstance()->any(u:User|u.UserID=uid), copy:BookCopy = BookCopy.allInstance()->any(c:BookCopy|c.Barcode=barcode), res:Reserve = Reserve.allInstance()->any(r:Reserve|r.ReservedUser=usr and r.ReservedCopy=copy and r.IsReserveClosed=false)
            precondition:
          usr.oclIsUndefined() = false and copy.oclIsUndefined() = false and res.oclIsUndefined() = false and usr.ReservedBook->includes(res) and copy.ReservationRecord->includes(res) and res.IsReserveClosed = false
            postcondition:
          res.IsReserveClosed = true and usr.ReservedBook->excludes(res) and copy.ReservationRecord->excludes(res) and copy.IsReserved = false and result = true
            
        }