Contract ProcessSaleService::makeNewSale(): Boolean {
          definition:
          curSale:Sale = CurrentSale
            precondition:
          curSale.oclIsUndefined() = false and curSale.IsComplete = false
            postcondition:
          let s:Sale in s.oclIsNew() and s.IsComplete = false and s.IsReadytoPay = false and s.Amount = 0.0 and s.Belongedstore = curSale.Belongedstore and s.BelongedCashDesk = curSale.BelongedCashDesk and s.ContainedSalesLine = curSale.ContainedSalesLine and Sale.allInstance()->includes(s) and result = true
            
        }