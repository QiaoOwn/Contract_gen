Contract ManageBookCopyCRUDService::addBookCopy(callNo:String,barcode:String,location:String): Boolean {
          definition:
          book:Book = Book.allInstance()->any(b:Book|b.CallNo=callNo), existingCopy:BookCopy = BookCopy.allInstance()->any(c:BookCopy|c.Barcode=barcode)
            precondition:
          book.oclIsUndefined() = false and existingCopy.oclIsUndefined() = true and callNo <> '' and barcode <> '' and location <> ''
            postcondition:
          let newCopy:BookCopy in newCopy.oclIsNew() and newCopy.Barcode=barcode and newCopy.Location=location and newCopy.Status=BookCopy::AVAILABLE and newCopy.IsReserved=false and newCopy.BookBelongs=book and BookCopy.allInstance()->includes(newCopy) and book.Copys->includes(newCopy) and book.CopyNum=book.CopyNum@pre + 1 and result=true
            
        }