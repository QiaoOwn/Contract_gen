Contract RepairService::approve(sid:Integer,rid:Integer,reject:Boolean,suggestion:String): ApprovalHistory {
          definition:
          rep:Repair = Repair.allInstance()->any(o:Repair|o.Id=rid), sta:Staff = Staff.allInstance()->any(o:Staff|o.Id=sid)
            precondition:
          rep.oclIsUndefined() = false and sta.oclIsUndefined() = false
            postcondition:
          let ah:ApprovalHistory in ah.oclIsNew() and ah.StaffId=sid and ah.Reject=reject and ah.Suggestion=suggestion and rep.History->includes(ah) and (reject = false implies rep.Process = rep.Process@pre + 1) and (reject = true implies rep.Process = rep.Process@pre - 1) and result=ah
            
        }