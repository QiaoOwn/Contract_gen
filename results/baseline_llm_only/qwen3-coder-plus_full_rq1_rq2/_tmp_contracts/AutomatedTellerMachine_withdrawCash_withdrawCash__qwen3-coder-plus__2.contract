Contract AutomatedTellerMachineSystem::withdrawCash(quantity:Integer): Boolean {
          definition:
          currentCard:BankCard = self.InputCard, isValidPassword:Boolean = self.PasswordValidated, isValidCardId:Boolean = self.CardIDValidated, isWithdrawAllowed:Boolean = self.IsWithdraw
            precondition:
          quantity > 0 and currentCard.oclIsUndefined() = false and isValidPassword = true and isValidCardId = true and isWithdrawAllowed = true and currentCard.Balance >= quantity
            postcondition:
          let updatedCard:BankCard in updatedCard.oclIsNew() = false and currentCard@pre.Balance - quantity = currentCard.Balance and self.WithdrawedNumber = quantity and result = true
            
        }