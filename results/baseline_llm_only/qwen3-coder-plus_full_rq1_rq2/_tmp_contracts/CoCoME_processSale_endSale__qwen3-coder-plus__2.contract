Contract ProcessSaleService::endSale(): Real {
          definition:
          currentSale:Sale = self.CurrentSale, currentPaymentMethod:PaymentMethod = self.CurrentPaymentMethod
            precondition:
          currentSale.oclIsUndefined() = false and currentSale.IsReadytoPay = true and currentSale.IsComplete = false and currentPaymentMethod.oclIsUndefined() = false
            postcondition:
          currentSale.IsComplete = true and currentSale.AssoicatedPayment.oclIsUndefined() = false and result = currentSale.Amount
            
        }