Contract ManageStoreCRUDService::deleteStore(id:Integer): Boolean {
          definition:
          store:Store = Store.allInstance()->any(s:Store|s.Id=id)
            precondition:
          store.oclIsUndefined() = false and store.AssociationCashdeskes->isEmpty() = true and store.Productcatalogs->isEmpty() = true and store.Items->isEmpty() = true and store.Cashiers->isEmpty() = true and store.Sales->isEmpty() = true
            postcondition:
          Store.allInstance()->excludes(store) and result = true
            
        }