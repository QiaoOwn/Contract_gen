Contract AutomatedTellerMachineSystem::depositFunds(quantity:Real): Boolean {
          definition:
          currentCard:BankCard = self.InputCard
            precondition:
          self.PasswordValidated = true and self.CardIDValidated = true and currentCard.oclIsUndefined() = false and quantity > 0 and currentCard.CardStatus = BankCard::NORMAL
            postcondition:
          currentCard.Balance = currentCard@pre.Balance + quantity and self.DepositedNumber = quantity and self.IsDeposit = true and result = true
            
        }