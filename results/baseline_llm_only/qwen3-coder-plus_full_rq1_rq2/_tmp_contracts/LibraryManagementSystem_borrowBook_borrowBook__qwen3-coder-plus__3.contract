Contract LibraryManagementSystemSystem::borrowBook(uid:String,barcode:String): Boolean {
          definition:
          usr:User = User.allInstance()->any(u:User|u.UserID=uid), copy:BookCopy = BookCopy.allInstance()->any(c:BookCopy|c.Barcode=barcode), maxLoans:Int = if usr.oclIsTypeOf(Student) then 5 else 10 endif
            precondition:
          usr.oclIsUndefined() = false and copy.oclIsUndefined() = false and usr.BorrowStatus = User::NORMAL and usr.LoanedNumber < maxLoans and (copy.Status = BookCopy::AVAILABLE or (copy.IsReserved = true and copy.ReservationRecord->exists(r:Reserve|r.ReservedUser=usr)))
            postcondition:
          let l:Loan in l.oclIsNew() and l.LoanedUser=usr and l.LoanedCopy=copy and l.LoanDate=self.CurrentDate and l.DueDate=if usr.oclIsTypeOf(Student) then self.CurrentDate.addDays(14) else self.CurrentDate.addDays(28) endif and l.IsReturned=false and Loan.allInstance()->includes(l) and copy.Status=BookCopy::LOANED and usr.LoanedNumber=usr@pre.LoanedNumber+1 and result=true
            
        }