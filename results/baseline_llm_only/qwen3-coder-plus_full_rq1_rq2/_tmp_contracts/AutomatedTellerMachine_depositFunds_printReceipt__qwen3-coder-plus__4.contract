Contract AutomatedTellerMachineSystem::printReceipt(): Real {
          definition:
          currentCard:BankCard = self.InputCard
            precondition:
          self.PasswordValidated = true and self.CardIDValidated = true and self.IsDeposit = true and currentCard.oclIsUndefined() = false and currentCard.CardStatus = BankCard::NORMAL
            postcondition:
          result = self.DepositedNumber
            
        }