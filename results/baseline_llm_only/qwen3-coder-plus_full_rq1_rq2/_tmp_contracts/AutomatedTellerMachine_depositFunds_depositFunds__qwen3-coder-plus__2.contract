Contract AutomatedTellerMachineSystem::depositFunds(quantity:Real): Boolean {
          definition:
          currentCard:BankCard = self.InputCard, isValidCard:Boolean = self.CardIDValidated, isPasswordValid:Boolean = self.PasswordValidated, isDepositAllowed:Boolean = self.IsDeposit
            precondition:
          currentCard.oclIsUndefined() = false and isValidCard = true and isPasswordValid = true and isDepositAllowed = true and quantity > 0
            postcondition:
          currentCard.Balance = currentCard@pre.Balance + quantity and self.DepositedNumber = quantity and result = true
            
        }