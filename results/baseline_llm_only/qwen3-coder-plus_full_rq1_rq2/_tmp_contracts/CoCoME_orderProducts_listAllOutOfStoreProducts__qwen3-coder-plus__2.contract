Contract CoCoMEOrderProducts::listAllOutOfStoreProducts(): Set(Item) {
          definition:
          outOfStockItems:Set(Item) = Item.allInstance()->select(i:Item|i.StockNumber <= 0)
            precondition:
          self.CurrentOrderProduct.oclIsUndefined() = false
            postcondition:
          result = outOfStockItems
            
        }