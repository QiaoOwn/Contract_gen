Contract AutomatedTellerMachineSystem::printReceipt(): Real {
          definition:
          currentCard:BankCard = self.InputCard, isValidCard:Boolean = self.CardIDValidated, isPasswordValid:Boolean = self.PasswordValidated, depositedAmount:Real = self.DepositedNumber, isDepositOp:Boolean = self.IsDeposit
            precondition:
          currentCard.oclIsUndefined() = false and isValidCard = true and isPasswordValid = true and depositedAmount > 0 and isDepositOp = true
            postcondition:
          result = depositedAmount
            
        }