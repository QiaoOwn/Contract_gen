Contract CoCoMEOrderProducts::placeOrder(): Boolean {
          definition:
          currentOrderProduct:OrderProduct = self.CurrentOrderProduct
            precondition:
          currentOrderProduct.oclIsUndefined() = false and currentOrderProduct.OrderStatus = OrderProduct::NEW
            postcondition:
          self.CurrentOrderProduct.OrderStatus = OrderProduct::REQUESTED and self.CurrentOrderProduct.Supplier.oclIsUndefined() = false and result = true
            
        }