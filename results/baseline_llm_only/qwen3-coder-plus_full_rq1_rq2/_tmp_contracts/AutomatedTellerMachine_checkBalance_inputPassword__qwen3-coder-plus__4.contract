Contract AutomatedTellerMachineSystem::inputPassword(password:Integer): Boolean {
          definition:
          inputCard:BankCard = self.InputCard
            precondition:
          self.CardIDValidated = true and inputCard.oclIsUndefined() = false and password <> null
            postcondition:
          self.PasswordValidated = (inputCard.Password = password) and result = (inputCard.Password = password)
            
        }