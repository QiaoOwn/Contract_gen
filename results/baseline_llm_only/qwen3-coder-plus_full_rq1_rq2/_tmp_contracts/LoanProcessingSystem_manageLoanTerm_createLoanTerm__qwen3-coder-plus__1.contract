Contract ManageLoanTermCRUDService::createLoanTerm(itemid:Integer,content:String): Boolean {
          definition:
          existingTerm:LoanTerm = LoanTerm.allInstance()->any(t:LoanTerm|t.ItemID=itemid)
            precondition:
          existingTerm.oclIsUndefined() = true and itemid <> null and content <> null
            postcondition:
          let newTerm:LoanTerm in newTerm.oclIsNew() and newTerm.ItemID=itemid and newTerm.Content=content and LoanTerm.allInstance()->includes(newTerm) and result=true
            
        }