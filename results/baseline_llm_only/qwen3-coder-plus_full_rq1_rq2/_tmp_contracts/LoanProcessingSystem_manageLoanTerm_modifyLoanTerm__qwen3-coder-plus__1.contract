Contract ManageLoanTermCRUDService::modifyLoanTerm(itemid:Integer,content:String): Boolean {
          definition:
          loanTerm:LoanTerm = LoanTerm.allInstance()->any(o:LoanTerm|o.ItemID=itemid)
            precondition:
          loanTerm.oclIsUndefined() = false and itemid <> 0 and content <> ''
            postcondition:
          loanTerm.Content = content and result = true
            
        }