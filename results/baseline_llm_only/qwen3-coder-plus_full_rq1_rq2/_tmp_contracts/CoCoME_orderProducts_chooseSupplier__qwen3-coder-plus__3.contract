Contract CoCoMEOrderProducts::chooseSupplier(supplierID:Integer): Boolean {
          definition:
          supp:Supplier = Supplier.allInstance()->any(s:Supplier|s.Id=supplierID), ordProd:OrderProduct = self.CurrentOrderProduct
            precondition:
          supp.oclIsUndefined() = false and ordProd.oclIsUndefined() = false and ordProd.Supplier.oclIsUndefined() = true
            postcondition:
          ordProd.Supplier = supp and result = true
            
        }