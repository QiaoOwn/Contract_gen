Contract ManageUserCRUDService::modifyUser(userid:Integer,name:String,address:String): Boolean {
          definition:
          usr:User = User.allInstance()->any(u:User|u.UserID=userid)
            precondition:
          usr.oclIsUndefined() = false and userid <> 0 and name <> ''
            postcondition:
          usr.Name = name and usr.Address = address and result = true
            
        }