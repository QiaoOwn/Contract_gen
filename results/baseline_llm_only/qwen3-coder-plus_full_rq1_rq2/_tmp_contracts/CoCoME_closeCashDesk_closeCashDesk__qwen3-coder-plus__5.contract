Contract CoCoMESystem::closeCashDesk(cashDeskID:Integer): Boolean {
          definition:
          cashDesk:CashDesk = CashDesk.allInstance()->any(cd:CashDesk|cd.Id=cashDeskID), currentStore:Store = self.CurrentStore
            precondition:
          cashDesk.oclIsUndefined() = false and currentStore.oclIsUndefined() = false and cashDesk.IsOpened = true and cashDesk.BelongedStore = currentStore
            postcondition:
          cashDesk@pre.IsOpened = true and cashDesk.IsOpened = false and result = true
            
        }