Contract ManageStoreCRUDService::modifyStore(id:Integer,name:String,address:String,isopened:Boolean): Boolean {
          definition:
          st:Store = Store.allInstance()->any(s:Store|s.Id=id)
            precondition:
          st.oclIsUndefined() = false and name.oclIsUndefined() = false and address.oclIsUndefined() = false
            postcondition:
          st@pre.Id = id and st.Name = name and st.Address = address and st.IsOpened = isopened and result = true
            
        }