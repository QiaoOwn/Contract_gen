Contract ManageProductCatalogCRUDService::createProductCatalog(id:Integer,name:String): Boolean {
          definition:
          existingCatalog:ProductCatalog = ProductCatalog.allInstance()->any(pc:ProductCatalog|pc.Id=id)
            precondition:
          existingCatalog.oclIsUndefined() = true and id > 0 and name <> ''
            postcondition:
          let newCatalog:ProductCatalog in newCatalog.oclIsNew() and newCatalog.Id=id and newCatalog.Name=name and ProductCatalog.allInstance()->includes(newCatalog) and result=true
            
        }