Contract EvaluateLoanRequestModule::listTenLoanRequest(): Set(LoanRequest) {
          definition:
          loanRequests:Set(LoanRequest) = LoanRequest.allInstance()->select(lr:LoanRequest|lr.Status = LoanRequestStatus::SUBMITTED or lr.Status = LoanRequestStatus::READYFORREVIEW)
            precondition:
          loanRequests.oclIsUndefined() = false
            postcondition:
          result = loanRequests->subSet(0, 10)
            
        }