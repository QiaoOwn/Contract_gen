Contract ManageSubjectCRUDService::createSubject(name:String): Boolean {
          definition:
          existingSubject:Subject = Subject.allInstance()->any(s:Subject|s.Name=name)
            precondition:
          name.oclIsUndefined() = false and name = "" = false and existingSubject.oclIsUndefined() = true
            postcondition:
          let newSubject:Subject in newSubject.oclIsNew() and newSubject.Name=name and Subject.allInstance()->includes(newSubject) and result=true
            
        }