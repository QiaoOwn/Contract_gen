Contract ManageStoreCRUDService::modifyStore(id:Integer,name:String,address:String,isopened:Boolean): Boolean {
          definition:
          st:Store = Store.allInstance()->any(s:Store|s.Id=id)
            precondition:
          st.oclIsUndefined() = false and id <> 0 and name <> '' and address <> ''
            postcondition:
          st.Id = id and st.Name = name and st.Address = address and st.IsOpened = isopened and result = true
            
        }