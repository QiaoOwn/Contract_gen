Contract AutomatedTellerMachineSystem::inputPassword(password:Integer): Boolean {
          definition:
          inputCard:BankCard = self.InputCard, passwordMatch:Boolean = inputCard.oclIsUndefined() = false and inputCard.Password = password
            precondition:
          self.CardIDValidated = true and inputCard.oclIsUndefined() = false and inputCard.CardStatus = BankCard::NORMAL
            postcondition:
          self.PasswordValidated = passwordMatch and result = passwordMatch
            
        }