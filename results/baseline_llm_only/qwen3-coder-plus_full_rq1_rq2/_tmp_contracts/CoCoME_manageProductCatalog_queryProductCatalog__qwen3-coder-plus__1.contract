Contract ManageProductCatalogCRUDService::queryProductCatalog(id:Integer): ProductCatalog {
          definition:
          catalog:ProductCatalog = ProductCatalog.allInstance()->any(c:ProductCatalog|c.Id=id)
            precondition:
          catalog.oclIsUndefined() = false
            postcondition:
          result = catalog
            
        }