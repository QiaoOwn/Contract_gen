Contract AutomatedTellerMachineSystem::withdrawCash(quantity:Integer): Boolean {
          definition:
          currentCard:BankCard = self.InputCard, isValidCard:Boolean = self.CardIDValidated, isPasswordValid:Boolean = self.PasswordValidated
            precondition:
          quantity > 0 and currentCard.oclIsUndefined() = false and isValidCard = true and isPasswordValid = true and currentCard.Balance >= quantity and currentCard.CardStatus = BankCard::NORMAL
            postcondition:
          currentCard.Balance = currentCard@pre.Balance - quantity and self.WithdrawedNumber = self.WithdrawedNumber@pre + quantity and self.IsWithdraw = true and result = true
            
        }