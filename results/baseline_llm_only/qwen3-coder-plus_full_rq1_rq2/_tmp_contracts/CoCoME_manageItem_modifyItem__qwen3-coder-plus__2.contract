Contract ManageItemCRUDService::modifyItem(barcode:Integer,name:String,price:Real,stocknumber:Integer,orderprice:Real): Boolean {
          definition:
          item:Item = Item.allInstance()->any(i:Item|i.Barcode=barcode)
            precondition:
          item.oclIsUndefined() = false and barcode <> 0 and name <> '' and price >= 0 and stocknumber >= 0 and orderprice >= 0
            postcondition:
          item.oclIsUndefined() = false and item@pre.Barcode = item.Barcode and item.Name = name and item.Price = price and item.StockNumber = stocknumber and item.OrderPrice = orderprice and result = true
            
        }