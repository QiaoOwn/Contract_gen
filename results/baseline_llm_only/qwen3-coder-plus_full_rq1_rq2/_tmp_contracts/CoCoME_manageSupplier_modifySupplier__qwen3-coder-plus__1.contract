Contract ManageSupplierCRUDService::modifySupplier(id:Integer,name:String): Boolean {
          definition:
          supp:Supplier = Supplier.allInstance()->any(s:Supplier|s.Id=id)
            precondition:
          supp.oclIsUndefined() = false and name.oclIsUndefined() = false
            postcondition:
          supp.Name = name and result = true
            
        }