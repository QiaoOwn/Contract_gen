Contract GenerateLoanLetterAndAgreementModule::generateLoanAgreement(): Boolean {
          definition:
          currentRequest:LoanRequest = self.CurrentLoanRequest, currentLetter:ApprovalLetter = self.CurrentApprovalLetter, currentAgreement:LoanAgreement = self.CurrentLoanAgreement
            precondition:
          currentRequest.oclIsUndefined() = false and currentLetter.oclIsUndefined() = false and currentAgreement.oclIsUndefined() = false and currentRequest.Status = LoanRequest::APPROVED
            postcondition:
          currentRequest.AttachedApprovalLetter = currentLetter and currentRequest.AttachedLoanAgreement = currentAgreement and result = true
            
        }