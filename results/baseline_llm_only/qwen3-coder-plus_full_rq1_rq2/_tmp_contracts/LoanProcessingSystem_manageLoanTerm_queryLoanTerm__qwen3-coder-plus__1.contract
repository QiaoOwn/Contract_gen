Contract ManageLoanTermCRUDService::queryLoanTerm(itemid:Integer): LoanTerm {
          definition:
          loanTerm:LoanTerm = LoanTerm.allInstance()->any(o:LoanTerm|o.ItemID=itemid)
            precondition:
          itemid <> 0 and loanTerm.oclIsUndefined() = false
            postcondition:
          result = loanTerm
            
        }