Contract CoCoMESystem::openCashDesk(cashDeskID:Integer): Boolean {
          definition:
          cashDesk:CashDesk = CashDesk.allInstance()->any(cd:CashDesk|cd.Id=cashDeskID), store:Store = self.CurrentStore
            precondition:
          cashDesk.oclIsUndefined() = false and store.oclIsUndefined() = false and cashDesk.IsOpened = false and cashDesk.BelongedStore = store
            postcondition:
          cashDesk.IsOpened = true and self.CurrentCashDesk = cashDesk and result = true
            
        }