Contract AutomatedTellerMachineSystem::printReceipt(): Real {
          definition:
          currentCard:BankCard = self.InputCard, isValidCard: Boolean = self.CardIDValidated, isPasswordValid: Boolean = self.PasswordValidated, isDepositAction: Boolean = self.IsDeposit
            precondition:
          currentCard.oclIsUndefined() = false and isValidCard = true and isPasswordValid = true and isDepositAction = true and self.DepositedNumber > 0
            postcondition:
          result = self.DepositedNumber
            
        }