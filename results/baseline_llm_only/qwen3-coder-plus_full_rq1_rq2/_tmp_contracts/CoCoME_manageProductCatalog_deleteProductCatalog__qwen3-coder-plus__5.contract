Contract ManageProductCatalogCRUDService::deleteProductCatalog(id:Integer): Boolean {
          definition:
          pc:ProductCatalog = ProductCatalog.allInstance()->any(o:ProductCatalog|o.Id=id)
            precondition:
          pc.oclIsUndefined() = false and pc.ContainedItems->isEmpty() = true
            postcondition:
          ProductCatalog.allInstance()->excludes(pc) and result = true
            
        }