Contract AutomatedTellerMachineSystem::printReceipt(): Real {
          definition:
          currentCard:BankCard = self.InputCard, isValidCard:Boolean = self.CardIDValidated, isPasswordValid:Boolean = self.PasswordValidated, isDepositAction:Boolean = self.IsDeposit, depositedAmount:Real = self.DepositedNumber
            precondition:
          currentCard.oclIsUndefined() = false and isValidCard = true and isPasswordValid = true and isDepositAction = true and depositedAmount > 0
            postcondition:
          result = depositedAmount
            
        }