Contract ManageProductCatalogCRUDService::modifyProductCatalog(id:Integer,name:String): Boolean {
          definition:
          cat:ProductCatalog = ProductCatalog.allInstance()->any(c:ProductCatalog|c.Id=id)
            precondition:
          cat.oclIsUndefined() = false and name.oclIsUndefined() = false
            postcondition:
          cat.Name = name and result = true
            
        }