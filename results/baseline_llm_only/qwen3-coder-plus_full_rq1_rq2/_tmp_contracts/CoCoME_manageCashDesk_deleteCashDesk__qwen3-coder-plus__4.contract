Contract ManageCashDeskCRUDService::deleteCashDesk(id:Integer): Boolean {
          definition:
          cashDesk:CashDesk = CashDesk.allInstance()->any(c:CashDesk|c.Id=id)
            precondition:
          cashDesk.oclIsUndefined() = false and cashDesk.IsOpened = false
            postcondition:
          CashDesk.allInstance()->excludes(cashDesk) and result = true
            
        }