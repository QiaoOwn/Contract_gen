Contract AutomatedTellerMachineSystem::inputPassword(password:Integer): Boolean {
          definition:
          currentCard:BankCard = self.InputCard
            precondition:
          currentCard.oclIsUndefined() = false and currentCard.CardStatus = BankCard::NORMAL and self.CardIDValidated = true and password <> null
            postcondition:
          self.PasswordValidated = (currentCard.Password = password) and result = (currentCard.Password = password)
            
        }