Contract ListBookHistory::listReservationBook(uid:String): Set(BookCopy) {
          definition:
          usr:User = User.allInstance()->any(u:User|u.UserID=uid)
            precondition:
          usr.oclIsUndefined() = false
            postcondition:
          result = usr.ReservedBook->collect(r:Reserve|r.ReservedCopy)
            
        }