Contract SearchBook::searchBookByISBN(iSBNnumber:String): Set(Book) {
          definition:
          books:Set(Book) = Book.allInstance()->select(b:Book|b.ISBn=iSBNnumber)
            precondition:
          iSBNnumber.oclIsUndefined() = false
            postcondition:
          result = books
            
        }