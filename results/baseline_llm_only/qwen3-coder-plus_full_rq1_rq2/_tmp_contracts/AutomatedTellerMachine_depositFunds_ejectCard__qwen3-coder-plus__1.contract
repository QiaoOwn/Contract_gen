Contract AutomatedTellerMachineSystem::ejectCard(): Boolean {
          definition:
          currentCard:BankCard = self.InputCard
            precondition:
          self.InputCard.oclIsUndefined() = false and self.PasswordValidated = true and currentCard.CardStatus = BankCard::NORMAL
            postcondition:
          self.InputCard = null and self.PasswordValidated = false and self.CardIDValidated = false and self.IsDeposit = false and self.DepositedNumber = 0 and result = true
            
        }