Contract EvaluateLoanRequestModule::chooseOneForReview(requestid:Integer): LoanRequest {
          definition:
          req:LoanRequest = LoanRequest.allInstance()->any(r:LoanRequest|r.RequestID=requestid)
            precondition:
          req.oclIsUndefined() = false and req.Status = LoanRequestStatus::SUBMITTED
            postcondition:
          self.CurrentLoanRequest = req and self.CurrentLoanRequests->includes(req) and req.Status = LoanRequestStatus::READYFORREVIEW and result = req
            
        }