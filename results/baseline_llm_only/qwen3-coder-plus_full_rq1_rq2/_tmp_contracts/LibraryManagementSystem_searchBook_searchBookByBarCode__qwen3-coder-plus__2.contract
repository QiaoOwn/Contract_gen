Contract SearchBook::searchBookByBarCode(barcode:String): Set(Book) {
          definition:
          bookCopies:Set(BookCopy) = BookCopy.allInstance()->select(bc:BookCopy|bc.Barcode=barcode), books:Set(Book) = bookCopies->collect(bc:BookCopy|bc.BookBelongs)
            precondition:
          barcode.oclIsUndefined() = false
            postcondition:
          result = books
            
        }