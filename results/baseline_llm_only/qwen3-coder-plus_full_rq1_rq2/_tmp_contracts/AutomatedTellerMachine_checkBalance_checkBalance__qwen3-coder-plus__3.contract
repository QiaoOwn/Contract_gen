Contract AutomatedTellerMachineSystem::checkBalance(): Real {
          definition:
          currentCard:BankCard = self.InputCard
            precondition:
          self.PasswordValidated = true and self.CardIDValidated = true and currentCard.oclIsUndefined() = false and currentCard.CardStatus = BankCard::NORMAL
            postcondition:
          result = currentCard.Balance
            
        }