Contract AutomatedTellerMachineSystem::printReceipt(): Real {
          definition:
          currentCard:BankCard = self.InputCard, isValid: Boolean = self.CardIDValidated and self.PasswordValidated
            precondition:
          self.InputCard.oclIsUndefined() = false and self.CardIDValidated = true and self.PasswordValidated = true and (self.IsWithdraw = true or self.IsDeposit = true)
            postcondition:
          self.WithdrawedNumber = self.WithdrawedNumber @pre and self.DepositedNumber = self.DepositedNumber @pre and result = 0.0
            
        }