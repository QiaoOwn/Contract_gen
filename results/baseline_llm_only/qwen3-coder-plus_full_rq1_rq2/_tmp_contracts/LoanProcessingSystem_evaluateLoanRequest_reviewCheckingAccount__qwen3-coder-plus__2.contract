Contract EvaluateLoanRequestModule::reviewCheckingAccount(): CheckingAccount {
          definition:
          currentReq:LoanRequest = self.CurrentLoanRequest, checkingAcc:CheckingAccount = currentReq.RequestedCAHistory
            precondition:
          currentReq.oclIsUndefined() = false and checkingAcc.oclIsUndefined() = false
            postcondition:
          checkingAcc.oclIsNew() = false and result = checkingAcc
            
        }