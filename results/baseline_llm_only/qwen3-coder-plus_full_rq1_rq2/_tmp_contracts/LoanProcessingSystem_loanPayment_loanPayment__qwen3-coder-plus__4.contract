Contract LoanProcessingSystemSystem::loanPayment(loanid:Integer): Boolean {
          definition:
          l:Loan = Loan.allInstance()->any(l:Loan|l.LoanID=loanid)
            precondition:
          l.oclIsUndefined() = false and l.Status = Loan::LSOPEN
            postcondition:
          l.RemainAmountToPay >= 0 and (l.IsPaidinFull = true implies l.RemainAmountToPay = 0) and result = true
            
        }