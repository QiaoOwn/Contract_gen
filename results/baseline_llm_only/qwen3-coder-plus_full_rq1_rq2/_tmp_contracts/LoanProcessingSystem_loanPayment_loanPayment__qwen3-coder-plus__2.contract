Contract LoanProcessingSystemSystem::loanPayment(loanid:Integer): Boolean {
          definition:
          loan:Loan = Loan.allInstance()->any(l:Loan|l.LoanID=loanid)
            precondition:
          loan.oclIsUndefined() = false and loan.Status = Loan::LSOPEN
            postcondition:
          loan.LoanID = loanid and result = true
            
        }