Contract EnterValidatedCreditReferencesModule::markRequestValid(): Boolean {
          definition:
          currentReq:LoanRequest = self.CurrentLoanRequest
            precondition:
          currentReq.oclIsUndefined() = false and currentReq.Status = LoanRequestStatus::SUBMITTED
            postcondition:
          currentReq.Status = LoanRequestStatus::REFERENCESVALIDATED and result = true
            
        }