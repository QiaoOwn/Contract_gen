Contract ProcessSaleService::makeNewSale(): Boolean {
          definition:
          currentCashDesk:CashDesk = CashDesk.allInstance()->any(cd:CashDesk|cd.IsOpened=true)
            precondition:
          currentCashDesk.oclIsUndefined() = false and self.CurrentSale.oclIsUndefined() = true
            postcondition:
          let newSale:Sale in newSale.oclIsNew() and newSale.Time=new Date() and newSale.IsComplete=false and newSale.Amount=0.0 and newSale.IsReadytoPay=false and newSale.BelongedCashDesk=currentCashDesk and newSale.Belongedstore=currentCashDesk.BelongedStore and currentCashDesk.ContainedSales->includes(newSale) and currentCashDesk.BelongedStore.Sales->includes(newSale) and self.CurrentSale=newSale and result=true
            
        }