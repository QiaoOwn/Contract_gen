Contract AutomatedTellerMachineSystem::ejectCard(): Boolean {
          definition:
          currentCard:BankCard = self.InputCard
            precondition:
          self.InputCard.oclIsUndefined() = false and self.CardIDValidated = true
            postcondition:
          self.InputCard = null and self.CardIDValidated = false and self.PasswordValidated = false and result = true
            
        }