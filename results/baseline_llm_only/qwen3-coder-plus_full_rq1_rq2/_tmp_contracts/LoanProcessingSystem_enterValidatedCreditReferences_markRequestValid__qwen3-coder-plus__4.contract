Contract EnterValidatedCreditReferencesModule::markRequestValid(): Boolean {
          definition:
          currentReq:LoanRequest = self.CurrentLoanRequest
            precondition:
          currentReq.oclIsUndefined() = false and currentReq.Status = LoanRequest::SUBMITTED
            postcondition:
          currentReq.Status = LoanRequest::REFERENCESVALIDATED and result = true
            
        }