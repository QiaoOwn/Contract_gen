Contract AutomatedTellerMachineSystem::inputCard(cardid:Integer): Boolean {
          definition:
          targetCard:BankCard = BankCard.allInstance()->any(c:BankCard|c.CardID=cardid)
            precondition:
          targetCard.oclIsUndefined() = false and targetCard.CardStatus <> BankCard::CANNEL and self.CardIDValidated = false
            postcondition:
          self.InputCard = targetCard and self.CardIDValidated = true and result = true
            
        }