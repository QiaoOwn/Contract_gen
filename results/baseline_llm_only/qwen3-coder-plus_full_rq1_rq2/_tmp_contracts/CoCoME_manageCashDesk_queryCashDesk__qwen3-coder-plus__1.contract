Contract ManageCashDeskCRUDService::queryCashDesk(id:Integer): CashDesk {
          definition:
          cashDesk:CashDesk = CashDesk.allInstance()->any(cd:CashDesk|cd.Id=id)
            precondition:
          cashDesk.oclIsUndefined() = false
            postcondition:
          result = cashDesk
            
        }