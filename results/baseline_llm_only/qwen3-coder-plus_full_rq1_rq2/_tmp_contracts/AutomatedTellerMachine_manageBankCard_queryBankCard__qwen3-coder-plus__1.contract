Contract ManageBankCardCRUDService::queryBankCard(cardid:Integer): BankCard {
          definition:
          targetCard:BankCard = BankCard.allInstance()->any(bc:BankCard|bc.CardID=cardid)
            precondition:
          targetCard.oclIsUndefined() = false
            postcondition:
          result = targetCard
            
        }