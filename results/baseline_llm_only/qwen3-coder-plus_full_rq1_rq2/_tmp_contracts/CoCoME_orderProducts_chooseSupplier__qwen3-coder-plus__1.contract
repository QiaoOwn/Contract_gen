Contract CoCoMEOrderProducts::chooseSupplier(supplierID:Integer): Boolean {
          definition:
          supp:Supplier = Supplier.allInstance()->any(s:Supplier|s.Id=supplierID), ordProd:OrderProduct = self.CurrentOrderProduct
            precondition:
          supp.oclIsUndefined() = false and ordProd.oclIsUndefined() = false and ordProd.OrderStatus = OrderProduct::NEW
            postcondition:
          ordProd.Supplier = supp and ordProd.OrderStatus = OrderProduct::REQUESTED and result = true
            
        }