Contract AutomatedTellerMachineSystem::printReceipt(): Real {
          definition:
          currentCard:BankCard = self.InputCard, isValid: Boolean = self.CardIDValidated and self.PasswordValidated
            precondition:
          self.InputCard.oclIsUndefined() = false and self.CardIDValidated = true and self.PasswordValidated = true and currentCard.CardStatus = BankCard::NORMAL
            postcondition:
          result = self.DepositedNumber
            
        }