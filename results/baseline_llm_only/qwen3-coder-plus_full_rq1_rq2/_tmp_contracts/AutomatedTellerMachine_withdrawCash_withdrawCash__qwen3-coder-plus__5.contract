Contract AutomatedTellerMachineSystem::withdrawCash(quantity:Integer): Boolean {
          definition:
          currentCard:BankCard = self.InputCard, isValidPassword:Boolean = self.PasswordValidated, isValidCardId:Boolean = self.CardIDValidated, isWithdrawAllowed:Boolean = self.IsWithdraw
            precondition:
          currentCard.oclIsUndefined() = false and isValidPassword = true and isValidCardId = true and isWithdrawAllowed = true and quantity > 0 and currentCard.Balance >= quantity
            postcondition:
          currentCard.Balance = currentCard@pre.Balance - quantity and self.WithdrawedNumber = self.WithdrawedNumber@pre + quantity and result = true
            
        }