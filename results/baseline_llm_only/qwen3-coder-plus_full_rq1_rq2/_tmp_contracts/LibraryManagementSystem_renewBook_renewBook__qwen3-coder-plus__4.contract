Contract LibraryManagementSystemSystem::renewBook(uid:String,barcode:String): Boolean {
          definition:
          usr:User = User.allInstance()->any(u:User|u.UserID=uid), copy:BookCopy = BookCopy.allInstance()->any(c:BookCopy|c.Barcode=barcode), activeLoan:Loan = Loan.allInstance()->any(l:Loan|l.LoanedUser=usr and l.LoanedCopy=copy and l.IsReturned=false)
            precondition:
          usr.oclIsUndefined() = false and copy.oclIsUndefined() = false and activeLoan.oclIsUndefined() = false and usr.BorrowStatus = User::NORMAL and activeLoan.RenewedTimes < 3
            postcondition:
          activeLoan.RenewDate <> activeLoan@pre.RenewDate and activeLoan.DueDate <> activeLoan@pre.DueDate and activeLoan.RenewedTimes = activeLoan@pre.RenewedTimes + 1 and result = true
            
        }