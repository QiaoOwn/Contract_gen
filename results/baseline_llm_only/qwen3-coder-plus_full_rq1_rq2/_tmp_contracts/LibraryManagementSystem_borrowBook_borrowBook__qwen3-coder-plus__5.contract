Contract LibraryManagementSystemSystem::borrowBook(uid:String,barcode:String): Boolean {
          definition:
          usr:User = User.allInstance()->any(u:User|u.UserID=uid), copy:BookCopy = BookCopy.allInstance()->any(c:BookCopy|c.Barcode=barcode), maxLoans:Integer = if usr.oclIsTypeOf(Student) then 5 else 10 endif
            precondition:
          usr.oclIsUndefined() = false and copy.oclIsUndefined() = false and usr.BorrowStatus = BorrowStatus::NORMAL and usr.LoanedNumber < maxLoans and (copy.Status = CopyStatus::AVAILABLE or (copy.IsReserved = true and copy.ReservationRecord->exists(r:Reserve|r.ReservedUser=usr)))
            postcondition:
          let loan:Loan in loan.oclIsNew() and loan.LoanedUser=usr and loan.LoanedCopy=copy and loan.LoanLibrarian=self.CurrentLibrarian and loan.IsReturned=false and loan.DueDate=if usr.oclIsTypeOf(Student) then Date.today().addDays(14) else Date.today().addDays(21) endif and Loan.allInstance()->includes(loan) and copy.Status=CopyStatus::LOANED and usr.LoanedNumber=usr@pre.LoanedNumber+1 and result=true
            
        }