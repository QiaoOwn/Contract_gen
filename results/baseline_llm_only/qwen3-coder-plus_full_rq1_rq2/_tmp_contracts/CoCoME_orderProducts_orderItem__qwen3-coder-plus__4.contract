Contract CoCoMEOrderProducts::orderItem(barcode:Integer,quantity:Integer): Boolean {
          definition:
          item:Item = Item.allInstance()->any(i:Item|i.Barcode=barcode), currentOrder:OrderProduct = self.CurrentOrderProduct
            precondition:
          item.oclIsUndefined() = false and currentOrder.oclIsUndefined() = false and quantity > 0 and item.StockNumber >= quantity
            postcondition:
          let oe:OrderEntry in oe.oclIsNew() and oe.Quantity=quantity and oe.Item=item and oe.SubAmount=(item.OrderPrice * quantity) and currentOrder.ContainedEntries->includes(oe) and currentOrder.Amount = currentOrder.ContainedEntries->sum(e:OrderEntry|e.SubAmount) and result=true
            
        }