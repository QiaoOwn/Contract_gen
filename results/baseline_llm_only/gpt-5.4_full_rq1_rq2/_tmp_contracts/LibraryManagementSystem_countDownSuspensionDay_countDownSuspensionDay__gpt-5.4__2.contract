Contract LibraryManagementSystemSystem::countDownSuspensionDay(): void {
          definition:
          suspendedUsers:Set(User) = User.allInstance()->select(u:User|u.BorrowStatus=BorrowStatus::SUSPEND and u.SuspensionDays > 0), expiredUsers:Set(User) = User.allInstance()->select(u:User|u.BorrowStatus=BorrowStatus::SUSPEND and u.SuspensionDays = 1)
            precondition:
          true
            postcondition:
          User.allInstance()->select(u:User|u.BorrowStatus=BorrowStatus::SUSPEND and u.SuspensionDays > 0)->forAll(u:User|u.SuspensionDays=u.SuspensionDays@pre - 1) and expiredUsers->forAll(u:User|u.BorrowStatus=BorrowStatus::NORMAL and u.SuspensionDays=0) and User.allInstance()->select(u:User|u.BorrowStatus=BorrowStatus::SUSPEND and u.SuspensionDays@pre > 1)->forAll(u:User|u.BorrowStatus=BorrowStatus::SUSPEND)
            
        }