Contract CoCoMEOrderProducts::makeNewOrder(orderid:Integer): Boolean {
          definition:
          op:OrderProduct = OrderProduct.allInstance()->any(o:OrderProduct|o.Id=orderid)
            precondition:
          op.oclIsUndefined() = true
            postcondition:
          let op:OrderProduct in op.oclIsNew() and op.Id=orderid and op.OrderStatus=OrderProduct::NEW and op.Amount=0 and OrderProduct.allInstance()->includes(op) and self.CurrentOrderProduct=op and result=true
            
        }