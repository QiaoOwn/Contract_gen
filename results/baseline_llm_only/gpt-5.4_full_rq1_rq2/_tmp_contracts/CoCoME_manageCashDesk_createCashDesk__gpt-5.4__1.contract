Contract ManageCashDeskCRUDService::createCashDesk(id:Integer,name:String,isopened:Boolean): Boolean {
          definition:
          cashDesk:CashDesk = CashDesk.allInstance()->any(c:CashDesk|c.Id=id)
            precondition:
          cashDesk.oclIsUndefined() = true
            postcondition:
          let cashDesk:CashDesk in cashDesk.oclIsNew() and cashDesk.Id=id and cashDesk.Name=name and cashDesk.IsOpened=isopened and CashDesk.allInstance()->includes(cashDesk) and result=true
            
        }