Contract RepairService::finishRepair(id:Integer,sid:Integer,did:Integer,res:String): Boolean {
          definition:
          rep:Repair = Repair.allInstance()->any(r:Repair|r.Id=id), sta:Staff = Staff.allInstance()->any(s:Staff|s.Id=sid), dev:Device = Device.allInstance()->any(d:Device|d.Id=did), contact:Staff = dev.Contacts
            precondition:
          rep.oclIsUndefined() = false and sta.oclIsUndefined() = false and dev.oclIsUndefined() = false and rep.RelatedDevice = dev and contact = sta and sta.Role = 3
            postcondition:
          rep.Process = 1 and rep.Result = res and result=true
            
        }