Contract EvaluateLoanRequestModule::listAvaiableLoanTerm(): Set(LoanTerm) {
          definition:
          currentLoanRequest:LoanRequest = self.CurrentLoanRequest
            precondition:
          currentLoanRequest.oclIsUndefined() = false and LoanRequest.allInstance()->includes(currentLoanRequest)
            postcondition:
          result = currentLoanRequest.AttachedLoanTerms
            
        }