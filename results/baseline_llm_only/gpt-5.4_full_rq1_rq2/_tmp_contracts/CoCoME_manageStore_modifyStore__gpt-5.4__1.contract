Contract ManageStoreCRUDService::modifyStore(id:Integer,name:String,address:String,isopened:Boolean): Boolean {
          definition:
          sto:Store = Store.allInstance()->any(s:Store|s.Id=id)
            precondition:
          sto.oclIsUndefined() = false
            postcondition:
          Store.allInstance()->includes(sto) and sto.Name=name and sto.Address=address and sto.IsOpened=isopened and result=true
            
        }