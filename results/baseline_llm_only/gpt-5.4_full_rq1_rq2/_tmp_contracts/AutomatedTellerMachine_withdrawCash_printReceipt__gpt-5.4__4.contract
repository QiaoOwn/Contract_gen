Contract AutomatedTellerMachineSystem::printReceipt(): Real {
          definition:
          card:BankCard = self.InputCard
            precondition:
          card.oclIsUndefined() = false and self.CardIDValidated = true and self.PasswordValidated = true and self.IsWithdraw = true and card.CardStatus = BankCard::NORMAL
            postcondition:
          result = self.WithdrawedNumber
            
        }