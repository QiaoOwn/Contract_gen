Contract EnterValidatedCreditReferencesModule::listSubmitedLoanRequest(): Set(LoanRequest) {
          definition:
          submittedLoanRequests:Set(LoanRequest) = LoanRequest.allInstance()->select(lr:LoanRequest|lr.Status=LoanRequestStatus::SUBMITTED)
            precondition:
          submittedLoanRequests.isEmpty() = false
            postcondition:
          self.CurrentLoanRequests=submittedLoanRequests and result=submittedLoanRequests
            
        }