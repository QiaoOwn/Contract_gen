Contract LibraryManagementSystemSystem::renewBook(uid:String,barcode:String): Boolean {
          definition:
          user:User = User.allInstance()->any(u:User|u.UserID=uid), copy:BookCopy = BookCopy.allInstance()->any(c:BookCopy|c.Barcode=barcode), loan:Loan = Loan.allInstance()->any(l:Loan|l.LoanedUser=user and l.LoanedCopy=copy and l.IsReturned=false)
            precondition:
          user.oclIsUndefined() = false and copy.oclIsUndefined() = false and loan.oclIsUndefined() = false and user.BorrowStatus = BorrowStatus::NORMAL and user.OverDueFee = 0 and copy.Status = CopyStatus::LOANED and loan.OverDueFee = 0 and loan.OverDue31Days = false
            postcondition:
          loan.RenewedTimes = loan.RenewedTimes@pre + 1 and loan.RenewDate <> loan.RenewDate@pre and loan.DueDate <> loan.DueDate@pre and loan.IsReturned = false and result=true
            
        }