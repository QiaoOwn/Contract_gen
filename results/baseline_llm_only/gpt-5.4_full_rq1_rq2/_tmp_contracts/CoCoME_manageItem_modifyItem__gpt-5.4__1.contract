Contract ManageItemCRUDService::modifyItem(barcode:Integer,name:String,price:Real,stocknumber:Integer,orderprice:Real): Boolean {
          definition:
          item:Item = Item.allInstance()->any(i:Item|i.Barcode=barcode)
            precondition:
          item.oclIsUndefined() = false and price >= 0 and stocknumber >= 0 and orderprice >= 0
            postcondition:
          Item.allInstance()->includes(item) and item.Barcode=barcode and item.Name=name and item.Price=price and item.StockNumber=stocknumber and item.OrderPrice=orderprice and result=true
            
        }