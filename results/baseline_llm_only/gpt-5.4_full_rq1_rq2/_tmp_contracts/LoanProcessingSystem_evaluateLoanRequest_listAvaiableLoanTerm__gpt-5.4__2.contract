Contract EvaluateLoanRequestModule::listAvaiableLoanTerm(): Set(LoanTerm) {
          definition:
          curLoanRequest:LoanRequest = self.CurrentLoanRequest
            precondition:
          curLoanRequest.oclIsUndefined() = false and LoanRequest.allInstance()->includes(curLoanRequest) and curLoanRequest.Name = LoanRequestStatus::READYFORREVIEW
            postcondition:
          result = curLoanRequest.AttachedLoanTerms
            
        }