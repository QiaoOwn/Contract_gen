Contract AutomatedTellerMachineSystem::inputPassword(password:Integer): Boolean {
          definition:
          inputCard:BankCard = self.InputCard
            precondition:
          inputCard.oclIsUndefined() = false and BankCard.allInstance()->includes(inputCard) and inputCard.CardStatus = CardStatus::NORMAL and self.CardIDValidated = true and self.IsWithdraw = true
            postcondition:
          self.PasswordValidated = (inputCard.Password = password) and result = self.PasswordValidated
            
        }