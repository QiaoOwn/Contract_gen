Contract EnterValidatedCreditReferencesModule::markRequestValid(): Boolean {
          definition:
          loanRequest:LoanRequest = self.CurrentLoanRequest
            precondition:
          loanRequest.oclIsUndefined() = false and LoanRequest.allInstance()->includes(loanRequest) and loanRequest.Status = LoanRequestStatus::SUBMITTED
            postcondition:
          LoanRequest.allInstance()->includes(loanRequest) and loanRequest.Status = LoanRequestStatus::REFERENCESVALIDATED and result=true
            
        }