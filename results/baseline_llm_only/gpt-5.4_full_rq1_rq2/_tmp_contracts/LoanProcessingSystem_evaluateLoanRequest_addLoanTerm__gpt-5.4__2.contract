Contract EvaluateLoanRequestModule::addLoanTerm(termid:Integer): Boolean {
          definition:
          loanTerm:LoanTerm = LoanTerm.allInstance()->any(o:LoanTerm|o.ItemID=termid), currentLoanRequest:LoanRequest = self.CurrentLoanRequest
            precondition:
          currentLoanRequest.oclIsUndefined() = false and loanTerm.oclIsUndefined() = false and currentLoanRequest.AttachedLoanTerms->includes(loanTerm) = false
            postcondition:
          currentLoanRequest.AttachedLoanTerms->includes(loanTerm) and result=true
            
        }