Contract CoCoMESystem::closeStore(storeID:Integer): Boolean {
          definition:
          store:Store = Store.allInstance()->any(s:Store|s.Id=storeID), currentStore:Store = self.CurrentStore
            precondition:
          store.oclIsUndefined() = false and currentStore.oclIsUndefined() = false and store = currentStore and store.IsOpened = true
            postcondition:
          Store.allInstance()->includes(store) and store.IsOpened = false and self.CurrentStore = store and result=true
            
        }