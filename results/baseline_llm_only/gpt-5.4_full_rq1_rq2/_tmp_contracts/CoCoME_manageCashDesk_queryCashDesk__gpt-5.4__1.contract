Contract ManageCashDeskCRUDService::queryCashDesk(id:Integer): CashDesk {
          definition:
          cashDesk:CashDesk = CashDesk.allInstance()->any(o:CashDesk|o.Id=id)
            precondition:
          cashDesk.oclIsUndefined() = false
            postcondition:
          result = cashDesk
            
        }