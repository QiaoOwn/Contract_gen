Contract CoCoMESystem::closeCashDesk(cashDeskID:Integer): Boolean {
          definition:
          cashDesk:CashDesk = CashDesk.allInstance()->any(c:CashDesk|c.Id=cashDeskID)
            precondition:
          cashDesk.oclIsUndefined() = false and cashDesk.IsOpened = true and self.CurrentCashDesk = cashDesk
            postcondition:
          cashDesk.IsOpened = false and self.CurrentCashDesk = cashDesk and result=true
            
        }