Contract SearchBook::searchBookByBarCode(barcode:String): Set(Book) {
          definition:
          copys:Set(BookCopy) = BookCopy.allInstance()->select(c:BookCopy|c.Barcode=barcode), books:Set(Book) = Book.allInstance()->select(b:Book|copys->includes(b.Copys))
            precondition:
          barcode <> ''
            postcondition:
          result = books
            
        }