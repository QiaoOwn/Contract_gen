Contract CoCoMESystem::receiveOrderedProduct(orderID:Integer): Boolean {
          definition:
          ord:OrderProduct = OrderProduct.allInstance()->any(o:OrderProduct|o.Id=orderID)
            precondition:
          ord.oclIsUndefined() = false and ord.OrderStatus = OrderStatus::REQUESTED
            postcondition:
          ord.OrderStatus = OrderStatus::RECEIVED and result=true
            
        }