Contract CoCoMEOrderProducts::listAllOutOfStoreProducts(): Set(Item) {
          definition:
          currentOrderProduct:OrderProduct = self.CurrentOrderProduct, items:Set(Item) = Item.allInstance()->select(i:Item|i.StockNumber=0)
            precondition:
          currentOrderProduct.oclIsUndefined() = false
            postcondition:
          result = items
            
        }