Contract ManageLoanTermCRUDService::createLoanTerm(itemid:Integer,content:String): Boolean {
          definition:
          loanTerm:LoanTerm = LoanTerm.allInstance()->any(o:LoanTerm|o.ItemID=itemid)
            precondition:
          loanTerm.oclIsUndefined() = true
            postcondition:
          let lt:LoanTerm in lt.oclIsNew() and lt.ItemID=itemid and lt.Content=content and LoanTerm.allInstance()->includes(lt) and result=true
            
        }