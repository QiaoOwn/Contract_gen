Contract AutomatedTellerMachineSystem::printReceipt(): Real {
          definition:
          card:BankCard = self.InputCard
            precondition:
          card.oclIsUndefined() = false and BankCard.allInstance()->includes(card) and self.CardIDValidated = true and self.PasswordValidated = true and self.IsDeposit = true and card.CardStatus = CardStatus::NORMAL
            postcondition:
          result = self.DepositedNumber
            
        }