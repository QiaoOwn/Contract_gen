Contract CoCoMEOrderProducts::orderItem(barcode:Integer,quantity:Integer): Boolean {
          definition:
          currentOrderProduct:OrderProduct = self.CurrentOrderProduct, item:Item = Item.allInstance()->any(i:Item|i.Barcode=barcode)
            precondition:
          currentOrderProduct.oclIsUndefined() = false and item.oclIsUndefined() = false and quantity <> 0 and currentOrderProduct.OrderStatus = OrderStatus::REQUESTED
            postcondition:
          let orderEntry:OrderEntry in orderEntry.oclIsNew() and orderEntry.Quantity=quantity and orderEntry.SubAmount=item.OrderPrice * quantity and orderEntry.Item=item and currentOrderProduct.ContainedEntries->includes(orderEntry) and currentOrderProduct.Amount=currentOrderProduct.Amount@pre + item.OrderPrice * quantity and OrderEntry.allInstance()->includes(orderEntry) and result=true
            
        }