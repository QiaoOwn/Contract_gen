Contract ManageCashDeskCRUDService::modifyCashDesk(id:Integer,name:String,isopened:Boolean): Boolean {
          definition:
          cashDesk:CashDesk = CashDesk.allInstance()->any(c:CashDesk|c.Id=id)
            precondition:
          cashDesk.oclIsUndefined() = false
            postcondition:
          CashDesk.allInstance()->includes(cashDesk) and cashDesk.Id=id and cashDesk.Name=name and cashDesk.IsOpened=isopened and result=true
            
        }