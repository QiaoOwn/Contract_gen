Contract LibraryManagementSystemSystem::cancelReservation(uid:String,barcode:String): Boolean {
          definition:
          user:User = User.allInstance()->any(u:User|u.UserID=uid), copy:BookCopy = BookCopy.allInstance()->any(c:BookCopy|c.Barcode=barcode), reserve:Reserve = Reserve.allInstance()->any(r:Reserve|r.ReservedUser=user and r.ReservedCopy=copy and r.IsReserveClosed=false)
            precondition:
          user.oclIsUndefined() = false and copy.oclIsUndefined() = false and reserve.oclIsUndefined() = false and User.allInstance()->includes(user) and BookCopy.allInstance()->includes(copy) and Reserve.allInstance()->includes(reserve)
            postcondition:
          Reserve.allInstance()->excludes(reserve) and user.ReservedBook->excludes(reserve) and copy.ReservationRecord->excludes(reserve) and copy.IsReserved=false and result=true
            
        }