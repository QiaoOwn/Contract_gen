Contract AutomatedTellerMachineSystem::printReceipt(): Real {
          definition:
          inputCard:BankCard = self.InputCard
            precondition:
          inputCard.oclIsUndefined() = false and BankCard.allInstance()->includes(inputCard) and self.CardIDValidated = true and self.PasswordValidated = true and inputCard.CardStatus = CardStatus::NORMAL and self.IsDeposit = true
            postcondition:
          result = self.DepositedNumber
            
        }