Contract SubmitLoanRequestModule::calculateScore(): Integer {
          definition:
          lr:LoanRequest = self.CurrentLoanRequest, ca:CheckingAccount = lr.RequestedCAHistory, ch:CreditHistory = lr.RequestedCreditHistory
            precondition:
          lr.oclIsUndefined() = false and LoanRequest.allInstance()->includes(lr) and ca.oclIsUndefined() = false and ch.oclIsUndefined() = false and lr.Status = LoanRequestStatus::REFERENCESVALIDATED
            postcondition:
          lr.CreditScore = result and result = lr.CreditScore
            
        }