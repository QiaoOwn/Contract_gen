Contract CoCoMESystem::receiveOrderedProduct(orderID:Integer): Boolean {
          definition:
          op:OrderProduct = OrderProduct.allInstance()->any(o:OrderProduct|o.Id=orderID)
            precondition:
          op.oclIsUndefined() = false and op.OrderStatus <> OrderProduct::RECEIVED
            postcondition:
          op.OrderStatus = OrderProduct::RECEIVED and OrderProduct.allInstance()->includes(op) and result=true
            
        }