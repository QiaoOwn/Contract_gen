Contract CoCoMESystem::closeStore(storeID:Integer): Boolean {
          definition:
          store:Store = Store.allInstance()->any(s:Store|s.Id=storeID)
            precondition:
          store.oclIsUndefined() = false and store.IsOpened = true and self.CurrentStore = store
            postcondition:
          store.IsOpened = false and Store.allInstance()->includes(store) and result=true
            
        }