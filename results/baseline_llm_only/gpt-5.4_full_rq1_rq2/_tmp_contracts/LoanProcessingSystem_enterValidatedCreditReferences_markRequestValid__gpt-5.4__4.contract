Contract EnterValidatedCreditReferencesModule::markRequestValid(): Boolean {
          definition:
          loanRequest:LoanRequest = self.CurrentLoanRequest, checkingAccount:CheckingAccount = loanRequest.RequestedCAHistory, creditHistory:CreditHistory = loanRequest.RequestedCreditHistory
            precondition:
          loanRequest.oclIsUndefined() = false and LoanRequest.allInstance()->includes(loanRequest) and loanRequest.Name = LoanRequestStatus::SUBMITTED and checkingAccount.oclIsUndefined() = false and creditHistory.oclIsUndefined() = false
            postcondition:
          LoanRequest.allInstance()->includes(loanRequest) and loanRequest.Name = LoanRequestStatus::REFERENCESVALIDATED and result=true
            
        }