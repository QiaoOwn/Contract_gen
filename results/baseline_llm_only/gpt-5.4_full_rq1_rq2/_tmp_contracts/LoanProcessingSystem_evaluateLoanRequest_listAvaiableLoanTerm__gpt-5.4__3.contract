Contract EvaluateLoanRequestModule::listAvaiableLoanTerm(): Set(LoanTerm) {
          definition:
          currentLoanRequest:LoanRequest = self.CurrentLoanRequest
            precondition:
          currentLoanRequest.oclIsUndefined() = false and LoanRequest.allInstance()->includes(currentLoanRequest) and currentLoanRequest.Name = LoanRequestStatus::READYFORREVIEW
            postcondition:
          result = LoanTerm.allInstance()
            
        }