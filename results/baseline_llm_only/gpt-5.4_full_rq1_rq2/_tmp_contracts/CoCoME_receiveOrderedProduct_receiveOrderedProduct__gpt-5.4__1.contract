Contract CoCoMESystem::receiveOrderedProduct(orderID:Integer): Boolean {
          definition:
          op:OrderProduct = OrderProduct.allInstance()->any(o:OrderProduct|o.Id=orderID)
            precondition:
          op.oclIsUndefined() = false and op.OrderStatus = OrderStatus::REQUESTED
            postcondition:
          op.OrderStatus = OrderStatus::RECEIVED and result=true
            
        }