Contract AutomatedTellerMachineSystem::printReceipt(): Real {
          definition:
          card:BankCard = self.InputCard
            precondition:
          card.oclIsUndefined() = false and BankCard.allInstance()->includes(card) and self.CardIDValidated = true and self.PasswordValidated = true and self.IsWithdraw = true and card.CardStatus = CardStatus::NORMAL and self.WithdrawedNumber > 0 and card.Balance >= self.WithdrawedNumber
            postcondition:
          card.Balance = card.Balance@pre - self.WithdrawedNumber and result = self.WithdrawedNumber
            
        }