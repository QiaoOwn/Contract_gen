Contract ManageCashierCRUDService::modifyCashier(id:Integer,name:String): Boolean {
          definition:
          cashier:Cashier = Cashier.allInstance()->any(c:Cashier|c.Id=id)
            precondition:
          cashier.oclIsUndefined() = false
            postcondition:
          Cashier.allInstance()->includes(cashier) and cashier.Id=id and cashier.Name=name and result=true
            
        }