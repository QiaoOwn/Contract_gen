Contract ManageBankCardCRUDService::modifyBankCard(cardid:Integer,cardstatus:CardStatus[NORMAL|SUSPEND|CANCEL],catalog:CardCatalog[CREDIT|DEPOSIT],password:Integer,balance:Real): Boolean {
          definition:
          bankCard:BankCard = BankCard.allInstance()->any(b:BankCard|b.CardID=cardid)
            precondition:
          bankCard.oclIsUndefined() = false
            postcondition:
          BankCard.allInstance()->includes(bankCard) and bankCard.CardStatus=cardstatus and bankCard.Catalog=catalog and bankCard.Password=password and bankCard.Balance=balance and result=true
            
        }