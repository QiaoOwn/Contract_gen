Contract LibraryManagementSystemSystem::borrowBook(uid:String,barcode:String): Boolean {
          definition:
          u:User = User.allInstance()->any(o:User|o.UserID=uid), bc:BookCopy = BookCopy.allInstance()->any(o:BookCopy|o.Barcode=barcode), rs:Set(Reserve) = Reserve.allInstance()->select(o:Reserve|o.ReservedCopy=bc and o.ReservedUser=u and o.IsReserveClosed=false), stu:Student = Student.allInstance()->any(o:Student|o.UserID=uid), fac:Faculty = Faculty.allInstance()->any(o:Faculty|o.UserID=uid)
            precondition:
          u.oclIsUndefined() = false and bc.oclIsUndefined() = false and u.BorrowStatus <> BorrowStatus::SUSPEND and ((stu.oclIsUndefined() = false and u.LoanedNumber < 5) or (fac.oclIsUndefined() = false and u.LoanedNumber < 10)) and (bc.Status = CopyStatus::AVAILABLE or (bc.IsReserved = true and rs.isEmpty() = false))
            postcondition:
          let l:Loan in l.oclIsNew() and l.LoanedUser=u and l.LoanedCopy=bc and l.IsReturned=false and l.RenewedTimes=0 and ((stu.oclIsUndefined() = false and l.DueDate=self.studentDueDate) or (fac.oclIsUndefined() = false and l.DueDate=self.facultyDueDate)) and Loan.allInstance()->includes(l) and u.LoanedBook->includes(l) and bc.LoanedRecord->includes(l) and bc.Status=CopyStatus::LOANED and u.LoanedNumber=u.LoanedNumber@pre+1 and result=true
            
        }