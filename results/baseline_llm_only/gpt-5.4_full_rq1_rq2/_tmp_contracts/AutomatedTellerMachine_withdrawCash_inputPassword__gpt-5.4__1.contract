Contract AutomatedTellerMachineSystem::inputPassword(password:Integer): Boolean {
          definition:
          card:BankCard = self.InputCard
            precondition:
          card.oclIsUndefined() = false and BankCard.allInstance()->includes(card) and card.CardStatus = CardStatus::NORMAL and self.CardIDValidated = true
            postcondition:
          self.PasswordValidated = (card.Password = password) and result = self.PasswordValidated
            
        }