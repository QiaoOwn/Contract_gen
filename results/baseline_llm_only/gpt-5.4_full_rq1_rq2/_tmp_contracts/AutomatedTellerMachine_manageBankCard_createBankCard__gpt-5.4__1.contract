Contract ManageBankCardCRUDService::createBankCard(cardid:Integer,cardstatus:CardStatus[NORMAL|SUSPEND|CANCEL],catalog:CardCatalog[CREDIT|DEPOSIT],password:Integer,balance:Real): Boolean {
          definition:
          bankCard:BankCard = BankCard.allInstance()->any(b:BankCard|b.CardID=cardid)
            precondition:
          bankCard.oclIsUndefined() = true
            postcondition:
          let b:BankCard in b.oclIsNew() and b.CardID=cardid and b.CardStatus=cardstatus and b.Catalog=catalog and b.Password=password and b.Balance=balance and BankCard.allInstance()->includes(b) and result=true
            
        }