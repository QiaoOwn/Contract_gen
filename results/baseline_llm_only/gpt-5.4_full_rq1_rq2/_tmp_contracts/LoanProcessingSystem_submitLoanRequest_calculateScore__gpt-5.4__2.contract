Contract SubmitLoanRequestModule::calculateScore(): Integer {
          definition:
          loanRequest:LoanRequest = self.CurrentLoanRequest, checkingAccount:CheckingAccount = loanRequest.RequestedCAHistory, creditHistory:CreditHistory = loanRequest.RequestedCreditHistory
            precondition:
          loanRequest.oclIsUndefined() = false and LoanRequest.allInstance()->includes(loanRequest) and checkingAccount.oclIsUndefined() = false and creditHistory.oclIsUndefined() = false and loanRequest.Status = LoanRequestStatus::REFERENCESVALIDATED
            postcondition:
          loanRequest.CreditScore = result and result >= 0
            
        }