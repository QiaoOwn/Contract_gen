Contract ProcessSaleService::makeNewSale(): Boolean {
          precondition:
          self.CurrentSale.oclIsUndefined() = true
            postcondition:
          let sale:Sale in sale.oclIsNew() and sale.IsComplete=false and sale.Amount=0 and sale.IsReadytoPay=false and self.CurrentSale=sale and Sale.allInstance()->includes(sale) and result=true
            
        }