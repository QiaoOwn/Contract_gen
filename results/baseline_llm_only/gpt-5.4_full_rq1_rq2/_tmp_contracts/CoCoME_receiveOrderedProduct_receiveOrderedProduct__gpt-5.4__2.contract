Contract CoCoMESystem::receiveOrderedProduct(orderID:Integer): Boolean {
          definition:
          order:OrderProduct = OrderProduct.allInstance()->any(o:OrderProduct|o.Id=orderID)
            precondition:
          order.oclIsUndefined() = false and order.OrderStatus = OrderStatus::REQUESTED
            postcondition:
          order.OrderStatus = OrderStatus::RECEIVED and result=true
            
        }