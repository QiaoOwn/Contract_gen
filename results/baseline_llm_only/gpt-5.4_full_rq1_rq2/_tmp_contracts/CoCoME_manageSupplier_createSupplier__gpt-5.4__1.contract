Contract ManageSupplierCRUDService::createSupplier(id:Integer,name:String): Boolean {
          definition:
          sup:Supplier = Supplier.allInstance()->any(s:Supplier|s.Id=id)
            precondition:
          sup.oclIsUndefined() = true
            postcondition:
          let s:Supplier in s.oclIsNew() and s.Id=id and s.Name=name and Supplier.allInstance()->includes(s) and result=true
            
        }