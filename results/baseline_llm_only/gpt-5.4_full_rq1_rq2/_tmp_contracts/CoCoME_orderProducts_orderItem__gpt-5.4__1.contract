Contract CoCoMEOrderProducts::orderItem(barcode:Integer,quantity:Integer): Boolean {
          definition:
          item:Item = Item.allInstance()->any(i:Item|i.Barcode=barcode), currentOrderProduct:OrderProduct = self.CurrentOrderProduct
            precondition:
          currentOrderProduct.oclIsUndefined() = false and item.oclIsUndefined() = false and quantity <> 0
            postcondition:
          let oe:OrderEntry in oe.oclIsNew() and oe.Quantity=quantity and oe.SubAmount=item.OrderPrice * quantity and oe.Item=item and currentOrderProduct.ContainedEntries->includes(oe) and OrderEntry.allInstance()->includes(oe) and currentOrderProduct.Amount=currentOrderProduct.Amount@pre + oe.SubAmount and result=true
            
        }