Contract EvaluateLoanRequestModule::chooseOneForReview(requestid:Integer): LoanRequest {
          definition:
          loanRequest:LoanRequest = LoanRequest.allInstance()->any(o:LoanRequest|o.RequestID=requestid)
            precondition:
          loanRequest.oclIsUndefined() = false and loanRequest.Status = LoanRequestStatus::READYFORREVIEW
            postcondition:
          self.CurrentLoanRequest = loanRequest and self.CurrentLoanRequests->includes(loanRequest) and result = loanRequest
            
        }