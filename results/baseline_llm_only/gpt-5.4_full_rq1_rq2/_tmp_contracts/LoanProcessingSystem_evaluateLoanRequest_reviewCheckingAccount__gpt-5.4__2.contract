Contract EvaluateLoanRequestModule::reviewCheckingAccount(): CheckingAccount {
          definition:
          loanRequest:LoanRequest = self.CurrentLoanRequest, checkingAccount:CheckingAccount = loanRequest.RequestedCAHistory
            precondition:
          loanRequest.oclIsUndefined() = false and checkingAccount.oclIsUndefined() = false and loanRequest.Status = LoanRequestStatus::READYFORREVIEW
            postcondition:
          result = checkingAccount
            
        }