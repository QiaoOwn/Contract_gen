Contract LibraryManagementSystemSystem::countDownSuspensionDay(): void {
          definition:
          suspendedUsers:Set(User) = User.allInstance()->select(u:User|u.SuspensionDays>0)
            precondition:
          true
            postcondition:
          User.allInstance()->select(u:User|u.SuspensionDays>0)->forAll(u:User|u.SuspensionDays=u.SuspensionDays@pre-1 and ((u.SuspensionDays=0 and u.BorrowStatus=BorrowStatus::SUSPEND) or (u.SuspensionDays>0 and u.BorrowStatus=u.BorrowStatus@pre))) and User.allInstance()->select(u:User|u.SuspensionDays<=0)->forAll(u:User|u.SuspensionDays=u.SuspensionDays@pre and u.BorrowStatus=u.BorrowStatus@pre)
            
        }