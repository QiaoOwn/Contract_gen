Contract AutomatedTellerMachineSystem::inputPassword(password:Integer): Boolean {
          definition:
          inputCard:BankCard = self.InputCard
            precondition:
          inputCard.oclIsUndefined() = false and self.CardIDValidated = true and inputCard.CardStatus = CardStatus::NORMAL
            postcondition:
          self.PasswordValidated = (inputCard.Password = password) and result = self.PasswordValidated
            
        }