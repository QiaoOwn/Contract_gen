Contract AirportSystem::createStaff(id:Integer,name:String,pswd:String,phone:String,role:Integer,bossid:Integer): Boolean {
          definition:
          staff:Staff = Staff.allInstance()->any(s:Staff|s.Id=id), boss:Staff = Staff.allInstance()->any(b:Staff|b.Id=bossid)
            precondition:
          staff.oclIsUndefined() = true
            postcondition:
          let s:Staff in s.oclIsNew() and s.Id=id and s.Name=name and s.Password=pswd and s.Phone=phone and s.Role=role and Staff.allInstance()->includes(s) and (boss.oclIsUndefined() = true or s.Boss=boss) and result=true
            
        }