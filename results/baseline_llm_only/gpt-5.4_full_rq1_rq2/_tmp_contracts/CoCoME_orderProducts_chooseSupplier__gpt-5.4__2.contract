Contract CoCoMEOrderProducts::chooseSupplier(supplierID:Integer): Boolean {
          definition:
          currentOrder:OrderProduct = self.CurrentOrderProduct, supplier:Supplier = Supplier.allInstance()->any(s:Supplier|s.Id=supplierID)
            precondition:
          currentOrder.oclIsUndefined() = false and supplier.oclIsUndefined() = false and currentOrder.OrderStatus = OrderStatus::NEW
            postcondition:
          currentOrder.Supplier = supplier and currentOrder.OrderStatus = OrderStatus::REQUESTED and result=true
            
        }