Contract ListBookHistory::listOverDueBook(uid:String): Set(BookCopy) {
          definition:
          user:User = User.allInstance()->any(u:User|u.UserID=uid), overdueLoans:Set(Loan) = Loan.allInstance()->select(l:Loan|l.LoanedUser=user and l.IsReturned=false and l.OverDue3Days=true), overdueCopies:Set(BookCopy) = BookCopy.allInstance()->select(bc:BookCopy|overdueLoans->exists(l:Loan|l.LoanedCopy=bc))
            precondition:
          user.oclIsUndefined() = false
            postcondition:
          result = overdueCopies
            
        }