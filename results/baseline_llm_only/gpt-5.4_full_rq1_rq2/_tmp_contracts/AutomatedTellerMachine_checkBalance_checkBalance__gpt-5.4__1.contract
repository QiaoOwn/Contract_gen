Contract AutomatedTellerMachineSystem::checkBalance(): Real {
          definition:
          inputCard:BankCard = self.InputCard
            precondition:
          inputCard.oclIsUndefined() = false and BankCard.allInstance()->includes(inputCard) and self.CardIDValidated = true and self.PasswordValidated = true and inputCard.CardStatus = CardStatus::NORMAL
            postcondition:
          BankCard.allInstance()->includes(inputCard) and inputCard.Balance = inputCard.Balance@pre and result = inputCard.Balance
            
        }