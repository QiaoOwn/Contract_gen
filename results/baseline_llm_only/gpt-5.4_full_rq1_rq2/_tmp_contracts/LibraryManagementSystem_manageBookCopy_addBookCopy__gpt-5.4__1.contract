Contract ManageBookCopyCRUDService::addBookCopy(callNo:String,barcode:String,location:String): Boolean {
          definition:
          book:Book = Book.allInstance()->any(b:Book|b.CallNo=callNo), copy:BookCopy = BookCopy.allInstance()->any(c:BookCopy|c.Barcode=barcode)
            precondition:
          book.oclIsUndefined() = false and copy.oclIsUndefined() = true
            postcondition:
          let bc:BookCopy in bc.oclIsNew() and bc.Barcode=barcode and bc.Location=location and bc.Status=CopyStatus::AVAILABLE and bc.IsReserved=false and bc.BookBelongs=book and BookCopy.allInstance()->includes(bc) and book.Copys->includes(bc) and book.CopyNum=book.CopyNum@pre + 1 and result=true
            
        }