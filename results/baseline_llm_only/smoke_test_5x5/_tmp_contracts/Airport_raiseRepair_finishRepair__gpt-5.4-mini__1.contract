Contract RepairService::finishRepair(id:Integer,sid:Integer,did:Integer,res:String): Boolean {
          definition:
          rep:Repair = Repair.allInstance()->any(r:Repair|r.Id=id), sta:Staff = Staff.allInstance()->any(s:Staff|s.Id=sid), dev:Device = Device.allInstance()->any(d:Device|d.Id=did), isWorker = sta.Role = 1
            precondition:
          rep.oclIsUndefined() = false and sta.oclIsUndefined() = false and dev.oclIsUndefined() = false and dev.Contacts = sta and isWorker = true
            postcondition:
          rep.Process = 1 and rep.Result = res and result = true
            
        }