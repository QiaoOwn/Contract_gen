Contract RepairService::feedback(id:Integer,sid:Integer,score:Integer,des:String): Boolean {
          definition:
          rep:Repair = Repair.allInstance()->any(r:Repair|r.Id=id), sta:Staff = Staff.allInstance()->any(s:Staff|s.Id=sid)
            precondition:
          rep.oclIsUndefined() = false and sta.oclIsUndefined() = false and rep.RaiseStaff = sta and sta.Role = Staff::GroundStaff and rep.Process = 2
            postcondition:
          rep.Score = score and (score >= 4 implies rep.Close = true and rep.Process = 3 and rep.Description = rep.Description@pre) and (score < 4 implies rep.Close = false and rep.Description = des and rep.Process = 0) and result = true
            
        }